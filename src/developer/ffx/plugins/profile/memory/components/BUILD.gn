import("//src/developer/ffx/build/ffx_plugin.gni")

ffx_plugin("ffx_profile_memory_components") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"

  sources = [
    "src/detailed.rs",
    "src/json.rs",
    "src/lib.rs",
    "src/output.rs",
    "src/resource_annotator.rs",
    "src/statistics.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust_fdomain",
    "//sdk/fidl/fuchsia.memory.attribution.plugin:fuchsia.memory.attribution.plugin_rust_fdomain",
    "//sdk/rust/zx-types",
    "//src/developer/ffx/lib/errors:lib",
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/target/holders:lib",
    "//src/developer/ffx/lib/writer:lib",
    "//src/lib/assembly/assembled_system",
    "//src/lib/assembly/container",
    "//src/lib/fdomain/client",
    "//src/lib/fidl/rust/fidl",
    "//src/performance/memory/attribution/processing",
    "//src/storage/fxfs/platform:constants",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:chrono",
    "//third_party/rust_crates:csv",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:prettytable-rs",
    "//third_party/rust_crates:regex-lite",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:zstd",
    "//third_party/zstd",
  ]

  test_deps = [
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:rustc-hash",
  ]
  args_sources = [ "src/args.rs" ]
  args_deps = [
    "//src/developer/ffx/core:lib",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:camino",
  ]
  with_unit_tests = true
}
