import("//src/developer/ffx/build/ffx_plugin.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  ffx_plugin("ffx_trace") {
    sdk_category = "not-yet-specified"
    version = "0.1.0"
    edition = "2024"
    with_unit_tests = true
    args_with_unit_tests = true
    config_data = [ "data/config.json" ]

    args_sources = [ "src/args.rs" ]

    sources = [
      "src/direct.rs",
      "src/lib.rs",
      "src/process.rs",
      "src/progress_reader.rs",
      "src/upload.rs",
    ]

    deps = [
      "//sdk/fidl/fuchsia.tracing:fuchsia.tracing_rust_fdomain",
      "//sdk/fidl/fuchsia.tracing.controller:fuchsia.tracing.controller_rust_fdomain",
      "//src/developer/ffx/config:lib",
      "//src/developer/ffx/lib/errors:lib",
      "//src/developer/ffx/lib/fho:lib",
      "//src/developer/ffx/lib/pbms:lib",
      "//src/developer/ffx/lib/target:lib",
      "//src/developer/ffx/lib/target/behavior:lib",
      "//src/developer/ffx/lib/target/holders:lib",
      "//src/developer/ffx/lib/trace:lib",
      "//src/developer/ffx/lib/writer:lib",
      "//src/lib/fdomain/client",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia-async",
      "//src/lib/gcs",
      "//src/lib/structured_ui",
      "//src/performance/lib/fxt/rust",
      "//src/performance/trace_task:trace_task_fdomain",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:async-fs",
      "//third_party/rust_crates:async-trait",
      "//third_party/rust_crates:blocking",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:hex",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:prettytable-rs",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:sha2",
      "//third_party/rust_crates:term_grid",
      "//third_party/rust_crates:termion",
      "//third_party/rust_crates:zstd",
      "//third_party/zstd",
    ]

    args_deps = [
      "//sdk/fidl/fuchsia.tracing:fuchsia.tracing_rust_fdomain",
      "//sdk/fidl/fuchsia.tracing.controller:fuchsia.tracing.controller_rust_fdomain",
      "//third_party/rust_crates:argh",
    ]

    test_deps = [
      "//src/developer/ffx/lib/writer:lib",
      "//src/lib/fdomain/local",
      "//src/lib/fuchsia",
      "//third_party/rust_crates:pretty_assertions",
      "//third_party/rust_crates:regex",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:tempfile",
    ]
  }

  ffx_tool("ffx_trace_tool") {
    # Needed for Honeydew's SDK inclusion
    #
    # TODO(b/330934833): Remove when IDK allows for `testonly` targets in dep
    # tree or when we can separate the concept of data_dep from host_test_data.
    testonly = false

    edition = "2024"
    output_name = "ffx-trace"
    deps = [
      ":ffx_trace",
      "//src/developer/ffx/lib/fho:lib",
      "//src/lib/fuchsia-async",
      "//third_party/zstd",
    ]
    sources = [ "src/main.rs" ]

    sdk_target_name = "sdk"
    sdk_category = "partner"
  }

  group("trace") {
    public_deps = [
      ":ffx_trace_tool",
      ":ffx_trace_tool_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_trace_tool_versioned" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":ffx_trace_tests($host_toolchain)" ]
}
