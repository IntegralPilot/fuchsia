import("//src/developer/ffx/build/ffx_plugin.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

ffx_plugin("ffx_test") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  features = [ "fdomain" ]
  deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust_fdomain",
    "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust_fdomain",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
    "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_fdomain",
    "//src/developer/ffx/config:lib",
    "//src/developer/ffx/lib/errors:lib",
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/target/holders:lib",
    "//src/developer/ffx/lib/testing:lib",
    "//src/developer/ffx/lib/writer:lib",
    "//src/developer/ffx/plugins/component/common:ffx_component",
    "//src/lib/diagnostics/data/rust",
    "//src/lib/fdomain/client",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/testing/test_list",
    "//src/sys/run_test_suite:lib_fdomain",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:chrono",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:schemars",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:signal-hook",
    "//tools/test_pilot/test_pilot_lib",
  ]

  test_deps = [
    "//src/lib/fdomain/local",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:tempfile",
    "//third_party/rust_crates:walkdir",
    "//third_party/rust_crates:zstd",
    "//third_party/zstd",
  ]

  args_deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//src/lib/diagnostics/data/rust",
    "//src/lib/diagnostics/selectors",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
  args_sources = [ "src/args.rs" ]

  sources = [
    "src/connector.rs",
    "src/lib.rs",
    "src/pilot.rs",
    "src/suite_definition.rs",
  ]

  config_data = [ "data/config.json" ]
}

ffx_tool("ffx_test_tool") {
  # Needed for Honeydew's SDK inclusion
  #
  # TODO(b/330934833): Remove when IDK allows for `testonly` targets in dep
  # tree or when we can separate the concept of data_dep from host_test_data.
  testonly = false

  edition = "2024"
  output_name = "ffx-test"
  deps = [
    ":ffx_test",
    "//src/developer/ffx/lib/fho:lib",
    "//src/lib/fuchsia-async",
  ]
  sources = [ "src/main.rs" ]

  sdk_target_name = "sdk"
  sdk_category = "partner"
}

group("test") {
  public_deps = [
    ":ffx_test_tool",
    ":ffx_test_tool_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_test_tool_versioned" ]
}

group("tests") {
  testonly = true
  deps = [ ":ffx_test_tests($host_toolchain)" ]
}
