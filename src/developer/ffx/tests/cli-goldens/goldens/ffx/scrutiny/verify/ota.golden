{
  "name": "ota",
  "description": "Runs OTA verification checks. Starting from a given update package hash, this fetches blobs from a delivery blob repository over HTTP. It follows the packages.json and packages' metadata to verify the presence and integrity of the full set of blobs that constitutes an update.",
  "examples": [
    "To run the OTA verification checks against a build:\n\n    $ ffx scrutiny verify ota \\\n        --update-package <merkle-hash-of-update-package> \\\n        --blob-server-url <url-of-blob-server>"
  ],
  "flags": [
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--help",
      "short": null,
      "description": "display usage information",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "update-package"
        }
      },
      "optionality": "required",
      "long": "--update-package",
      "short": null,
      "description": "the merkle hash of the update package",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "blob-server-url"
        }
      },
      "optionality": "required",
      "long": "--blob-server-url",
      "short": null,
      "description": "url of the blob server to fetch artifacts from",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "delivery-blob-type"
        }
      },
      "optionality": "optional",
      "long": "--delivery-blob-type",
      "short": null,
      "description": "optional delivery blob type to use (e.g. 1)",
      "hidden": false
    }
  ],
  "notes": [],
  "commands": [],
  "positionals": [],
  "error_codes": []
}