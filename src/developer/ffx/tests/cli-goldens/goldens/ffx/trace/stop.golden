{
  "name": "stop",
  "description": "Stops an active running trace.",
  "examples": [],
  "flags": [
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--help",
      "short": null,
      "description": "display usage information",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "output"
        }
      },
      "optionality": "optional",
      "long": "--output",
      "short": null,
      "description": "name of output trace file. Relative or absolute paths are both supported. If this is not supplied (the default), then the default target will be used as the method to stop the trace.",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--verbose",
      "short": "v",
      "description": "increase verbosity of command output. Defaults to false. Enabling this prints stats from trace providers including the number of records dropped, wrapped buffers count, % of durable buffer used and non durable bytes written.",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--no-symbolize",
      "short": null,
      "description": "prevent symbolization of the trace file. Defaults to false. If the 'kernel:ipc' category is not included in tracing, this flag does nothing. Otherwise this flag will prevent the symbolization of the kernel IPC traces, leaving only the ordinals in the trace.",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--no-verify-trace",
      "short": null,
      "description": "prevent checking the trace data when stopping tracing. Defaults to false. If this flag is enabled, trace result analysis will not be triggered.",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--retain-raw-fidl",
      "short": null,
      "description": "retain raw FIDL-related trace arguments after symbolization. Defaults to false.",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--abort",
      "short": null,
      "description": "stop the currently running background trace session. Discard the trace data. Defaults to false.",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--upload",
      "short": null,
      "description": "upload the trace file to GCS and display the Perfetto Trace Viewer URL. Defaults to false.",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "bucket"
        }
      },
      "optionality": "optional",
      "long": "--bucket",
      "short": null,
      "description": "GCS bucket to upload the trace file to.",
      "hidden": false
    }
  ],
  "notes": [],
  "commands": [],
  "positionals": [],
  "error_codes": []
}