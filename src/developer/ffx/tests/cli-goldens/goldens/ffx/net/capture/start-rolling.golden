{
  "name": "start-rolling",
  "description": "Arguments for the `start-rolling` subcommand. Start a rolling packet capture",
  "examples": [],
  "flags": [
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--help",
      "short": null,
      "description": "display usage information",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "name"
        }
      },
      "optionality": "optional",
      "long": "--name",
      "short": null,
      "description": "name to assign to this rolling packet capture upon detaching (maximum 64 characters) If omitted, a default name will be used.",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "snap-len"
        }
      },
      "optionality": "optional",
      "long": "--snap-len",
      "short": null,
      "description": "number of bytes from the start of each packet to save Defaults to 262144 (256 KiB) if 0 or absent.",
      "hidden": false
    },
    {
      "kind": {
        "Option": {
          "arg_name": "capture-size"
        }
      },
      "optionality": "optional",
      "long": "--capture-size",
      "short": null,
      "description": "buffer size in bytes for the rolling capture Must be between 262144 (256 KiB) and 16777216 (16 MiB). Defaults to 2097152 (2 MiB) if 0 or absent.",
      "hidden": false
    }
  ],
  "notes": [],
  "commands": [],
  "positionals": [
    {
      "name": "interface",
      "description": "interface to capture on Must specify one interface using a prefix format: `id:<id>`, `name:<name>`, or `ip:<address>` (e.g. `name:lo`, `id:1`, `ip:fe80::1`).",
      "optionality": "required",
      "hidden": false
    },
    {
      "name": "pcap_filter",
      "description": "pcap-filter string describing which packets are captured",
      "optionality": "optional",
      "hidden": false
    }
  ],
