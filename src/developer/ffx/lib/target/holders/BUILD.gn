import("//build/rust/rustc_library.gni")

assert(is_host, "target holders is host only")

rustc_library("lib") {
  name = "target_holders"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain",
    "//src/developer/ffx/command/error:lib",
    "//src/developer/ffx/fidl:fuchsia.developer.ffx_rust",
    "//src/developer/ffx/lib/discovery:lib",
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/netext:lib",
    "//src/developer/ffx/lib/rcs:lib",
    "//src/developer/ffx/lib/safe_string:lib",
    "//src/developer/ffx/lib/ssh:lib",
    "//src/developer/ffx/lib/target:lib",
    "//src/developer/ffx/lib/target/behavior:lib",
    "//src/lib/fdomain/client",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  test_deps = [ "//third_party/rust_crates:assert_matches" ]

  sources = [
    "src/from_toolbox.rs",
    "src/host_ssh_addr.rs",
    "src/lib.rs",
    "src/nodename.rs",
    "src/remote_control_proxy.rs",
    "src/ssh_addr.rs",
    "src/target_info_query.rs",
    "src/with_moniker.rs",
  ]
}

group("holders") {
  deps = [ ":lib" ]
}

group("tests") {
  testonly = true
  deps = [ ":lib_test($host_toolchain)" ]
}
