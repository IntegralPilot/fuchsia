load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# safe_string is used cross toolchain
rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "safe_string",
    edition = "2024",
    test_deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:serde_json",
    ],
    version = "0.1.0",
    visibility = [
        "//src/developer/ffx:__subpackages__",
        "//src/devices/bin/driver_tools:__pkg__",
    ],
    with_host_unit_tests = True,
    deps = ["//third_party/rust_crates/vendor:serde"],
)
