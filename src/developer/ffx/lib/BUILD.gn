import("ffx_libraries_list.gni")

assert(is_host, "ffx/lib is for use with the host toolchain only")

libs = all_ffx_libraries

group("tests") {
  testonly = true
  deps = []
  foreach(lib, tests_unmigrated_ffx_libraries) {
    deps += [ "${lib}:tests" ]
  }
}

group("lib") {
  testonly = true

  deps = []
  foreach(lib, libs) {
    deps += [ lib ]
  }
}

group("host_tests") {
  testonly = true
  deps = [
    "e2e_emu:host_tests",
    "fuchsia-controller:host_tests",
    "profiler:host_tests",
    "symbolize:host_tests",
    "target_net:host_tests",
  ]
}
