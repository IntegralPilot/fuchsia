load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# arg_parsing is used cross toolchain
rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "arg_parsing",
    edition = "2024",
    version = "0.1.0",
    visibility = [
        "//src/developer/ffx:__subpackages__",
        "//src/power/tools/cli:__subpackages__",
    ],
    with_host_unit_tests = True,
    deps = ["//third_party/rust_crates/vendor:regex-lite"],
)
