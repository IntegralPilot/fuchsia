import("//build/rust/rustc_library.gni")

if (is_host) {
  rustc_library("lib") {
    name = "ffx_uefi_disk"
    version = "0.1.0"
    edition = "2024"
    with_unit_tests = true

    sources = [
      "src/boot_data.rs",
      "src/builder.rs",
      "src/lib.rs",
      "src/vbmeta.rs",
    ]

    inputs = [
      "//third_party/android/platform/external/avb/test/data/atx_metadata.bin",
      "//third_party/android/platform/external/avb/test/data/testkey_atx_psk.pem",
    ]

    deps = [
      "//build/sdk/meta:rust",
      "//src/developer/ffx/config:lib",
      "//src/developer/ffx/lib/fho:lib",
      "//src/developer/ffx/lib/ssh:lib",
      "//src/lib/assembly/assembled_system",
      "//src/lib/assembly/vbmeta",
      "//third_party/rust_crates:camino",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:tempfile",
      "//tools/make-fuchsia-vol:lib",
    ]

    test_deps = [ "//src/lib/fuchsia" ]
  }

  group("uefi_disk") {
    public_deps = [ ":lib" ]
  }

  group("tests") {
    testonly = true
    deps = [ ":lib_test" ]
  }
}
