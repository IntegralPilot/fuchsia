library fuchsia.developer.ffx;

/// Internal testing functionality for the host process.
@discoverable
closed protocol Testing {
    /// Causes the host process to hang, pausing all execution indefinitely.
    strict Hang() -> ();

    /// Crashes the host process by intentionally invoking a Rust panic.
    strict Crash() -> ();
};
