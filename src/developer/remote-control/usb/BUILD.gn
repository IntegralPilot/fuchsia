import("//build/drivers.gni")

fuchsia_driver_package("usb-vsock-package") {
  package_name = "usb-vsock"
  driver_components = [
    "usb-vsock-service",
    "vsock-usb",
  ]
  export_to_bazel = true
}

group("drivers") {
  deps = [
    "usb-vsock-service",
    "vsock-usb",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "usb-vsock-service:tests",
    "vsock-usb:tests",
  ]
}
