@available(added=HEAD)
library fuchsia.feedback.internal;

using zx;

type RecorderError = flexible enum {
    UNKNOWN = 0;
    IO_ERROR = 1;
    DECOMPRESSION_ERROR = 2;
    VMO_ERROR = 3;
    STREAM_ERROR = 4;
};

type SystemLogSource = flexible enum {
    DISK = 1;
    STREAM = 2;
};

type SystemLogMetadata = table {
    1: first_timestamp zx.InstantBoot;
    2: last_timestamp zx.InstantBoot;
    3: source SystemLogSource;
};

@discoverable
open protocol SystemLogRecorder {
    /// Requests the system logs for snapshot generation.
    ///
    /// The returned VMO contains the logs in fully decompressed plain text format.
    flexible GetCurrentBootLogs() -> (resource table {
        1: logs zx.Handle:VMO;
        2: metadata SystemLogMetadata;
    }) error RecorderError;
};
