load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_applicable_licenses = ["//:license"])

# This library contains some low-level helpers that need to be shared between
# the "client" and "symbols", but which doesn't below in the symbol library
# itself.

cc_library(
    name = "test_support",
    testonly = True,
    hdrs = [
        "scoped_test_env.h",
        "test_with_loop.h",
    ],
    deps = [
        ":common",
        "//src/developer/debug/shared:test_support",
    ],
    alwayslink = True,
)

cc_library(
    name = "tests",
    testonly = True,
    srcs = [
        "adapters_unittest.cc",
        "address_ranges_unittest.cc",
        "cache_dir_unittest.cc",
        "checked_math_unittest.cc",
        "curl_unittest.cc",
        "data_extractor_unittest.cc",
        "err_or_unittest.cc",
        "file_util_unittest.cc",
        "fuzzy_matcher_unittest.cc",
        "inet_util_unittest.cc",
        "join_callbacks_unittest.cc",
        "leb_unittest.cc",
        "tagged_data_unittest.cc",
    ],
    implementation_deps = [
        ":common",
        ":test_support",
        "//src/lib/files",
        "//zircon/system/ulib/fbl",
        "@com_google_googletest//:gtest",
    ],
    alwayslink = True,
)

# Simple support library for writing perf tests. This is a much simpler variant
# of //zircon/system/ulib/perftest that will run on the host.
cc_library(
    name = "perf_test",
    testonly = True,
    srcs = [
        "perf_test.cc",
        "perf_test.h",
    ],
    implementation_deps = ["//src/lib/fxl"],
    deps = [
        "@com_googletest_gtest//:gtest",
    ],
    alwayslink = True,
)

cc_library(
    name = "common",
    srcs = [
        "address_ranges.cc",
        "cache_dir.cc",
        "curl.cc",
        "data_extractor.cc",
        "err.cc",
        "file_util.cc",
        "fuzzy_matcher.cc",
        "host_util.cc",
        "inet_util.cc",
        "int128_t.cc",
        "leb.cc",
        "scoped_temp_file.cc",
        "string_util.cc",
        "tagged_data.cc",
        "tagged_data_builder.cc",
        "worker_pool.cc",
    ],
    hdrs = [
        "adapters.h",
        "address_range.h",
        "address_ranges.h",
        "async_util.h",
        "cache_dir.h",
        "checked_math.h",
        "curl.h",
        "data_extractor.h",
        "err.h",
        "err_or.h",
        "file_util.h",
        "fuzzy_matcher.h",
        "host_util.h",
        "inet_util.h",
        "int128_t.h",
        "join_callbacks.h",
        "leb.h",
        "ref_ptr_to.h",
        "scoped_temp_file.h",
        "string_util.h",
        "tagged_data.h",
        "tagged_data_builder.h",
        "worker_pool.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//sdk/lib/fit",
        "//src/developer/debug/shared",
        "//src/lib/containers/cpp",
        "//src/lib/fxl",
        "//src/lib/unwinder",
        "//third_party/curl:libcurl",
    ],
    alwayslink = True,
)
