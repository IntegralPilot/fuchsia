import("//src/starnix/lib/selinux/policy.gni")

# --- Base Policy Source Set ---

sepolicy_source_set("base_policy") {
  testonly = true
  sources = [ "composite_policies/base_policy.conf" ]
}

# --- Composite Policies ---

template("unittest_policy") {
  sepolicy_binary(target_name) {
    testonly = true
    prebuilt = "composite_policies/compiled/$target_name"
    deps = [ ":base_policy" ]
    sources = invoker.sources
  }
}

unittest_policy("conditional_policy") {
  sources = [ "composite_policies/new_file/conditional_policy.conf" ]
}

unittest_policy("genfscon_policy") {
  sources = [ "composite_policies/new_file/genfscon_policy.conf" ]
}

unittest_policy("minimal_policy") {
  sources = [ "composite_policies/new_file/minimal_policy.conf" ]
}

unittest_policy("with_additional_domain_policy") {
  sources = [
    "composite_policies/new_file/minimal_policy.conf",
    "composite_policies/new_file/with_additional_domain_policy.conf",
    "composite_policies/new_file/with_unlabeled_access_domain_policy.conf",
  ]
}

unittest_policy("with_unlabeled_access_domain_policy") {
  sources = [
    "composite_policies/new_file/minimal_policy.conf",
    "composite_policies/new_file/with_unlabeled_access_domain_policy.conf",
  ]
}

unittest_policy("allow_fork_policy") {
  sources = [
    "composite_policies/new_file/allow_fork_policy.conf",
    "composite_policies/new_file/minimal_policy.conf",
  ]
}

unittest_policy("bounded_transition_policy") {
  sources = [ "composite_policies/new_file/bounded_transition_policy.conf" ]
}

unittest_policy("class_defaults_policy") {
  sources = [ "composite_policies/new_file/class_defaults_policy.conf" ]
}

unittest_policy("exceptions_config_policy") {
  sources = [ "composite_policies/new_file/exceptions_config_policy.conf" ]
}

unittest_policy("range_transition_policy") {
  sources = [ "composite_policies/new_file/range_transition_policy.conf" ]
}

unittest_policy("role_transition_not_allowed_policy") {
  sources =
      [ "composite_policies/new_file/role_transition_not_allowed_policy.conf" ]
}

unittest_policy("role_transition_policy") {
  sources = [ "composite_policies/new_file/role_transition_policy.conf" ]
}

unittest_policy("type_transition_policy") {
  sources = [ "composite_policies/new_file/type_transition_policy.conf" ]
}

# --- Handle Unknown Variants ---

foreach(mode,
        [
          "allow",
          "deny",
          "reject",
        ]) {
  sepolicy_binary("handle_unknown_policy-$mode") {
    testonly = true
    output_name = "handle_unknown_policy-$mode"
    prebuilt = "composite_policies/compiled/handle_unknown_policy-$mode"
    handle_unknown = mode
    sources = [ "composite_policies/new_file/handle_unknown_policy.conf" ]
  }
}

# --- Standalone / Legacy Micro Policies (Single .conf file) ---

micro_policies = [
  "allow_a_attr_b_attr_class0_perm0_policy",
  "allow_a_t_a1_attr_class0_perm0_a2_attr_class0_perm1_policy",
  "allow_a_t_b_attr_class0_perm0_policy",
  "allow_a_t_b_t_class0_perm0_policy",
  "allow_with_constraints_policy",
  "allowxperm_policy",
  "constraints_policy",
  "file_no_defaults_policy",
  "file_range_source_high_policy",
  "file_range_source_low_high_policy",
  "file_range_source_low_policy",
  "file_range_target_high_policy",
  "file_range_target_low_high_policy",
  "file_range_target_low_policy",
  "file_source_defaults_policy",
  "file_target_defaults_policy",
  "hooks_tests_policy",
  "minimal_policy",
  "multiple_levels_and_categories_policy",
  "no_allow_a_attr_b_attr_class0_perm0_policy",
  "no_allow_a_t_b_attr_class0_perm0_policy",
  "no_allow_a_t_b_t_class0_perm0_policy",
  "security_context_tests_policy",
  "security_server_tests_policy",
]

foreach(name, micro_policies) {
  sepolicy_binary("micro_$name") {
    testonly = true
    source = "micro_policies/$name.conf"
    prebuilt = "micro_policies/$name"
    output_name = name
  }
}

group("test_policies") {
  testonly = true
  deps = [
    ":allow_fork_policy",
    ":bounded_transition_policy",
    ":class_defaults_policy",
    ":conditional_policy",
    ":exceptions_config_policy",
    ":genfscon_policy",
    ":handle_unknown_policy-allow",
    ":handle_unknown_policy-deny",
    ":handle_unknown_policy-reject",
    ":minimal_policy",
    ":range_transition_policy",
    ":role_transition_not_allowed_policy",
    ":role_transition_policy",
    ":type_transition_policy",
    ":with_additional_domain_policy",
    ":with_unlabeled_access_domain_policy",
  ]
  foreach(name, micro_policies) {
    deps += [ ":micro_$name" ]
  }
}
