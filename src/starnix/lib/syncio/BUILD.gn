import("//build/components.gni")
import("//build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix_syncio-tests" ]
}

rustc_library("syncio") {
  edition = "2024"
  sources = [
    "src/lib.rs",
    "src/zxio.rs",
  ]
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:pin-weak",
    "//third_party/rust_crates:zerocopy",
  ]

  public_deps = [ "//sdk/lib/zxio:zxio_static" ]

  test_deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
  ]

  configs += [ "//src/starnix/build:kernel_library_config" ]
}

fuchsia_unittest_package("starnix_syncio-tests") {
  manifest = "meta/syncio_tests.cml"
  deps = [ ":syncio_test" ]
}
