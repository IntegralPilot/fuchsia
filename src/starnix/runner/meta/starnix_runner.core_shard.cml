{
    offer: [
        {
            protocol: [
                "fuchsia.ui.composition.Allocator",
                "fuchsia.ui.composition.Flatland",
                "fuchsia.ui.composition.FlatlandFactory",
                "fuchsia.ui.display.singleton.DisplayPower",
                "fuchsia.ui.display.singleton.Info",
                "fuchsia.ui.input3.Keyboard",
                "fuchsia.ui.policy.DeviceListenerRegistry",
                "fuchsia.ui.test.input.Registry",
            ],
            from: "#ui",
            to: "#starnix_runner",
            dependency: "weak",
            source_availability: "unknown",
        },
        {
            protocol: [
                "fuchsia.net.interfaces.admin.Installer",
                "fuchsia.net.interfaces.State",
                "fuchsia.net.ndp.RouterAdvertisementOptionWatcherProvider",
                "fuchsia.net.neighbor.Controller",
                "fuchsia.net.neighbor.View",
                "fuchsia.net.power.WakeGroupProvider",
                "fuchsia.net.root.Interfaces",
                "fuchsia.net.routes.admin.RouteTableProviderV4",
                "fuchsia.net.routes.admin.RouteTableProviderV6",
                "fuchsia.net.routes.admin.RouteTableV4",
                "fuchsia.net.routes.admin.RouteTableV6",
                "fuchsia.net.routes.admin.RuleTableV4",
                "fuchsia.net.routes.admin.RuleTableV6",
                "fuchsia.net.routes.StateV4",
                "fuchsia.net.routes.StateV6",
                "fuchsia.net.settings.Control",
                "fuchsia.net.settings.State",
                "fuchsia.net.sockets.Control",
                "fuchsia.net.sockets.Diagnostics",
                "fuchsia.net.stack.Stack",
                "fuchsia.posix.socket.packet.Provider",
            ],
            from: "#network",
            to: "#starnix_runner",
        },
        {
            protocol: "fuchsia.posix.socket.Provider_Unproxied",
            from: "#network",
            as: "fuchsia.posix.socket.Provider",
            to: "#starnix_runner",
        },
        {
            protocol: "fuchsia.posix.socket.raw.Provider_Unproxied",
            from: "#network",
            as: "fuchsia.posix.socket.raw.Provider",
            to: "#starnix_runner",
        },
        {
            protocol: [ "fuchsia.net.tun.Control" ],
            from: "#network-tun",
            to: "#starnix_runner",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            protocol: [ "fuchsia.buildinfo.Provider" ],
            from: "#build-info",
            to: "#starnix_runner",
        },
        {
            protocol: [
                "fuchsia.net.filter.Control",
                "fuchsia.net.filter.SocketControl",
            ],
            from: "#network",
            to: "#starnix_runner",
            source_availability: "unknown",
        },
        {
            protocol: [ "fuchsia.net.policy.socketproxy.StarnixNetworks" ],
            from: "#network",
            to: "#starnix_runner",
            availability: "optional",
        },
        {
            protocol: [ "fuchsia.power.battery.BatteryManager" ],
            from: "#battery_manager",
            to: "#starnix_runner",
            source_availability: "unknown",
        },
        {
            protocol: [
                "fuchsia.hardware.power.statecontrol.Admin",
                "fuchsia.kernel.StallResource",
                "fuchsia.kernel.Stats",
                "fuchsia.kernel.VmexResource",
                "fuchsia.scheduler.RoleManager",
                "fuchsia.sys2.BootController",
                "fuchsia.sysinfo.SysInfo",
                "fuchsia.thermal.SensorManager",
            ],
            from: "parent",
            to: "#starnix_runner",
        },
        {
            protocol: "fuchsia.diagnostics.ArchiveAccessor",
            from: "parent/diagnostics-accessors",
            to: "#starnix_runner",
        },
        {
            protocol: "fuchsia.diagnostics.LogStream",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            protocol: [ "fuchsia.settings.Privacy" ],
            from: "#setui_service",
            to: "#starnix_runner",
            source_availability: "unknown",
        },
        {
            protocol: [ "fuchsia.wlan.wlanix.Wlanix" ],
            from: "#wlanix",
            to: "#starnix_runner",
            source_availability: "unknown",
        },
        {
            protocol: [ "fuchsia.erofs.Erofs" ],
            from: "#erofs",
            to: "#starnix_runner",
            source_availability: "unknown",
        },
        {
            protocol: [
                "fuchsia.sysmem.Allocator",
                "fuchsia.sysmem2.Allocator",
            ],
            from: "parent",
            to: [ "#starnix_runner" ],
        },
        {
            protocol: [ "fuchsia.vulkan.loader.Loader" ],
            from: "#vulkan_loader",
            to: [ "#starnix_runner" ],
        },
        {
            protocol: [ "fuchsia.recovery.FactoryReset" ],
            from: "#factory_reset",
            to: [ "#starnix_runner" ],
        },
        {
            protocol: [ "fuchsia.boot.Items" ],
            from: "parent",
            to: [ "#starnix_runner" ],
        },
        {
            protocol: [
                "fuchsia.feedback.CrashReporter",
                "fuchsia.feedback.LastRebootInfoProvider",
            ],
            from: "#feedback",
            to: "#starnix_runner",
        },
        {
            directory: "boot",
            from: "parent",
            as: "boot-kernel",
            to: [ "#starnix_runner" ],
            subdir: "kernel",
        },
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-class",
            from: "parent",
            as: "dev-gpu",
            to: [ "#starnix_runner" ],
            subdir: "gpu",
        },
        {
            directory: "dev-class",
            from: "parent",
            as: "dev-serial",
            to: [ "#starnix_runner" ],
            subdir: "serial",
        },
        {
            directory: "dev-class",
            from: "parent",
            as: "dev-temperature",
            to: [ "#starnix_runner" ],
            subdir: "temperature",
        },
        {
            directory: "dev-class",
            from: "parent",
            as: "dev-trippoint",
            to: [ "#starnix_runner" ],
            subdir: "trippoint",
        },
        {
            directory: "block",
            from: "parent",
            to: [ "#starnix_runner" ],
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.gpu.magma.Service",
            from: "parent",
            to: [ "#starnix_runner" ],
        },
        {
            service: [
                "fuchsia.hardware.adb.Service",
                "fuchsia.hardware.cpu.ctrl.Service",
                "fuchsia.hardware.google.nanohub.StarnixDataChannelService",
            ],
            from: "parent",
            to: [ "#starnix_runner" ],
        },
        {
            protocol: [
                "fuchsia.power.broker.Topology",
                "fuchsia.power.cpu.DomainController",
                "fuchsia.power.suspend.Stats",
                "fuchsia.power.system.ActivityGovernor",
                "fuchsia.power.system.BootControl",
            ],
            from: "parent",
            to: "#starnix_runner",
            availability: "optional",
        },
        {
            protocol: "fuchsia.hardware.qualcomm.fastrpc.SecureFastRpc",
            from: "#fastrpc",
            to: "#starnix_runner",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            protocol: "fuchsia.hardware.backlight.Device",
            from: "#backlight",
            to: "#starnix_runner",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            protocol: "fuchsia.hardware.google.nanohub.Device",
            from: "#nanohub",
            to: "#starnix_runner",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            protocol: "fuchsia.hardware.google.nanohub.DisplayDevice",
            from: "#display",
            to: "#starnix_runner",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            protocol: "fuchsia.hardware.sockettunnel.Device",
            from: "#sockettunnel",
            to: "#starnix_runner",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            service: "fuchsia.hardware.qcom.hvdcpopti.Service",
            from: "parent",
            to: [ "#starnix_runner" ],
        },
        {
            service: "fuchsia.hardware.qualcomm.router.ClientService",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            service: "fuchsia.power.battery.ChargerService",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            service: "fuchsia.power.broker.ElementInfoProviderService",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            config: "fuchsia.starnix.config.container.ExtraFeatures",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            config: "fuchsia.starnix.config.Prefetch",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            config: "fuchsia.starnix.runner.EnableDataCollection",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            config: "fuchsia.time.config.WritableUTCTime",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            config: "fuchsia.ui.VisualDebuggingLevel",
            from: "parent",
            to: "#starnix_runner",
            availability: "transitional",
        },
        {
            protocol: [ "fuchsia.time.external.Adjust" ],
            from: "#timekeeper",
            to: "#starnix_runner",
            availability: "optional",
        },
        {
            protocol: [ "fuchsia.time.alarms.WakeAlarms" ],
            from: "#timekeeper",
            to: [ "#starnix_runner" ],
        },
        {
            service: "fuchsia.hardware.power.suspend.SuspendService",
            from: "parent",
            to: "#starnix_runner",
        },
        {
            protocol: [ "fuchsia.cpu.profiler.Session" ],
            from: "#cpu_profiler",
            to: "#starnix_runner",
            availability: "optional",
            source_availability: "unknown",
        },
    ],
    expose: [
        {
            service: "fuchsia.starnix.runner.Manager",
            from: "#starnix_runner",
        },
    ],
}
