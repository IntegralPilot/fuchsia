{
    actions: [
        {
            type: "skip",
            matchers: [
                // TODO(https://fxbug.dev/555172047): Machina kernel is missing the dm-verity mod.
                // It's unclear why these tests pass occasionally, likely something related to the
                // wonky check for root permission in open_dm_device() during tests.
                "device_mapper_test::create_dm_device",
                "device_mapper_test::dm_dev_status",
                "device_mapper_test::dm_list_devices",
            ],
        },
        {
            type: "expect_failure",
            matchers: [
                // TODO(https://fxbug.dev/555172047): Machina kernel is missing the dm-verity mod.
                "device_mapper_test::dm_list_versions",
                "device_mapper_test::dm_table_status_buffer_full",
                "device_mapper_test::dm_table_status_corrupt::create_verity_target_shared_loop_device_expects",
                "device_mapper_test::dm_table_status_corrupt::create_verity_target_two_loop_devices_sha256_expects",
                "device_mapper_test::dm_table_status_corrupt::create_verity_target_two_loop_devices_sha512_expects",
                "device_mapper_test::dm_table_status_flag",
                "device_mapper_test::dm_table_status_no_active_table",
                "device_mapper_test::dm_table_status_valid",
                "device_mapper_test::list_devices_buffer_full",
                "device_mapper_test::read_corrupted_dm_verity_device::create_verity_target_shared_loop_device_expects",
                "device_mapper_test::read_corrupted_dm_verity_device::create_verity_target_two_loop_devices_sha256_expects",
                "device_mapper_test::read_corrupted_dm_verity_device::create_verity_target_two_loop_devices_sha512_expects",
                "device_mapper_test::read_dm_device_no_active_table",
                "device_mapper_test::read_loaded_and_resumed_dm_device::create_verity_target_shared_loop_device_expects",
                "device_mapper_test::read_loaded_and_resumed_dm_device::create_verity_target_two_loop_devices_sha256_expects",
                "device_mapper_test::read_loaded_and_resumed_dm_device::create_verity_target_two_loop_devices_sha512_expects",
                "device_mapper_test::remove_dm_device_cached_handle_in_scope",
                "device_mapper_test::remove_dm_device_in_scope",
                "device_mapper_test::suspend_and_resume_dm_device",
                "device_mapper_test::test_dm_table_load_invalid_root_hash::create_verity_target_shared_loop_device_expects",
                "device_mapper_test::test_dm_table_load_invalid_root_hash::create_verity_target_two_loop_devices_sha256_expects",
                "device_mapper_test::test_dm_table_load_invalid_root_hash::create_verity_target_two_loop_devices_sha512_expects",

                // TODO(https://fxbug.dev/553922248): eBPF Failures during Machina bringup.
                "ebpf_test::ebpf_sk_storage",
                "ebpf_test::ebpf_udp_recv",
            ],
        },
    ],
}
