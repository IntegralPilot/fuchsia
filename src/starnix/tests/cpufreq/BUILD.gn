import("//build/components.gni")
import("//build/rust/rustc_binary.gni")
import("//src/starnix/build/starnix_linux_rustc_binary.gni")
import("//src/starnix/kernel/starnix.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix_cpufreq_test" ]
}

rustc_binary("bin") {
  testonly = true
  edition = "2024"
  output_name = "starnix_cpufreq_test"

  deps = [
    "//sdk/fidl/fuchsia.hardware.cpu.ctrl:fuchsia.hardware.cpu.ctrl_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/sys/lib/component-events",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  sources = [
    "src/fake_cpu_ctrl.rs",
    "src/main.rs",
  ]
}

fuchsia_test_component("integration_test") {
  manifest = "meta/integration_test.cml"
  deps = [ ":bin" ]
  test_type = "starnix"
}

starnix_linux_rustc_binary("cpu_control_client_bin") {
  testonly = true
  edition = "2024"
  source_root = "src/cpu_control_client.rs"
  sources = [ "src/cpu_control_client.rs" ]
}

starnix_linux_rustc_binary("kernel_client_bin") {
  testonly = true
  edition = "2024"
  source_root = "src/kernel_client.rs"
  sources = [ "src/kernel_client.rs" ]
}

fuchsia_component("container_with_cpu_control_client") {
  testonly = true
  manifest = "meta/container_with_cpu_control_client.cml"
}

fuchsia_component("cpu_control_client") {
  testonly = true
  manifest = "meta/cpu_control_client.cml"
  deps = [ ":cpu_control_client_bin" ]
}

fuchsia_component("container_with_kernel_client") {
  testonly = true
  manifest = "meta/container_with_kernel_client.cml"
}

fuchsia_component("kernel_client") {
  testonly = true
  manifest = "meta/kernel_client.cml"
  deps = [ ":kernel_client_bin" ]
}

fuchsia_component("cpufreq_container") {
  testonly = true
  manifest = "meta/cpufreq_container.cml"
}

fuchsia_package("cpufreq_container_pkg") {
  testonly = true
  deps = [
    ":cpufreq_container",
    "//src/starnix/containers/debian:container_resources",
  ]
}

fuchsia_test_package("starnix_cpufreq_test") {
  test_components = [ ":integration_test" ]
  deps = [
    ":container_with_cpu_control_client",
    ":container_with_kernel_client",
    ":cpu_control_client",
    ":cpufreq_container",
    ":kernel_client",
    "//src/starnix/containers/debian:container_resources",
  ]
  subpackages = [ "//src/starnix/kernel:starnix_kernel_package" ]
}
