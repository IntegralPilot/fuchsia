{
    include: [
        "inspect/offer.shard.cml",
        "syslog/offer.shard.cml",
    ],
    children: [
        {
            name: "kernel",
            url: "starnix_kernel#meta/starnix_kernel.cm",
        },
        {
            name: "runner",
            url: "starnix#meta/starnix_runner.cm",
        },
        {
            name: "debian_container",
            url: "#meta/container.cm",
            environment: "#starnix_kernel_env",
        },
        {
            name: "netstack",
            url: "netstack#meta/netstack.cm",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.kernel.VmexResource",
            from: "parent",
            to: "#kernel",
        },
        {
            directory: "boot-kernel",
            from: "parent",
            to: "#kernel",
        },
        {
            protocol: "fuchsia.starnix.runner.Manager",
            from: "#runner",
            to: "#kernel",
        },
        {
            protocol: [
                "fuchsia.net.power.WakeGroupProvider",
                "fuchsia.posix.socket.Provider",
            ],
            from: "#netstack",
            to: "#kernel",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.posix.socket.Provider",
            from: "#netstack",
        },
        {
            protocol: "fuchsia.starnix.runner.Manager",
            from: "#runner",
        },
    ],
    environments: [
        {
            name: "starnix_kernel_env",
            extends: "realm",
            runners: [
                {
                    runner: "starnix",
                    from: "#kernel",
                },
            ],
        },
        {
            name: "debian_container_env",
            extends: "realm",
            runners: [
                {
                    runner: "starnix_container",
                    from: "#debian_container",
                },
            ],
        },
    ],
}
