import("//src/starnix/lib/selinux/policy.gni")

sepolicy_source_set("userspace_base_policy") {
  testonly = true
  deps = [ "//src/starnix/lib/selinux/testdata:base_policy" ]
  sources = [ "test_policy.conf" ]
}

template("userspace_policy") {
  sepolicy_binary(target_name) {
    testonly = true
    prebuilt = "prebuilt/$target_name"
    deps = [ ":userspace_base_policy" ]
    sources = invoker.sources
  }
}

