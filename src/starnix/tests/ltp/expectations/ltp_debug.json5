{
    actions: [
        {
            type: "skip",
            matchers: [
                // TODO(https://fxbug.dev/551874588): Lacks /dev/cpu_dma_latency to constrain
                // low-power C-states; on hardware in debug builds, the slow post-sleep CPU
                // clock combined with unoptimized debug logic and extra checks leads to an
                // excessively long delay between timer interrupt and returning from the syscall.
                "nanosleep01",
            ],
        },
    ],
}
