import("//build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [
    "android_usb:tests",
    "binderfs:tests",
    "boot:tests",
    "cgroupfs:tests",
    "ext4:tests",
    "fastrpc:tests",
    "inotify:tests",
    "input:tests",
    "kgsl:tests",
    "layeredfs:tests",
    "loop:tests",
    "nanohub:tests",
    "nmfs:tests",
    "perfetto_consumer:tests",
    "selinuxfs:tests",
    "syscalls:tests",
    "tracefs:tests",
  ]
}

rustc_library("modules") {
  name = "starnix-modules"
  edition = "2024"
  version = "0.1.0"
  source_root = "lib.rs"

  sources = [ "lib.rs" ]

  configs += [ "//src/starnix/build:kernel_library_config" ]

  deps = [
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/modules/binderfs",
    "//src/starnix/modules/cgroupfs",
    "//src/starnix/modules/debugfs",
    "//src/starnix/modules/device_mapper",
    "//src/starnix/modules/erofs",
    "//src/starnix/modules/ext4",
    "//src/starnix/modules/functionfs",
    "//src/starnix/modules/fuse",
    "//src/starnix/modules/inotify",
    "//src/starnix/modules/loop",
    "//src/starnix/modules/overlayfs",
    "//src/starnix/modules/procfs",
    "//src/starnix/modules/pstore",
    "//src/starnix/modules/selinuxfs",
    "//src/starnix/modules/tracefs",
    "//src/starnix/modules/tun",
    "//src/starnix/modules/zram",
  ]
}
