{
    include: [
        "//src/sys/test_runners/gtest/default.shard.cml",
        "inspect/offer.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        binary: "bin/cpu_profiler_integration_test",
    },
    children: [
        {
            name: "cpu_profiler",
            url: "#meta/cpu_profiler.cm",
        },
        {
            name: "demo_target",
            url: "#meta/demo_target.cm",
            startup: "eager",
        },
    ],
    collections: [
        {
            name: "launchpad",
            durability: "transient",
        },
    ],
    use: [
        {
            protocol: "fuchsia.cpu.profiler.Session",
            from: "#cpu_profiler",
        },
        {
            protocol: [ "fuchsia.process.Launcher" ],
        },
        {
            protocol: "fuchsia.sys2.LifecycleController",
            from: "framework",
        },
    ],
    offer: [
        {
            protocol: [
                "fuchsia.kernel.RootJob",
                "fuchsia.kernel.SamplingResource",
            ],
            from: "parent",
            to: [ "#cpu_profiler" ],
        },
        {
            protocol: "fuchsia.sys2.RealmQuery",
            from: "framework",
            as: "fuchsia.sys2.RealmQuery.root",
            to: [ "#cpu_profiler" ],
        },
        {
            protocol: "fuchsia.sys2.LifecycleController",
            from: "framework",
            as: "fuchsia.sys2.LifecycleController.root",
            to: "#cpu_profiler",
        },
        {
            event_stream: [ "debug_started" ],
            from: "parent",
            to: "#cpu_profiler",
        },
    ],
}
