{
    children: [
        {
            name: "cpu_profiler",
            url: "fuchsia-pkg://fuchsia.com/cpu_profiler#meta/cpu_profiler.cm",
            startup: "eager",
            environment: "#core-env",
        },
    ],
    offer: [
        {
            protocol: [
                "fuchsia.kernel.RootJob",
                "fuchsia.kernel.SamplingResource",
                "fuchsia.sys2.LifecycleController",
                "fuchsia.sys2.LifecycleController.root",
            ],
            from: "parent",
            to: "#cpu_profiler",
        },
        {
            protocol: [ "fuchsia.sys2.RealmQuery.root" ],
            from: "parent",
            to: "#cpu_profiler",
        },
        {
            protocol: [ "fuchsia.test.manager.SuiteRunner" ],
            from: "#test_manager",
            to: "#cpu_profiler",
            dependency: "weak", // Prevent circular dependency.
            source_availability: "unknown",
        },
        {
            event_stream: [ "debug_started" ],
            from: "parent",
            to: "#cpu_profiler",
        },
        {
            storage: [ "cache" ],
            from: "self",
            to: "#cpu_profiler",
        },

        // Needed for managing syscall tests.
        {
            protocol: [ "fuchsia.cpu.profiler.Session" ],
            from: "#cpu_profiler",
            to: "#test_manager",
            availability: "optional",
        },

        // Needed for running syscall tests in correct environment.
        {
            protocol: [ "fuchsia.cpu.profiler.Session" ],
            from: "#cpu_profiler",
            to: "#testing",
            availability: "optional",
        },
    ],
    expose: [
        {
            protocol: [ "fuchsia.profiling.Controller" ],
            from: "#cpu_profiler",
        },
    ],
}
