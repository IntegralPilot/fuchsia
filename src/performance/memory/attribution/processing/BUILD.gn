import("//build/components/fuchsia_unittest_package.gni")
import("//build/rust/rustc_library.gni")

rustc_library("processing") {
  name = "attribution_processing"
  edition = "2024"
  version = "0.1.0"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust_common",
    "//sdk/fidl/fuchsia.memory.attribution.plugin:fuchsia.memory.attribution.plugin_rust_common",
    "//sdk/rust/zx-types",
    "//src/lib/fidl/rust/fidl",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:regex-lite",
    "//third_party/rust_crates:rustc-hash",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:smallvec",
    "//third_party/rust_crates:zerocopy",
  ]

  if (is_fuchsia) {
    deps += [ "//src/lib/trace/rust:trace" ]
  }

  test_deps = [
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:serde_json",
  ]

  sources = [
    "src/digest.rs",
    "src/fkernel_serde.rs",
    "src/fplugin_serde.rs",
    "src/lib.rs",
    "src/macros.rs",
    "src/name.rs",
    "src/summary.rs",
  ]
}

fuchsia_unittest_package("tests") {
  package_name = "attribution-processing-tests"
  deps = [ ":processing_test" ]
}
