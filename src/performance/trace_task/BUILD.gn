import("//build/rust/rustc_library.gni")

# This library is intended to be runnable both on the host and device.

template("trace_task_crate") {
  rustc_library(target_name) {
    version = "0.1.0"
    edition = "2024"
    with_unit_tests =
        !defined(invoker.with_unit_tests) || invoker.with_unit_tests

    deps = [
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia-async",
      "//third_party/rust_crates:async-channel",
      "//third_party/rust_crates:async-lock",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:zstd",
    ]

    public_deps = [ "//third_party/zstd" ]

    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    if (with_unit_tests) {
      test_deps = [ "//src/lib/fuchsia" ]
      if (defined(invoker.test_deps)) {
        test_deps += invoker.test_deps
      }
      inputs = [
        "//src/performance/lib/fxt/rust/tests/goldens/data/perfetto_golden.fxt",
      ]

      if (is_host) {
        test_deps += [
          "//third_party/rust_crates:async-fs",
          "//third_party/rust_crates:tempfile",
        ]
      }
    }
    sources = [
      "src/lib.rs",
      "src/trace_task.rs",
      "src/triggers.rs",
    ]
  }
}

# Both trace_task and trace_task_fdomain compile the exact same Rust source
# files. Unit tests are enabled on the fdomain trace_task target
# (:trace_task_fdomain) and disabled on the legacy trace_task (with_unit_tests =
# false) to avoid compiling and running duplicate unit test binaries across both
# FIDL backend variants.
trace_task_crate("trace_task") {
  with_unit_tests = false
  deps = [
    "//sdk/fidl/fuchsia.tracing.controller:fuchsia.tracing.controller_rust_flex",
    "//src/lib/fdomain/client:flex_fidl",
  ]
}

trace_task_crate("trace_task_fdomain") {
  with_unit_tests = true
  deps = [
    "//sdk/fidl/fuchsia.tracing.controller:fuchsia.tracing.controller_rust_fdomain_flex",
    "//src/lib/fdomain/client:flex_fdomain",
  ]
  test_deps = [ "//src/lib/fdomain/local" ]
}

group("tests") {
  testonly = true
  deps = [ ":trace_task_fdomain_test" ]
}
