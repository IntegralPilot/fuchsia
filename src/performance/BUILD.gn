group("tools") {
  deps = [
    "fxtdump",
    "perf-analyze",
    "trace2json",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "cpu_profiler:tests",
    "ktrace_provider:tests",
    "lib:tests",
    "memory:tests",
    "perf-analyze:tests",
    "perfetto-bridge:tests",
    "profiler_session_manager:tests",
    "trace/tests",
    "trace2json:trace2json_tests($host_toolchain)",
    "trace_bench:tests",
    "trace_manager:tests",
    "trace_session_manager:tests",
  ]
}
