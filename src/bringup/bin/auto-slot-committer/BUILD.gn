import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  name = "auto_slot_committer"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/sys/lib/stdout-to-debuglog/rust",
    "//third_party/rust_crates:anyhow",
  ]

  test_deps = [ "//third_party/rust_crates:futures" ]

  source_root = "src/main.rs"
  sources = [ "src/main.rs" ]
}

fuchsia_component("auto-slot-committer-component") {
  component_name = "auto-slot-committer"
  manifest = "meta/auto-slot-committer.cml"
  deps = [ ":bin" ]
  check_includes = false
}

fuchsia_package("package") {
  package_name = "auto-slot-committer"
  deps = [ ":auto-slot-committer-component" ]
}

fuchsia_unittest_package("auto-slot-committer-tests") {
  deps = [ ":bin_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":auto-slot-committer-tests" ]
}
