{
    children: [
        {
            name: "auto-slot-committer",
            url: "fuchsia-boot:///auto-slot-committer#meta/auto-slot-committer.cm",
            startup: "eager",
        },
    ],
    offer: [
        {
            protocol: [ "fuchsia.boot.WriteOnlyLog" ],
            from: "parent",
            to: "#auto-slot-committer",
        },
        {
            // TODO(b/435749189): consider splitting slot management into its
            // own protocol so that we don't need to provide access to the
            // entire paver API here.
            protocol: [ "fuchsia.paver.Paver" ],
            from: "#paver",
            to: "#auto-slot-committer",
        },
    ],
}
