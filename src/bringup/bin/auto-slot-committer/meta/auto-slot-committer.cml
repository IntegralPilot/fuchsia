{
    program: {
        runner: "elf",
        binary: "bin/auto_slot_committer",
        forward_stdout_to: "none",
        forward_stderr_to: "none",
    },
    use: [
        {
            protocol: [
                "fuchsia.boot.WriteOnlyLog",
                // TODO(b/435749189): consider splitting slot management into
                // its own protocol so that we don't need to provide access to
                // the entire paver API here.
                "fuchsia.paver.Paver",
            ],
        },
    ],
}
