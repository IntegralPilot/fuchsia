{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/device-name-provider",
    },
    capabilities: [
        { protocol: "fuchsia.device.NameProvider" },
    ],
    use: [
        // For network device access.
        {
            // TODO(https://fxbug.dev/324273348): Remove this capability once the clients have
            // been migrated to services. The service capability has been added below.
            directory: "dev-class-network",
            rights: [ "r*" ],
            path: "/dev/class/network",
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.hardware.network.Service",
        },
        {
            protocol: [ "fuchsia.boot.Items" ],
        },
        {
            config: "fuchsia.network.PrimaryInterface",
            key: "primary_interface",
            availability: "optional",
            type: "string",
            max_size: 200,
            default: "",
        },
        {
            config: "fuchsia.zircon.nodename",
            key: "nodename",
            availability: "optional",
            type: "string",
            max_size: 200,
            default: "",
        },
        {
            config: "fuchsia.zircon.namegen",
            key: "namegen",
            availability: "optional",
            type: "string",
            max_size: 10,
            default: "1",
        },
        {
            config: "fuchsia.device.BootItemInterfaceForNodeName",
            key: "boot_item_interface_for_node_name",
            availability: "optional",
            type: "uint8",
            default: 0,
        },
        {
            config: "fuchsia.device.BootItemInterfaceFlipLowMacBit",
            key: "boot_item_interface_flip_low_mac_bit",
            availability: "optional",
            type: "bool",
            default: false,
        },
    ],
    expose: [
        {
            protocol: "fuchsia.device.NameProvider",
            from: "self",
        },
    ],
}
