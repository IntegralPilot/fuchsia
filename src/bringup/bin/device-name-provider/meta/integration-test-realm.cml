{
    include: [ "//src/bringup/bin/device-name-provider/meta/integration-test-realm-common.shard.cml" ],
    children: [
        {
            name: "fake-boot-items",
            url: "fake_boot_items#meta/fake_boot_items.cm",
        },
    ],
    capabilities: [
        {
            config: "use_boot_item",
            type: "bool",
            value: true,
        },
        {
            config: "fuchsia.device.BootItemInterfaceForNodeName",
            type: "uint8",
            value: 0,
        },
        {
            config: "fuchsia.device.BootItemInterfaceFlipLowMacBit",
            type: "bool",
            value: false,
        },
    ],
    offer: [
        {
            protocol: "fuchsia.boot.Items",
            from: "#fake-boot-items",
            to: "#device-name-provider",
        },
        {
            config: [
                "fuchsia.device.BootItemInterfaceFlipLowMacBit",
                "fuchsia.device.BootItemInterfaceForNodeName",
            ],
            from: "self",
            to: "#device-name-provider",
            availability: "optional",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.test.Suite",
            from: "#integration-test",
            to: "parent",
        },
    ],
}
