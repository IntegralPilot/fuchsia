import("//boards/default_for_emulator.gni")
import("//build/assembly/test_product_bundle.gni")
import("//build/go/go_library.gni")
import("//build/go/go_test.gni")
import("//build/testing/host_test_data.gni")

group("tests") {
  testonly = true
  deps = []
  if (host_os == "linux") {
    deps += [ ":console_qemu_test($host_toolchain)" ]
  }
}

if (is_linux) {
  _pb_label = ":test_product_bundle($default_toolchain)"
  _pb_out_dir = get_label_info(_pb_label, "target_out_dir")
  _pb_path = "${_pb_out_dir}/test_product_bundle"

  host_test_data("host_test_data") {
    sources = [ _pb_path ]
    deps = [ _pb_label ]
  }

  go_library("lib") {
    testonly = true
    deps = [ "//tools/emulator/emulatortest" ]
    sources = [ "console_qemu_test.go" ]
  }

  go_test("console_qemu_test") {
    embed = [ ":lib" ]
    args = [
      "--emulator.pb-path",
      rebase_path(_pb_path, root_build_dir),
    ]
    non_go_deps = [ ":host_test_data" ]
  }
}

if (current_toolchain == default_toolchain) {
  test_product_bundle("test_product_bundle") {
    board_config = default_board_for_emulator
    platform = {
      build_type = "eng"
      feature_set_level = "bootstrap"
      development_support = {
        include_netsvc = true
      }
      storage = {
        filesystems = {
          image_mode = "no_image"
        }
      }
    }
    bootfs_files_labels = [
      "//src/bringup/bin/console-launcher:shell-permissions-test",
      "//src/testing/runtests",
    ]
  }
}
