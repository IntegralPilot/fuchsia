import("//build/components/fuchsia_test_component.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("fake_boot_arguments-binary") {
  testonly = true
  name = "fake_boot_arguments"
  edition = "2024"
  source_root = "src/fake_boot_arguments.rs"

  sources = [ "src/fake_boot_arguments.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
    "//sdk/rust/zbi",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//src/sys/pkg/lib/fuchsia-merkle",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}
