{
    children: [
        {
            name: "tee_manager",
            url: "{{COMPONENT_URL}}",
            startup: "eager",
        },
    ],
    expose: [
        {
            protocol: [
                "fuchsia.security.keymint.Admin",
                "fuchsia.security.keymint.SealingKeys",
            ],
            from: "#tee_manager",
        },
    ],
    offer: [
        {
            service: "fuchsia.hardware.tee.proprietary.Service",
            from: "parent",
            to: "#tee_manager",
            availability: "same_as_target",
        },
        {
            service: "fuchsia.hardware.rpmb.Service",
            from: "parent",
            to: "#tee_manager",
            availability: "same_as_target",
        },
        {
            directory: "block",
            from: "parent",
            as: "tee_persist",
            to: "#tee_manager",
            subdir: "tee_persist",
            availability: "same_as_target",
        },
        {
            directory: "block",
            from: "parent",
            as: "tee_userdata",
            to: "#tee_manager",
            subdir: "tee_userdata",
            availability: "same_as_target",
        },
    ],
}
