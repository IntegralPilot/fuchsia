import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_macro.gni")

declare_args() {
  # The RSEQ backend is not yet implemented.
  enable_rseq_backend_for_rcu = false
}

group("tests") {
  testonly = true
  deps = [ ":fuchsia-rcu-tests" ]
}

rustc_macro("fuchsia-rcu-derive") {
  edition = "2024"
  source_root = "macro/src/lib.rs"
  sources = [ "macro/src/lib.rs" ]
  deps = [
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
  ]
}

rustc_library("fuchsia-rcu") {
  edition = "2024"
  version = "0.1.0"
  with_unit_tests = true

  deps = [
    ":fuchsia-rcu-derive",
    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//src/lib/shared-buffer",

    # TODO(b/559178925): Refactor RcuDroppable trait to avoid all implementers
    # as dependencies.
    "//src/lib/trace/rust:trace",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:futures",
  ]

  if (enable_rseq_backend_for_rcu) {
    features = [ "rseq_backend" ]

    deps += [ "//src/lib/fuchsia-rseq" ]
  }

  sources = [
    "src/atomic_stack.rs",
    "src/lib.rs",
    "src/rcu_arc.rs",
    "src/rcu_box.rs",
    "src/rcu_droppable.rs",
    "src/rcu_droppable_arc.rs",
    "src/rcu_option_arc.rs",
    "src/rcu_option_box.rs",
    "src/rcu_ptr.rs",
    "src/rcu_read_scope.rs",
    "src/rcu_weak.rs",
    "src/read_counters.rs",
    "src/state_machine.rs",
  ]
}

fuchsia_unittest_package("fuchsia-rcu-tests") {
  deps = [ ":fuchsia-rcu_test" ]
}
