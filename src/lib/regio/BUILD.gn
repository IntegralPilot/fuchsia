import("//build/components.gni")
import("//build/rust/rustc_library.gni")

regio_common = {
  crate_name = "regio"
  edition = "2024"
  sources = [
    "src/arm64/mod.rs",
    "src/arm64/spec.rs",
    "src/lib.rs",
    "src/mmio.rs",
    "src/riscv64/encoding.rs",
    "src/riscv64/mod.rs",
    "src/testing/mod.rs",
    "src/testing/x86.rs",
    "src/traits.rs",
    "src/x86/cpuid.rs",
    "src/x86/cr.rs",
    "src/x86/mod.rs",
    "src/x86/msr.rs",
    "src/x86/pio.rs",
  ]
  deps = [ "//zircon/system/ulib/mmio-ptr:mmio-ptr-rs" ]
}

# TODO(https://fxbug.dev/548748442): remove when all fixed in the code
regio_configs = []
if (is_kernel) {
  regio_configs += [ "//zircon/kernel/switch:allow-new-without-default" ]
  regio_configs += [ "//zircon/kernel/switch:allow-clone-on-copy" ]
  regio_configs += [ "//zircon/kernel/switch:allow-non-canonical-clone-impl" ]
  regio_configs += [ "//zircon/kernel/switch:allow-doc-lazy-continuation" ]
  regio_configs += [ "//zircon/kernel/switch:allow-assertions-on-constants" ]
  regio_configs += [ "//zircon/kernel/switch:allow-let-unit-value" ]
}

rustc_library("regio") {
  forward_variables_from(regio_common, "*")
  with_unit_tests = true
  configs += regio_configs
}

# The same crate as ":regio", but with the testing feature enabled.
rustc_library("regio-testing") {
  forward_variables_from(regio_common, "*")
  testonly = true
  features = [ "testing" ]
  configs += regio_configs
}

fuchsia_unittest_package("regio-tests") {
  deps = [ ":regio_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":regio-tests",
    ":regio_test($host_toolchain)",
  ]
}
