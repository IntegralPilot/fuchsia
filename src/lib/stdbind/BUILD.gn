import("//build/cpp/library_headers.gni")
import("//build/rust/rustc_library.gni")
import("//build/test.gni")

library_headers("headers") {
  headers = [ "lib/stdbind/optional.h" ]
}

source_set("stdbind") {
  public_deps = [ ":headers" ]
}

rustc_library("stdbind-rs") {
  name = "stdbind"
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/lib.rs",
    "src/optional.rs",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":stdbind-cpp-unittests($host_toolchain)",
    ":stdbind-rs_test($host_toolchain)",
  ]
}

test("stdbind-cpp-unittests") {
  sources = [ "optional-test.cc" ]
  deps = [
    "//src/lib/stdbind",
    "//zircon/system/ulib/zxtest",
  ]
}
