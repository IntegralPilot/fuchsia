import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("kprint") {
  with_unit_tests = true
  edition = "2024"

  sources = [
    "src/backend.rs",
    "src/lib.rs",
  ]

  deps = [ "macro:kprint-macro" ]
}

fuchsia_unittest_package("kprint-test") {
  deps = [ ":kprint_test" ]
  test_specs = {
    environments = [ emu_env ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":kprint-test",
    ":kprint_test($host_toolchain)",
  ]
}
