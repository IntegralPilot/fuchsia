import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("line-editor") {
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:libc",
  ]

  sources = [
    "src/config.rs",
    "src/control.rs",
    "src/editor.rs",
    "src/history.rs",
    "src/io.rs",
    "src/lib.rs",
    "src/state.rs",
    "src/tests.rs",
    "src/types.rs",
  ]
}

fuchsia_unittest_package("line-editor-tests") {
  deps = [ ":line-editor_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":line-editor-tests" ]
}
