{
    name: "aml_mipicsi",
    composite_name: "aml_mipi",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        compat: "driver/aml_mipicsi.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "pdev",
            primary: true,
            bind: {
                one_of: [
                    { compat: "amlogic,mipi-csi2" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        pid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.T931",
                        did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.MIPI_CSI",
                    },
                ],
            },
        },
    ],
}
