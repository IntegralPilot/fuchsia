{
    name: "gdc",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        colocate: "true",
        compat: "driver/gdc.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "camera-sensor",
            banjo: "fuchsia.camera.BIND_PROTOCOL.CAMERA_SENSOR_2",
            primary: true,
            bind: { protocol: "fuchsia.camera.BIND_PROTOCOL.CAMERA_SENSOR_2" },
        },
        {
            name: "pdev",
            bind: {
                one_of: [
                    { compat: "arm,mali-gdc" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.arm.platform.BIND_PLATFORM_DEV_VID.ARM",
                        pid: "fuchsia.arm.platform.BIND_PLATFORM_DEV_PID.GDC",
                        did: "fuchsia.arm.platform.BIND_PLATFORM_DEV_DID.MALI_IV010",
                    },
                ],
            },
        },
    ],
}
