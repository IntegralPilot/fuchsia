{
    name: "ge2d",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        colocate: "true",
        compat: "driver/ge2d.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "camera-sensor",
            banjo: "fuchsia.camera.BIND_PROTOCOL.CAMERA_SENSOR_2",
            primary: true,
            bind: { protocol: "fuchsia.camera.BIND_PROTOCOL.CAMERA_SENSOR_2" },
        },
        {
            name: "canvas",
            service: "fuchsia.hardware.amlogiccanvas.Service",
        },
        {
            name: "pdev",
            bind: {
                one_of: [
                    { compat: "amlogic,ge2d" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        pid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.T931",
                        did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.GE2D",
                    },
                ],
            },
        },
    ],
}
