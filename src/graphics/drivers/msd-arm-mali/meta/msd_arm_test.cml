{
    include: [ "//src/graphics/drivers/msd-arm-mali/meta/msd_arm.shard.cml" ],
    program: {
        binary: "driver/msd_arm_test.so",
        bind: "meta/bind/msd_arm.bindbc",
    },
    capabilities: [
        {
            service: [ "fuchsia.gpu.magma.TestService" ],
        },
    ],
    expose: [
        {
            service: [ "fuchsia.gpu.magma.TestService" ],
            from: "self",
        },
    ],
}
