{
    name: "msd_arm",
    include: [ "//src/graphics/drivers/msd-arm-mali/meta/msd_arm.shard.cml" ],
    program: {
        binary: "driver/msd_arm.so",
        allowed_scheduler_roles: [
            "fuchsia.graphics.drivers.msd-arm-mali.device",
            "fuchsia.graphics.drivers.msd-arm-mali.gpu-interrupt",
            "fuchsia.graphics.drivers.msd-arm-mali.mmu-interrupt",
        ],
    },
    use: [
        {
            name: "mali",
            service: "fuchsia.hardware.gpu.mali.Service",
            primary: true,
            transport: "Driver",
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            bind: {
                one_of: [
                    { compat: "arm,mali-gpu" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.arm.platform.BIND_PLATFORM_DEV_VID.ARM",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: "fuchsia.arm.platform.BIND_PLATFORM_DEV_DID.MAGMA_MALI",
                    },
                ],
            },
        },
    ],
}
