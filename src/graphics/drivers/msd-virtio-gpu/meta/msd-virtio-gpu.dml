{
    name: "msd-virtio-gpu",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/msd-virtio.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { service: "fuchsia.gpu.virtio.Service" },
    },
    use: [
        { protocol: "fuchsia.gpu.virtio.VirtioGpu" },
        { protocol: "fuchsia.kernel.InfoResource" },
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "default",
            service: "fuchsia.gpu.virtio.Service",
            generate_bind_rule: false,
        },
    ],
}
