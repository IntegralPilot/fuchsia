{
    name: "goldfish_address_space",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/goldfish_address_space.so",
    },
    capabilities: [
        { service: "fuchsia.hardware.goldfish.AddressSpaceService" },
    ],
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                rules: {
                    "fuchsia.BIND_PCI_DID": "0xF153",
                    "fuchsia.BIND_PCI_VID": "0x607D",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.goldfish.AddressSpaceService",
            from: "self",
        },
    ],
}
