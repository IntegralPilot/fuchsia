{
    name: "goldfish_sync",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/goldfish_sync.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.goldfish.SyncService" },
    ],
    use: [
        {
            name: "acpi",
            service: "fuchsia.hardware.acpi.Service",
            generate_bind_rule: false,
        },
        {
            name: "irq000",
            service: "fuchsia.hardware.interrupt.Service",
        },
        {
            name: "acpi",
            primary: true,
            bind: {
                banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE",
                rules: { "fuchsia.acpi.HID": "GFSH0006" },
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.goldfish.SyncService",
            from: "self",
        },
    ],
}
