{
    name: "msd_vsi",
    include: [ "//src/graphics/drivers/msd-vsi-vip/meta/msd_vsi.shard.cml" ],
    program: {
        binary: "driver/libmsd_vsi.so",
        bind: {
            protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
            vid: "fuchsia.verisilicon.platform.BIND_PLATFORM_DEV_VID.VERISILICON",
            pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
            did: "fuchsia.verisilicon.platform.BIND_PLATFORM_DEV_DID.MAGMA_VIP",
        },
    },
}
