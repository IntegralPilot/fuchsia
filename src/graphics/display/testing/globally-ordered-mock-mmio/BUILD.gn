import("//build/components.gni")
import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")

rustc_library("globally-ordered-mock-mmio") {
  # The library is a test double. It must not be linked into production code.
  testonly = true

  edition = "2024"
  name = "globally_ordered_mock_mmio"
  with_unit_tests = true

  sources = [
    "src/data_access.rs",
    "src/expectation.rs",
    "src/formatting.rs",
    "src/history_entry.rs",
    "src/lib.rs",
    "src/mmio_operand_value.rs",
    "src/mock_builder.rs",
    "src/operation.rs",
    "src/scoreboard.rs",
    "src/source_info.rs",
    "src/trace_builder.rs",
  ]

  deps = [
    "//sdk/lib/driver/mmio/rust:mmio",
    "//src/lib/fuchsia-sync",
  ]

  # `mmio::register!` expands to `bitfield::bitfield!`.
  test_deps = [
    "//src/lib/fuchsia",
    "//third_party/rust_crates:bitfield",
  ]
}

rustc_test("globally_ordered_mock_mmio_integration_test_bin") {
  name = "globally_ordered_mock_mmio_integration_test"
  edition = "2024"
  source_root = "tests/integration_test.rs"
  sources = [ "tests/integration_test.rs" ]

  deps = [
    ":globally-ordered-mock-mmio",
    "//sdk/lib/driver/mmio/rust:mmio",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:bitfield",
  ]
}

fuchsia_unittest_package("globally-ordered-mock-mmio-tests") {
  package_name = "globally-ordered-mock-mmio-tests"
  deps = [ ":globally_ordered_mock_mmio_integration_test_bin" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

fuchsia_unittest_package("globally-ordered-mock-mmio-unittests") {
  package_name = "globally-ordered-mock-mmio-unittests"
  deps = [ ":globally-ordered-mock-mmio_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":globally-ordered-mock-mmio-tests",
    ":globally-ordered-mock-mmio-unittests",
  ]
}
