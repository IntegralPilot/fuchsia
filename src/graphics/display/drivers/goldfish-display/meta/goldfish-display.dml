{
    name: "goldfish-display",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { banjo: "fuchsia.goldfish.platform.BIND_PROTOCOL.CONTROL" },
    },
    capabilities: [
        { service: "fuchsia.hardware.display.engine.Service" },
    ],
    use: [
        { protocol: "fuchsia.sysmem2.Allocator" },
        {
            name: "default",
            service: "fuchsia.hardware.goldfish.ControlService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.goldfish.pipe.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.display.engine.Service",
            from: "self",
        },
    ],
}
