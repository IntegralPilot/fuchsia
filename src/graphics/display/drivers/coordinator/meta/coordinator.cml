{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "driver",
        binary: "driver/display-coordinator.so",
        bind: "meta/bind/display-coordinator.bindbc",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        default_dispatcher_scheduler_role: "fuchsia.graphics.display.drivers.display.coordinator",
        allowed_scheduler_roles: [ "fuchsia.graphics.display.drivers.display.coordinator" ],
        memory_priority_role: "fuchsia.display.driver.memory",
    },
    use: [
        { service: "fuchsia.driver.compat.Service" },
        {
            service: [ "fuchsia.hardware.display.engine.Service" ],
            availability: "optional",
        },
        {
            config: "fuchsia.display.FallbackHorizontalSizeMm",
            key: "fallback_horizontal_size_mm",
            type: "uint32",
        },
        {
            config: "fuchsia.display.FallbackVerticalSizeMm",
            key: "fallback_vertical_size_mm",
            type: "uint32",
        },
    ],
}
