{
    name: "aml-canvas",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        default_dispatcher_scheduler_role: "fuchsia.graphics.display.drivers.aml-canvas.device",
    },
    capabilities: [
        { service: "fuchsia.hardware.amlogiccanvas.Service" },
    ],
    use: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    { compat: "amlogic,canvas" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.CANVAS",
                    },
                ],
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.amlogiccanvas.Service",
            from: "self",
        },
    ],
}
