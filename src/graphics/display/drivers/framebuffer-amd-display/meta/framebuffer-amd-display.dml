{
    name: "framebuffer-amd-display",
    include: [ "//src/graphics/display/lib/framebuffer-display/meta/framebuffer-pci-boot-display-driver.shard.cml" ],
    program: {},
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                pci: {
                    vid: "fuchsia.pci.BIND_PCI_VID.AMD",
                    class: "fuchsia.pci.BIND_PCI_CLASS.DISPLAY",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
}
