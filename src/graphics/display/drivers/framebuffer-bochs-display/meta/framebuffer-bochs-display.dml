{
    name: "framebuffer-bochs-display",
    include: [ "driver_component/driver.shard.cml" ],
    program: {},
    capabilities: [
        { service: "fuchsia.hardware.display.engine.Service" },
    ],
    use: [
        { protocol: "fuchsia.sysmem2.Allocator" },
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                pci: {
                    vid: "0x1234",
                    did: "0x1111",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.display.engine.Service",
            from: "self",
        },
    ],
}
