{
    include: [
        "driver_component/driver.shard.cml",
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "driver",
        binary: "driver/boot-framebuffer-display.so",
        bind: "meta/bind/boot-framebuffer-display-bind.bindbc",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [ { service: "fuchsia.hardware.display.engine.Service" } ],
    use: [
        { protocol: [ "fuchsia.boot.Items", "fuchsia.sysmem2.Allocator" ] },
        { service: "fuchsia.hardware.platform.device.Service" },
    ],
    expose: [ { service: "fuchsia.hardware.display.engine.Service", from: "self" } ],
}
