import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")

driver_bind_rules("boot-framebuffer-display-bind") {
  rules = "meta/boot-framebuffer-display.bind"
  deps = [ "//src/devices/bind/fuchsia", "//src/devices/bind/fuchsia.platform" ]
}

fuchsia_cc_driver("driver") {
  output_name = "boot-framebuffer-display"
  sources = [ "boot-framebuffer-display.cc" ]
  deps = [
    ":boot-framebuffer-display-bind",
    "//sdk/fidl/fuchsia.boot:fuchsia.boot_cpp",
    "//sdk/fidl/fuchsia.hardware.platform.device:fuchsia.hardware.platform.device_cpp",
    "//sdk/lib/driver/component/cpp",
    "//src/graphics/display/lib/framebuffer-display",
    "//src/graphics/display/lib/framebuffer-display:boot-framebuffer",
  ]
}

fuchsia_driver_component("boot-framebuffer-display") {
  component_name = "boot-framebuffer-display"
  deps = [ ":driver" ]
  manifest = "meta/boot-framebuffer-display.cml"
  info = "meta/boot-framebuffer-display-info.json"
}

fuchsia_driver_package("package") {
  package_name = "boot-framebuffer-display"
  driver_components = [ ":boot-framebuffer-display" ]
}
