import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("zero_function_test") {
    main_source = "zero_function_test.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
      "//src/tests/end_to_end/usb/lib/testusb:testusb",
      "//src/tests/end_to_end/usb/lib/zero_function",
    ]
    package_deps = [ "//src/devices/usb/drivers/usb-zero-function:package" ]

    # `setup_class` registers the usb-zero-function driver ephemerally via
    # `ffx driver register`, so the subtool has to ship with the test.
    test_data_deps =
        [ "//src/developer/ffx/tools/driver:ffx_driver_tool_test_data" ]

    # This test drives the DUT's USB peripheral from the host, so it can only
    # run on Iris devices hosted by a Fuchsia cell.
    environments = [ iris_cell_env ]
  }
}

group("tests") {
  testonly = true
  public_deps = [ ":zero_function_test($host_toolchain)" ]
}
