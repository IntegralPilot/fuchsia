import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("usb_virtual_disconnect_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 10
      disconnect_duration_sec = 10
    }
    local_config_source = "UsbVirtualDisconnectTestbed.yaml"
    environments = [ sorrel_env ]
    timeout_secs = 600
  }

  python_mobly_test("usb_disconnect_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_usb_disconnects = 5
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      vim3_env,
      nuc11_env,
      nelson_env,
      sherlock_env,
      sorrel_env,
    ]
    timeout_secs = 600
  }

  python_mobly_test("usb_disconnect_stress_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_usb_disconnects = 100
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [ iris_env ]
    timeout_secs = 7200
  }

  python_mobly_test("cdc_stress_test") {
    main_source = "test_cdc_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      packet_iterations = 10
      large_transfer_iterations = 5
      transfer_size_mb = 5
      varying_burst_count = 50
      toggle_iterations = 10
      power_iterations = 2
      disconnect_duration_sec = 5
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [ sorrel_env ]
    timeout_secs = 900
  }
  python_mobly_test("usb_fastboot_loop_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 5
      disconnect_duration_sec = 1
      fastboot_loop = true
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      sorrel_env,
    ]
    timeout_secs = 900
  }

  python_mobly_test("adb_root_unroot_stress_test") {
    main_source = "test_adb_root_unroot_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 10
    }
    environments = [ sorrel_env ]
    timeout_secs = 600
  }

  python_mobly_test("adb_fastboot_stress_test") {
    main_source = "test_adb_fastboot_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 10
    }
    environments = [ sorrel_env ]
    timeout_secs = 1200
  }
  python_mobly_test("adb_random_stress_test") {
    main_source = "test_adb_random_stress.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    params = {
      num_iterations = 20
    }
    environments = [ sorrel_env ]
    timeout_secs = 1200
  }
}

group("zero_function_stress_test") {
  testonly = true
  public_deps = [ "zero_function:tests($host_toolchain)" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":adb_fastboot_stress_test($host_toolchain)",
    ":adb_random_stress_test($host_toolchain)",
    ":adb_root_unroot_stress_test($host_toolchain)",
    ":cdc_stress_test($host_toolchain)",
    ":usb_disconnect_stress_test($host_toolchain)",
    ":usb_disconnect_test($host_toolchain)",
    ":usb_fastboot_loop_test($host_toolchain)",
    ":usb_virtual_disconnect_test($host_toolchain)",
    "zero_function:tests($host_toolchain)",
  ]
}
