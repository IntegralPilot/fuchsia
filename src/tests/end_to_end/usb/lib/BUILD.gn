import("//build/python/python_library.gni")

python_library("usb_lib") {
  testonly = true
  library_name = "usb_lib"
  sources = [
    "__init__.py",
    "sysfs_usb.py",
    "usb_config.py",
  ]
  library_deps = [ "//src/testing/end_to_end/honeydew" ]
}

group("tests") {
  testonly = true
  deps = [
    ":usb_lib",
    "testusb:tests",
    "zero_function:tests",
  ]
}
