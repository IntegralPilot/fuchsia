import("//build/python/python_binary.gni")
import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")

python_library("testusb") {
  testonly = true
  library_name = "testusb"
  sources = [
    "__init__.py",
    "backend.py",
    "cli.py",
    "ioctl.py",
    "models.py",
    "runner.py",
  ]
}

# Standalone binary for host execution
python_binary("testusb_bin") {
  testonly = true
  main_source = "cli.py"
  output_name = "testusb.pyz"
  deps = [ ":testusb" ]
}

if (is_host) {
  python_host_test("testusb_test") {
    main_source = "testusb_test.py"
    libraries = [ ":testusb" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [ ":testusb_test($host_toolchain)" ]
}
