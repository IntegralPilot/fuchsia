group("tests") {
  testonly = true
  deps = [
    "functional:tests",
    "lib:tests",
    "performance:tests",
    "stress:tests",
  ]
}

group("usb_enumeration_test") {
  testonly = true
  public_deps = [ "functional:usb_enumeration_test($host_toolchain)" ]
}

group("usb_virtual_disconnect_test") {
  testonly = true
  public_deps = [ "stress:usb_virtual_disconnect_test($host_toolchain)" ]
}

group("usb_disconnect_test") {
  testonly = true
  public_deps = [ "stress:usb_disconnect_test($host_toolchain)" ]
}

group("zero_function_test") {
  testonly = true
  public_deps = [ "functional:zero_function_test($host_toolchain)" ]
}

group("zero_function_stress_test") {
  testonly = true
  public_deps = [ "stress:zero_function_stress_test($host_toolchain)" ]
}

group("zero_function") {
  testonly = true
  public_deps = [
    ":zero_function_stress_test",
    ":zero_function_test",
  ]
}
