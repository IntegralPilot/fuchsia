import("//build/testing/environments.gni")
import("//build/testing/perf/test.gni")

python_perf_test("adb_throughput_test") {
  main_source = "test_adb_throughput.py"
  expected_metric_names_filepaths = [
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull_storage.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push_storage.txt",
  ]
  libraries = [
    "//src/performance/lib/perf_publish",
    "//src/performance/lib/reporting",
    "//src/performance/lib/trace_processing",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    # Default transfer file sizes in bytes (50 MB)
    transfer_file_size_bytes = 50000000
    storage_transfer_file_size_bytes = 50000000
  }
  environments = [ sorrel_env ]
}

# Large variation with larger storage transfer size (500 MB)
python_perf_test("adb_throughput_large_test") {
  main_source = "test_adb_throughput.py"
  expected_metric_names_filepaths = [
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull_storage.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push_storage.txt",
  ]
  libraries = [
    "//src/performance/lib/perf_publish",
    "//src/performance/lib/reporting",
    "//src/performance/lib/trace_processing",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    transfer_file_size_bytes = 50000000
    storage_transfer_file_size_bytes = 500000000
  }
  environments = [ iris_env ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":adb_throughput_large_test",
    ":adb_throughput_test",
  ]
}
