import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("reboot_hang_test") {
    main_source = "reboot_hang_test.py"

    environments = [ iris_env ]

    timeout_secs = 900

    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    test_data_deps =
        [ "//src/developer/ffx/tools/driver:ffx_driver_tool_test_data" ]
    package_deps = [ "//src/devices/tests/hang-on-stop:hang_on_stop_package" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":reboot_hang_test($host_toolchain)" ]
}
