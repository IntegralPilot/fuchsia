import("//boards/default_for_emulator.gni")
import("//build/assembly/test_product_bundle.gni")
import("//build/go/go_library.gni")
import("//build/go/go_test.gni")
import("//build/testing/host_test_data.gni")

group("tests") {
  testonly = true

  deps = []

  if (host_os == "linux") {
    deps += [ ":memory_budget_tests($host_toolchain)" ]
  }
}

if (is_linux) {
  host_test_data("host_fvm") {
    visibility = [ ":*" ]

    deps = [ "//src/storage/bin/fvm" ]

    sources = [ "$root_out_dir/fvm" ]
    outputs = [ "$root_out_dir/test_data/tools/{{source_file_part}}" ]
  }

  host_test_data("vm_config") {
    visibility = [ ":*" ]

    sources = [ "test_data/vm_config.json" ]
    outputs = [ "$root_out_dir/test_data/config/{{source_file_part}}" ]
  }

  _pb_label = ":test_product_bundle($default_toolchain)"
  _pb_out_dir = get_label_info(_pb_label, "target_out_dir")
  _pb_path = "${_pb_out_dir}/test_product_bundle"

  host_test_data("host_test_data") {
    sources = [ _pb_path ]
    deps = [ _pb_label ]
  }

  go_library("lib") {
    testonly = true

    deps = [
      "//tools/emulator",
      "//tools/emulator/emulatortest",
      "//tools/lib/jsonutil",
      "//tools/virtual_device:proto",
    ]

    sources = [ "boot_test.go" ]
  }

  go_test("memory_budget_tests") {
    embed = [ ":lib" ]
    args = [
      "-product-bundle",
      rebase_path(_pb_path, root_build_dir),
    ]
    non_go_deps = [
      ":host_fvm",
      ":host_test_data",
      ":vm_config",
      "//src/storage/lib/sparse/rust:simg2img_sources",
    ]
  }
}

if (current_toolchain == default_toolchain) {
  test_product_bundle("test_product_bundle") {
    board_config = default_board_for_emulator
    platform = {
      build_type = "eng"
    }
  }
}
