import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("regen_fidl_benchmark_suite") {
    bazel_target = ":regen_fidl_benchmark_suite"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/regen_fidl_benchmark_suite_/regen_fidl_benchmark_suite"
  }
} else {
  # If "regen_fidl_benchmark_suite" is not referenced in host toolchain, provide
  # forwarding group so that both "host" and "regen_fidl_benchmark_suite" are
  # redirected to host toolchain.
  group("regen_fidl_benchmark_suite") {
    public_deps = [ ":regen_fidl_benchmark_suite($host_toolchain)" ]
  }
}

# "host" target is referenced by `//bundles/fidl:tools` without specifying
# the toolchain. GN evaluates in the default toolchain.
group("host") {
  public_deps = [ ":regen_fidl_benchmark_suite($host_toolchain)" ]
}
