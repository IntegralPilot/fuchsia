        "int32_array.go",
        "int32_vector.go",
        "optional_struct_tree.go",
        "optional_union_tree.go",
        "padded_struct_tree.go",
        "struct_array.go",
        "struct_field.go",
        "struct_tree.go",
        "struct_vector.go",
        "table_all_set.go",
        "table_all_unset.go",
        "table_reserved_last_set.go",
        "table_single_set.go",
        "union.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/src/tests/benchmarks/fidl/benchmark_suite/gen/gidl",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//src/tests/benchmarks/fidl/benchmark_suite/gen:__subpackages__"],
    deps = [
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/config",
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/gidl/util",
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/types",
