load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "gidl",
    srcs = [
        "bool_array.go",
        "byte_array.go",
        "byte_vector.go",
        "byte_vector_limit.go",
        "enum_array.go",
        "enum_array_non_dense.go",
        "float_array.go",
        "gpu_magma.go",
