load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "main",
    srcs = [
        "file_fidl.go",
        "file_gidl.go",
        "format.go",
        "main.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/src/tests/benchmarks/fidl/benchmark_suite/gen",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/config",
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/fidl",
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/fidl/util",
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/gidl",
        "//src/tests/benchmarks/fidl/benchmark_suite/gen/gidl/util",
    ],
)

go_binary_host_tool(
    name = "regen_fidl_benchmark_suite",
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
)
