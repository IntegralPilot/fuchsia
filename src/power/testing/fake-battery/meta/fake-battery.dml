{
    name: "fake-battery",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/fake_battery.so",
        bind: {
            vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
            pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
            did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.FAKE_BATTERY",
        },
    },
    capabilities: [
        {
            protocol: [ "fuchsia.power.battery.BatteryInfoProvider" ],
        },
        {
            service: [
                "fuchsia.hardware.power.battery.Service",
                "fuchsia.power.battery.InfoService",
                "test.hardwarepowercontrol.Service",
            ],
        },
    ],
    expose: [
        {
            service: [
                "fuchsia.hardware.power.battery.Service",
                "fuchsia.power.battery.InfoService",
                "test.hardwarepowercontrol.Service",
            ],
            from: "self",
        },
    ],
}
