import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/fidl/fidl.gni")
import("//build/test.gni")

fidl("test.trippoint") {
  sources = [ "control.test.fidl" ]
  public_deps = [ "//zircon/vdso/zx" ]
}

fuchsia_driver_dml("fake_trippoint_dml") {
  dml = "meta/fake-trippoint.dml"
  driver_name = "fake-trippoint"
  golden_bind = "meta/fake-trippoint.bind"
  golden_cml = "meta/fake-trippoint.cml"
}

driver_bind_rules("bind") {
  dml_label = ":fake_trippoint_dml"
  bind_output = "fake-trippoint.bindbc"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.test",
  ]
}

fuchsia_cc_driver("driver") {
  output_name = "fake_trippoint"
  sources = [ "trippoint_driver.cc" ]
  deps = [
    ":bind",
    ":test.trippoint_cpp",
    "//sdk/fidl/fuchsia.hardware.temperature:fuchsia.hardware.temperature_cpp",
    "//sdk/fidl/fuchsia.hardware.trippoint:fuchsia.hardware.trippoint_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//src/devices/lib/driver:driver_runtime",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_driver_component("fake_trippoint_component") {
  component_name = "fake_trippoint"
  dml_label = ":fake_trippoint_dml"
  deps = [ ":driver" ]
  info = "meta/fake_trippoint_info.json"
}
