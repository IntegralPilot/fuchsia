{
    name: "fake-trippoint",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/fake_trippoint.so",
        bind: { protocol: "fuchsia.test.BIND_PROTOCOL.PARENT" },
    },
    capabilities: [
        { service: "fuchsia.hardware.temperature.Service" },
        { service: "test.trippoint.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.temperature.Service",
            from: "self",
        },
        {
            service: "test.trippoint.Service",
            from: "self",
        },
    ],
}
