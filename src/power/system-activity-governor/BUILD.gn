import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

# Sources and deps are shared by both the real binary and the variant that uses
# fake time.
sag_sources = [
  "src/activity_governor_request_frontend.rs",
  "src/cpu_element_manager.rs",
  "src/cpu_manager.rs",
  "src/events.rs",
  "src/main.rs",
  "src/power_observability.rs",
  "src/system_activity_governor.rs",
]

sag_deps = [
  ":sag_config",
  "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
  "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_rust",
  "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
  "//sdk/fidl/fuchsia.hardware.power.suspend:fuchsia.hardware.power.suspend_rust",
  "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
  "//sdk/fidl/fuchsia.power.cpu.manager:fuchsia.power.cpu.manager_rust",
  "//sdk/fidl/fuchsia.power.observability:fuchsia.power.observability_rust",
  "//sdk/fidl/fuchsia.power.suspend:fuchsia.power.suspend_rust",
  "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
  "//sdk/lib/power/state_recorder/rust",
  "//sdk/lib/scheduler/rust",
  "//sdk/rust/zx",
  "//src/lib/async-utils",
  "//src/lib/diagnostics/inspect/contrib/rust:fuchsia-inspect-contrib",
  "//src/lib/diagnostics/inspect/format/rust",
  "//src/lib/diagnostics/inspect/runtime/rust",
  "//src/lib/diagnostics/inspect/rust",
  "//src/lib/fidl/rust/fidl",
  "//src/lib/fuchsia",
  "//src/lib/fuchsia-async",
  "//src/lib/fuchsia-component",
  "//src/lib/fuchsia-sync",
  "//src/lib/trace/rust:trace",
  "//src/lib/trace/rust:trace-provider",
  "//src/power/broker/client",
  "//third_party/rust_crates:anyhow",
  "//third_party/rust_crates:async-lock",
  "//third_party/rust_crates:async-trait",
  "//third_party/rust_crates:futures",
  "//third_party/rust_crates:log",
  "//third_party/rust_crates:strum",
  "//third_party/rust_crates:strum_macros",
]

rustc_binary("bin") {
  name = "system_activity_governor"
  edition = "2024"
  with_unit_tests = true

  configs += [ "//build/config/rust:bootfs" ]

  sources = sag_sources
  deps = sag_deps
  test_deps = [
    "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//src/lib/test_util",
  ]
}

rustc_binary("bin_with_fake_time") {
  testonly = true
  name = "system_activity_governor_fake_time"
  edition = "2024"

  configs += [ "//build/config/rust:bootfs" ]

  sources = sag_sources
  deps = sag_deps
  non_rust_deps = [ "//src/lib/fake-clock/lib:lib_with_utc" ]
}

fuchsia_component_manifest("manifest") {
  manifest = "meta/system-activity-governor.cml"
  component_name = "system-activity-governor"
}

fuchsia_component_manifest("manifest_fake_time") {
  manifest = "meta/system-activity-governor-fake-time.cml"
  component_name = "system-activity-governor-fake-time"
}

fuchsia_component("component_fake_time") {
  testonly = true
  cm_label = ":manifest_fake_time"
  deps = [ ":bin_with_fake_time" ]
}

fuchsia_structured_config_rust_lib("sag_config") {
  cm_label = ":manifest"
}

group("system-activity-governor") {
  testonly = true
  deps = [
    ":bin",
    ":tests",
  ]
}

fuchsia_package_with_single_component("config-no-suspender") {
  manifest = "meta/config-no-suspender.cml"
}

fuchsia_package_with_single_component("config-use-suspender") {
  manifest = "meta/config-use-suspender.cml"
}

fuchsia_package_with_single_component("config-wait-for-token") {
  manifest = "meta/config-wait-for-token.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

fuchsia_package("package") {
  package_name = "system-activity-governor"
  deps = [ ":component" ]
}

fuchsia_unittest_package("system-activity-governor-unittests") {
  deps = [ ":bin_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":system-activity-governor-unittests",
    "fake/tests",
    "integration/tests",
  ]
}
