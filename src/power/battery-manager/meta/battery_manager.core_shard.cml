{
    children: [
        {
            name: "battery_manager",
            url: "fuchsia-pkg://fuchsia.com/battery-manager#meta/battery_manager.cm",
            environment: "#core-env",
        },
    ],
    offer: [
        {
            storage: "data",
            from: "self",
            to: [ "#battery_manager" ],
        },
        {
            storage: "tmp",
            from: "self",
            to: [ "#battery_manager" ],
        },
        {
            directory: "boot",
            from: "parent",
            as: "config",
            to: [ "#battery_manager" ],
            rights: [ "r*" ],
            subdir: "config/battery_manager",
        },
        {
            service: [ "fuchsia.hardware.power.battery.Service" ],
            from: "parent",
            to: "#battery_manager",
            availability: "optional",
        },
        {
            service: [ "fuchsia.power.battery.InfoService" ],
            from: "parent",
            to: "#battery_manager",
            availability: "optional",
        },
        {
            protocol: "fuchsia.power.system.ActivityGovernor",
            from: "parent",
            to: "#battery_manager",
            availability: "optional",
        },
        {
            protocol: "fuchsia.feedback.CrashReporter",
            from: "#feedback",
            to: "#battery_manager",
        },
        {
            config: [ "fuchsia.power.SuspendEnabled" ],
            from: "parent",
            to: [ "#battery_manager" ],
        },
        {
            protocol: [
                "fuchsia.power.battery.BatteryManager",
                "fuchsia.power.battery.test.BatterySimulator",
            ],
            from: "#battery_manager",
            to: "self/toolbox",
            target_availability: "unknown",
        },
    ],
}
