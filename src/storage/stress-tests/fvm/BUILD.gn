import("//build/rust/rustc_test.gni")

rustc_test("stressor-bin") {
  name = "fvm_stressor"
  edition = "2024"
  source_root = "main.rs"
  testonly = true

  deps = [
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/log/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/storage/lib/block_client/rust",
    "//src/storage/lib/fs_management/rust:fs_management",
    "//src/storage/stress-tests/utils",
    "//src/sys/lib/stress-test",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
  ]

  sources = [
    "environment.rs",
    "instance_actor.rs",
    "main.rs",
    "volume.rs",
    "volume_actor.rs",
    "vslice.rs",
  ]
}
