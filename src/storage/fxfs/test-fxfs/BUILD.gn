import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  edition = "2024"
  output_name = "test-fxfs"
  deps = [
    ":test_fxfs_config",
    "//sdk/fidl/fuchsia.fshost:fuchsia.fshost_rust",
    "//sdk/fidl/fuchsia.hardware.inlineencryption:fuchsia.hardware.inlineencryption_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component/client",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//src/performance/memory/attribution/refaults_vmo",
    "//src/storage/fidl/fuchsia.fs.startup:fuchsia.fs.startup_rust",
    "//src/storage/fxfs:lib",
    "//src/storage/fxfs/crypto",
    "//src/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
    "//src/storage/fxfs/platform",
    "//src/storage/fxfs/test-fxfs/fidl/fuchsia.test.fxfs:fuchsia.test.fxfs_rust",
    "//src/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server",
    "//src/storage/lib/storage_device",
    "//src/storage/lib/vfs/rust:vfs_static",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  sources = [ "src/main.rs" ]
  assert_no_deps = [ "//src/storage/lib/vfs/rust:vfs" ]
  testonly = true
}

fuchsia_component_manifest("test-fxfs-manifest") {
  component_name = "test-fxfs"
  manifest = "meta/test-fxfs.cml"
}

fuchsia_component("test-fxfs") {
  cm_label = ":test-fxfs-manifest"
  deps = [ ":bin" ]
  testonly = true
}

fuchsia_structured_config_rust_lib("test_fxfs_config") {
  cm_label = ":test-fxfs-manifest"
  testonly = true
}

fuchsia_package("test-fxfs-package") {
  package_name = "test-fxfs"
  deps = [
    ":test-fxfs",
    "//src/storage/crypt/fxfs",
  ]
  testonly = true
}
