import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("f2fs_reader") {
  name = "f2fs_reader"
  edition = "2024"
  with_unit_tests = true
  sources = [
    "src/block_cache.rs",
    "src/checkpoint.rs",
    "src/crypto.rs",
    "src/dir.rs",
    "src/fsverity.rs",
    "src/inode.rs",
    "src/lib.rs",
    "src/nat.rs",
    "src/reader.rs",
    "src/superblock.rs",
    "src/xattr.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/fuchsia-sync",
    "//src/storage/lib/fscrypt",
    "//src/storage/lib/fsverity-merkle",
    "//src/storage/lib/storage_device",
    "//third_party/rust_crates:aes",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:cbc",
    "//third_party/rust_crates:enumn",
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:lru-cache",
    "//third_party/rust_crates:siphasher",
    "//third_party/rust_crates:zerocopy",
  ]

  test_deps = [
    "//src/lib/fuchsia",
    "//src/storage/f2fs_reader/testdata:images",
    "//third_party/rust_crates:zstd",
    "//third_party/zstd",
  ]
}

fuchsia_unittest_package("f2fs-reader-tests") {
  deps = [ ":f2fs_reader_test" ]
  test_specs = {
    # Several tests load the f2fs.img.zst image which expands to 256MiB. Running
    # the tests in parallel can cause the system to OOM.
    parallel = 1
  }
}

group("tests") {
  testonly = true
  deps = [
    ":f2fs-reader-tests",
    "//src/storage/f2fs_reader/fuzzers:f2fs_reader-fuzzers",
    "//src/storage/f2fs_reader/migrate:tests",
  ]
}
