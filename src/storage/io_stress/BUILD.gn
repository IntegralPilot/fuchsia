import("//build/components.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_library.gni")
import("//build/testing/perf/test.gni")
import("//src/storage/fshost/generated_fshost_config.gni")

rustc_library("lib") {
  name = "io_stress"
  edition = "2024"
  testonly = true
  with_unit_tests = true
  source_root = "src/lib.rs"
  sources = [
    "src/lib.rs",
    "src/parser.rs",
    "src/stress.rs",
    "src/workloads.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
    "//sdk/fidl/fuchsia.memory.debug:fuchsia.memory.debug_rust",
    "//sdk/fidl/fuchsia.memorypressure:fuchsia.memorypressure_rust",
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/trace/rust:trace",
    "//src/performance/lib/fuchsiaperf",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
  ]
}

rustc_binary("bin") {
  name = "io_stress"
  edition = "2024"
  testonly = true
  sources = [ "src/main.rs" ]
  deps = [
    ":lib",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/trace/rust:trace-provider",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
  ]
}

rustc_binary("suite_bin") {
  name = "io_stress_suite"
  edition = "2024"
  testonly = true
  source_root = "src/suite.rs"
  sources = [ "src/suite.rs" ]
  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.memorypressure:fuchsia.memorypressure_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde_json",
  ]
}

fuchsia_component_manifest("manifest") {
  testonly = true
  component_name = "io_stress"
  manifest = "meta/io_stress.cml"
}

fuchsia_test_component("io-stress-component") {
  component_name = "io_stress"
  cm_label = ":manifest"
  deps = [ ":bin" ]
  test_type = "system"
}

fuchsia_component_manifest("suite_manifest") {
  testonly = true
  component_name = "io_stress_suite"
  manifest = "meta/io_stress_suite.cml"
}

fuchsia_test_component("io-stress-suite-component") {
  component_name = "io_stress_suite"
  cm_label = ":suite_manifest"
  deps = [ ":suite_bin" ]
  test_type = "system"
}

if (target_cpu == "riscv64" || data_filesystem_format == "minfs") {
  # These empty groups act as stubs for unsupported configurations (e.g.,
  # riscv64 or minfs) to prevent build failures when referenced by higher-level
  # test groups like //src/storage:tests and
  # //src/tests/end_to_end/perf:benchmarks
  group("io-stress-test") {
    testonly = true
  }
  group("io_stress_perf_test") {
    testonly = true
  }
  group("io-stress-unittests") {
    testonly = true
  }
} else {
  fuchsia_test_package("io-stress-test") {
    test_components = [ ":io-stress-suite-component" ]
    deps = [ ":io-stress-component" ]
    validate_structured_config = false
  }

  fuchsia_component_perf_test("io_stress_perf_test") {
    package = ":io-stress-test"
    component_name = "io_stress_suite"
    expected_metric_names_filepath = "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.io_stress.txt"
    results_path_test_arg = "--output-fuchsiaperf"
    test_type = "system"
    environments = performance_testing_environments
  }
  fuchsia_unittest_package("io-stress-unittests") {
    deps = [ ":lib_test" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":io-stress-test",
    ":io-stress-unittests",
  ]
}
