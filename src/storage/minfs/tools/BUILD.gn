import("//build/sdk/sdk_host_tool.gni")

executable("minfs") {
  sources = [
    "main.cc",
    "minfs.h",
  ]
  deps = [
    "//src/storage/lib/host",
    "//src/storage/lib/vfs/cpp",
    "//src/storage/lib/vfs/cpp/journal",
    "//src/storage/minfs",
    "//zircon/system/ulib/bitmap",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zx",
  ]
}

sdk_host_tool("minfs_sdk") {
  category = "partner"
  output_name = "minfs"
  deps = [ ":minfs" ]
}
