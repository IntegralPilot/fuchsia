{
    program: {
        runner: "starnix_container",
        binary: "data/tests/storage-starnix-benchmarks",
        args: [
            "--benchmark-dir",
            "{component_path}/data",
            "--output-fuchsiaperf",
            "/custom_artifacts/results.fuchsiaperf.json",
            "--filesystem-name",
            "starnix_data",
        ],
    },
    use: [
        {
            storage: "data",
            path: "/data",
        },
        {
            storage: "custom_artifacts",
            rights: [ "rw*" ],
            path: "/custom_artifacts",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.component.Binder",
            from: "framework",
        },
    ],
}
