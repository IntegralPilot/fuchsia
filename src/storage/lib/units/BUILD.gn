import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("units") {
  edition = "2024"
  name = "storage_units"
  with_unit_tests = true
  sources = [ "src/lib.rs" ]
  deps = []
  if (is_fuchsia) {
    sources += [ "src/page.rs" ]
    deps += [ "//sdk/rust/zx" ]
  }
  test_deps = [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("storage-units-tests") {
  deps = [ ":units_test" ]

  test_specs = {
    log_settings = {
      # The multiplication overflow panic tests produce ERROR logs.
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":storage-units-tests",
    ":units_test($host_toolchain)",
  ]
}
