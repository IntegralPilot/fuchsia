import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("blob_pager_and_verifier") {
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//src/storage/fidl/fuchsia.storage.mapping:fuchsia.storage.mapping_rust",
    "//src/storage/lib/mapping",
    "//src/storage/lib/ptr_slice",
    "//src/storage/lib/vmo-fifo",
    "//src/sys/pkg/lib/fuchsia-hash",
    "//src/sys/pkg/lib/fuchsia-merkle",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:event-listener",
    "//third_party/rust_crates:log",
  ]
  test_deps = [
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]

  sources = [
    "src/delivery.rs",
    "src/lib.rs",
  ]
}

fuchsia_unittest_package("blob_pager_and_verifier_tests") {
  deps = [ ":blob_pager_and_verifier_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":blob_pager_and_verifier_tests" ]
}
