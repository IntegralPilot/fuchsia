import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

assert(is_host, "Python E2E tests are host-only")

# Demonstrates soft-rebooting a Fuchsia device and verifying recovery. When
# running on an emulator, persistent TAP networking (--net tap) is required.
python_mobly_test("soft_reboot_test") {
  main_source = "test_soft_reboot.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    num_reboots = 1
  }
  enable_hermetic_exe = true
  environments = [
    # Only enable for AEMU-x64 as host-tests aren't supported on QEMU-arm64.
    aemu_env,
    vim3_env,
    nuc11_env,
    nelson_env,
    sherlock_env,
  ]
}

# Monitored soft reboot variant using FFX monitor session. Requires an active
# ffx monitor daemon in the environment (use_monitor_state = true).
python_mobly_test("soft_reboot_test_with_ffx_monitor") {
  main_source = "test_soft_reboot.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    num_reboots = 1
  }
  enable_hermetic_exe = true
  environments = [
    # Only enable for AEMU-x64 as host-tests aren't supported on QEMU-arm64.
    aemu_env,
    vim3_env,
    nuc11_env,
    nelson_env,
    sherlock_env,
  ]
  honeydew_config = {
    transports = {
      ffx = {
        use_monitor_state = true
      }
    }
  }
}

# It uses "fuchsia-controller" to reboot the device. However, once device
# comes back up, it starts SL4F server and sends an SL4F request. Thus this
# test will ensure SL4F functionality in Honeydew is still working. Note - To
# run this test in CQ, ensure builder config has SL4F as dependency.
python_mobly_test("soft_reboot_test_sl4f") {
  main_source = "test_soft_reboot.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    num_reboots = 1
  }

  # FuchsiaDevice to use SL4F, include below config
  honeydew_config = {
    affordances = {
      bluetooth = {
        implementation = "sl4f"
      }
    }
  }

  environments = [
    # Only enable for AEMU-x64 as host-tests aren't supported on QEMU-arm64.
    aemu_env,
  ]
}

group("test_soft_reboot_sl4f") {
  testonly = true
  deps = [
    ":soft_reboot_test_sl4f",
    "../../honeydew:sl4f_packages($target_toolchain)",
  ]
}
