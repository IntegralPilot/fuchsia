import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

assert(is_host, "Python E2E tests are host-only")

# Demonstrates hard power cycling via auxiliary hardware (DMC or PDU). Requires
# a hardware testbed with a power switch and a custom Mobly config YAML.
python_mobly_test("power_cycle_test") {
  main_source = "power_cycle_test.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    num_power_cycles = 1
  }
  local_config_source = "PowerCycleTestbed.yaml"
  environments = [
    vim3_env,
    nuc11_env,
    nelson_env,
    sherlock_env,
  ]
}
