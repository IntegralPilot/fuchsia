import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

assert(is_host, "Python E2E tests are host-only")

# An intentionally failing test case used exclusively by Continuous Integration
# infrastructure to validate test failure exoneration and flake detection.
python_mobly_test("exoneration_failing_test") {
  main_source = "exoneration_failing_test.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  environments = [ aemu_env ]
}
