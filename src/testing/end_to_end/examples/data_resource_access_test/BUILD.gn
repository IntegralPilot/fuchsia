import("//build/python/python_library.gni")
import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

assert(is_host, "Python E2E tests are host-only")

# Demonstrates accessing custom test data files at runtime on any standard
# target or emulator.
python_mobly_test("data_resource_access_test") {
  main_source = "data_resource_access_test.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ":my_resources",
  ]
  environments = [
    # Only enable for AEMU-x64 as host-tests aren't supported on QEMU-arm64.
    aemu_env,
  ]
}

python_library("my_resources") {
  testonly = true
  source_root = "my_resources"
  sources = [
    "__init__.py",
    "test_data.json",
  ]
}
