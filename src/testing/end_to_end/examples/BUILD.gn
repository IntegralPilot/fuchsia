assert(is_host, "Python targets only build in a host toolchain")

# All of the lacewing example tests and their dependencies.
group("examples") {
  testonly = true
  public_deps = [
    "data_resource_access_test",
    "exoneration_failing_test",
    "fidl_hello_world_test",
    "hello_world_test",
    "multi_device_test_sl4f",
    "openwrt_ap_test",
    "power_cycle_test",
    "test_case_revive_example:run_wo_test_case_revive",
    "test_case_revive_example:test_case_revive_with_hard_reboot",
    "test_case_revive_example:test_case_revive_with_soft_reboot",
    "test_cases_example",
    "test_cases_revive_example",
    "test_soft_reboot:soft_reboot_test",
    "test_soft_reboot:soft_reboot_test.hermetic",
    "test_soft_reboot:soft_reboot_test_with_ffx_monitor",
    "test_soft_reboot:test_soft_reboot_sl4f",
  ]
}

# Tests in this directory that can safely run on a standard Fuchsia emulator
# without requiring specialized hardware, multiple devices, or power cycling.
group("emulator_tests") {
  testonly = true
  public_deps = [
    "data_resource_access_test",
    "fidl_hello_world_test",
    "hello_world_test",
    "test_cases_example",
  ]
}
