import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

assert(is_host, "Python E2E tests are host-only")

# Demonstrates coordinating multiple Fuchsia devices in a single Mobly testbed.
# Requires at least two Fuchsia devices configured in the testbed and SL4F
# packages on the target devices.
python_mobly_test("multi_device_test_sl4f") {
  main_source = "multi_device_test_sl4f.py"

  # The library below provides device interaction APIs.
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  multi_fuchsia_device = true
  params_source = "params.yaml"
  honeydew_config = {
    affordances = {
      bluetooth = {
        implementation = "sl4f"
      }
    }
  }
}
