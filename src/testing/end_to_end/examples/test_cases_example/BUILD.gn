import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

assert(is_host, "Python E2E tests are host-only")

# Demonstrates structuring reusable test logic using FuchsiaTestCases on any
# standard target or emulator.
python_mobly_test("test_cases_example") {
  main_source = "test_cases_example.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  environments = [
    # Only enable for AEMU-x64 as host-tests aren't supported on QEMU-arm64.
    aemu_env,
  ]
}
