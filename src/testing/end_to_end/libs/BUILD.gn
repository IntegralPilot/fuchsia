import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")

group("e2e_tests_libs") {
  testonly = true

  deps = [ ":libs" ]
}

# TODO(https://fxbug.dev/486509630): Clean up "libs" library and folder.

python_library("libs") {
  library_name = "libs"

  visibility = [
    ":*",
    "//src/testing/end_to_end/antlion:*",
    "//src/testing/end_to_end/libs/*",
    "//src/testing/end_to_end/mobly_base_tests/*",
    "//src/testing/end_to_end/mobly_controller:*",
    "//src/testing/end_to_end/mobly_controller/openwrt_access_point:*",
    "//src/testing/end_to_end/mobly_driver/*",
  ]

  sources = [
    "__init__.py",
    "commands/__init__.py",
    "commands/command.py",
    "commands/date.py",
    "commands/journalctl.py",
    "commands/nmcli.py",
    "commands/pgrep.py",
    "exception_utils.py",
    "proc/__init__.py",
    "proc/job.py",
    "proc/runner.py",
    "ssh/__init__.py",
    "ssh/connection.py",
    "ssh/formatter.py",
    "ssh/settings.py",
    "types.py",
    "validation.py",
  ]
  source_root = "//src/testing/end_to_end/libs"
  library_deps = []
}
