import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("adb_test") {
    main_source = "test_adb.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    environments = [ iris_env ]
  }
}

# Group containing all of the ADB transport functional test cases and their
# dependencies.
group("tests") {
  testonly = true
  public_deps = [ ":adb_test($host_toolchain)" ]
}
