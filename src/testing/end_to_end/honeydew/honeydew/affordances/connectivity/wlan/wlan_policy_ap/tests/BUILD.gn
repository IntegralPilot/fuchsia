import("//build/python/python_host_test.gni")
import("//build/python/python_mobly_test.gni")

assert(is_host, "Python only supported in host toolchains.")

python_host_test("unit_tests") {
  main_source = "unit_tests.py"
  libraries = [ "//src/testing/end_to_end/honeydew" ]
  main_callable = "unittest.main"
  extra_args = [ "-v" ]
}

python_mobly_test("functional_tests") {
  main_source = "functional_tests.py"
  libraries = [
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests:fuchsia_wlan_base_test",
    "//src/testing/end_to_end/antlion",
  ]
  test_data_deps =
      [ "//src/developer/ffx/tools/driver:ffx_driver_tool_test_data" ]
}
