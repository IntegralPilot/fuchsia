{
    renderer: "vulkan",
    frame_scheduler_min_predicted_frame_duration_in_us: 0,
    frame_prediction_margin_in_us: 3000,
    pointer_auto_focus: true,
    display_composition: true,
    display_composition_enable_heuristics: false,
    i_can_haz_display_id: -1,
    i_can_haz_display_mode: -1,
    display_rotation: 270,
    min_display_horizontal_resolution_px: -1,
    max_display_horizontal_resolution_px: -1,
    min_display_vertical_resolution_px: -1,
    max_display_vertical_resolution_px: -1,
    min_display_refresh_rate_millihertz: -1,
    max_display_refresh_rate_millihertz: -1,
    enable_frame_counter_overlay: false,
    use_separate_input_thread: true,
    visual_debugging_level: 0,
    prefetch: false,
}
