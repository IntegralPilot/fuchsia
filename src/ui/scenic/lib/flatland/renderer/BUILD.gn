# Keep the renderer source set separate from the rest of Flatland
# due to its dependencies on Escher which we do not want exposed.
source_set("renderer") {
  sources = [
    "mock_renderer.h",
    "null_renderer.cc",
    "null_renderer.h",
    "renderer.h",
    "vk_renderer.cc",
    "vk_renderer.h",
  ]

  public_deps = [
    "//src/lib/fidl/contrib/fpromise",
    "//src/ui/lib/escher/geometry:escher_geometry",
    "//src/ui/scenic/lib/flatland:flatland_types",
    "//src/ui/scenic/lib/flatland:image_formats",
    "//src/ui/scenic/lib/flatland/buffers",
    "//third_party/glm",
  ]

  deps = [
    "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_cpp",
    "//src/ui/lib/escher",
    "//src/ui/scenic/lib/utils",
    "//zircon/system/ulib/trace",
  ]
}
