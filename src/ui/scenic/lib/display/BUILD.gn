source_set("types") {
  sources = [
    "fidl_id_types.h",
    "fidl_typedefs.h",
  ]

  public_deps = [
    "//sdk/fidl/fuchsia.hardware.display:fuchsia.hardware.display_cpp",
    "//sdk/fidl/fuchsia.hardware.display.types:fuchsia.hardware.display.types_cpp",
    "//sdk/fidl/fuchsia.math:fuchsia.math_cpp",
    "//src/ui/scenic/lib/types",
  ]
}

source_set("display") {
  sources = [
    "color_converter.cc",
    "color_converter.h",
    "coordinator_proxy.cc",
    "coordinator_proxy.h",
    "display.cc",
    "display.h",
    "display_coordinator_listener.cc",
    "display_coordinator_listener.h",
    "display_manager.cc",
    "display_manager.h",
    "display_power_manager.cc",
    "display_power_manager.h",
    "internal/check_config_cache.h",
    "internal/display_equivalence.h",
    "internal/layer.cc",
    "internal/layer.h",
    "internal/layer_equivalence.h",
    "util.cc",
    "util.h",
    "vsync_source.cc",
    "vsync_source.h",
    "vsync_source_manager.cc",
    "vsync_source_manager.h",
  ]

  public_deps = [
    ":types",
    "//sdk/fidl/fuchsia.ui.composition.internal:fuchsia.ui.composition.internal_cpp",
    "//sdk/fidl/fuchsia.ui.display.color:fuchsia.ui.display.color_cpp",
    "//sdk/fidl/fuchsia.ui.display.singleton:fuchsia.ui.display.singleton_cpp",
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/fit",
    "//sdk/lib/sys/cpp",
    "//src/lib/fsl",
    "//src/lib/fxl",
    "//src/ui/scenic/lib/utils",
    "//third_party/glm",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/inspect",
    "//zircon/system/ulib/zx",
  ]
  deps = [
    # TODO(https://fxbug.dev/42098803): For displayOwned/NotOwnedSignal.
    # TODO(https://fxbug.dev/42097798): Remove this when we externalize Displays.
    "//src/ui/scenic/lib/allocation",
    "//src/ui/scenic/lib/scheduling:vsync_timing",
    "//zircon/system/public",
    "//zircon/system/ulib/fzl",
    "//zircon/system/ulib/trace",
  ]

  # TODO(https://fxbug.dev/446717362): Scenic also has a display:: namespace.
  assert_no_deps = [ "//src/graphics/display/lib/*" ]
}

