{
    name: "aml-light",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/aml-light.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "gpio-amber-led",
            service: "fuchsia.hardware.gpio.Service",
            bind: { match_name: true },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    { compat: "amlogic,aml-light" },
                    {
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.GPIO_LIGHT",
                    },
                ],
            },
        },
        {
            name: "pwm-amber-led",
            service: "fuchsia.hardware.pwm.Service",
            bind: { match_name: true },
        },
        {
            name: "gpio-green-led",
            service: "fuchsia.hardware.gpio.Service",
            availability: "optional",
            bind: { match_name: true },
        },
        {
            name: "pwm-green-led",
            service: "fuchsia.hardware.pwm.Service",
            availability: "optional",
            bind: { match_name: true },
        },
    ],
}
