import("//build/bind/bind.gni")
import("//build/cipd.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

declare_args() {
  # Toggles between the C++ and Rust driver implementations.
  #
  # TODO(https://fxbug.dev/527195603): Remove the toggle after the Rust port is completed.
  # Valid values: "cpp", "rust"
  goodix_gt92xx_driver_flavor = "cpp"
}

driver_bind_rules("goodix_gt92xx_bind") {
  rules = "meta/goodix-gt92xx.bind"
  bind_output = "goodix-gt92xx.bindbc"
  tests = "meta/goodix-gt92xx-bind-test.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.gpio",
    "//src/devices/bind/fuchsia.platform",
  ]
}

astro_firmware_path =
    "gt9293-astro/GT9293_6105(6E43)_Official_Release_20180917.bin"

fuchsia_cc_driver("driver-cpp") {
  legacy = true
  output_name = "goodix-gt92xx-cpp"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  sources = [
    "cpp/goodix-gt92xx-firmware.cc",
    "cpp/goodix-gt92xx.cc",
  ]
  defines = [ "GT9293_ASTRO_FIRMWARE_PATH=\"$astro_firmware_path\"" ]
  deps = [
    ":goodix_gt92xx_bind",
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_cpp",
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
    "//sdk/lib/driver/mmio/cpp",
    "//src/devices/i2c/lib/i2c-channel-legacy",
    "//src/devices/lib/driver",
    "//src/devices/lib/driver:driver_runtime",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//src/ui/input/lib/hid",
    "//src/ui/input/lib/input-report-reader",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/fzl",
    "//zircon/system/ulib/inspect",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/trace",
    "//zircon/system/ulib/zx",
  ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}

fuchsia_rust_driver("driver-rust") {
  edition = "2024"
  source_root = "rust/src/lib.rs"
  output_name = "goodix-gt92xx-rust"
  with_unit_tests = true
  sources = [
    "rust/src/driver.rs",
    "rust/src/lib.rs",
  ]
  deps = [
    ":goodix_gt92xx_bind",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
    "//sdk/lib/driver/component/rust",
    "//sdk/rust/zx",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_driver_component("component-cpp") {
  info = "meta/goodix-gt92xx-module-info.json"
  component_name = "goodix-gt92xx"
  manifest = "meta/goodix-gt92xx-cpp.cml"
  deps = [ ":driver-cpp" ]
}

fuchsia_driver_component("component-rust") {
  info = "meta/goodix-gt92xx-module-info.json"
  component_name = "goodix-gt92xx"
  manifest = "meta/goodix-gt92xx-rust.cml"
  deps = [ ":driver-rust" ]
}

group("component") {
  if (goodix_gt92xx_driver_flavor == "rust") {
    deps = [ ":component-rust" ]
  } else {
    deps = [ ":component-cpp" ]
  }
}

if (internal_access) {
  resource("astro-firmware") {
    sources = [ "//prebuilt/touch/$astro_firmware_path" ]
    outputs = [ "lib/firmware/$astro_firmware_path" ]
  }
}

# Active Package: always use "goodix-gt92xx" to align with the board
# configuration's dependencies.
fuchsia_driver_package("goodix-gt92xx") {
  export_to_bazel = true
  package_name = "goodix-gt92xx"
  driver_components = [ ":component" ]

  deps = []
  if (internal_access) {
    deps += [ ":astro-firmware" ]
  }
}

group("test") {
  testonly = true
  deps = [ ":goodix-gt92xx-test" ]
}

test("goodix-gt92xx-test") {
  output_name = "goodix-gt92xx-test"
  configs += [ "//build/config:all_source" ]
  sources = [
    "cpp/goodix-gt92xx-firmware-test.cc",
    "cpp/goodix-gt92xx-firmware.cc",
    "cpp/goodix-gt92xx-test.cc",
    "cpp/goodix-gt92xx.cc",
  ]
  defines = [ "GT9293_ASTRO_FIRMWARE_PATH=\"$astro_firmware_path\"" ]
  deps = [
    ":goodix_gt92xx_bind",
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_cpp",
    "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_cpp",
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/async_patterns/testing/cpp",
    "//src/devices/gpio/testing/fake-gpio",
    "//src/devices/i2c/lib/i2c-channel-legacy",
    "//src/devices/i2c/testing/fake-i2c",
    "//src/devices/i2c/testing/mock-i2c:mock-i2c-gtest",
    "//src/devices/lib/driver:driver_runtime",
    "//src/devices/testing/mock-ddk",
    "//src/lib/ddk",
    "//src/lib/ddk:ddk-metadata-headers",
    "//src/lib/ddktl",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
    "//src/ui/input/lib/hid",
    "//src/ui/input/lib/input-report-reader",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/fzl",
    "//zircon/system/ulib/inspect",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/trace",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}

fuchsia_unittest_package("goodix-gt92xx-test-package") {
  package_name = "goodix-gt92xx-test"
  deps = [ ":goodix-gt92xx-test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

# The Rust unit test package: compiled and run in CI/CQ regardless of flavor.
fuchsia_unittest_package("goodix-gt92xx-rust-test-package") {
  package_name = "goodix-gt92xx-rust-test"
  deps = [ ":driver-rust_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":goodix-gt92xx-rust-test-package",
    ":goodix-gt92xx-test-package",
    ":goodix_gt92xx_bind_test",
  ]
}
