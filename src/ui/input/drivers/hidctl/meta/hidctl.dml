{
    name: "hidctl",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/hidctl.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            one_of: [
                { banjo: "fuchsia.test.BIND_PROTOCOL.PARENT" },
                {
                    vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
                    pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.HIDCTL",
                },
            ],
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.hidbus.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.hidbus.Service",
            from: "self",
        },
    ],
}
