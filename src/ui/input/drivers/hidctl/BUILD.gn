import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")
import("//build/testing/cc_test_executable.gni")

fuchsia_driver_dml("hidctl-dml") {
  dml = "meta/hidctl.dml"
  driver_name = "hidctl"
}

driver_bind_rules("hidctl_bind") {
  bind_output = "hidctl.bindbc"
  dml_label = ":hidctl-dml"
  tests = "meta/bind_tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.test",
    "//src/devices/bind/fuchsia.test.platform",
  ]
}

fuchsia_cc_driver("hidctl-driver") {
  legacy = true
  output_name = "hidctl"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  sources = [ "hidctl.cc" ]
  deps = [
    ":hidctl_bind",
    "//sdk/fidl/fuchsia.hardware.hidbus:fuchsia.hardware.hidbus_cpp",
    "//sdk/fidl/fuchsia.hardware.hidctl:fuchsia.hardware.hidctl_cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//src/devices/lib/driver",
    "//src/devices/lib/driver:driver_runtime",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/pretty",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_driver_component("hidctl") {
  dml_label = ":hidctl-dml"
  component_name = "hidctl"
  deps = [ ":hidctl-driver" ]
  info = "meta/hidctl-info.json"
}

cc_test_executable("hidctl-test") {
  testonly = true
  configs += [ "//build/config:all_source" ]
  sources = [
    "hidctl-test.cc",
    "hidctl.cc",
  ]
  deps = [
    ":hidctl_bind",
    "//sdk/fidl/fuchsia.hardware.hidbus:fuchsia.hardware.hidbus_cpp",
    "//sdk/fidl/fuchsia.hardware.hidctl:fuchsia.hardware.hidctl_cpp",
    "//src/devices/testing/mock-ddk",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/pretty",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("hidctl-test-package") {
  deps = [ ":hidctl-test" ]
  test_specs = {
    environments = basic_envs
  }
}

group("tests") {
  testonly = true
  deps = [
    ":hidctl-test-package",
    ":hidctl_bind_test",
  ]
}
