{
    name: "hid",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { banjo: "fuchsia.hid.BIND_PROTOCOL.BUS" },
    },
    capabilities: [
        { service: "fuchsia.hardware.input.Service" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.hidbus.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.input.Service",
            from: "self",
        },
    ],
}
