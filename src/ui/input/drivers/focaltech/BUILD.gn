import("//build/bind/bind.gni")
import("//build/cipd.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

declare_args() {
  # Toggles between the C++ and Rust driver implementations.
  #
  # TODO(https://fxbug.dev/527192080): Remove the toggle after the Rust port is completed.
  # Valid values: "cpp", "rust"
  focaltech_driver_flavor = "cpp"
}

driver_bind_rules("focaltech_touch_bind") {
  rules = "meta/focaltech.bind"
  bind_output = "focaltech.bindbc"
  tests = "meta/bind_tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.focaltech.platform",
    "//src/devices/bind/fuchsia.gpio",
    "//src/devices/bind/fuchsia.platform",
  ]
}

source_set("firmware-sherlock") {
  sources = [ "cpp/ft_firmware_sherlock.cc" ]
  deps = [ ":common" ]
  cflags_cc = [ "-Wno-newline-eof" ]
}

source_set("common") {
  sources = [
    "cpp/ft_device.cc",
    "cpp/ft_device.h",
    "cpp/ft_firmware.cc",
    "cpp/ft_firmware.h",
  ]
  deps = [
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/platform-device/cpp",
    "//src/lib/ddk:ddk_metadata",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_cpp",
    "//sdk/fidl/fuchsia.hardware.input.focaltech:fuchsia.hardware.input.focaltech_cpp",
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//sdk/lib/stdcompat",
    "//src/devices/i2c/lib/i2c-channel",
    "//src/graphics/display/lib/device-protocol-display",
    "//src/ui/input/lib/input-report-reader",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/hwreg",
    "//zircon/system/ulib/inspect",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/trace",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_cc_driver("driver-cpp") {
  output_name = "focaltech-cpp"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  sources = [ "cpp/ft_firmware_none.cc" ]
  deps = [
    ":common",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_cc_driver("driver-cpp-sherlock") {
  output_name = "focaltech-sherlock-cpp"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  deps = [
    ":common",
    "//src/devices/lib/driver:driver_runtime",
  ]

  if (internal_access) {
    deps += [ ":firmware-sherlock" ]
  } else {
    sources = [ "cpp/ft_firmware_none.cc" ]
  }
}

focaltech_rust_shared_sources = [
  "rust/src/driver.rs",
  "rust/src/lib.rs",
]

focaltech_rust_shared_deps = [
  "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
  "//sdk/lib/driver/component/rust",
  "//sdk/rust/zx",
  "//third_party/rust_crates:log",
]

fuchsia_rust_driver("driver-rust") {
  edition = "2024"
  source_root = "rust/src/lib.rs"
  output_name = "focaltech-rust"
  with_unit_tests = true
  sources = focaltech_rust_shared_sources
  deps = focaltech_rust_shared_deps
}

fuchsia_rust_driver("driver-rust-sherlock") {
  edition = "2024"
  source_root = "rust/src/lib.rs"
  output_name = "focaltech-sherlock-rust"
  with_unit_tests = true
  sources = focaltech_rust_shared_sources
  deps = focaltech_rust_shared_deps
}

fuchsia_driver_component("component-cpp") {
  component_name = "focaltech"
  deps = [
    ":driver-cpp",
    ":focaltech_touch_bind",
  ]
  info = "meta/focaltech-info.json"
  manifest = "meta/focaltech-cpp.cml"
}

fuchsia_driver_component("component-sherlock-cpp") {
  component_name = "focaltech-sherlock"
  deps = [
    ":driver-cpp-sherlock",
    ":focaltech_touch_bind",
  ]
  info = "meta/focaltech-sherlock-info.json"
  manifest = "meta/focaltech-sherlock-cpp.cml"
}

fuchsia_driver_component("component-rust") {
  component_name = "focaltech"
  deps = [
    ":driver-rust",
    ":focaltech_touch_bind",
  ]
  info = "meta/focaltech-info.json"
  manifest = "meta/focaltech-rust.cml"
}

fuchsia_driver_component("component-sherlock-rust") {
  component_name = "focaltech-sherlock"
  deps = [
    ":driver-rust-sherlock",
    ":focaltech_touch_bind",
  ]
  info = "meta/focaltech-sherlock-info.json"
  manifest = "meta/focaltech-sherlock-rust.cml"
}

group("component") {
  if (focaltech_driver_flavor == "rust") {
    deps = [ ":component-rust" ]
  } else {
    deps = [ ":component-cpp" ]
  }
}

group("component-sherlock") {
  if (focaltech_driver_flavor == "rust") {
    deps = [ ":component-sherlock-rust" ]
  } else {
    deps = [ ":component-sherlock-cpp" ]
  }
}

# Active Package Generic
fuchsia_driver_package("package") {
  export_to_bazel = true
  package_name = "focaltech"
  driver_components = [ ":component" ]
}

# Active Package Sherlock
fuchsia_driver_package("focaltech-sherlock-package") {
  export_to_bazel = true
  package_name = "focaltech-sherlock"
  driver_components = [ ":component-sherlock" ]
}

test("focaltech-test-bin") {
  output_name = "focaltech-test"
  configs += [ "//build/config:all_source" ]
  sources = [ "cpp/ft_device_test.cc" ]
  deps = [
    ":common",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/fake-platform-device/cpp",
    "//sdk/lib/driver/testing/cpp",
    "//src/devices/gpio/testing/fake-gpio",
    "//src/devices/i2c/testing/fake-i2c",
    "//src/lib/ddk:ddk_metadata",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
  ]
  defines = [ "FT_TEST" ]
}

fuchsia_unittest_package("focaltech-test") {
  deps = [ ":focaltech-test-bin" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

fuchsia_unittest_package("focaltech-rust-test") {
  deps = [ ":driver-rust_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":focaltech-rust-test",
    ":focaltech-test",
    ":focaltech_touch_bind_test",
  ]
}
