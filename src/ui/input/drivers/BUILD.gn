group("drivers") {
  deps = [
    "adc-buttons:bazel_package",
    "buttons",
    "focaltech:component-cpp",
    "focaltech:component-rust",
    "focaltech:component-sherlock-cpp",
    "focaltech:component-sherlock-rust",
    "goodix-gt6853:component-cpp",
    "goodix-gt6853:component-rust",
    "goodix-gt92xx:component-cpp",
    "goodix-gt92xx:component-rust",
    "hid",
    "hid-input-report",
    "hidctl",
    "usb-hid",
    "usb-hid:usb-one-endpoint-hid-fake-usb",
    "usb-hid:usb-two-endpoint-hid-fake-usb",
    "virtio:virtio_input",
  ]
  if (current_cpu == "x64") {
    deps += [ "pc-ps2" ]
  }
}

group("tests") {
  testonly = true

  deps = [
    "adc-buttons:tests",
    "buttons:tests",
    "focaltech:tests",
    "goodix-gt6853:tests",
    "goodix-gt92xx:tests",
    "hid:tests",
    "hid-input-report:tests",
    "hidctl:tests",
    "pc-ps2:tests",
    "usb-hid:tests",
    "virtio:tests",
  ]
}
