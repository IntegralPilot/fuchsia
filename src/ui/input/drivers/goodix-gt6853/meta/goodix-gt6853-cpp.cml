{
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "driver",
        compat: "driver/goodix-gt6853-cpp.so",
        bind: "meta/bind/goodix-gt6853-bind.bindbc",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.ui.input.drivers.goodix-gt6853.device" ],
    },
    use: [
        {
            protocol: [ "fuchsia.scheduler.RoleManager" ],
        },
        { service: "fuchsia.hardware.gpio.Service" },
        { service: "fuchsia.hardware.i2c.Service" },
    ],
}
