            {
                "name": "MicWrongGpioFunction",
                "expected": "abort",
                "device": {
                    "fuchsia.Service": "\"fuchsia.hardware.gpio.Service\"",
                    "fuchsia.NAME": "\"NOT_A_KNOWN_FUNCTION\""
                }
            }
        ]
