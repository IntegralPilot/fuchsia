import("//build/components.gni")
import("//build/test.gni")

source_set("input-report-reader") {
  sources = [
    "reader.cc",
    "reader.h",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
    "//sdk/lib/stdcompat",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/trace",
    "//zircon/system/ulib/zx",
  ]
}

test("unittests") {
  output_name = "input-report-reader-tests"
  sources = [ "reader-test.cc" ]
  deps = [
    ":input-report-reader",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
    "//third_party/googletest:gtest",
    "//zircon/system/public",
    "//zircon/system/ulib/sync:sync-cpp",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_unittest_package("input-report-reader-tests") {
  package_name = "input-report-reader-tests"
  deps = [ ":unittests" ]
}

group("tests") {
  testonly = true
  deps = [ ":input-report-reader-tests" ]
}
