{
    name: "node-group",
    program: {
        binary: "driver/node-group.so",
    },
    use: [
        { protocol: "fuchsia.compat.nodegroup.test.Waiter" },
        {
            name: "a",
            primary: true,
            bind: {
                protocol: "100",
                rules: { "fuchsia.BIND_USB_VID": 20 },
            },
        },
        {
            name: "b",
            bind: { protocol: "20" },
        },
    ],
}
