import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/rust/rustc_test.gni")
import("//build/test.gni")

fidl("fuchsia.rebind.test") {
  testonly = true
  sources = [ "rebind.test.fidl" ]
  public_deps = [ "//zircon/vdso/zx" ]
}

fuchsia_driver_dml("rebind_child-dml") {
  dml = "meta/rebind_child.dml"
  driver_name = "rebind_child"
}

driver_bind_rules("child_bind") {
  testonly = true
  dml_label = ":rebind_child-dml"
  bind_output = "rebind_child.bindbc"
}

fuchsia_cc_driver("child_driver") {
  testonly = true
  output_name = "rebind_child"
  sources = [ "rebind_child.cc" ]
  deps = [
    ":child_bind",
    ":fuchsia.rebind.test_cpp",
    "//sdk/fidl/fuchsia.driver.compat:fuchsia.driver.compat_cpp",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/compat/cpp:symbols",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("child_driver_component") {
  testonly = true
  component_name = "rebind_child"
  dml_label = ":rebind_child-dml"
  deps = [ ":child_driver" ]
  info = "meta/component-info.json"
}

fuchsia_driver_dml("rebind_parent-dml") {
  dml = "meta/rebind_parent.dml"
  driver_name = "rebind_parent"
}

driver_bind_rules("parent_bind") {
  testonly = true
  dml_label = ":rebind_parent-dml"
  bind_output = "rebind_parent.bindbc"
  deps = [ "//src/devices/bind/fuchsia.test" ]
}

fuchsia_cc_driver("parent_driver") {
  testonly = true
  output_name = "rebind_parent"
  sources = [ "rebind_parent.cc" ]
  deps = [
    ":fuchsia.rebind.test_cpp",
    ":parent_bind",
    "//sdk/fidl/fuchsia.driver.compat:fuchsia.driver.compat_cpp",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/compat/cpp:symbols",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//sdk/lib/driver/legacy-bind-constants",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("parent_driver_component") {
  testonly = true
  component_name = "rebind_parent"
  dml_label = ":rebind_parent-dml"
  deps = [ ":parent_driver" ]
  info = "meta/component-info.json"
}

group("drivers") {
  testonly = true
  deps = [
    ":child_driver_component",
    ":parent_driver_component",
  ]
}

rustc_test("rebind_test") {
  edition = "2024"
  testonly = true
  source_root = "test.rs"
  sources = [ "test.rs" ]
  deps = [
    ":fuchsia.rebind.test_rust",
    "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
    "//sdk/fidl/fuchsia.device.fs:fuchsia.device.fs_rust",
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/lib/device-watcher/rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust:rust_no_driver_manager",
    "//sdk/lib/syslog/cpp",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
  ]
}

fuchsia_unittest_package("package") {
  package_name = "rebind_test"
  deps = [
    ":child_driver_component",
    ":parent_driver_component",
    ":rebind_test",
    "//sdk/lib/driver_test_realm:driver_manager_test",
    "//src/devices/misc/drivers/test-parent",
  ]
}

fuchsia_unittest_package("package-rust") {
  package_name = "rebind_test-rustdm"
  deps = [
    ":child_driver_component",
    ":parent_driver_component",
    ":rebind_test",
    "//sdk/lib/driver_test_realm:driver_manager_test_rust",
    "//src/devices/misc/drivers/test-parent",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":package",
    ":package-rust",
  ]
}
