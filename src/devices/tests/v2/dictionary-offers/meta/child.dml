{
    name: "dictionary_offers_child",
    program: {
        binary: "driver/dictionary_offers_child.so",
        service_connect_validation: "true",
        bind: { service: "fuchsia.dictionaryoffers.test.DataService" },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.dictionaryoffers.test.ControlService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.dictionaryoffers.test.DataService",
            generate_bind_rule: false,
        },
    ],
}
