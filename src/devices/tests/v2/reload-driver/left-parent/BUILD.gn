import("//build/drivers.gni")

fuchsia_driver_dml("left_parent-dml") {
  dml = "meta/left_parent.dml"
  driver_name = "left_parent"
}

driver_bind_rules("bind") {
  dml_label = ":left_parent-dml"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/tests/v2/reload-driver/bindlib:fuchsia.reloaddriverbind.test",
  ]
  bind_output = "left_parent.bindbc"
}

fuchsia_cc_driver("driver") {
  testonly = true
  output_name = "reload_test_left_parent_driver"
  sources = [ "left_parent_driver.cc" ]
  deps = [
    ":bind",
    "//src/devices/lib/driver:driver_runtime",
    "//src/devices/tests/v2/reload-driver:driver_helpers",
  ]
}

fuchsia_driver_component("component") {
  dml_label = ":left_parent-dml"
  testonly = true
  component_name = "left_parent"
  deps = [ ":driver" ]
  info = "meta/info.json"
}
