composite child_b;

using fuchsia.reloaddriverbind.test;

primary parent "right" {
  fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY ==
    fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY.TARGET_2;
}

parent "left" {
  fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY ==
    fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY.LEAF;
}
