import("//build/components.gni")
import("//build/rust/rustc_test.gni")

group("tests") {
  testonly = true
  deps = [ ":reload_driver_cross_colocated_test" ]
}

group("drivers") {
  testonly = true
  deps = [
    "drivers/leaf:component",
    "drivers/left-parent:component",
    "drivers/right-parent:component",
    "drivers/root:component",
    "drivers/target:component",
  ]
}

source_set("driver_helpers") {
  testonly = true
  sources = [
    "driver_helpers.cc",
    "driver_helpers.h",
  ]
  public_deps = [
    "//sdk/lib/driver/component/cpp",
    "//src/devices/tests/v2/reload-driver/bindlib:fuchsia.reloaddriverbind.test_cpp",
    "//src/devices/tests/v2/reload-driver/fidl:fuchsia.reloaddriver.test_cpp",
  ]
}

rustc_test("bin") {
  edition = "2024"
  testonly = true
  output_name = "reload_driver_cross_colocated_bin"
  source_root = "test.rs"
  sources = [ "test.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_rust",
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust:rust_no_driver_manager",
    "//sdk/rust/zx",
    "//src/devices/tests/v2/reload-driver:reloadtest_tools",
    "//src/devices/tests/v2/reload-driver/fidl:fuchsia.reloaddriver.test_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_unittest_package("reload_driver_cross_colocated_test") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  deps = [
    ":bin",
    "drivers/leaf:component",
    "drivers/left-parent:component",
    "drivers/right-parent:component",
    "drivers/root:component",
    "drivers/target:component",
    "//sdk/lib/driver_test_realm:driver_manager_test",
    "//sdk/lib/driver_test_realm:driver_test_realm_component",
  ]
}
