{
    name: "leaf",
    program: {
        binary: "driver/runtime-protocol-leaf.so",
        colocate: "true",
        bind: { protocol: "fuchsia.test.BIND_PROTOCOL.DEVICE" },
    },
    use: [
        {
            name: "waiter",
            protocol: "fuchsia.runtime.test.Waiter",
            generate_bind_rule: false,
        },
        {
            name: "service",
            service: "fuchsia.runtime.test.Service",
            generate_bind_rule: false,
        },
    ],
}
