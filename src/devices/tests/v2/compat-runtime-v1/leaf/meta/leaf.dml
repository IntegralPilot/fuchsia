{
    name: "leaf",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/compat-runtime-v1-leaf.so",
        colocate: "true",
        bind: { protocol: "fuchsia.compat.BIND_PROTOCOL.PARENT" },
    },
    use: [
        {
            name: "service",
            service: "fuchsia.compat.runtime.Service",
            generate_bind_rule: false,
        },
    ],
}
