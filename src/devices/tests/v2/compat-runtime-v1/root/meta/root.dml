{
    name: "root",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/compat-runtime-v1-root.so",
        bind: { protocol: "fuchsia.test.BIND_PROTOCOL.PARENT" },
    },
    capabilities: [
        { service: "fuchsia.compat.runtime.Service" },
    ],
    expose: [
        {
            service: "fuchsia.compat.runtime.Service",
            from: "self",
        },
    ],
}
