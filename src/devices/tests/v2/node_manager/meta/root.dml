{
    name: "root",
    program: {
        binary: "driver/nodemanager_root.so",
        bind: {
            rules: { "fuchsia.BIND_PROTOCOL": "fuchsia.test.BIND_PROTOCOL.PARENT" },
        },
    },
    capabilities: [
        { service: "fuchsia.nodemanager.test.Service" },
    ],
    use: [
        { protocol: "fuchsia.driver.framework.NodeManager" },
    ],
    expose: [
        {
            service: "fuchsia.nodemanager.test.Service",
            from: "self",
        },
    ],
}
