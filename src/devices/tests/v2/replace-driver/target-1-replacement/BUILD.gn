import("//build/drivers.gni")

fuchsia_driver_dml("target_1-dml") {
  dml = "meta/target_1.dml"
  driver_name = "target_1"
}

driver_bind_rules("bind") {
  dml_label = ":target_1-dml"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/tests/v2/reload-driver/bindlib:fuchsia.reloaddriverbind.test",
  ]
  bind_output = "target_1.bindbc"
}

fuchsia_cc_driver("driver") {
  testonly = true
  output_name = "replace_test_target_1_driver"
  sources = [ "target_1_driver.cc" ]
  deps = [
    ":bind",
    "//src/devices/lib/driver:driver_runtime",
    "//src/devices/tests/v2/reload-driver:driver_helpers",
  ]
}

fuchsia_driver_component("component") {
  testonly = true
  manifest = "meta/target_1.cml"
  component_name = "target_1_replacement"
  deps = [ ":driver" ]
  info = "meta/info.json"
}
