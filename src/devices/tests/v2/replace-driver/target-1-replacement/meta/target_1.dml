{
    name: "target_1",
    program: {
        binary: "driver/replace_test_target_1_driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        fallback: "true",
        bind: {
            rules: { "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY": "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY.TARGET_1" },
        },
    },
    use: [
        { protocol: "fuchsia.reloaddriver.test.Waiter" },
    ],
}
