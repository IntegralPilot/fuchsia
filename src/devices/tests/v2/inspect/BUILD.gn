import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/rust/rustc_test.gni")
import("//build/test.gni")

group("tests") {
  testonly = true
  deps = [
    ":package",
    ":package-rust",
  ]
}

group("drivers") {
  testonly = true
  deps = [ ":root" ]
}

fidl("fuchsia.inspect.test") {
  testonly = true
  sources = [ "inspect.test.fidl" ]
}

fuchsia_driver_dml("root-dml") {
  dml = "meta/root.dml"
  driver_name = "root"
}

driver_bind_rules("bind") {
  dml_label = ":root-dml"
  bind_output = "root.bindbc"
  deps = [ "//src/devices/bind/fuchsia.test" ]
}

fuchsia_cc_driver("root-driver") {
  legacy = true
  testonly = true
  output_name = "inspect-root"
  sources = [ "root-driver.cc" ]
  deps = [
    ":bind",
    "//src/devices/lib/driver",
    "//src/devices/tests/v2/inspect:fuchsia.inspect.test_cpp",
    "//src/devices/tests/v2/inspect/bind:fuchsia.inspect_cpp",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/inspect",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_driver_component("root") {
  testonly = true
  component_name = "root"
  dml_label = ":root-dml"
  deps = [ ":root-driver" ]
  info = "meta/root-info.json"
}

rustc_test("bin") {
  edition = "2024"
  testonly = true
  output_name = "inspect-bin"
  source_root = "test.rs"
  sources = [ "test.rs" ]
  deps = [
    ":fuchsia.inspect.test_rust",
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/lib/device-watcher/rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust:rust_no_driver_manager",
    "//src/lib/diagnostics/reader/rust",
    "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
  ]
}

fuchsia_unittest_package("package") {
  manifest = "meta/test.cml"
  package_name = "compat-driver-inspect-test"
  deps = [
    ":bin",
    ":root",
    "//sdk/lib/driver_test_realm:driver_manager_test",
    "//src/devices/misc/drivers/test-parent",
  ]
}

fuchsia_unittest_package("package-rust") {
  manifest = "meta/test.cml"
  package_name = "compat-driver-inspect-test-rustdm"
  deps = [
    ":bin",
    ":root",
    "//sdk/lib/driver_test_realm:driver_manager_test_rust",
    "//src/devices/misc/drivers/test-parent",
  ]
}
