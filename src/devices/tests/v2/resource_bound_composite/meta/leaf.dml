{
    name: "leaf",
    program: {
        binary: "driver/resourceboundcomposite_leaf.so",
        service_connect_validation: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        { protocol: "fuchsia.resourceboundcomposite.test.Waiter" },
        {
            name: "left",
            primary: true,
            bind: {
                rules: { "fuchsia.resourceboundcompositebind.test.TEST_DEVICE_TYPE": "fuchsia.resourceboundcompositebind.test.TEST_DEVICE_TYPE.LEFT_SPKR" },
            },
        },
        {
            name: "default",
            service: "fuchsia.resourceboundcomposite.test.Service",
            generate_bind_rule: false,
        },
        {
            name: "right",
            bind: {
                rules: { "fuchsia.resourceboundcompositebind.test.TEST_DEVICE_TYPE": "fuchsia.resourceboundcompositebind.test.TEST_DEVICE_TYPE.RIGHT_SPKR" },
            },
        },
    ],
}
