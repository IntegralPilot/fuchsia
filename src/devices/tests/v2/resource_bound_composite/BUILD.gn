import("//build/components.gni")
import("//build/drivers.gni")
import("//build/rust/rustc_test.gni")
import("//sdk/ctf/build/ctf.gni")

group("tests") {
  testonly = true
  deps = [ ":resourceboundcomposite_test_pkg" ]
}

fidl("fuchsia.resourceboundcomposite.test") {
  testonly = true
  sources = [ "resourceboundcomposite.test.fidl" ]
  public_deps = [ "//zircon/vdso/zx" ]
}

bind_library("fuchsia.resourceboundcompositebind.test") {
  source = "resourceboundcomposite.test.bind"
}

fuchsia_driver_dml("root-dml") {
  dml = "meta/root.dml"
  driver_name = "root"
}

driver_bind_rules("root_bind") {
  dml_label = ":root-dml"
  deps = [ "//src/devices/bind/fuchsia.test" ]
  bind_output = "root.bindbc"
}

fuchsia_cc_driver("root_driver") {
  testonly = true
  output_name = "resourceboundcomposite_root"
  sources = [ "root_driver.cc" ]
  deps = [
    ":fuchsia.resourceboundcomposite.test_cpp",
    ":fuchsia.resourceboundcompositebind.test_cpp",
    ":root_bind",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_cpp",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/component/cpp",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("root") {
  dml_label = ":root-dml"
  testonly = true
  deps = [ ":root_driver" ]
  info = "meta/root_info.json"
}

fuchsia_driver_dml("leaf-dml") {
  dml = "meta/leaf.dml"
  driver_name = "leaf"
}

driver_bind_rules("leaf_bind") {
  dml_label = ":leaf-dml"
  bind_output = "leaf.bindbc"
  deps = [
    ":fuchsia.resourceboundcompositebind.test",
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.platform",
    "//src/devices/bind/fuchsia.test",
  ]
}

fuchsia_cc_driver("leaf_driver") {
  testonly = true
  output_name = "resourceboundcomposite_leaf"
  sources = [ "leaf_driver.cc" ]
  deps = [
    ":fuchsia.resourceboundcomposite.test_cpp",
    ":leaf_bind",
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/driver/component/cpp",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("leaf") {
  dml_label = ":leaf-dml"
  testonly = true
  deps = [ ":leaf_driver" ]
  info = "meta/leaf_info.json"
}

rustc_test("bin") {
  edition = "2024"
  testonly = true
  output_name = "resourceboundcomposite_test_bin"
  source_root = "test.rs"
  sources = [ "test.rs" ]
  deps = [
    ":fuchsia.resourceboundcomposite.test_rust",
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust:rust_no_driver_manager",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test:lib",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_test_component("test_root") {
  testonly = true
  manifest = "meta/test_root.cml"
  deps = [ ":bin" ]
  test_type = "ctf"
}

fuchsia_test_package("resourceboundcomposite_test_pkg") {
  test_components = [ ":test_root" ]
  deps = [
    ":leaf",
    ":root",
    "//sdk/lib/driver_test_realm:driver_manager_test",
    "//sdk/lib/driver_test_realm:driver_test_realm_component",
    "//src/devices/misc/drivers/test-parent",
  ]
}
