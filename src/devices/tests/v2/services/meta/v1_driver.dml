{
    name: "v1_driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/v1_driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { protocol: "fuchsia.test.BIND_PROTOCOL.PARENT" },
    },
    capabilities: [
        { service: "fuchsia.services.test.Device" },
    ],
    expose: [
        {
            service: "fuchsia.services.test.Device",
            from: "self",
        },
    ],
}
