{
    name: "top-b",
    program: {
        binary: "driver/reload_test_nested_top_b_driver.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            rules: { "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY": "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY.NODE_C" },
        },
    },
    use: [
        { protocol: "fuchsia.reloaddriver.test.Waiter" },
    ],
}
