{
    name: "composite-a",
    program: {
        binary: "driver/reload_test_nested_composite_a_driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        { protocol: "fuchsia.reloaddriver.test.Waiter" },
        {
            name: "B",
            primary: true,
            bind: {
                composite_name: "F",
                rules: { "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY": "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY.COMPOSITE_PARENT_B" },
            },
        },
        {
            name: "E",
            bind: {
                rules: { "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY": "fuchsia.reloaddriverbind.test.TEST_BIND_PROPERTY.COMPOSITE_PARENT_E" },
            },
        },
    ],
}
