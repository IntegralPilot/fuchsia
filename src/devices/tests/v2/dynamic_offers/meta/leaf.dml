{
    name: "leaf",
    program: {
        binary: "driver/dynamic_offers_leaf.so",
        bind: { protocol: "fuchsia.test.BIND_PROTOCOL.DEVICE" },
    },
    use: [
        {
            name: "waiter",
            protocol: "fuchsia.offers.test.Waiter",
            generate_bind_rule: false,
        },
        {
            name: "service",
            service: "fuchsia.offers.test.Service",
            generate_bind_rule: false,
        },
    ],
}
