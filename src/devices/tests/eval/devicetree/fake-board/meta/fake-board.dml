{
    name: "fake-board",
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        colocate: "true",
        bind: {
            service: "fuchsia.hardware.platform.bus.Service",
            vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
            pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.TEST",
        },
    },
    use: [
        {
            name: "composite_node_manager",
            protocol: "fuchsia.driver.framework.CompositeNodeManager",
            generate_bind_rule: false,
        },
        {
            name: "platform_bus",
            service: "fuchsia.hardware.platform.bus.Service",
            generate_bind_rule: false,
        },
    ],
}
