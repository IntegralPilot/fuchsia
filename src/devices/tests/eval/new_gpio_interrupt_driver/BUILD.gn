import("//build/components.gni")
import("//build/rust/rustc_test.gni")

group("tests") {
  testonly = true
  deps = [ ":new_gpio_interrupt_driver_test" ]
}

rustc_test("bin") {
  edition = "2024"
  testonly = true
  output_name = "new_gpio_interrupt_driver_test_bin"
  source_root = "test.rs"
  sources = [ "test.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_rust",
    "//sdk/lib/device-watcher/rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust:rust_no_driver_manager",
    "//sdk/rust/zx",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_unittest_package("new_gpio_interrupt_driver_test") {
  deps = [
    ":bin",
    "//sdk/lib/driver_test_realm:driver_manager_test_rust",
    "//sdk/lib/driver_test_realm:driver_test_realm_component",
    "//src/devices/misc/drivers/new_gpio_interrupt_driver:component",
  ]
}
