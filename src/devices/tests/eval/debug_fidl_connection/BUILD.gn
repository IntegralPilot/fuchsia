import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/rust/rustc_test.gni")

group("tests") {
  testonly = true
  deps = [ ":debug_fidl_connection_test" ]
}

driver_bind_rules("bind") {
  rules = "meta/debug_fidl.bind"
  bind_output = "debug_fidl.bindbc"
  deps = [ "//src/devices/bind/fuchsia" ]
}

fuchsia_rust_driver("driver") {
  edition = "2024"
  testonly = true

  output_name = "debug_fidl_driver"
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/lib/driver/component/rust",
    "//sdk/rust/zx",
    "//src/devices/tests/fidl-service:echo_rust",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_driver_component("component") {
  testonly = true
  component_name = "debug_fidl"
  manifest = "meta/debug_fidl.cml"
  deps = [
    ":bind",
    ":driver",
  ]
  info = "meta/component_info.json"
}

rustc_test("bin") {
  edition = "2024"
  testonly = true
  output_name = "debug_fidl_connection_test_bin"
  source_root = "test.rs"
  sources = [ "test.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust:rust_no_driver_manager",
    "//src/devices/tests/fidl-service:echo_rust",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
  ]
}

fuchsia_unittest_package("debug_fidl_connection_test") {
  deps = [
    ":bin",
    ":component",
    "//sdk/lib/driver_test_realm:driver_manager_test_rust",
    "//sdk/lib/driver_test_realm:driver_test_realm_component",
  ]
}
