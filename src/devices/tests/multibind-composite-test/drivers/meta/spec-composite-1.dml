{
    name: "spec-composite-1",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/spec-composite-1.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "node_a",
            primary: true,
            bind: {
                rules: { "multibind.test.NODE_ID": "multibind.test.NODE_ID.A" },
            },
        },
        {
            name: "node_c",
            bind: {
                rules: { "multibind.test.NODE_ID": "multibind.test.NODE_ID.C" },
            },
        },
        {
            name: "node_d",
            bind: {
                rules: { "multibind.test.NODE_ID": "multibind.test.NODE_ID.D" },
            },
        },
    ],
}
