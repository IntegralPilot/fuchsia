{
    name: "spec-composite-2",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/spec-composite-2.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "node_d",
            primary: true,
            bind: {
                rules: { "multibind.test.NODE_ID": "multibind.test.NODE_ID.D" },
            },
        },
        {
            name: "node_b",
            bind: {
                rules: { "multibind.test.NODE_ID": "multibind.test.NODE_ID.B" },
            },
        },
    ],
}
