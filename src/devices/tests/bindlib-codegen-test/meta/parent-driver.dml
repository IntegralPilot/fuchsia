{
    name: "parent-driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/bindlib-codegen-parent.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { banjo: "fuchsia.test.BIND_PROTOCOL.PARENT" },
    },
}
