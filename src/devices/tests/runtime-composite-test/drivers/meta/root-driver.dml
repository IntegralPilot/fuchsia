{
    name: "root-driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/runtime-composite-root-driver.so",
        colocate: "true",
        bind: { banjo: "fuchsia.test.BIND_PROTOCOL.PARENT" },
    },
    capabilities: [
        { service: "fuchsia.runtime.composite.test.Service" },
    ],
    expose: [
        {
            service: "fuchsia.runtime.composite.test.Service",
            from: "self",
        },
    ],
}
