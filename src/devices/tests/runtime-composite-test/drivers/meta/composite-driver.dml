{
    name: "composite-driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/runtime-composite-composite-driver.so",
        colocate: "true",
    },
    use: [
        {
            name: "default",
            service: "fuchsia.runtime.composite.test.Service",
            generate_bind_rule: false,
        },
        {
            name: "test_primary",
            primary: true,
            bind: {
                banjo: "composite.test.lib.BIND_PROTOCOL.VALUE_1",
                rules: { "fuchsia.BIND_USB_VID": "composite.test.lib.BIND_USB_VID.VALUE" },
            },
        },
        {
            name: "child_a",
            bind: { banjo: "composite.test.lib.BIND_PROTOCOL.VALUE_2" },
        },
    ],
}
