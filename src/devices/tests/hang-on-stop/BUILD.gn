import("//build/components.gni")
import("//build/drivers.gni")

driver_bind_rules("hang_on_stop_bind") {
  testonly = true
  rules = "meta/hang_on_stop.bind"
  bind_output = "hang_on_stop.bindbc"
  deps = [ "//src/devices/bind/fuchsia.test" ]
}

fuchsia_rust_driver("hang_on_stop_driver") {
  testonly = true
  edition = "2024"
  output_name = "hang_on_stop"
  source_root = "src/lib.rs"
  sources = [ "src/lib.rs" ]
  deps = [
    ":hang_on_stop_bind",
    "//sdk/lib/driver/component/rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_driver_component("component") {
  testonly = true
  component_name = "hang-on-stop"
  manifest = "meta/hang-on-stop.cml"
  info = "meta/hang-on-stop-info.json"
  deps = [
    ":hang_on_stop_bind",
    ":hang_on_stop_driver",
  ]
}

fuchsia_driver_package("hang_on_stop_package") {
  testonly = true
  package_name = "hang-on-stop"
  driver_components = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":hang_on_stop_package" ]
}
