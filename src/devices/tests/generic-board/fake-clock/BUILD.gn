import("//build/components.gni")
import("//build/drivers.gni")
import("//build/drivers/dml.gni")

fuchsia_driver_dml("fake-clock-dml") {
  dml = "meta/fake-clock.dml"
  driver_name = "fake-clock"
}

driver_bind_rules("fake-clock-bind") {
  dml_label = ":fake-clock-dml"
  bind_output = "fake-clock.bindbc"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.platform",
  ]
}

fuchsia_cc_driver("fake-clock-driver") {
  output_name = "fake-clock"
  sources = [ "fake-clock.cc" ]
  deps = [
    ":fake-clock-bind",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_cpp",
    "//sdk/fidl/fuchsia.hardware.clock:fuchsia.hardware.clock_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//sdk/lib/driver/platform-device/cpp",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("fake-clock-component") {
  component_name = "fake-clock"
  dml_label = ":fake-clock-dml"
  info = "fake-clock-info.json"
  deps = [ ":fake-clock-driver" ]
}
