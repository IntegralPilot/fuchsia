{
    name: "fake-clock",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
    },
    capabilities: [
        { service: "fuchsia.hardware.clock.Service" },
    ],
    use: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            requirements: {
                protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                compat: "fake,clock",
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.clock.Service",
            from: "self",
        },
    ],
}
