import("//build/components.gni")
import("//build/drivers.gni")
import("//build/drivers/dml.gni")

fuchsia_driver_dml("fake-device-dml") {
  dml = "meta/fake-device.dml"
  driver_name = "fake-device"
}

driver_bind_rules("fake-device-bind") {
  dml_label = ":fake-device-dml"
  bind_output = "fake-device.bindbc"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.clock",
    "//src/devices/bind/fuchsia.platform",
  ]
}

fuchsia_cc_driver("fake-device-driver") {
  output_name = "fake-device"
  sources = [ "fake-device.cc" ]
  deps = [
    ":fake-device-bind",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_cpp",
    "//sdk/fidl/fuchsia.hardware.clock:fuchsia.hardware.clock_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//sdk/lib/driver/platform-device/cpp",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("fake-device-component") {
  component_name = "fake-device"
  dml_label = ":fake-device-dml"
  info = "fake-device-info.json"
  deps = [ ":fake-device-driver" ]
}
