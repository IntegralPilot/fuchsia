import("//build/compiled_action.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/drivers/dml.gni")

driver_bind_rules("generic-board-bind") {
  rules = "generic-board.bind"
  bind_output = "generic-board.bindbc"
  deps = [ "//src/devices/bind/fuchsia" ]
}

fuchsia_rust_driver("generic-board-driver") {
  output_name = "generic-board"
  edition = "2024"
  source_root = "src/lib.rs"
  sources = [ "src/lib.rs" ]
  deps = [
    ":generic-board-bind",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_next",
    "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_rust_next",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/lib/driver/component/rust",
    "//sdk/lib/driver/runtime/rust/fidl",
    "//src/devices/board/lib/dml-config",
    "//src/devices/board/lib/dml-config:fuchsia.board.dml.config_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:phf",
  ]
}

fuchsia_driver_component("generic-board-component") {
  component_name = "generic-board"
  manifest = "meta/generic-board.cml"
  info = "meta/generic-board-info.json"
  deps = [ ":generic-board-driver" ]
}

fuchsia_board_dml("gen-board-config") {
  board_name = "fake-board-dml"
  dml = "tests/fake-board.dml"
}

# Resource for the generated config
resource("board-config") {
  sources = [ "$target_gen_dir/board-config.fidl" ]
  outputs = [ "config/board-config.fidl" ]
  deps = [ ":gen-board-config" ]
}

group("drivers") {
  deps = [
    ":generic-board-component",
    "fake-clock:fake-clock-component",
    "fake-device:fake-device-component",
  ]
}

group("tests") {
  testonly = true
  deps = [ "tests:generic-board-test-package" ]
}
