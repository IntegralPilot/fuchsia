{
    name: "fake-board",
    children: [
        {
            name: "clock",
            url: "fuchsia-pkg://fuchsia.com/fake-clock#meta/fake-clock.cm",
            compatible: "fake,clock",
            metadata: [
                {
                    id: "raw-test-id",
                    data: [
                        1,
                        2,
                        3,
                        4,
                    ],
                },
            ],
        },
        {
            name: "device",
            url: "fuchsia-pkg://fuchsia.com/fake-device#meta/fake-device.cm",
            compatible: "fake,device",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#clock",
        },
        {
            name: "my-clock",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock",
            to: "#device",
            constraints: { id: 1 },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#device",
        },
    ],
    metadata_mappings: [
        {
            metadata_id: "fuchsia.hardware.clockimpl.ClockIdsMetadata",
            aggregations: [
                {
                    service: "fuchsia.hardware.clock.Service",
                    field: "clock_nodes",
                    auto_increment: "node_id",
                },
            ],
        },
    ],
}
