import("//build/zircon/zx_library.gni")

group("tests") {
  testonly = true
  deps = [ "tests" ]
}

zx_library("scsi") {
  sdk = "source"
  sdk_headers = [
    "lib/scsi/controller.h",
    "lib/scsi/block-device.h",
  ]
  sources = [
    "block-device.cc",
    "controller.cc",
  ]
  deps = [
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_cpp",
    "//src/devices/block/lib/common",
    "//zircon/third_party/ulib/safemath",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.driver.token:fuchsia.driver.token_cpp",
    "//sdk/fidl/fuchsia.hardware.block.volume:fuchsia.hardware.block.volume_cpp",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//sdk/lib/driver/runtime:driver_runtime_cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/lib/driver:driver_runtime",
    "//src/storage/lib/block_server:block_server_cc",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/hwreg",
    "//zircon/system/ulib/sync:sync-cpp",
    "//zircon/system/ulib/zircon-internal:headers",
  ]
}
