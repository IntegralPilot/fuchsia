group("drivers") {
  deps = [
    "drivers/ahci",
    "drivers/aml-sdmmc",
    "drivers/aml-sdmmc:aml-sdmmc-no-banjo-bazel-package",
    "drivers/cqhci",
    "drivers/ftl",
    "drivers/nvme",
    "drivers/pci-sdhci",
    "drivers/ramdisk",
    "drivers/sdhci",
    "drivers/sdmmc",
    "drivers/ufs",
    "drivers/ums-function",
    "drivers/usb-mass-storage",
    "drivers/virtio:virtio_block",
    "drivers/virtio:virtio_scsi",
  ]
}

group("tests") {
  testonly = true

  deps = [
    "bin:tests",
    "drivers:tests",
    "lib:tests",
    "tests",
  ]
}

group("e2e_tests") {
  testonly = true

  deps = [ "drivers:e2e_tests" ]
}
