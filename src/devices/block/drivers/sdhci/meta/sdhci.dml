{
    name: "sdhci",
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.devices.sdhci.irq" ],
        bind: { service: "fuchsia.hardware.sdhci.Service" },
    },
    capabilities: [
        { service: "fuchsia.hardware.power.PowerTokenService" },
        { service: "fuchsia.hardware.sdmmc.SdmmcMetadata" },
        { service: "fuchsia.hardware.sdmmc.SdmmcService" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            default: false,
            availability: "optional",
        },
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "default",
            service: "fuchsia.hardware.power.PowerTokenService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.sdhci.Service",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.sdmmc.SdmmcMetadata",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.sdmmc.SdmmcMetadata",
            from: "self",
        },
        {
            service: "fuchsia.hardware.sdmmc.SdmmcService",
            from: "self",
        },
    ],
}
