{
    name: "pci-sdhci",
    program: {},
    capabilities: [
        { service: "fuchsia.hardware.sdhci.Service" },
    ],
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                pci: {
                    class: "fuchsia.pci.BIND_PCI_CLASS.GENERIC_SYSTEM_PERIPHERAL",
                    subclass: "0x05",
                    interface: "0x01",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.sdhci.Service",
            from: "self",
        },
    ],
}
