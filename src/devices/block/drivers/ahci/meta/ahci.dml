{
    name: "ahci_bind",
    composite_name: "ahci",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/ahci.so",
    },
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                pci: {
                    class: "fuchsia.pci.BIND_PCI_CLASS.MASS_STORAGE",
                    subclass: "fuchsia.pci.massstorage.BIND_PCI_SUBCLASS.SATA",
                    interface: "0x01",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { protocol: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
}
