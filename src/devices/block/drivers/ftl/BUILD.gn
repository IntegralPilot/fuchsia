import("//build/bind/bind.gni")
import("//build/drivers.gni")

group("tests") {
  testonly = true
  deps = [
    ":ftl_bind_test",
    "tests",
  ]
}

fuchsia_driver_dml("ftl-dml") {
  dml = "meta/ftl.dml"
  driver_name = "ftl"
}

driver_bind_rules("ftl_bind") {
  dml_label = ":ftl-dml"
  bind_output = "ftl.bindbc"
  tests = "meta/bind_tests.json"
  deps = [ "//src/devices/bind/fuchsia.nand" ]
}

fuchsia_cc_driver("ftl-driver") {
  output_name = "ftl"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  deps = [
    ":common",
    ":ftl_bind",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/compat/cpp:logging",
    "//sdk/lib/driver/component/cpp",
    "//zircon/system/ulib/fbl",
  ]
}

fuchsia_driver_component("ftl") {
  component_name = "ftl"
  dml_label = ":ftl-dml"
  deps = [ ":ftl-driver" ]
  info = "meta/ftl-info.json"
}

fuchsia_driver_package("package") {
  package_name = "ftl"
  export_to_bazel = true
  driver_components = [ ":ftl" ]
}

# Also used by ftl-test.
source_set("common") {
  visibility = [ "./*" ]
  configs += [ "//build/config:all_source" ]
  sources = [
    "block_device.cc",
    "metrics.cc",
    "nand_driver.cc",
    "nand_operation.cc",
    "oob_doubler.cc",
  ]
  public_deps = [
    "//sdk/banjo/fuchsia.hardware.badblock:fuchsia.hardware.badblock_banjo_cpp",
    "//sdk/banjo/fuchsia.hardware.nand:fuchsia.hardware.nand_banjo_cpp",
    "//sdk/fidl/fuchsia.driver.token:fuchsia.driver.token_cpp",
    "//sdk/fidl/fuchsia.hardware.block.volume:fuchsia.hardware.block.volume_cpp",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_cpp",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//sdk/lib/fdio",
    "//sdk/lib/fit-promise",
    "//sdk/lib/zbi-format",
    "//src/storage/lib/block_server:block_server_cc",
    "//src/storage/lib/ftl",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/fzl",
    "//zircon/system/ulib/inspect",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/trace",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}
