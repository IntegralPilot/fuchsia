{
    name: "ftl",
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.devices.block.drivers.ftl.device" ],
        bind: {
            protocol: "fuchsia.nand.BIND_PROTOCOL.DEVICE",
            rules: { "fuchsia.BIND_NAND_CLASS": "fuchsia.nand.BIND_NAND_CLASS.FTL" },
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.block.volume.Service" },
    ],
    use: [
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "default",
            service: "fuchsia.driver.compat.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.block.volume.Service",
            from: "self",
        },
    ],
}
