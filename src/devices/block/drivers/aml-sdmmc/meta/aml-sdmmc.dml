{
    name: "aml-sdmmc",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        suspend_enabled: "true",
    },
    capabilities: [
        { service: "fuchsia.hardware.power.PowerTokenService" },
        { service: "fuchsia.hardware.sdmmc.SdmmcService" },
        { service: "fuchsia.hardware.sdmmc.SdmmcMetadata" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
        },
        { protocol: "fuchsia.power.broker.Topology" },
        { protocol: "fuchsia.power.system.ActivityGovernor" },
        { protocol: "fuchsia.power.system.CpuElementManager" },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "clock-gate",
            service: "fuchsia.hardware.clock.Service",
            availability: "optional",
        },
        {
            name: "gpio-reset",
            service: "fuchsia.hardware.gpio.Service",
            availability: "optional",
            bind: { match_name: true },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    {
                        compat: "amlogic,meson-axg-mmc",
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                    },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: [
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.SDMMC_A",
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.SDMMC_B",
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.SDMMC_C",
                        ],
                    },
                ],
            },
        },
        {
            name: "pwm",
            service: "fuchsia.pwm.Init",
            availability: "optional",
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.sdmmc.SdmmcService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.sdmmc.SdmmcMetadata",
            from: "self",
        },
    ],
}
