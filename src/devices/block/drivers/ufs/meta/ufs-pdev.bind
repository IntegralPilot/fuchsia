composite ufs_pdev;

using fuchsia;

primary parent "pdev" {
  fuchsia.COMPATIBLE == "google,ufshc";
}

parent "phy" {
  fuchsia.Service == "fuchsia.hardware.ufs.phy.Service";
}

optional parent "ufs-interconnect" {
  fuchsia.Service == "fuchsia.hardware.interconnect.PathService";
  fuchsia.NAME == "ufs-interconnect";
}
