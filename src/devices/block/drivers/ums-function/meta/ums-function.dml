{
    name: "ums-function",
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            protocol: "fuchsia.usb.BIND_PROTOCOL.FUNCTION",
            usb: {
                class: "fuchsia.usb.BIND_USB_CLASS.MASS_STORAGE",
                subclass: "fuchsia.usb.massstorage.BIND_USB_SUBCLASS.SCSI",
                protocol: "fuchsia.usb.massstorage.BIND_USB_PROTOCOL.BULK_ONLY",
            },
        },
    },
    use: [
        { protocol: "fuchsia.hardware.usb.endpoint.Endpoint" },
        {
            name: "default",
            service: "fuchsia.driver.compat.Service",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.usb.function.UsbFunctionService",
            generate_bind_rule: false,
        },
    ],
}
