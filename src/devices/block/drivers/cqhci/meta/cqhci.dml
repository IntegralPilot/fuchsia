{
    name: "cqhci",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        allowed_scheduler_roles: [ "fuchsia.devices.sdhci.irq" ],
        suspend_enabled: "true",
        bind: { service: "fuchsia.hardware.cqhci.Service" },
    },
    capabilities: [
        { service: "fuchsia.hardware.block.volume.Service" },
        { service: "fuchsia.hardware.rpmb.Service" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            from: "parent",
            key: "suspend_enabled",
            type: "bool",
        },
        { protocol: "fuchsia.power.system.ActivityGovernor" },
        { protocol: "fuchsia.power.system.CpuElementManager" },
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "default",
            service: "fuchsia.hardware.cqhci.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: [
                "fuchsia.hardware.block.volume.Service",
                "fuchsia.hardware.rpmb.Service",
            ],
            from: "self",
        },
    ],
}
