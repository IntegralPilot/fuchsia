{
    name: "skip-block",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            one_of: [
                {
                    banjo: "fuchsia.nand.BIND_PROTOCOL.DEVICE",
                    rules: { "fuchsia.BIND_AUTOBIND": 0 },
                },
                {
                    banjo: "fuchsia.nand.BIND_PROTOCOL.DEVICE",
                    rules: { "fuchsia.BIND_NAND_CLASS": "fuchsia.nand.BIND_NAND_CLASS.BBS" },
                },
            ],
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.skipblock.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.skipblock.Service",
            from: "self",
        },
    ],
}
