{
    name: "nand",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.devices.nand.drivers.nand.device" ],
        bind: { protocol: "fuchsia.rawnand.BIND_PROTOCOL.DEVICE" },
    },
    capabilities: [
        { service: "fuchsia.boot.metadata.PartitionMap" },
    ],
    use: [
        {
            name: "role_manager",
            protocol: "fuchsia.scheduler.RoleManager",
            generate_bind_rule: false,
        },
        {
            name: "partition_map",
            service: "fuchsia.boot.metadata.PartitionMap",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.boot.metadata.PartitionMap",
            from: "self",
        },
    ],
}
