{
    name: "nandpart",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            protocol: "fuchsia.nand.BIND_PROTOCOL.DEVICE",
            rules: { "fuchsia.BIND_NAND_CLASS": "fuchsia.nand.BIND_NAND_CLASS.PARTMAP" },
        },
    },
    use: [
        {
            name: "partition_map",
            service: "fuchsia.boot.metadata.PartitionMap",
            generate_bind_rule: false,
        },
    ],
}
