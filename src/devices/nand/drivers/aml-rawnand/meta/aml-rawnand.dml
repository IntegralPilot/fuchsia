{
    name: "aml-rawnand",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        compat: "driver/aml-rawnand.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.boot.metadata.PartitionMap" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.boot.metadata.PartitionMap",
            generate_bind_rule: false,
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    {
                        compat: "amlogic,meson-g12a-raw-nand",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                    },
                    {
                        banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.RAW_NAND",
                    },
                ],
            },
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
    ],
    expose: [
        {
            service: "fuchsia.boot.metadata.PartitionMap",
            from: "self",
        },
    ],
}
