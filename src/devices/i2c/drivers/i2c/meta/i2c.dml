{
    name: "i2c",
    program: {
        default_dispatcher_scheduler_role: "fuchsia.devices.i2c.drivers.i2c.bus",
        bind: {
            service: "fuchsia.hardware.i2cimpl.Service",
            transport: "Driver",
        },
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        {
            service: "fuchsia.hardware.i2c.Service",
            metadata: {
                id: "fuchsia.hardware.i2c.businfo.I2CBusMetadata",
                schema: {
                    $schema: "http://json-schema.org/draft-07/schema#",
                    type: "object",
                    properties: {
                        bus_id: {
                            type: "integer",
                            fuchsia_type: "provider_id",
                        },
                        channels: {
                            type: "array",
                            items: { $ref: "#/definitions/I2CChannel" },
                        },
                    },
                    required: [ "channels" ],
                    definitions: {
                        I2CChannel: {
                            type: "object",
                            properties: {
                                address: {
                                    type: "integer",
                                    fuchsia_type: "uint16",
                                },
                                id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                name: { type: "string" },
                            },
                            required: [ "address" ],
                        },
                    },
                },
            },
        },
        { service: "fuchsia.hardware.power.PowerTokenService" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            availability: "optional",
            default: false,
        },
        { service: "fuchsia.hardware.i2c.businfo.I2CBusMetadata" },
        {
            service: "fuchsia.hardware.i2cimpl.Service",
            transport: "Driver",
        },
        { service: "fuchsia.hardware.power.PowerTokenService" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.i2c.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
    ],
}
