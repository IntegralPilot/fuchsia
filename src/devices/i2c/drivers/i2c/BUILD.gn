import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

fuchsia_driver_dml("i2c-dml") {
  dml = "meta/i2c.dml"
  driver_name = "i2c"
}

fuchsia_driver_dml_cpp_parser("i2c-metadata") {
  dml_label = ":i2c-dml"
}

driver_bind_rules("i2c_bind") {
  dml_label = ":i2c-dml"
  bind_output = "i2c.bindbc"
  tests = "meta/tests.json"
  deps = [ "//src/devices/bind/fuchsia" ]
}

fuchsia_structured_config_cpp_elf_lib("i2c-config") {
  cm_label = ":i2c-dml_manifest"
}

source_set("common") {
  sources = [
    "i2c-child-server.cc",
    "i2c-child-server.h",
    "i2c.cc",
    "i2c.h",
    "request.cc",
    "request.h",
  ]
  deps = [
    ":i2c-metadata",
    ":i2c_bind",
    "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_cpp",
    "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_cpp",
    "//sdk/fidl/fuchsia.scheduler:fuchsia.scheduler_cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/lib/driver:driver_runtime",
    "//zircon/system/ulib/trace",
    "//zircon/system/ulib/zx",
  ]
  public_deps = [
    ":i2c-config",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_cpp",
    "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_cpp",
    "//sdk/fidl/fuchsia.hardware.i2c.businfo:fuchsia.hardware.i2c.businfo_cpp",
    "//sdk/fidl/fuchsia.hardware.i2cimpl:fuchsia.hardware.i2cimpl_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//sdk/lib/driver/logging/cpp",
  ]
}

fuchsia_cc_driver("i2c-driver") {
  output_name = "i2c"
  deps = [ ":common" ]
}

fuchsia_driver_component("i2c") {
  visibility = [
    ":*",
    "//src/devices/i2c:drivers",
  ]
  component_name = "i2c"
  deps = [ ":i2c-driver" ]
  info = "meta/i2c-info.json"
  cm_label = ":i2c-dml_manifest"
}

fuchsia_driver_package("package") {
  package_name = "i2c"
  driver_components = [ ":i2c" ]
}

test("i2c-test-bin") {
  output_name = "i2c-test"
  configs += [ "//build/config:all_source" ]
  sources = [
    "fake-i2c-impl.cc",
    "fake-i2c-impl.h",
    "i2c-test-env.h",
    "i2c-test.cc",
    "i2c-transaction-test.cc",
  ]
  deps = [
    ":common",
    "//sdk/fidl/fuchsia.scheduler:fuchsia.scheduler_cpp",
    "//sdk/lib/driver/metadata/cpp",
    "//sdk/lib/driver/testing/cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
  ]
}

fuchsia_unittest_package("i2c-test") {
  deps = [ ":i2c-test-bin" ]
  test_specs = {
    environments = basic_envs
    log_settings = {
      # The `BadTransfer` test purposefully triggers an error log.
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":i2c-test",
    ":i2c_bind_test",
  ]
}
