{
    name: "clock",
    program: {
        bind: {
            one_of: [
                { protocol: "fuchsia.clock.BIND_PROTOCOL.IMPL" },
                {
                    service: "fuchsia.hardware.clockimpl.Service",
                    transport: "Driver",
                },
            ],
        },
        default_dispatcher_opts: [ "allow_sync_calls" ],
        colocate: "true",
    },
    capabilities: [
        {
            service: "fuchsia.hardware.clock.Service",
            metadata: {
                id: "fuchsia.hardware.clockimpl.ClockIdsMetadata",
                schema: {
                    $schema: "http://json-schema.org/draft-07/schema#",
                    type: "object",
                    properties: {
                        clock_nodes: {
                            type: "array",
                            items: { $ref: "#/definitions/ClockNodeDescriptor" },
                        },
                    },
                    required: [ "clock_nodes" ],
                    definitions: {
                        ClockNodeDescriptor: {
                            type: "object",
                            properties: {
                                id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                node_id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                name: { type: "string" },
                            },
                            required: [
                                "id",
                                "node_id",
                            ],
                        },
                    },
                },
            },
        },
        { service: "fuchsia.hardware.clock.DebugService" },
    ],
    use: [
        {
            service: "fuchsia.hardware.clockimpl.Service",
            transport: "Driver",
        },
        { service: "fuchsia.hardware.clockimpl.ClockIdsMetadata" },
        { service: "fuchsia.hardware.clockimpl.InitMetadata" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.clock.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.clock.DebugService",
            from: "self",
        },
    ],
}
