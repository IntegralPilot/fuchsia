import("//build/bazel/bazel_fuchsia_test_package.gni")

bazel_fuchsia_test_package("vim3-clk-test") {
  bazel_target = ":vim3-clk-test-package"
  test_component_names = [ "vim3-clk-test-bin" ]
}

if (target_cpu == "arm64") {
  import("//build/bazel/drivers/bazel_driver_package.gni")

  bazel_driver_package("bazel_package") {
    bazel_target = "//src/devices/clock/drivers/vim3-clk:vim3-clk"
    package_name = "vim3-clk"
    inputs = [
      "aml-fclk.h",
      "aml-fclk-rates.cc",
      "meson_gate.cc",
      "meson_gate.h",
      "meson_pll.cc",
      "meson_pll.h",
      "vim3_clk.cc",
      "vim3_clk.h",
    ]
  }
}
