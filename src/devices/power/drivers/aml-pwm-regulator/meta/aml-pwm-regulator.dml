{
    name: "aml-pwm-regulator",
    include: [
        "driver/platform-device.shard.cml",
        "driver_component/driver.shard.cml",
    ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.vreg.Service" },
    ],
    use: [
        {
            name: "pwm",
            service: "fuchsia.hardware.pwm.Service",
            primary: true,
        },
        {
            name: "pdev",
            bind: {
                one_of: [
                    { compat: "amlogic,pwm-regulator" },
                    {
                        banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.PWM_VREG",
                    },
                ],
            },
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.vreg.Service",
            from: "self",
        },
    ],
}
