{
    name: "power",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/power.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { protocol: "fuchsia.power.BIND_PROTOCOL.IMPL" },
    },
    capabilities: [
        { service: "fuchsia.hardware.power.Service" },
    ],
    use: [
        {
            name: "domain_metadata",
            service: "fuchsia.hardware.power.DomainMetadata",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.power.Service",
            from: "self",
        },
    ],
}
