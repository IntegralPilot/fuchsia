{
    name: "nelson-brownout-protection-bind",
    composite_name: "brownout_protection",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/nelson-brownout-protection.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.devices.power.drivers.nelson-brownout-protection" ],
    },
    use: [
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "power-sensor",
            service: "fuchsia.hardware.power.sensor.Service",
            bind: {
                rules: { "fuchsia.ID": "fuchsia.amlogic.platform.s905d3.ID.POWER_SENSOR_DOMAIN_AUDIO" },
            },
        },
        {
            name: "codec",
            service: "fuchsia.hardware.audio.CodecService",
            primary: true,
            bind: { service: "fuchsia.hardware.audio.CodecService" },
        },
        {
            name: "alert-gpio",
            service: "fuchsia.hardware.gpio.Service",
            bind: {
                rules: { "fuchsia.NAME": "alert-gpio" },
            },
        },
        {
            name: "gpio-init",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
    ],
}
