{
    name: "ti-ina231",
    include: [
        "driver/platform-device.shard.cml",
        "driver_component/driver.shard.cml",
    ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.power.sensor.Service" },
    ],
    use: [
        {
            name: "i2c",
            service: "fuchsia.hardware.i2c.Service",
            primary: true,
            bind: {
                rules: { "fuchsia.NAME": "i2c" },
            },
        },
        {
            name: "pdev",
            bind: {
                banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                vid: "fuchsia.ti.platform.BIND_PLATFORM_DEV_VID.TI",
                did: [
                    "fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.INA231_MLB",
                    "fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.INA231_SPEAKERS",
                ],
                rules: { "fuchsia.BIND_PLATFORM_DEV_INSTANCE_ID": 0 },
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.power.sensor.Service",
            from: "self",
        },
    ],
}
