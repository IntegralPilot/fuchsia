{
    name: "fusb302-bind",
    composite_name: "fusb302",
    program: {
        binary: "driver/fusb302.so",
        allowed_scheduler_roles: [ "fuchsia.devices.power.drivers.fusb302.interrupt" ],
    },
    use: [
        {
            name: "gpio-int",
            service: "fuchsia.hardware.gpio.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.gpio.Service",
                rules: { "fuchsia.NAME": "gpio-int" },
            },
        },
        {
            name: "i2c",
            service: "fuchsia.hardware.i2c.Service",
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
    ],
}
