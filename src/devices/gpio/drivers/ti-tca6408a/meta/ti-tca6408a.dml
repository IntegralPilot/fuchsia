{
    name: "ti-tca6408a",
    include: [ "driver/platform-device.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.pinimpl.Service" },
        { service: "fuchsia.hardware.pinimpl.Metadata" },
        { service: "fuchsia.scheduler.RoleName" },
    ],
    use: [
        {
            name: "i2c",
            service: "fuchsia.hardware.i2c.Service",
            primary: true,
            bind: { service: "fuchsia.hardware.i2c.Service" },
        },
        {
            name: "pdev",
            bind: {
                one_of: [
                    { compat: "ti,tca6408a" },
                    {
                        rules: {
                            "fuchsia.BIND_PROTOCOL": "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                            "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.ti.platform.BIND_PLATFORM_DEV_VID.TI",
                            "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.TCA6408A",
                        },
                    },
                ],
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.pinimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.pinimpl.Metadata",
            from: "self",
        },
        {
            service: "fuchsia.scheduler.RoleName",
            from: "self",
        },
    ],
}
