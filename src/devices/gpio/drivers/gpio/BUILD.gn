import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

fuchsia_driver_dml("gpio-dml") {
  dml = "meta/gpio.dml"
  driver_name = "gpio"
}

fuchsia_driver_dml_cpp_parser("gpio-metadata") {
  dml_label = ":gpio-dml"
}

driver_bind_rules("gpio_bind") {
  dml_label = ":gpio-dml"
  bind_output = "gpio.bindbc"
  tests = "meta/bind_tests.json"
  deps = [ "//src/devices/bind/fuchsia" ]
}

fuchsia_structured_config_cpp_elf_lib("gpio-config") {
  cm_label = ":gpio-dml_manifest"
}

source_set("common") {
  sources = [
    "gpio.cc",
    "gpio.h",
  ]
  deps = [
    ":gpio-metadata",
    ":gpio_bind",
    "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_cpp",
    "//sdk/fidl/fuchsia.scheduler:fuchsia.scheduler_cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/driver/node/cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/bind/fuchsia.gpio:fuchsia.gpio_cpp",
    "//src/lib/ddk:ddk_metadata",
    "//zircon/system/ulib/zx",
  ]
  public_deps = [
    ":gpio-config",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_cpp",
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_cpp",
    "//sdk/fidl/fuchsia.hardware.pin:fuchsia.hardware.pin_cpp",
    "//sdk/fidl/fuchsia.hardware.pinimpl:fuchsia.hardware.pinimpl_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//zircon/system/ulib/fbl",
  ]
}

fuchsia_cc_driver("gpio-driver") {
  output_name = "gpio"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  deps = [
    ":common",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("gpio") {
  visibility = [
    ":*",
    "//src/devices/bus/drivers/platform/test:*",
    "//src/devices/gpio:drivers",
  ]
  component_name = "gpio"
  deps = [ ":gpio-driver" ]
  info = "meta/gpio-info.json"
  cm_label = ":gpio-dml_manifest"
}

fuchsia_driver_package("package") {
  package_name = "gpio"
  validate_structured_config = false
  driver_components = [ ":gpio" ]
}

test("gpio-test-bin") {
  output_name = "gpio-test"
  sources = [ "gpio-test.cc" ]
  deps = [
    ":common",
    "//sdk/fidl/fuchsia.hardware.pinimpl:fuchsia.hardware.pinimpl_cpp",
    "//sdk/fidl/fuchsia.scheduler:fuchsia.scheduler_cpp",
    "//sdk/lib/async_patterns/testing/cpp",
    "//sdk/lib/driver/metadata/cpp",
    "//sdk/lib/driver/testing/cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/bind/fuchsia.gpio:fuchsia.gpio_cpp",
    "//src/lib/ddk:ddk_metadata",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
  ]
}

fuchsia_unittest_package("gpio-test") {
  deps = [ ":gpio-test-bin" ]
  test_specs = {
    environments = basic_envs
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":gpio-test",
    ":gpio_bind_test",
  ]
}
