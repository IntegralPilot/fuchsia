{
    name: "gpio",
    program: {
        allowed_scheduler_roles: [ "fuchsia.devices.gpio.drivers.aml-gpio.gpioh" ],
        bind: {
            service: "fuchsia.hardware.pinimpl.Service",
            transport: "Driver",
        },
        default_dispatcher_opts: [ "allow_sync_calls" ],
        colocate: "true",
    },
    capabilities: [
        {
            service: "fuchsia.hardware.gpio.Service",
            metadata: {
                id: "fuchsia.hardware.pinimpl.Metadata",
                schema: {
                    $schema: "http://json-schema.org/draft-07/schema#",
                    type: "object",
                    properties: {
                        controller_id: {
                            type: "integer",
                            fuchsia_type: "provider_id",
                        },
                        pins: {
                            type: "array",
                            items: { $ref: "#/definitions/PinConfig" },
                        },
                        device_pin_states: {
                            type: "array",
                            items: { $ref: "#/definitions/DevicePinStates" },
                        },
                    },
                    required: [ "pins" ],
                    definitions: {
                        Pull: {
                            type: "string",
                            enum: [
                                "Down",
                                "None",
                                "Up",
                            ],
                        },
                        DriveType: {
                            type: "string",
                            enum: [
                                "OpenDrain",
                                "OpenSource",
                                "PushPull",
                            ],
                        },
                        BufferMode: {
                            type: "string",
                            enum: [
                                "Input",
                                "OutputHigh",
                                "OutputLow",
                            ],
                        },
                        PinConfig: {
                            type: "object",
                            properties: {
                                pin: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                name: { type: "string" },
                                function: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                function_name: { type: "string" },
                                drive_strength_ua: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                drive_type: { $ref: "#/definitions/DriveType" },
                                pull: { $ref: "#/definitions/Pull" },
                                buffer_mode: { $ref: "#/definitions/BufferMode" },
                            },
                            required: [ "pin" ],
                        },
                        Configuration: {
                            type: "object",
                            properties: {
                                pull: { $ref: "#/definitions/Pull" },
                                function: {
                                    type: "integer",
                                    fuchsia_type: "uint64",
                                },
                                function_name: { type: "string" },
                                drive_strength_ua: {
                                    type: "integer",
                                    fuchsia_type: "uint64",
                                },
                                drive_type: { $ref: "#/definitions/DriveType" },
                            },
                        },
                        InitCall: {
                            type: "object",
                            properties: {
                                pin_config: { $ref: "#/definitions/Configuration" },
                                buffer_mode: { $ref: "#/definitions/BufferMode" },
                            },
                        },
                        PinConfiguration: {
                            type: "object",
                            properties: {
                                pin: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                call: { $ref: "#/definitions/InitCall" },
                            },
                            required: [
                                "call",
                                "pin",
                            ],
                        },
                        PinState: {
                            type: "object",
                            properties: {
                                name: { type: "string" },
                                pins: {
                                    type: "array",
                                    items: { $ref: "#/definitions/PinConfiguration" },
                                },
                            },
                            required: [
                                "name",
                                "pins",
                            ],
                        },
                        DevicePinStates: {
                            type: "object",
                            properties: {
                                name: { type: "string" },
                                states: {
                                    type: "array",
                                    items: { $ref: "#/definitions/PinState" },
                                },
                            },
                            required: [
                                "name",
                                "states",
                            ],
                        },
                    },
                },
            },
        },
        { service: "fuchsia.hardware.pin.Service" },
        { service: "fuchsia.hardware.pin.PinStatesService" },
        { service: "fuchsia.hardware.power.PowerTokenService" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.driver.ExposeDebugCapabilities",
            key: "expose_debug_capabilities",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            service: "fuchsia.hardware.pinimpl.Service",
            transport: "Driver",
        },
        { service: "fuchsia.hardware.pinimpl.Metadata" },
        { service: "fuchsia.hardware.power.PowerTokenService" },
        { service: "fuchsia.scheduler.RoleName" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.gpio.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.pin.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
    ],
}
