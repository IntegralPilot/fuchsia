{
    name: "interconnect",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        bind: { service: "fuchsia.hardware.interconnect.Service" },
    },
    capabilities: [
        { service: "fuchsia.hardware.interconnect.PathService" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.interconnect.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.interconnect.PathService",
            from: "self",
        },
    ],
}
