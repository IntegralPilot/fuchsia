{
    name: "fake_interconnect",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        bind: { banjo: "fuchsia.test.BIND_PROTOCOL.PARENT" },
    },
    capabilities: [
        { service: "fuchsia.hardware.interconnect.Service" },
    ],
    use: [
        { protocol: "fuchsia.interconnect.test.Waiter" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.interconnect.Service",
            from: "self",
        },
    ],
}
