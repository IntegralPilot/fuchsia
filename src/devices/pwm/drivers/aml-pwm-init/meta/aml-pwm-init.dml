{
    name: "aml-pwm-init",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.clock.Service",
            generate_bind_rule: false,
        },
        {
            name: "gpio-bt",
            service: "fuchsia.hardware.gpio.Service",
            bind: {
                rules: { "fuchsia.NAME": "gpio-bt" },
            },
        },
        {
            name: "pwm",
            service: "fuchsia.hardware.pwm.Service",
            primary: true,
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
    ],
    composite: "aml_pwm_init",
}
