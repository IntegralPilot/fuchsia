{
    name: "pwm",
    program: {
        bind: {
            service: "fuchsia.hardware.pwmimpl.Service",
            transport: "Driver",
        },
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        {
            service: "fuchsia.hardware.pwm.Service",
            metadata: {
                id: "fuchsia.hardware.pwm.PwmChannelsMetadata",
                schema: {
                    $schema: "http://json-schema.org/draft-07/schema#",
                    type: "object",
                    properties: {
                        channels: {
                            type: "array",
                            items: { $ref: "#/definitions/PwmChannelInfo" },
                        },
                    },
                    required: [ "channels" ],
                    definitions: {
                        PwmChannelInfo: {
                            type: "object",
                            properties: {
                                channel: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                name: { type: "string" },
                                period_ns: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                            },
                            required: [
                                "channel",
                                "period_ns",
                            ],
                        },
                    },
                },
            },
        },
    ],
    use: [
        { service: "fuchsia.driver.compat.Service" },
        { service: "fuchsia.hardware.pwm.PwmChannelsMetadata" },
        { service: "fuchsia.hardware.pwmimpl.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.pwm.Service",
            from: "self",
        },
    ],
}
