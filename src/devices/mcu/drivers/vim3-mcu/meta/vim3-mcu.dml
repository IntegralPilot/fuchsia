{
    name: "vim3-mcu",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/vim3-mcu.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.fan.Service" },
    ],
    use: [
        {
            name: "i2c",
            service: "fuchsia.hardware.i2c.Service",
            primary: true,
        },
        {
            name: "mcu",
            bind: {
                one_of: [
                    { compat: "khadas,vim3-mcu" },
                    {
                        vid: "fuchsia.khadas.platform.BIND_PLATFORM_DEV_VID.KHADAS",
                        pid: "fuchsia.khadas.platform.BIND_PLATFORM_DEV_PID.VIM3",
                        did: "fuchsia.khadas.platform.BIND_PLATFORM_DEV_DID.VIM3_MCU",
                    },
                ],
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.fan.Service",
            from: "self",
        },
    ],
}
