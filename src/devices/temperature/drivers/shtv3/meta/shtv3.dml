{
    name: "shtv3",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/shtv3.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            service: "fuchsia.hardware.i2c.Service",
            vid: "fuchsia.sensirion.platform.BIND_PLATFORM_DEV_VID.SENSIRION",
            did: "fuchsia.sensirion.platform.BIND_PLATFORM_DEV_DID.SHTV3",
        },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.i2c.Service",
            generate_bind_rule: false,
        },
    ],
}
