import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

fuchsia_driver_dml("shtv3-dml") {
  dml = "meta/shtv3.dml"
  driver_name = "shtv3"
}

driver_bind_rules("shtv3-bind") {
  bind_output = "shtv3.bindbc"
  dml_label = ":shtv3-dml"
  tests = "meta/shtv3-bind-test.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.sensirion.platform",
  ]
}

source_set("common") {
  public_deps = [
    ":shtv3-bind",
    "//sdk/fidl/fuchsia.hardware.temperature:fuchsia.hardware.temperature_cpp",
    "//src/devices/i2c/lib/i2c-channel-legacy",
    "//src/devices/lib/driver",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_cc_driver("shtv3-driver") {
  legacy = true
  output_name = "shtv3"
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  sources = [ "shtv3.cc" ]
  deps = [ ":common" ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}

fuchsia_driver_component("shtv3") {
  dml_label = ":shtv3-dml"
  info = "meta/shtv3-info.json"
  component_name = "shtv3"
  deps = [ ":shtv3-driver" ]
}

fuchsia_driver_package("package") {
  package_name = "shtv3"
  export_to_bazel = true
  driver_components = [ ":shtv3" ]
}

test("shtv3-test-bin") {
  output_name = "shtv3-test"
  sources = [
    "shtv3-test.cc",
    "shtv3.cc",
  ]
  deps = [
    ":common",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/driver/runtime/testing/cpp",
    "//src/devices/bin/driver_runtime",
    "//src/devices/i2c/testing/fake-i2c",
    "//zircon/system/ulib/zxtest",
  ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}

fuchsia_unittest_package("shtv3-test") {
  deps = [ ":shtv3-test-bin" ]
  test_specs = {
    environments = basic_envs
  }
}

group("tests") {
  testonly = true
  deps = [
    ":shtv3-bind_test",
    ":shtv3-test",
  ]
}
