{
    name: "aml-cpu-legacy",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        colocate: "true",
        compat: "driver/aml-cpu-legacy.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.cpu.ctrl.Service" },
    ],
    use: [
        // The CPU device must bind to a legacy thermal driver to which DVFS commands are forwarded.
        // We need to specify the PLL sensor to ensure the correct bind, as there is a non-legacy thermal
        // device controlling the DDR sensor.
        {
            name: "thermal",
            primary: true,
            bind: {
                banjo: "fuchsia.thermal.BIND_PROTOCOL.DEVICE",
                did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.THERMAL_PLL",
            },
        },
        {
            name: "pdev",
            bind: {
                one_of: [
                    { compat: "google,amlogic-cpu" },
                    {
                        banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.google.platform.BIND_PLATFORM_DEV_VID.GOOGLE",
                        pid: "fuchsia.google.platform.BIND_PLATFORM_DEV_PID.SHERLOCK",
                        did: "fuchsia.google.platform.BIND_PLATFORM_DEV_DID.GOOGLE_AMLOGIC_CPU",
                    },
                ],
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.cpu.ctrl.Service",
            from: "self",
        },
    ],
}
