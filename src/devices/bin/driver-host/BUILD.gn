import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

group("driver-host") {
  deps = [ ":package" ]
}

group("tests") {
  testonly = true
  deps = [ ":driver-host-unittests" ]
}

_bin_common = {
  edition = "2024"

  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust_next",
    "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust_next",
    "//sdk/fidl/fuchsia.data:fuchsia.data_rust",
    "//sdk/fidl/fuchsia.data:fuchsia.data_rust_next",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_next",
    "//sdk/fidl/fuchsia.driver.host:fuchsia.driver.host_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust_next",
    "//sdk/fidl/fuchsia.ldsvc:fuchsia.ldsvc_rust",
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
    "//sdk/fidl/fuchsia.system.state:fuchsia.system.state_rust",
    "//sdk/lib/async/rust/scope_dispatcher",
    "//sdk/lib/driver/component/rust",
    "//sdk/lib/driver/runtime/rust",
    "//sdk/lib/driver/runtime/rust/env",
    "//sdk/lib/driver/runtime/rust/fdf_sys",
    "//sdk/lib/driver/runtime/rust/fidl",
    "//sdk/lib/scheduler/rust",
    "//sdk/rust/zx",
    "//src/devices/lib/driver-host-passive-abi",
    "//src/lib/debug/rust",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/driver_symbols:driver_symbols_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//src/lib/trace/rust:trace-provider",
    "//src/performance/memory/scudo:rust",
    "//src/sys/lib/namespace",
    "//src/sys/lib/stdout-to-debuglog/rust",
    "//src/sys/lib/task-exceptions",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:log",
  ]

  sources = [
    "src/conversion.rs",
    "src/driver.rs",
    "src/driver_host.rs",
    "src/loader.rs",
    "src/main.rs",
    "src/modules.rs",
    "src/utils.rs",
  ]
}

rustc_binary("bin") {
  forward_variables_from(_bin_common, "*")
  output_name = "driver-host"
  configs += [ "//build/config/rust:bootfs" ]
  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
}

rustc_binary("bin_with_heapdump") {
  forward_variables_from(_bin_common, "*")
  output_name = "driver-host-with-heapdump"
  deps += [ "//src/performance/memory/heapdump/instrumentation:autobind" ]
  configs += [ "//build/config/rust:bootfs" ]
  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("component") {
  component_name = "driver_host"
  manifest = "meta/driver_host.cml"
  deps = [ ":bin" ]
}

fuchsia_component("next_component") {
  component_name = "driver_host_next"
  manifest = "meta/driver_host_next.cml"
  deps = [ ":bin" ]
}

fuchsia_component("component_with_heapdump") {
  component_name = "driver_host"
  manifest = "meta/driver_host_with_heapdump.cml"
  deps = [ ":bin_with_heapdump" ]
}

fuchsia_component("next_component_with_heapdump") {
  component_name = "driver_host_next"
  manifest = "meta/driver_host_next_with_heapdump.cml"
  deps = [ ":bin_with_heapdump" ]
}

fuchsia_package("package") {
  package_name = "driver_host"
  deps = [
    ":component",
    ":next_component",
  ]
}

fuchsia_package("package_with_heapdump") {
  package_name = "driver_host"
  deps = [
    ":component_with_heapdump",
    ":next_component_with_heapdump",
  ]
}

# Run with `fx test driver-host-unittests`.
fuchsia_unittest_package("driver-host-unittests") {
  deps = [ ":bin_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
