{
    capabilities: [
        // Note: Given base drivers are implicitly dependent on storage working
        // already, given they're loaded from blobs. Therefore the storage
        // capability here does not create a dependency cycle between storage
        // drivers and file systems.
        {
            storage: "base_driver_persistent_data",
            from: "#fshost",
            subdir: "base_driver_data",
            backing_dir: "data",

            // TODO(https://fxbug.dev/536896503): Move to static instance ID.
            storage_id: "static_instance_id_or_moniker",
        },
    ],
    offer: [
        {
            storage: "base_driver_persistent_data",
            from: "self",
            as: "data",
            to: "#base-drivers",
        },
    ],
}
