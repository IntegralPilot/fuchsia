import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [
    "lib/driver-unit-test/logger.h",
    "lib/driver-unit-test/utils.h",
  ]
  public_deps = [
    # lib/driver-unit-test/logger.h has #include <fbl/string.h>.
    "//zircon/system/ulib/fbl",

    # <lib/driver-unit-test/logger.h> has #include
    # <fidl/fuchsia.driver.test.logger/cpp/fidl.h>
    "//sdk/fidl/fuchsia.driver.test.logger:fuchsia.driver.test.logger_cpp",
  ]
}

source_set("driver-unit-test") {
  sources = [
    "logger.cc",
    "utils.cc",
  ]
  public_deps = [ ":headers" ]
  deps = [
    "//sdk/lib/fidl",
    "//src/lib/ddk",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}

group("tests") {
  testonly = true
  deps = [ "test:tests" ]
}
