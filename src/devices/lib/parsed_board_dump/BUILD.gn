import("//build/rust/rustc_library.gni")

rustc_library("parsed_board_dump") {
  name = "parsed_board_dump"
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/ast.rs",
    "src/compare.rs",
    "src/format.rs",
    "src/lib.rs",
    "src/parse.rs",
  ]

  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:serde_json5",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":parsed_board_dump_test($host_toolchain)" ]
}
