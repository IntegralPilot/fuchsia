{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://fuchsia.googlesource.com/fuchsia/+/refs/heads/main/src/devices/lib/parsed_board_dump/schemas/board-parsed.schema.json",
    "title": "ParsedBoardDump",
    "description": "Standard schema for board topology golden and candidate parsed.json5 files used by dmlc validate-board and other driver tools.",
    "type": "object",
    "properties": {
        "platform_bus_nodes": {
            "type": "array",
            "description": "Hardware devices registered directly with the Platform Bus (MMIOs, IRQs, BTIs, SMCs, Metadata, etc.).",
            "items": {
                "$ref": "#/definitions/PlatformBusNode"
            },
            "default": []
        },
        "board_child_nodes": {
            "type": "array",
            "description": "Direct topological child nodes published by the board driver (e.g. system bus containers, sys, pt).",
            "items": {
                "$ref": "#/definitions/BoardChildNode"
            },
            "default": []
        },
        "composite_node_specs": {
            "type": "array",
            "description": "DFv2 Composite Node Specifications mapping parent bind rules and capability offers.",
            "items": {
                "$ref": "#/definitions/CompositeNodeSpec"
            },
            "default": []
        },
        "iommus": {
            "type": "array",
            "description": "Global IOMMU controllers registered on the board.",
            "items": {
                "$ref": "#/definitions/IommuEntry"
            },
            "default": []
        }
    },
    "additionalProperties": false,
    "definitions": {
        "PropertyValue": {
            "description": "A node or bind property value primitive (non-negative integer, string, or boolean).",
            "oneOf": [
                {
                    "type": "integer",
                    "minimum": 0
                },
                {
                    "type": "string"
                },
                {
                    "type": "boolean"
                }
            ]
        },
        "NodeProperty": {
            "type": "object",
            "description": "A key-value property assigned to a node or parent specification.",
            "properties": {
                "key": {
                    "type": "string",
                    "description": "Property key (e.g., 'fuchsia.BIND_PROTOCOL', 'fuchsia.devicetree.FIRST_COMPATIBLE')."
                },
                "value": {
                    "$ref": "#/definitions/PropertyValue",
                    "description": "Value associated with the key."
                }
            },
            "required": [
                "key",
                "value"
            ],
            "additionalProperties": false
        },
        "BindRule": {
            "type": "object",
            "description": "A condition-based bind rule evaluated against parent node properties.",
            "properties": {
                "key": {
                    "type": "string",
                    "description": "Bind property key to match against (e.g. 'fuchsia.BIND_PLATFORM_DEV_VID')."
                },
                "condition": {
                    "type": "string",
                    "enum": [
                        "Accept",
                        "Reject"
                    ],
                    "description": "Matching evaluation condition."
                },
                "values": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/PropertyValue"
                    },
                    "description": "List of acceptable or rejected values."
                }
            },
            "required": [
                "key",
                "condition",
                "values"
            ],
            "additionalProperties": false
        },
        "ParentSpec": {
            "type": "object",
            "description": "Bind rules and property definitions for one parent of a composite device.",
            "properties": {
                "bind_rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/BindRule"
                    },
                    "description": "List of bind rules this parent must satisfy.",
                    "default": []
                },
                "properties": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/NodeProperty"
                    },
                    "description": "List of properties forwarded or assigned to this parent branch.",
                    "default": []
                }
            },
            "additionalProperties": false
        },
        "CompositeNodeSpec": {
            "type": "object",
            "description": "A multi-parent composite node definition.",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the composite device (e.g. 'dwmac-ff3f0000', 'wifi', 'buttons')."
                },
                "driver_host": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional isolated driver host URL or name."
                },
                "parents": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ParentSpec"
                    },
                    "description": "Ordered list of parent specifications required to bind this composite.",
                    "default": []
                }
            },
            "required": [
                "name"
            ],
            "additionalProperties": false
        },
        "MmioResource": {
            "type": "object",
            "description": "Memory-Mapped I/O register range.",
            "properties": {
                "base": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Physical base address of the MMIO region."
                },
                "length": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Length of the MMIO region in bytes."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional descriptive name for the MMIO bank."
                }
            },
            "additionalProperties": false
        },
        "IrqResource": {
            "type": "object",
            "description": "Platform interrupt request specification.",
            "properties": {
                "number": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Interrupt vector number (e.g. GIC SPI vector)."
                },
                "mode": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Interrupt trigger mode (e.g. 'EDGE_HIGH', 'LEVEL_LOW')."
                },
                "wake_vector": {
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "description": "Whether this interrupt can wake the system from low power states."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional interrupt name."
                },
                "properties": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/NodeProperty"
                    },
                    "description": "Optional properties attached to the interrupt.",
                    "default": []
                }
            },
            "additionalProperties": false
        },
        "BtiResource": {
            "type": "object",
            "description": "Bus Transaction Initiator for DMA transactions.",
            "properties": {
                "iommu_id": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "ID of the associated IOMMU."
                },
                "bti_id": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "BTI client identifier."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional BTI name."
                }
            },
            "additionalProperties": false
        },
        "SmcResource": {
            "type": "object",
            "description": "Secure Monitor Call resource reservation.",
            "properties": {
                "base": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Base SMC function identifier."
                },
                "count": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Number of sequential SMC function IDs."
                },
                "exclusive": {
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "description": "Whether exclusive access to these SMC calls is required."
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional SMC call name."
                }
            },
            "additionalProperties": false
        },
        "BootMetadataResource": {
            "type": "object",
            "description": "ZBI boot metadata item attached to a platform node.",
            "properties": {
                "zbi_type": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Zircon Boot Image (ZBI) item type identifier."
                },
                "zbi_extra": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "ZBI extra parameter."
                }
            },
            "additionalProperties": false
        },
        "MetadataEntry": {
            "type": "object",
            "description": "FIDL type or string-keyed metadata attached to a platform device.",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Metadata identifier (e.g. 'fuchsia.hardware.pinimpl.Metadata')."
                },
                "data_size": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "Byte length of the serialized binary payload."
                },
                "decoded_dictionary": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "description": "Optional decoded key-value representation of the metadata payload.",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "id"
            ],
            "additionalProperties": false
        },
        "PlatformBusNode": {
            "type": "object",
            "description": "Platform bus node registering hardware resources.",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Unique device node name (e.g. 'gpio-controller-ff634400')."
                },
                "vid": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "pid": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "did": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "instance_id": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "interrupt_controller_id": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "driver_host": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "mmios": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/MmioResource"
                    },
                    "default": []
                },
                "irqs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IrqResource"
                    },
                    "default": []
                },
                "btis": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/BtiResource"
                    },
                    "default": []
                },
                "smcs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/SmcResource"
                    },
                    "default": []
                },
                "boot_metadata": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/BootMetadataResource"
                    },
                    "default": []
                },
                "metadata": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/MetadataEntry"
                    },
                    "default": []
                },
                "properties": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/NodeProperty"
                    },
                    "default": []
                }
            },
            "required": [
                "name"
            ],
            "additionalProperties": false
        },
        "BoardChildNode": {
            "type": "object",
            "description": "Non-platform device direct child node.",
            "properties": {
                "name": {
                    "type": "string"
                },
                "driver_host": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "bus_info": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "properties": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/NodeProperty"
                    },
                    "default": []
                }
            },
            "required": [
                "name"
            ],
            "additionalProperties": false
        },
        "IommuEntry": {
            "type": "object",
            "description": "Global board IOMMU instance.",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "description"
            ],
            "additionalProperties": false
        }
    }
}
