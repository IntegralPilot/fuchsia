import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

fuchsia_driver_dml("adc-dml") {
  dml = "meta/adc.dml"
  driver_name = "adc"
}

fuchsia_driver_dml_cpp_parser("adc-metadata") {
  dml_label = ":adc-dml"
}

driver_bind_rules("adc_bind") {
  dml_label = ":adc-dml"
  bind_output = "adc.bindbc"
  tests = "meta/test_bind.json"
  deps = [ "//src/devices/bind/fuchsia" ]
}

source_set("common") {
  sources = [
    "adc.cc",
    "adc.h",
  ]
  deps = [ ":adc-metadata" ]
  public_deps = [
    ":adc_bind",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_cpp",
    "//sdk/fidl/fuchsia.hardware.adc:fuchsia.hardware.adc_cpp",
    "//sdk/fidl/fuchsia.hardware.adcimpl:fuchsia.hardware.adcimpl_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//sdk/lib/driver/mmio/cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/bind/fuchsia.adc:fuchsia.adc_cpp",
    "//src/devices/lib/amlogic",
    "//src/devices/lib/fidl-metadata",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/hwreg",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_cc_driver("adc-driver") {
  output_name = "adc"
  deps = [
    ":common",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("adc") {
  info = "meta/adc-info.json"
  component_name = "adc"
  dml_label = ":adc-dml"
  deps = [ ":adc-driver" ]
}

fuchsia_driver_package("package") {
  package_name = "adc"
  driver_components = [ ":adc" ]
}

test("adc-test-bin") {
  output_name = "adc-test"
  sources = [ "adc-test.cc" ]
  deps = [
    ":common",
    "//sdk/lib/driver/metadata/cpp",
    "//sdk/lib/driver/testing/cpp",
    "//src/lib/fxl/test:gtest_main",
  ]
}

fuchsia_unittest_package("adc-test") {
  deps = [ ":adc-test-bin" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":adc-test",
    ":adc_bind_test",
  ]
}
