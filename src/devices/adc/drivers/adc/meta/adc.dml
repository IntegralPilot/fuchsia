{
    name: "adc",
    program: {
        bind: {
            service: "fuchsia.hardware.adcimpl.Service",
            transport: "Driver",
        },
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        {
            service: "fuchsia.hardware.adc.Service",
            metadata: {
                id: "fuchsia.hardware.adcimpl.Metadata",
                schema: {
                    $schema: "http://json-schema.org/draft-07/schema#",
                    type: "object",
                    properties: {
                        channels: {
                            type: "array",
                            items: { $ref: "#/definitions/AdcChannel" },
                        },
                    },
                    required: [ "channels" ],
                    definitions: {
                        AdcChannel: {
                            type: "object",
                            properties: {
                                channel: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                name: { type: "string" },
                            },
                            required: [ "channel" ],
                        },
                    },
                },
            },
        },
    ],
    use: [
        {
            service: "fuchsia.hardware.adcimpl.Service",
            transport: "Driver",
        },
        { service: "fuchsia.hardware.adcimpl.Metadata" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.adc.Service",
            from: "self",
        },
    ],
}
