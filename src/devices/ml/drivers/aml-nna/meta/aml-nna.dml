{
    name: "aml-nna",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.platform.device.Service" },
        { service: "fuchsia.hardware.vsi.PowerParentService" },
    ],
    use: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    { compat: "amlogic,nna" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.NNA",
                        pid: [
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.A311D",
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.A5",
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.S905D3",
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.T931",
                        ],
                    },
                ],
            },
        },
        {
            name: "register-reset",
            service: "fuchsia.hardware.registers.Service",
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.platform.device.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.vsi.PowerParentService",
            from: "self",
        },
    ],
}
