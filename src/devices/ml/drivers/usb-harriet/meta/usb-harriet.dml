{
    name: "usb-harriet",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/usb-harriet.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            protocol: "fuchsia.usb.BIND_PROTOCOL.INTERFACE",
            usb: {
                vid: "fuchsia.usb.BIND_USB_VID.GOOGLE",
                pid: "fuchsia.usb.BIND_USB_PID.HARRIET",
            },
        },
    },
}
