composite tcs3400_light;

using fuchsia;
using fuchsia.gpio;
using fuchsia.platform;

primary parent "i2c" {
  fuchsia.Service == "fuchsia.hardware.i2c.Service";
}

parent "gpio-int" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "gpio-int";
}

parent "pdev" {
  fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC;
  if fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE {
    fuchsia.COMPATIBLE == "ams,tcs3400";
  } else {
    fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.platform.BIND_PLATFORM_DEV_DID.TCS3400_LIGHT;
  }
}

optional parent "gpio-init-0" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
}

optional parent "pin-states-0" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}

