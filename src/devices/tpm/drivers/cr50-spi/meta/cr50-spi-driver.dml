{
    name: "cr50-spi",
    composite_name: "cr50_spi",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/cr50-spi-driver.so",
    },
    use: [
        {
            name: "acpi",
            primary: true,
            bind: {
                one_of: [
                    {
                        protocol: "fuchsia.acpi.BIND_PROTOCOL.DEVICE",
                        rules: {
                            "fuchsia.BIND_ACPI_BUS_TYPE": "fuchsia.acpi.BIND_ACPI_BUS_TYPE.SPI",
                            "fuchsia.acpi.FIRST_CID": "google,cr50",
                        },
                    },
                ],
            },
        },
        {
            name: "irq000",
            service: "fuchsia.hardware.interrupt.Service",
        },
        {
            service: "fuchsia.hardware.acpi.Service",
            generate_bind_rule: false,
        },
        {
            service: "fuchsia.hardware.spi.Service",
            generate_bind_rule: false,
        },
    ],
}
