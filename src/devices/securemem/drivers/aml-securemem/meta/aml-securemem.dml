{
    name: "aml-securemem",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        compat: "driver/aml-securemem.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.devices.securemem.drivers.aml-securemem.server-loop" ],
    },
    use: [
        {
            name: "pdev",
            primary: true,
            bind: {
                one_of: [
                    { compat: "amlogic,secure-mem" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.SECURE_MEM",
                    },
                ],
            },
        },
        { protocol: "fuchsia.scheduler.RoleManager" },
        { protocol: "fuchsia.hardware.sysmem.Sysmem" },
        {
            name: "tee",
            service: "fuchsia.hardware.tee.Service",
        },
    ],
}
