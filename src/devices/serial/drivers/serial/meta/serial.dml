{
    name: "serial",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            service: "fuchsia.hardware.serialimpl.Service",
            rules: {
                // Don't bind to our own node.
                "fuchsia.BIND_PROTOCOL": { neq: "fuchsia.serial.BIND_PROTOCOL.DEVICE" },
            },
        },
    },
    capabilities: [
        { service: "fuchsia.boot.metadata.MacAddressMetadata" },
        { service: "fuchsia.hardware.power.PowerTokenService" },
        { service: "fuchsia.hardware.serial.Service" },
        { service: "fuchsia.hardware.serialimpl.Service" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            default: false,
            availability: "optional",
        },
        {
            name: "default",
            service: "fuchsia.boot.metadata.MacAddressMetadata",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.power.PowerTokenService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.serialimpl.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.boot.metadata.MacAddressMetadata",
            from: "self",
        },
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.serial.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.serialimpl.Service",
            from: "self",
        },
    ],
}
