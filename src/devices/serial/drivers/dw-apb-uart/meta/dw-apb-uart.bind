composite dw_apb_uart;

using fuchsia.platform;
using fuchsia;
using fuchsia.gpio;

primary parent "pdev" {
  fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC;
  fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE;
  accept fuchsia.COMPATIBLE {
    "goog,goog-dw-apb-uart",
    "snps,dw-apb-uart",
  }
}

parent "baudclk" {
  fuchsia.Service == "fuchsia.hardware.clock.Service";
  fuchsia.NAME == "baudclk";
}

parent "apb_pclk" {
  fuchsia.Service == "fuchsia.hardware.clock.Service";
  fuchsia.NAME == "apb_pclk";
}

parent "reset" {
  fuchsia.Service == "fuchsia.hardware.reset.Service";
  fuchsia.NAME == "reset";
}

parent "power-domain" {
  fuchsia.Service == "fuchsia.hardware.powerdomain.Service";
}

optional parent "gpio-init-0" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
}
