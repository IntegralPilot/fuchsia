{
    name: "uart16550_bind",
    composite_name: "uart16550",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/uart16550.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.serialimpl.Service" },
    ],
    use: [
        {
            name: "acpi",
            primary: true,
            bind: {
                one_of: [
                    {
                        protocol: "fuchsia.acpi.BIND_PROTOCOL.DEVICE",
                        rules: { "fuchsia.acpi.HID": "PNP0501" },
                    },
                ],
            },
        },
        { service: "fuchsia.hardware.acpi.Service" },
        {
            name: "irq000",
            service: "fuchsia.hardware.interrupt.Service",
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.serialimpl.Service",
            from: "self",
        },
    ],
}
