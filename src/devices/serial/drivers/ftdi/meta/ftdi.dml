{
    name: "ftdi",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/ftdi.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            banjo: "fuchsia.usb.BIND_PROTOCOL.INTERFACE",
            rules: {
                "fuchsia.BIND_USB_VID": "fuchsia.usb.BIND_USB_VID.FTDI",
                "fuchsia.BIND_USB_PID": [
                    "fuchsia.usb.BIND_USB_PID.FTDI232H",
                    "fuchsia.usb.BIND_USB_PID.FTDI232R",
                ],
            },
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.i2cimpl.Service" },
        { service: "fuchsia.hardware.serialimpl.Service" },
        { service: "fuchsia.hardware.i2c.businfo.I2CBusMetadata" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.i2cimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.serialimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.i2c.businfo.I2CBusMetadata",
            from: "self",
        },
    ],
}
