{
    name: "virtio_console_bind",
    composite_name: "virtio_console",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/virtio_console.so",
    },
    capabilities: [
        {
            service: [ "fuchsia.hardware.pty.Service" ],
        },
    ],
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                pci: {
                    vid: "fuchsia.pci.BIND_PCI_VID.VIRTIO",
                    did: [
                        "fuchsia.pci.BIND_PCI_DID.VIRTIO_DEV_TYPE_CONSOLE",
                        "fuchsia.pci.BIND_PCI_DID.VIRTIO_DEV_TYPE_T_CONSOLE",
                    ],
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { protocol: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: [ "fuchsia.hardware.pty.Service" ],
            from: "self",
        },
    ],
}
