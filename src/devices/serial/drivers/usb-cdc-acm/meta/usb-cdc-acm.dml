{
    name: "usb-cdc-acm",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/usb-cdc-acm.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        requirements: {
            protocol: "fuchsia.usb.BIND_PROTOCOL.INTERFACE",
            rules: {
                "fuchsia.BIND_USB_CLASS": "fuchsia.usb.BIND_USB_CLASS.COMM",
                "fuchsia.BIND_USB_SUBCLASS": "fuchsia.usb.comm.BIND_USB_SUBCLASS.ABSTRACT",
            },
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.serialimpl.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.serialimpl.Service",
            from: "self",
        },
    ],
}
