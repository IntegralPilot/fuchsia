{
    name: "fake-usb-cdc-acm",
    program: {
        binary: "driver/fake-usb-cdc-acm.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: "meta/bind/usb_cdc_acm_function_bind.bindbc",
        requirements: {
            protocol: "fuchsia.usb.BIND_PROTOCOL.FUNCTION",
            rules: {
                "fuchsia.BIND_USB_CLASS": "fuchsia.usb.BIND_USB_CLASS.COMM",
                "fuchsia.BIND_USB_SUBCLASS": "fuchsia.usb.comm.BIND_USB_SUBCLASS.ABSTRACT",
            },
        },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.usb.function.UsbFunctionService",
            generate_bind_rule: false,
        },
    ],
}
