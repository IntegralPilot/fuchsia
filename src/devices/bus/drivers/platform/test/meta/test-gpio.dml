{
    name: "test-gpio",
    include: [
        "driver/platform-device.shard.cml",
        "driver_component/driver.shard.cml",
    ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        colocate: "true",
        bind: {
            banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
            vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
            pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.PBUS_TEST",
            did: "fuchsia.test.platform.BIND_PLATFORM_DEV_DID.GPIO",
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.pinimpl.Service" },
        { service: "fuchsia.hardware.pinimpl.Metadata" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.platform.device.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.pinimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.pinimpl.Metadata",
            from: "self",
        },
    ],
}
