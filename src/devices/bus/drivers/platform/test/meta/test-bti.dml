{
    name: "test-bti",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        compat: "driver/test-bti.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        host_restart_on_crash: "true",
        bind: {
            vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
            pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.PBUS_TEST",
            did: "fuchsia.test.platform.BIND_PLATFORM_DEV_DID.BTI",
            rules: {
                "fuchsia.resource.BTI_0": "bti-0",
                "fuchsia.resource.BTI_COUNT": 1,
            },
        },
    },
}
