{
    name: "test-composite-node-spec",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        compat: "driver/test-composite-node-spec.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "pdev",
            primary: true,
            bind: {
                composite_name: "composite_node_spec",
                banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
                pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.PBUS_TEST",
                did: "fuchsia.test.platform.BIND_PLATFORM_DEV_DID.COMPOSITE_NODE_SPEC",
            },
        },
        {
            name: "test",
            bind: { banjo: "fuchsia.test.BIND_PROTOCOL.DEVICE" },
        },
    ],
}
