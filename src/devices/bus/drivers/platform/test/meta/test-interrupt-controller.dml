{
    name: "test-interrupt-controller",
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
            vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
            pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.PBUS_TEST",
            did: "fuchsia.test.platform.BIND_PLATFORM_DEV_DID.INTERRUPT_CONTROLLER",
        },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.interrupt.ControllerRegistryService",
            generate_bind_rule: false,
        },
    ],
}
