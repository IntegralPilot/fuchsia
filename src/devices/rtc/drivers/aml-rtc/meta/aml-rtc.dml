{
    name: "aml-rtc",
    include: [
        "driver/platform-device.shard.cml",
        "driver_component/driver.shard.cml",
    ],
    program: {
        bind: {
            banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
            vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
            pid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.A5",
            did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.RTC",
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.rtc.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.rtc.Service",
            from: "self",
        },
    ],
}
