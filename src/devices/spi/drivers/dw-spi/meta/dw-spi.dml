{
    name: "dw-spi",
    include: [ "driver/platform-device.shard.cml" ],
    program: {
        binary: "driver/dw-spi.so",
    },
    capabilities: [
        { service: "fuchsia.hardware.spiimpl.Service" },
        { service: "fuchsia.hardware.spi.businfo.SpiBusMetadata" },
    ],
    use: [
        {
            name: "pdev",
            primary: true,
            bind: { compat: "google,spi" },
        },
        {
            name: "bus",
            service: "fuchsia.hardware.clock.Service",
            bind: {
                rules: { "fuchsia.NAME": "bus" },
            },
        },
        {
            name: "registers",
            service: "fuchsia.hardware.clock.Service",
            bind: {
                rules: { "fuchsia.NAME": "registers" },
            },
        },
        {
            name: "reset",
            service: "fuchsia.hardware.reset.Service",
            bind: {
                rules: { "fuchsia.NAME": "reset" },
            },
        },
        {
            name: "power-domain",
            service: "fuchsia.hardware.powerdomain.Service",
        },
        {
            name: "cs-0",
            service: "fuchsia.hardware.gpio.Service",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "cs-0" },
            },
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "gpio-init-1",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "pin-states-0" },
            },
        },
        {
            name: "pin-states-1",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "pin-states-1" },
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.spiimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.spi.businfo.SpiBusMetadata",
            from: "self",
        },
    ],
}
