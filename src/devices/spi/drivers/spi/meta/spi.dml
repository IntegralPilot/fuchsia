{
    name: "spi",
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [
            "fuchsia.devices.spi.drivers.aml-spi.transaction",
            "fuchsia.devices.spi.drivers.aml-spi.spi1",
            "fuchsia.devices.spi.drivers.msm-spi.spi4",
        ],
        bind: { service: "fuchsia.hardware.spiimpl.Service" },
    },
    capabilities: [
        { service: "fuchsia.hardware.power.PowerTokenService" },
        { service: "fuchsia.hardware.spi.Service" },
        { service: "fuchsia.hardware.spi.TestService" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.driver.ExposeDebugCapabilities",
            key: "expose_debug_capabilities",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.power.PowerTokenService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.spiimpl.Service",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.spi.businfo.SpiBusMetadata",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.scheduler.RoleName",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.spi.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.spi.TestService",
            from: "self",
        },
    ],
}
