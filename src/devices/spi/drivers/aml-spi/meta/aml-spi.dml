{
    name: "aml-spi",
    composite_name: "spi_0",
    include: [ "driver/platform-device.shard.cml" ],
    program: {
        colocate: "true",
    },
    capabilities: [
        { service: "fuchsia.hardware.spiimpl.Service" },
        { service: "fuchsia.hardware.spi.businfo.SpiBusMetadata" },
        { service: "fuchsia.scheduler.RoleName" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.driver.compat.Service",
            generate_bind_rule: false,
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
        {
            name: "gpio-cs-0",
            service: "fuchsia.hardware.gpio.Service",
            primary: true,
            bind: {
                rules: { "fuchsia.NAME": "gpio-cs-0" },
            },
        },
        {
            name: "reset",
            service: "fuchsia.hardware.registers.Service",
        },
        {
            name: "pdev",
            bind: {
                one_of: [
                    { compat: "amlogic,g12a-spi" },
                    {
                        rules: {
                            "fuchsia.BIND_PROTOCOL": "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                            "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                            "fuchsia.BIND_PLATFORM_DEV_PID": "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                            "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.SPI",
                        },
                    },
                ],
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.spiimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.spi.businfo.SpiBusMetadata",
            from: "self",
        },
        {
            service: "fuchsia.scheduler.RoleName",
            from: "self",
        },
    ],
}
