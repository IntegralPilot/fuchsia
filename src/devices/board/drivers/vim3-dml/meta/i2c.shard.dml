{
    children: [
        {
            name: "i2c-5000",
            id: 0,
            compatible: "amlogic,meson-axg-i2c",
        },
        {
            name: "i2c-1c000",
            id: 2,
            compatible: "amlogic,meson-axg-i2c",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#i2c-5000",
            constraints: {
                mmio: [
                    {
                        name: "i2c",
                        address: 0xff805000,
                        size: 0x20,
                    },
                ],
                interrupts: [
                    {
                        name: "primary",
                        number: 227,
                        mode: "EdgeHigh",
                    },
                ],
            },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#i2c-1c000",
            constraints: {
                mmio: [
                    {
                        name: "i2c",
                        address: 0xffd1c000,
                        size: 0x20,
                    },
                ],
                interrupts: [
                    {
                        name: "primary",
                        number: 71,
                        mode: "EdgeHigh",
                    },
                ],
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#i2c-5000",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 87,
                                call: {
                                    pin_config: { function: 1 },
                                },
                            },
                            {
                                pin: 88,
                                call: {
                                    pin_config: { function: 1 },
                                },
                            },
                        ],
                    },
                ],
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#i2c-1c000",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 30,
                                call: {
                                    pin_config: { function: 2 },
                                },
                            },
                            {
                                pin: 31,
                                call: {
                                    pin_config: { function: 2 },
                                },
                            },
                        ],
                    },
                ],
            },
        },
    ],
}
