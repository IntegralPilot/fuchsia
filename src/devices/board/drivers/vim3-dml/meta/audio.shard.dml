{
    children: [
        {
            name: "audio-controller-ff642000",
            url: "fuchsia-pkg://fuchsia.com/aml-g12-composite#meta/aml-g12-composite.cm",
            compatible: "amlogic,audio-controller",
        },
    ],
    offer: [
        {
            name: "clock-gate",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#audio-controller-ff642000",
            constraints: { id: 0x1000b },
        },
        {
            name: "clock-pll",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#audio-controller-ff642000",
            constraints: { id: 0x20002 },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#audio-controller-ff642000",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 67,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 3000,
                                    },
                                },
                            },
                            {
                                pin: 17,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 3000,
                                    },
                                },
                            },
                            {
                                pin: 64,
                                call: {
                                    pin_config: { function: 2 },
                                },
                            },
                            {
                                pin: 65,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 3000,
                                    },
                                },
                            },
                            {
                                pin: 66,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 3000,
                                    },
                                },
                            },
                            {
                                pin: 18,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 3000,
                                    },
                                },
                            },
                            {
                                pin: 19,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 3000,
                                    },
                                },
                            },
                            {
                                pin: 20,
                                call: {
                                    pin_config: { function: 2 },
                                },
                            },
                        ],
                    },
                ],
            },
        },
        {
            name: "gpio-tdm-a-sclk",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-ff634400",
            to: "#audio-controller-ff642000",
            constraints: {
                pin: 67,
                name: "gpio-tdm-a-sclk",
            },
        },
        {
            name: "gpio-tdm-b-sclk",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-ff634400",
            to: "#audio-controller-ff642000",
            constraints: {
                pin: 17,
                name: "gpio-tdm-b-sclk",
            },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#audio-controller-ff642000",
            constraints: {
                mmio: [
                    {
                        name: "audio",
                        address: 0xff642000,
                        size: 0x2000,
                    },
                ],
                btis: [
                    {
                        name: "audio",
                        id: 3,
                    },
                ],
            },
        },
    ],
}
