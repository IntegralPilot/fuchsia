{
    children: [
        {
            name: "gpu-ffe40000",
            url: "fuchsia-pkg://fuchsia.com/aml-gpu#meta/aml-gpu.cm",
            compatible: "amlogic,gpu",
        },
        {
            name: "arm-mali-0",
            url: "fuchsia-pkg://fuchsia.com/msd-arm-mali#meta/msd_arm.cm",
            compatible: "arm,mali-gpu",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#gpu-ffe40000",
            constraints: {
                mmio: [
                    {
                        name: "mali",
                        address: 0xffe40000,
                        size: 0x40000,
                    },
                    {
                        name: "hiu",
                        address: 0xff63c000,
                        size: 0x2000,
                    },
                ],
            },
        },
        {
            name: "aml-gpu",
            service: "fuchsia.hardware.registers.Service",
            from: "#register-controller-1000",
            to: "#gpu-ffe40000",
            constraints: {
                mmio_id: 0,
                masks: [
                    {
                        offset: 0x40,
                        size: 0x4,
                        mask: 0x100000,
                    },
                    {
                        offset: 0x80,
                        size: 0x4,
                        mask: 0x100000,
                    },
                    {
                        offset: 0x48,
                        size: 0x4,
                        mask: 0x4000,
                    },
                    {
                        offset: 0x88,
                        size: 0x4,
                        mask: 0x4000,
                    },
                ],
            },
        },
        {
            name: "mali",
            service: "fuchsia.hardware.gpu.mali.Service",
            from: "#gpu-ffe40000",
            to: "#arm-mali-0",
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#arm-mali-0",
            constraints: {
                mmio: [
                    {
                        name: "mali",
                        address: 0xffe40000,
                        size: 0x40000,
                    },
                ],
                interrupts: [
                    {
                        name: "gpu",
                        number: 194,
                        mode: "LevelHigh",
                    },
                    {
                        name: "mmu",
                        number: 193,
                        mode: "LevelHigh",
                    },
                    {
                        name: "job",
                        number: 192,
                        mode: "LevelHigh",
                    },
                ],
                btis: [
                    {
                        name: "mali",
                        id: 10,
                    },
                ],
            },
        },
    ],
}
