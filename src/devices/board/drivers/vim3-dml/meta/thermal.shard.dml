{
    children: [
        {
            name: "temperature-sensor-ff634800",
            url: "fuchsia-pkg://fuchsia.com/aml-trip#meta/aml-trip.cm",
            compatible: "amlogic,g12a-thermal",
        },
        {
            name: "temperature-sensor-ff634c00",
            url: "fuchsia-pkg://fuchsia.com/aml-trip#meta/aml-trip.cm",
            compatible: "amlogic,g12a-thermal",
        },
    ],
    offer: [
        {
            name: "clock-init",
            service: "fuchsia.clock.Init",
            from: "#clock-controller-ff63c000",
            to: "#temperature-sensor-ff634800",
        },
        {
            name: "clock-init",
            service: "fuchsia.clock.Init",
            from: "#clock-controller-ff63c000",
            to: "#temperature-sensor-ff634c00",
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#temperature-sensor-ff634800",
            constraints: {
                mmio: [
                    {
                        name: "pll",
                        address: 0xff634800,
                        size: 0x80,
                    },
                    {
                        name: "trim",
                        address: 0xff800268,
                        size: 0x4,
                    },
                ],
                interrupts: [
                    {
                        name: "thermal",
                        number: 67,
                        mode: "EdgeHigh",
                    },
                ],
            },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#temperature-sensor-ff634c00",
            constraints: {
                mmio: [
                    {
                        name: "ddr",
                        address: 0xff634c00,
                        size: 0x80,
                    },
                    {
                        name: "trim",
                        address: 0xff800230,
                        size: 0x4,
                    },
                ],
                interrupts: [
                    {
                        name: "thermal",
                        number: 68,
                        mode: "EdgeHigh",
                    },
                ],
            },
        },
    ],
}
