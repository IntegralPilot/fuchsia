{
    children: [
        {
            name: "register-controller-1000",
            url: "fuchsia-pkg://fuchsia.com/registers#meta/registers.cm",
            compatible: "fuchsia,registers",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#register-controller-1000",
            constraints: {
                mmio: [
                    {
                        name: "registers",
                        address: 0xffd01000,
                        size: 0x100,
                    },
                ],
            },
        },
    ],
}
