{
    children: [
        {
            name: "rtc-51",
            url: "fuchsia-pkg://fuchsia.com/pcf8563#meta/component.cm",
            compatible: "nxp,pcf8563",
        },
    ],
    offer: [
        {
            name: "rtc-51",
            service: "fuchsia.hardware.i2c.Service",
            from: "#i2c-5000",
            to: "#rtc-51",
            constraints: { address: 0x51 },
        },
    ],
}
