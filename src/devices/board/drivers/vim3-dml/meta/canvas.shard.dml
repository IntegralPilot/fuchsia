{
    children: [
        {
            name: "canvas-ff638000",
            url: "fuchsia-pkg://fuchsia.com/aml-canvas#meta/aml-canvas.cm",
            compatible: "amlogic,canvas",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#canvas-ff638000",
            constraints: {
                mmio: [
                    {
                        name: "canvas",
                        address: 0xff638000,
                        size: 0x2000,
                    },
                ],
                btis: [
                    {
                        name: "canvas",
                        id: 12,
                    },
                ],
            },
        },
    ],
}
