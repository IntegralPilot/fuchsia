{
    children: [
        {
            name: "cpu-controller-0",
            url: "fuchsia-pkg://fuchsia.com/aml-cpu#meta/aml-cpu.cm",
            compatible: "amlogic,cpu",
        },
    ],
    offer: [
        {
            name: "power-01",
            service: "fuchsia.hardware.power.Service",
            from: "#power-controller",
            to: "#cpu-controller-0",
            constraints: { domain: 0 },
        },
        {
            name: "sys-cpu-div16",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#cpu-controller-0",
            constraints: { id: 0x10001 },
        },
        {
            name: "sys-cpu-big-clk",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#cpu-controller-0",
            constraints: { id: 1048576 },
        },
        {
            name: "sys-cpub-div16",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#cpu-controller-0",
            constraints: { id: 0x10004 },
        },
        {
            name: "sys-cpu-little-clk",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#cpu-controller-0",
            constraints: { id: 1048577 },
        },
        {
            name: "sys-pll-div16",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#cpu-controller-0",
            constraints: { id: 0x10000 },
        },
        {
            name: "sys-pllb-div16",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#cpu-controller-0",
            constraints: { id: 0x10003 },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#cpu-controller-0",
            constraints: {
                mmio: [
                    {
                        name: "control",
                        address: 0xff800000,
                        size: 0x1000,
                    },
                ],
            },
        },
        {
            name: "power-02",
            service: "fuchsia.hardware.power.Service",
            from: "#power-controller",
            to: "#cpu-controller-0",
            constraints: { domain: 1 },
        },
    ],
}
