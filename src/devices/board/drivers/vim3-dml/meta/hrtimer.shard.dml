{
    children: [
        {
            name: "hrtimer-0",
            url: "fuchsia-pkg://fuchsia.com/hrtimer#meta/hrtimer.cm",
            compatible: "amlogic,hrtimer",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#hrtimer-0",
            constraints: {
                mmio: [
                    {
                        name: "timer",
                        address: 0xffd00000,
                        size: 0x10000,
                    },
                ],
                interrupts: [
                    {
                        name: "timer-a",
                        number: 42,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "timer-b",
                        number: 43,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "timer-c",
                        number: 38,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "timer-d",
                        number: 61,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "timer-f",
                        number: 92,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "timer-g",
                        number: 93,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "timer-h",
                        number: 94,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "timer-i",
                        number: 95,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                ],
            },
        },
    ],
}
