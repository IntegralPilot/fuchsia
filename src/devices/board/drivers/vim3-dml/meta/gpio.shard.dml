{
    children: [
        {
            name: "gpio-controller-ff634400",
            compatible: "amlogic,meson-g12a-gpio",
        },
        {
            name: "gpio-controller-20",
            url: "fuchsia-pkg://fuchsia.com/ti-tca6408a#meta/ti-tca6408a.cm",
            compatible: "ti,tca6408a",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#gpio-controller-ff634400",
            constraints: {
                mmio: [
                    {
                        name: "gpio",
                        address: 0xff634400,
                        size: 0x400,
                    },
                    {
                        name: "gpio-ao",
                        address: 0xff800000,
                        size: 0x1000,
                    },
                    {
                        name: "gpio-interrupt",
                        address: 0xffd00000,
                        size: 0x10000,
                    },
                ],
                interrupts: [
                    {
                        name: "0",
                        number: 96,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                    {
                        name: "1",
                        number: 97,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "2",
                        number: 98,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "3",
                        number: 99,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "4",
                        number: 100,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "5",
                        number: 101,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "6",
                        number: 102,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "7",
                        number: 103,
                        mode: "EdgeHigh",
                    },
                ],
            },
        },
        {
            name: "gpio-controller-20",
            service: "fuchsia.hardware.i2c.Service",
            from: "#i2c-5000",
            to: "#gpio-controller-20",
            constraints: { address: 0x20 },
        },
        {
            name: "gpio-header-pin-37",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-ff634400",
            to: "parent",
            constraints: {
                pin: 80,
                name: "GPIO_HEADER_PIN_37",
            },
        },
    ],
}
