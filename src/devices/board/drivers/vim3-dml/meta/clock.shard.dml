{
    children: [
        {
            name: "clock-controller-ff63c000",
            url: "fuchsia-pkg://fuchsia.com/vim3-clk#meta/vim3-clk.cm",
            compatible: "amlogic,g12b-clk",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#clock-controller-ff63c000",
            constraints: {
                mmio: [
                    {
                        name: "hhi",
                        address: 0xff63c000,
                        size: 0x2000,
                    },
                    {
                        name: "apb",
                        address: 0xff620000,
                        size: 0x10000,
                    },
                    {
                        name: "msr",
                        address: 0xffd18000,
                        size: 0x1000,
                    },
                ],
            },
        },
    ],
}
