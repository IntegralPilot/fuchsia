{
    children: [
        {
            name: "bt-uart-ffd24000",
            url: "fuchsia-pkg://fuchsia.com/aml-uart#meta/aml-uart.cm",
            compatible: "amlogic,bt-uart",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#bt-uart-ffd24000",
            constraints: {
                mmio: [
                    {
                        address: 0xffd24000,
                        size: 0x18,
                    },
                ],
                interrupts: [
                    {
                        name: "primary",
                        number: 58,
                        mode: "EdgeHigh",
                        wake_vector: true,
                    },
                ],
                boot_metadata: [
                    {
                        zbi_type: 0x43414d6d,
                        zbi_extra: 0,
                    },
                ],
            },
        },
        {
            name: "pwm-ffd1b000",
            service: "fuchsia.pwm.Init",
            from: "#pwm-init",
            to: "#bt-uart-ffd24000",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#bt-uart-ffd24000",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 68,
                                call: {
                                    pin_config: { function: 1 },
                                },
                            },
                            {
                                pin: 69,
                                call: {
                                    pin_config: { function: 1 },
                                },
                            },
                            {
                                pin: 70,
                                call: {
                                    pin_config: { function: 1 },
                                },
                            },
                            {
                                pin: 71,
                                call: {
                                    pin_config: { function: 1 },
                                },
                            },
                        ],
                    },
                ],
            },
        },
    ],
}
