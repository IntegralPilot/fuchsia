{
    name: "vim3",
    include: [
        "adc.shard.dml",
        "audio.shard.dml",
        "bluetooth.shard.dml",
        "buttons.shard.dml",
        "canvas.shard.dml",
        "clock.shard.dml",
        "cpu.shard.dml",
        "display.shard.dml",
        "dt-root.shard.dml",
        "ethernet.shard.dml",
        "gic.shard.dml",
        "gpio.shard.dml",
        "gpu.shard.dml",
        "hrtimer.shard.dml",
        "i2c.shard.dml",
        "mcu.shard.dml",
        "nna.shard.dml",
        "power.shard.dml",
        "pwm.shard.dml",
        "registers.shard.dml",
        "rtc.shard.dml",
        "sdmmc.shard.dml",
        "suspend.shard.dml",
        "thermal.shard.dml",
        "usb.shard.dml",
        "video.shard.dml",
        "wifi.shard.dml",
    ],
    program: {
        driver_name: "vim3-dml",
        bind: {
            service: "fuchsia.hardware.platform.bus.Service",
            transport: "Driver",
            vid: "fuchsia.khadas.platform.BIND_PLATFORM_DEV_VID.KHADAS",
            pid: "fuchsia.khadas.platform.BIND_PLATFORM_DEV_PID.VIM3",
        },
    },
    metadata_mappings: [
        {
            metadata_id: "fuchsia.hardware.pinimpl.Metadata",
            aggregations: [
                {
                    service: "fuchsia.hardware.gpio.Service",
                    field: "pins",
                },
                {
                    service: "fuchsia.hardware.pin.PinStatesService",
                    field: "device_pin_states",
                    use_node_name: true,
                },
            ],
        },
        {
            metadata_id: "fuchsia.hardware.adcimpl.Metadata",
            aggregations: [
                {
                    service: "fuchsia.hardware.adc.Service",
                    field: "channels",
                },
            ],
        },
        {
            metadata_id: "fuchsia.hardware.clockimpl.ClockIdsMetadata",
            aggregations: [
                {
                    service: "fuchsia.hardware.clock.Service",
                    field: "clock_nodes",
                    auto_increment: "node_id",
                },
            ],
        },
        {
            metadata_id: "fuchsia.hardware.i2c.businfo.I2CBusMetadata",
            aggregations: [
                {
                    service: "fuchsia.hardware.i2c.Service",
                    field: "channels",
                },
            ],
        },
        {
            metadata_id: "fuchsia.hardware.registers.Metadata",
            aggregations: [
                {
                    service: "fuchsia.hardware.registers.Service",
                    field: "registers",
                },
            ],
        },
    ],
}
