{
    children: [
        {
            name: "nna-ff100000",
            url: "fuchsia-pkg://fuchsia.com/aml-nna#meta/aml-nna.cm",
            compatible: "amlogic,nna",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#nna-ff100000",
            constraints: {
                mmio: [
                    {
                        name: "nna",
                        address: 0xff100000,
                        size: 0x30000,
                    },
                    {
                        name: "hiu",
                        address: 0xff63c000,
                        size: 0x2000,
                    },
                    {
                        name: "power",
                        address: 0xff800000,
                        size: 0x1000,
                    },
                    {
                        name: "memory-pd",
                        address: 0xff63c000,
                        size: 0x1000,
                    },
                    {
                        name: "sram",
                        address: 0xff000000,
                        size: 0x100000,
                    },
                ],
                interrupts: [
                    {
                        name: "nna",
                        number: 179,
                        mode: "LevelHigh",
                    },
                ],
                btis: [
                    {
                        name: "nna",
                        id: 11,
                    },
                ],
            },
        },
        {
            name: "nna_reset_level2",
            service: "fuchsia.hardware.registers.Service",
            from: "#register-controller-1000",
            to: "#nna-ff100000",
            constraints: {
                mmio_id: 0,
                masks: [
                    {
                        offset: 0x88,
                        size: 0x4,
                        mask: 0x1000,
                    },
                ],
            },
        },
    ],
}
