{
    children: [
        {
            name: "pwm-init",
            url: "fuchsia-pkg://fuchsia.com/aml-pwm-init#meta/aml-pwm-init.cm",
        },
        {
            name: "pwm-ffd1b000",
            url: "fuchsia-pkg://fuchsia.com/aml-pwm#meta/aml-pwm.cm",
            compatible: "amlogic,meson-g12a-ee-pwm",
        },
        {
            name: "pwm_a-regulator",
            url: "fuchsia-pkg://fuchsia.com/aml-pwm-regulator#meta/aml-pwm-regulator.cm",
            compatible: "amlogic,pwm-regulator",
        },
        {
            name: "pwm_a0_d-regulator",
            url: "fuchsia-pkg://fuchsia.com/aml-pwm-regulator#meta/aml-pwm-regulator.cm",
            compatible: "amlogic,pwm-regulator",
        },
    ],
    offer: [
        {
            name: "pwm-ffd1b000",
            service: "fuchsia.hardware.pwm.Service",
            from: "#pwm-ffd1b000",
            to: "#pwm-init",
            constraints: {
                controller: "pwm-ffd1b000",
                channel: 4,
                period_ns: 0,
            },
        },
        {
            name: "gpio-bt",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-ff634400",
            to: "#pwm-init",
            constraints: {
                pin: 73,
                name: "gpio-bt",
            },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#pwm-ffd1b000",
            constraints: {
                mmio: [
                    {
                        name: "pwm_ab",
                        address: 0xffd1b000,
                        size: 0x1000,
                    },
                    {
                        name: "pwm_cd",
                        address: 0xffd1a000,
                        size: 0x1000,
                    },
                    {
                        name: "pwm_ef",
                        address: 0xffd19000,
                        size: 0x1000,
                    },
                    {
                        name: "ao_pwm_ab",
                        address: 0xff807000,
                        size: 0x1000,
                    },
                    {
                        name: "ao_pwm_cd",
                        address: 0xff802000,
                        size: 0x1000,
                    },
                ],
            },
        },
        {
            name: "pwm",
            service: "fuchsia.hardware.pwm.Service",
            from: "#pwm-ffd1b000",
            to: "#pwm_a-regulator",
            constraints: {
                channel: 0,
                period_ns: 1250,
            },
        },
        {
            name: "pwm",
            service: "fuchsia.hardware.pwm.Service",
            from: "#pwm-ffd1b000",
            to: "#pwm_a0_d-regulator",
            constraints: {
                channel: 9,
                period_ns: 1250,
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#pwm-init",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 72,
                                call: {
                                    pin_config: { function: 1 },
                                },
                            },
                        ],
                    },
                ],
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#pwm-ffd1b000",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 98,
                                call: {
                                    pin_config: { function: 3 },
                                },
                            },
                            {
                                pin: 98,
                                call: { buffer_mode: "OutputLow" },
                            },
                            {
                                pin: 99,
                                call: {
                                    pin_config: { function: 3 },
                                },
                            },
                            {
                                pin: 99,
                                call: { buffer_mode: "OutputLow" },
                            },
                        ],
                    },
                ],
            },
        },
    ],
}
