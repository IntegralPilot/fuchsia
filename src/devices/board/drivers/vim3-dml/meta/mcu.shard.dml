{
    children: [
        {
            name: "khadas-mcu-18",
            url: "fuchsia-pkg://fuchsia.com/vim3-mcu#meta/vim3-mcu.cm",
            compatible: "khadas,vim3-mcu",
        },
    ],
    offer: [
        {
            name: "khadas-mcu-18",
            service: "fuchsia.hardware.i2c.Service",
            from: "#i2c-5000",
            to: "#khadas-mcu-18",
            constraints: { address: 0x18 },
        },
    ],
}
