{
    children: [
        {
            name: "display-ff900000",
            url: "fuchsia-pkg://fuchsia.com/amlogic-display#meta/amlogic-display.cm",
            compatible: "amlogic,display",
        },
    ],
    offer: [
        {
            name: "canvas",
            service: "fuchsia.hardware.amlogiccanvas.Service",
            from: "#canvas-ff638000",
            to: "#display-ff900000",
            constraints: {},
        },
        {
            name: "gpio-hdmi-hotplug-detect",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-ff634400",
            to: "#display-ff900000",
            constraints: {
                controller: "gpio-controller-ff634400",
                pin: 78,
                name: "gpio-hdmi-hotplug-detect",
                pull: "Down",
                buffer_mode: "Input",
            },
        },
        {
            name: "gpio-lcd-reset",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-20",
            to: "#display-ff900000",
            constraints: {
                controller: "gpio-controller-20",
                pin: 0,
                name: "gpio-lcd-reset",
            },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#display-ff900000",
            constraints: {
                mmio: [
                    {
                        name: "vpu",
                        address: 0xff900000,
                        size: 0x40000,
                    },
                    {
                        name: "dsi-top",
                        address: 0xffd073c0,
                        size: 0x40,
                    },
                    {
                        name: "dsi-phy",
                        address: 0xff644000,
                        size: 0x2000,
                    },
                    {
                        name: "dsi-controller",
                        address: 0xffd07000,
                        size: 0x1000,
                    },
                    {
                        name: "hhi",
                        address: 0xff63c000,
                        size: 0x2000,
                    },
                    {
                        name: "always-on-rti",
                        address: 0xff800000,
                        size: 0x1000,
                    },
                    {
                        name: "ee-reset",
                        address: 0xffd01000,
                        size: 0x100,
                    },
                    {
                        name: "gpio-mux",
                        address: 0xff634400,
                        size: 0x400,
                    },
                    {
                        name: "hdmitx-controller",
                        address: 0xff600000,
                        size: 0x8000,
                    },
                    {
                        name: "hdmitx-top",
                        address: 0xff608000,
                        size: 0x8000,
                    },
                ],
                interrupts: [
                    {
                        name: "viu1-vsync",
                        number: 35,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "rdma-done",
                        number: 121,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "vdin1-write-done",
                        number: 118,
                        mode: "EdgeHigh",
                    },
                ],
                btis: [
                    { id: 0x0d },
                ],
                smcs: [
                    {
                        service_call_num_base: 0x02,
                        count: 1,
                        exclusive: false,
                    },
                ],
            },
        },
    ],
}
