{
    children: [
        {
            name: "video-decoder-ffd00000",
            url: "fuchsia-pkg://fuchsia.com/amlogic_decoder#meta/amlogic_video_decoder.cm",
            compatible: "amlogic,g12b-vdec",
        },
    ],
    offer: [
        {
            name: "canvas",
            service: "fuchsia.hardware.amlogiccanvas.Service",
            from: "#canvas-ff638000",
            to: "#video-decoder-ffd00000",
            constraints: {},
        },
        {
            name: "clock-dos",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#video-decoder-ffd00000",
            constraints: { id: 65543 },
        },
        {
            name: "clock-dos-vdec",
            service: "fuchsia.hardware.clock.Service",
            from: "#clock-controller-ff63c000",
            to: "#video-decoder-ffd00000",
            constraints: { id: 65541 },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#video-decoder-ffd00000",
            constraints: {
                mmio: [
                    {
                        name: "cbus",
                        address: 0xffd00000,
                        size: 0x100000,
                    },
                    {
                        name: "dos",
                        address: 0xff620000,
                        size: 0x10000,
                    },
                    {
                        name: "hiu",
                        address: 0xff63c000,
                        size: 0x2000,
                    },
                    {
                        name: "aobus",
                        address: 0xff800000,
                        size: 0x1000,
                    },
                    {
                        name: "dmc",
                        address: 0xff638000,
                        size: 0x2000,
                    },
                ],
                interrupts: [
                    {
                        name: "vdec",
                        number: 55,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "vidx",
                        number: 64,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "vdec-hevc",
                        number: 75,
                        mode: "EdgeHigh",
                    },
                    {
                        name: "vdec-hevc-vidx",
                        number: 76,
                        mode: "EdgeHigh",
                    },
                ],
                btis: [
                    {
                        name: "vdec",
                        id: 2,
                    },
                ],
            },
        },
    ],
}
