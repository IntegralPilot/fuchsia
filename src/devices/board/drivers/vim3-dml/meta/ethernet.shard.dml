{
    children: [
        {
            name: "dwmac-ff3f0000",
            url: "fuchsia-pkg://fuchsia.com/dwmac#meta/dwmac.cm",
            compatible: "amlogic,meson-g12a-dwmac",
        },
        {
            name: "ethernet-phy-ff634000",
            url: "fuchsia-pkg://fuchsia.com/aml-ethernet#meta/aml-ethernet.cm",
            compatible: "amlogic,ethernet-phy",
        },
    ],
    offer: [
        {
            name: "eth-board",
            service: "fuchsia.hardware.ethernet.board.Service",
            from: "#ethernet-phy-ff634000",
            to: "#dwmac-ff3f0000",
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#dwmac-ff3f0000",
            constraints: {
                mmio: [
                    {
                        name: "dwmac",
                        address: 0xff3f0000,
                        size: 0x10000,
                    },
                ],
                interrupts: [
                    {
                        name: "dwmac",
                        number: 40,
                        mode: "LevelHigh",
                    },
                ],
                btis: [
                    {
                        name: "dwmac",
                        id: 1,
                    },
                ],
                boot_metadata: [
                    {
                        zbi_type: 0x43414d6d,
                        zbi_extra: 0,
                    },
                ],
            },
        },
        {
            name: "gpio-eth-interrupt",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-ff634400",
            to: "#ethernet-phy-ff634000",
            constraints: {
                pin: 14,
                name: "INTERRUPT",
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#ethernet-phy-ff634000",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 0,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 1,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 2,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 3,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 4,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 5,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 6,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 7,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 8,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 9,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 10,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 11,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 12,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                            {
                                pin: 13,
                                call: {
                                    pin_config: {
                                        function: 1,
                                        drive_strength_ua: 2500,
                                    },
                                },
                            },
                        ],
                    },
                ],
            },
        },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#ethernet-phy-ff634000",
            constraints: {
                mmio: [
                    {
                        name: "eth",
                        address: 0xff634000,
                        size: 0x1000,
                    },
                    {
                        name: "eth-pll",
                        address: 0xff63c000,
                        size: 0x2000,
                    },
                ],
            },
        },
    ],
}
