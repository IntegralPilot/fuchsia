{
    children: [
        {
            name: "adc-buttons",
            url: "fuchsia-pkg://fuchsia.com/adc-buttons#meta/adc-buttons.cm",
            compatible: "fuchsia,adc-buttons",
        },
        {
            name: "gpio-buttons",
            url: "fuchsia-pkg://fuchsia.com/buttons#meta/buttons.cm",
            compatible: "fuchsia,gpio-buttons",
        },
    ],
    offer: [
        {
            name: "adc-2",
            service: "fuchsia.hardware.adc.Service",
            from: "#adc-9000",
            to: "#adc-buttons",
            constraints: { channel: 2 },
        },
        {
            name: "power",
            service: "fuchsia.hardware.gpio.Service",
            from: "#gpio-controller-ff634400",
            to: "#gpio-buttons",
            constraints: {
                pin: 92,
                name: "power",
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            from: "#gpio-controller-ff634400",
            to: "#gpio-buttons",
            constraints: {
                states: [
                    {
                        name: "default",
                        pins: [
                            {
                                pin: 92,
                                call: {
                                    pin_config: {
                                        function: 0,
                                        pull: "None",
                                        wake_vector: true,
                                    },
                                },
                            },
                        ],
                    },
                ],
            },
        },
    ],
}
