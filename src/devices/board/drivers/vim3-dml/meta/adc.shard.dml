{
    children: [
        {
            name: "adc-9000",
            url: "fuchsia-pkg://fuchsia.com/aml-saradc#meta/aml-saradc.cm",
            compatible: "amlogic,meson-g12a-saradc",
        },
    ],
    offer: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            from: "parent",
            to: "#adc-9000",
            constraints: {
                mmio: [
                    {
                        name: "adc",
                        address: 0xff809000,
                        size: 0x1000,
                    },
                    {
                        name: "ao",
                        address: 0xff800000,
                        size: 0x1000,
                    },
                ],
                interrupts: [
                    {
                        name: "saradc",
                        number: 232,
                        mode: "EdgeHigh",
                    },
                ],
            },
        },
    ],
}
