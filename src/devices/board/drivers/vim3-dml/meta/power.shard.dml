{
    children: [
        {
            name: "power-controller",
            url: "fuchsia-pkg://fuchsia.com/aml-meson-power#meta/aml-meson-power.cm",
            compatible: "amlogic,power",
        },
    ],
    offer: [
        {
            name: "vreg-pwm-big",
            service: "fuchsia.hardware.vreg.Service",
            from: "#pwm_a-regulator",
            to: "#power-controller",
        },
        {
            name: "vreg-pwm-little",
            service: "fuchsia.hardware.vreg.Service",
            from: "#pwm_a0_d-regulator",
            to: "#power-controller",
        },
    ],
}
