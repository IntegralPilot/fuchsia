composite post_init;
using fuchsia.amlogic.platform.s905d3;
using fuchsia.google.platform;
using fuchsia.gpio;

primary parent "pbus" {
  fuchsia.Service == "fuchsia.hardware.platform.bus.Service";
  fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.google.platform.BIND_PLATFORM_DEV_VID.GOOGLE;
  fuchsia.BIND_PLATFORM_DEV_PID == fuchsia.google.platform.BIND_PLATFORM_DEV_PID.NELSON;
  fuchsia.BIND_PLATFORM_DEV_INSTANCE_ID == 1;
}

parent "hw-id-0" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOZ_PIN_ID.PIN_7;
}

parent "hw-id-1" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOZ_PIN_ID.PIN_8;
}

parent "hw-id-2" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOZ_PIN_ID.PIN_3;
}

parent "hw-id-3" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOZ_PIN_ID.PIN_0;
}

parent "hw-id-4" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOAO_PIN_ID.PIN_4;
}

parent "disp-soc-id0" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOZ_PIN_ID.PIN_11;
}

parent "disp-soc-id1" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOZ_PIN_ID.PIN_12;
}

parent "selina-osc-en" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOH_PIN_ID.PIN_8;
}

parent "touch-interrupt" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.ID == fuchsia.amlogic.platform.s905d3.GPIOZ_PIN_ID.PIN_4;
}

optional parent "gpio-init" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
}

optional parent "pin-states-0" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}
