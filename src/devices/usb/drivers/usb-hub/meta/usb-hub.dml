{
    name: "usb-hub",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/usb-hub.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            banjo: "fuchsia.usb.BIND_PROTOCOL.DEVICE",
            rules: { "fuchsia.BIND_USB_CLASS": "fuchsia.usb.BIND_USB_CLASS.HUB" },
        },
    },
}
