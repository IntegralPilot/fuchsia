{
    name: "dwc2",
    include: [],
    program: {
        allowed_scheduler_roles: [ "fuchsia.devices.usb.drivers.dwc2.interrupt" ],
    },
    capabilities: [
        { protocol: "fuchsia.hardware.usb.endpoint.Endpoint" },
        { service: "fuchsia.hardware.usb.dci.UsbDciService" },
        { service: "fuchsia.boot.metadata.MacAddressMetadata" },
        { service: "fuchsia.boot.metadata.SerialNumberMetadata" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            availability: "optional",
            default: false,
        },
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "dwc2-phy",
            service: "fuchsia.hardware.usb.phy.Service",
        },
        {
            name: "pdev",
            service: "fuchsia.boot.metadata.MacAddressMetadata",
        },
        {
            name: "pdev",
            service: "fuchsia.boot.metadata.SerialNumberMetadata",
        },
        { protocol: "fuchsia.power.system.ActivityGovernor" },
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    { compat: "snps,dwc2" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.USB_DWC2",
                    },
                ],
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.usb.dci.UsbDciService",
            from: "self",
        },
        {
            protocol: "fuchsia.hardware.usb.endpoint.Endpoint",
            from: "self",
        },
        {
            service: "fuchsia.boot.metadata.MacAddressMetadata",
            from: "self",
        },
        {
            service: "fuchsia.boot.metadata.SerialNumberMetadata",
            from: "self",
        },
    ],
}
