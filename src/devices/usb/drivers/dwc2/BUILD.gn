import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/drivers/dml.gni")
import("//build/test.gni")

fuchsia_driver_dml("dwc2-dml") {
  dml = "meta/dwc2.dml"
  driver_name = "dwc2"
}

driver_bind_rules("dwc2_bind") {
  dml_label = ":dwc2-dml"
  bind_output = "dwc2.bindbc"
  tests = "meta/tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.designware.platform",
    "//src/devices/bind/fuchsia.platform",
  ]
}

source_set("common") {
  sources = [
    "dwc2.cc",
    "dwc2.h",
    "usb_dwc_regs.h",
  ]
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  deps = [
    "//sdk/lib/async",
    "//sdk/lib/driver/compat/cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/bind/fuchsia.designware.platform:fuchsia.designware.platform_cpp",
  ]
  public_deps = [
    ":dwc2-config",
    "//sdk/fidl/fuchsia.boot.metadata:fuchsia.boot.metadata_cpp",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_cpp",
    "//sdk/fidl/fuchsia.hardware.usb.dci:fuchsia.hardware.usb.dci_cpp",
    "//sdk/fidl/fuchsia.hardware.usb.descriptor:fuchsia.hardware.usb.descriptor_cpp",
    "//sdk/fidl/fuchsia.hardware.usb.phy:fuchsia.hardware.usb.phy_cpp",
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/logging/cpp",
    "//sdk/lib/driver/metadata/cpp",
    "//sdk/lib/driver/mmio/cpp",
    "//sdk/lib/driver/platform-device/cpp",
    "//sdk/lib/driver/power/cpp",
    "//sdk/lib/fit",
    "//src/devices/lib/dma-buffer",
    "//src/devices/usb/lib/fuchsia.hardware.usb.dwc2:fuchsia.hardware.usb.dwc2_cpp",
    "//src/devices/usb/lib/usb:descriptors",
    "//src/devices/usb/lib/usb-endpoint:usb-endpoint-server-sdk",
    "//src/lib/ddk:ddk_metadata_only",
    "//zircon/system/ulib/hwreg",
    "//zircon/system/ulib/sync:sync-cpp",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_cc_driver("dwc2-driver") {
  output_name = "dwc2"
  deps = [
    ":common",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("dwc2") {
  info = "meta/dwc2-info.json"
  cm_label = ":dwc2-dml_manifest"
  deps = [
    ":dwc2-driver",
    ":dwc2_bind",
  ]
}

fuchsia_structured_config_cpp_elf_lib("dwc2-config") {
  cm_label = ":dwc2-dml_manifest"
}

fuchsia_structured_config_values("dwc2-values") {
  cm_label = ":dwc2-dml_manifest"
  values = {
    enable_suspend = false
  }
}

fuchsia_driver_package("package") {
  package_name = "dwc2"
  export_to_bazel = true
  driver_components = [ ":dwc2" ]
  deps = [ ":dwc2-values" ]
}

test("dwc2-test-bin") {
  sources = [ "dwc2-test.cc" ]
  output_name = "dwc2-test"
  deps = [
    ":common",
    "//sdk/lib/driver/compat/cpp",
    "//sdk/lib/driver/fake-mmio-reg/cpp",
    "//sdk/lib/driver/fake-platform-device/cpp",
    "//sdk/lib/driver/testing/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
}

fuchsia_unittest_package("dwc2-test") {
  deps = [ ":dwc2-test-bin" ]
  test_specs = {
    environments = basic_envs
  }
}

group("tests") {
  testonly = true
  deps = [
    ":dwc2-test",
    ":dwc2_bind_test",
  ]
}
