{
    name: "usb-composite",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/usb-composite.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        fallback: "true",
        bind: { banjo: "fuchsia.usb.BIND_PROTOCOL.DEVICE" },
    },
    capabilities: [
        { service: "fuchsia.hardware.usb.UsbService" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.usb.UsbService",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.usb.UsbService",
            from: "self",
        },
    ],
}
