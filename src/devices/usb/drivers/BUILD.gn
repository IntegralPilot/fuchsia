group("tests") {
  testonly = true

  deps = [
    "dwc2:tests",
    "dwc3:tests",
    "usb-bus:tests",
    "usb-composite:tests",
    "usb-hub:tests",
    "usb-peripheral:tests",
    "usb-virtual-bus:tests",
    "usb-zero-function:tests",
    "xhci:tests",
  ]
  if (target_cpu == "arm64") {
    deps += [ "aml-usb-phy:tests" ]
  }
}
