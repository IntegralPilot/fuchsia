{
    name: "usb-virtual-bus",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
            pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.USB",
            rules: { "fuchsia.BIND_PLATFORM_DEV_PID": "fuchsia.test.platform.BIND_PLATFORM_DEV_DID.VIRTUAL_BUS" },
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.usb.dci.UsbDciService" },
        { service: "fuchsia.hardware.usb.hci.UsbHciService" },
    ],
    expose: [
        {
            service: [
                "fuchsia.hardware.usb.dci.UsbDciService",
                "fuchsia.hardware.usb.hci.UsbHciService",
            ],
            from: "self",
        },
    ],
}
