[
    {
        "parent": "pdev",
        "tests": [
            {
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.designware.platform.BIND_PLATFORM_DEV_DID.DWC3",
                    "fuchsia.BIND_PLATFORM_DEV_PID": "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                    "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC"
                },
                "expected": "match",
                "name": "AllMatch"
            },
            {
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.designware.platform.BIND_PLATFORM_DEV_DID.DWC3",
                    "fuchsia.BIND_PLATFORM_DEV_PID": "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC"
                },
                "expected": "abort",
                "name": "AbortNoVID"
            },
            {
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.designware.platform.BIND_PLATFORM_DEV_DID.DWC3",
                    "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC"
                },
                "expected": "abort",
                "name": "AbortNoPID"
            },
            {
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_PID": "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                    "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC"
                },
                "expected": "abort",
                "name": "AbortNoDID"
            },
            {
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                    "fuchsia.COMPATIBLE": "\"snps,dwc3\"",
                    "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC"
                },
                "expected": "match",
                "name": "DeviceTreeAllMatch"
            },
            {
                "device": {
                    "fuchsia.COMPATIBLE": "\"snps,dwc3\"",
                    "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC"
                },
                "expected": "abort",
                "name": "DeviceTreeAbortNoDID"
            },
            {
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                    "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC"
                },
                "expected": "abort",
                "name": "DeviceTreeAbortNoFirstCompatible"
            },
            {
                "device": {
                    "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                    "fuchsia.COMPATIBLE": "\"snps,dwc3\""
                },
                "expected": "abort",
                "name": "DeviceTreeAbortNoVID"
            }
        ]
    },
    {
        "parent": "dwc3-phy",
        "tests": [
            {
                "device": {
                    "fuchsia.NAME": "\"dwc3-phy\"",
                    "fuchsia.Service": "\"fuchsia.hardware.usb.phy.Service\""
                },
                "expected": "match",
                "name": "NameMatch"
            },
            {
                "device": {
                    "fuchsia.NAME": "\"wrong-phy\"",
                    "fuchsia.Service": "\"fuchsia.hardware.usb.phy.Service\""
                },
                "expected": "abort",
                "name": "AbortWrongName"
            },
            {
                "device": {
                    "fuchsia.Service": "\"fuchsia.hardware.usb.phy.Service\""
                },
                "expected": "abort",
                "name": "AbortNoName"
            },
            {
                "device": {
                    "fuchsia.NAME": "\"dwc3-phy\""
                },
                "expected": "abort",
                "name": "AbortNoService"
            }
        ]
    }
]
