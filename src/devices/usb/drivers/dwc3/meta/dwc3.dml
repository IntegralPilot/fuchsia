{
    name: "dwc3",
    include: [ "driver/platform-device.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        service_connect_validation: "true",
        default_dispatcher_scheduler_role: "fuchsia.devices.usb.drivers.dwc3.interrupt",
        suspend_enabled: "false",
    },
    capabilities: [
        { protocol: "fuchsia.hardware.usb.endpoint.Endpoint" },
        { service: "fuchsia.hardware.usb.dci.UsbDciService" },
        { service: "fuchsia.boot.metadata.MacAddressMetadata" },
        { service: "fuchsia.boot.metadata.SerialNumberMetadata" },
        { service: "fuchsia.hardware.usb.phy.Metadata" },
        { service: "fuchsia.hardware.usb.policy.Service" },
    ],
    use: [
        {
            name: "pdev",
            primary: true,
            bind: {
                one_of: [
                    {
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                        compat: "snps,dwc3",
                    },
                    {
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        did: "fuchsia.designware.platform.BIND_PLATFORM_DEV_DID.DWC3",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                    },
                ],
            },
        },
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            availability: "optional",
            default: false,
        },
        { protocol: "fuchsia.power.system.ActivityGovernor" },
        { service: "fuchsia.hardware.clock.Service" },
        {
            name: "usb-ddr",
            service: "fuchsia.hardware.interconnect.PathService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "usb-ddr" },
            },
        },
        { service: "fuchsia.hardware.reset.Service" },
        { service: "fuchsia.hardware.usb.phy.ConnectionWatcherService" },
        {
            name: "dwc3-phy",
            service: "fuchsia.hardware.usb.phy.Service",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "dwc3-phy" },
            },
        },
        { service: "fuchsia.hardware.vreg.Service" },
        { service: "fuchsia.boot.metadata.MacAddressMetadata" },
        { service: "fuchsia.boot.metadata.SerialNumberMetadata" },
        {
            name: "usb-ipa",
            service: "fuchsia.hardware.interconnect.PathService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "usb-ipa" },
            },
        },
        {
            name: "ddr-usb",
            service: "fuchsia.hardware.interconnect.PathService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "ddr-usb" },
            },
        },
        {
            name: "usb-interconnect",
            service: "fuchsia.hardware.interconnect.PathService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "usb-interconnect" },
            },
        },
        {
            name: "core-clk",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "core-clk" },
            },
        },
        {
            name: "iface-clk",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "iface-clk" },
            },
        },
        {
            name: "bus-aggr-clk",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "bus-aggr-clk" },
            },
        },
        {
            name: "xo",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "xo" },
            },
        },
        {
            name: "sleep-clk",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "sleep-clk" },
            },
        },
        {
            name: "utmi-clk",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "utmi-clk" },
            },
        },
        {
            name: "core_reset",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "core_reset" },
            },
        },
        {
            name: "dwc3-regulator",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "dwc3-regulator" },
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.usb.dci.UsbDciService",
            from: "self",
        },
        {
            protocol: "fuchsia.hardware.usb.endpoint.Endpoint",
            from: "self",
        },
        {
            service: "fuchsia.boot.metadata.MacAddressMetadata",
            from: "self",
        },
        {
            service: "fuchsia.boot.metadata.SerialNumberMetadata",
            from: "self",
        },
        {
            service: "fuchsia.hardware.usb.phy.Metadata",
            from: "self",
        },
        {
            service: "fuchsia.hardware.usb.policy.Service",
            from: "self",
        },
    ],
    config: {
        bypass_platform_extension: { type: "bool" },
    },
}
