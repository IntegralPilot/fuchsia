{
    name: "xhci",
    include: [
        "driver/platform-device.shard.cml",
        "driver_component/driver.shard.cml",
    ],
    program: {
        allowed_scheduler_roles: [ "fuchsia.devices.usb.drivers.xhci.interrupter" ],
    },
    capabilities: [
        { protocol: "fuchsia.hardware.usb.endpoint.Endpoint" },
        { service: "fuchsia.hardware.usb.hci.UsbHciService" },
    ],
    use: [
        {
            name: "pdev",
            primary: true,
            bind: {
                one_of: [
                    {
                        service: "fuchsia.hardware.pci.Service",
                        pci: {
                            class: "fuchsia.pci.BIND_PCI_CLASS.SERIAL_BUS_CONTROLLER",
                            subclass: "fuchsia.pci.serial.BIND_PCI_SUBCLASS.USB",
                            interface: "fuchsia.pci.serial.usb.BIND_PCI_INTERFACE.XHCI",
                        },
                    },
                    {
                        compat: "generic-xhci",
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                    },
                    {
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: [
                            "0x02",
                            "fuchsia.platform.BIND_PLATFORM_DEV_DID.XHCI",
                        ],
                    },
                ],
            },
        },
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
        },
        { protocol: "fuchsia.power.system.ActivityGovernor" },
        { protocol: "fuchsia.scheduler.RoleManager" },
        { service: "fuchsia.hardware.pci.Service" },
        { service: "fuchsia.hardware.usb.phy.Service" },
        {
            name: "xhci",
            availability: "optional",
            bind: {
                service: "fuchsia.hardware.usb.phy.Service",
                one_of: [
                    {
                        rules: { "fuchsia.NAME": "xhci" },
                    },
                    { did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.XHCI" },
                ],
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { protocol: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.usb.hci.UsbHciService",
            from: "self",
        },
        {
            protocol: "fuchsia.hardware.usb.endpoint.Endpoint",
            from: "self",
        },
    ],
}
