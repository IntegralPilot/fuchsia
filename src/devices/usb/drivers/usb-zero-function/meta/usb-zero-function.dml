{
    name: "usb-zero-function",
    program: {
        colocate: "true",
        bind: {
            banjo: "fuchsia.usb.BIND_PROTOCOL.FUNCTION",
            usb: {
                class: "fuchsia.usb.BIND_USB_CLASS.VENDOR_SPECIFIC",
                subclass: 0,
                protocol: [
                    1,
                    2,
                ],
            },
        },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.usb.function.UsbFunctionService",
            generate_bind_rule: false,
        },
    ],
}
