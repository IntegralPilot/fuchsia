{
    name: "registers",
    include: [ "driver_component/driver.shard.cml" ],
    program: {},
    capabilities: [
        {
            service: "fuchsia.hardware.registers.Service",
            metadata: {
                id: "fuchsia.hardware.registers.Metadata",
                schema: {
                    $schema: "http://json-schema.org/draft-07/schema#",
                    type: "object",
                    properties: {
                        registers: {
                            type: "array",
                            items: { $ref: "#/definitions/RegistersMetadataEntry" },
                        },
                    },
                    required: [ "registers" ],
                    definitions: {
                        RegistersMetadataEntry: {
                            type: "object",
                            properties: {
                                name: { type: "string" },
                                mmio_id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                masks: {
                                    type: "array",
                                    items: { $ref: "#/definitions/MaskEntry" },
                                },
                            },
                            required: [
                                "masks",
                                "mmio_id",
                                "name",
                            ],
                        },
                        MaskEntry: {
                            type: "object",
                            properties: {
                                offset: {
                                    type: "integer",
                                    fuchsia_type: "uint64",
                                },
                                size: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                mask: {
                                    type: "integer",
                                    fuchsia_type: "uint64",
                                },
                                count: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                overlap_check: { type: "boolean" },
                            },
                            required: [
                                "mask",
                                "offset",
                                "size",
                            ],
                        },
                    },
                },
            },
        },
    ],
    use: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    { compat: "fuchsia,registers" },
                    {
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        pid: 0,
                        did: 41,
                    },
                ],
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.registers.Service",
            from: "self",
        },
    ],
}
