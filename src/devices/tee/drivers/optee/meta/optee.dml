{
    name: "optee",
    composite_name: "tee",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        compat: "driver/optee.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [ "fuchsia.tee.default" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.tee.Service" },
    ],
    use: [
        {
            name: "pdev",
            primary: true,
            bind: {
                one_of: [
                    { compat: "amlogic,optee" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                        pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.OPTEE",
                        rules: { "fuchsia.BIND_PLATFORM_DEV_INSTANCE_ID": 0 },
                    },
                ],
            },
        },
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            name: "rpmb",
            service: "fuchsia.hardware.rpmb.Service",
            availability: "optional",
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.tee.Service",
            from: "self",
        },
    ],
}
