composite ot_radio;

using fuchsia;

primary parent "spi" {
  fuchsia.Service == "fuchsia.hardware.spi.Service";
}

parent "pdev" {
  if fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE {
    fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC;
    fuchsia.COMPATIBLE == "nordic,nrf52840";
  } else {
    fuchsia.BIND_PROTOCOL == fuchsia.platform.BIND_PROTOCOL.DEVICE;
    fuchsia.BIND_PLATFORM_DEV_VID == fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC;
    fuchsia.BIND_PLATFORM_DEV_DID == fuchsia.platform.BIND_PLATFORM_DEV_DID.OT_RADIO;
    fuchsia.BIND_PLATFORM_DEV_INSTANCE_ID == 0;
  }
}

parent "gpio-int" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "gpio-int";
}

parent "gpio-reset" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "gpio-reset";
}

parent "gpio-bootloader" {
  fuchsia.Service == "fuchsia.hardware.gpio.Service";
  fuchsia.NAME == "gpio-bootloader";
}

optional parent "gpio-init-0" {
  fuchsia.BIND_INIT_STEP == fuchsia.gpio.BIND_INIT_STEP.GPIO;
}

optional parent "pin-states-0" {
  fuchsia.Service == "fuchsia.hardware.pin.PinStatesService";
}
