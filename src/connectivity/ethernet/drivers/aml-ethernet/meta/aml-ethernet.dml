{
    name: "aml_eth_bind",
    composite_name: "aml_eth",
    include: [
        "//sdk/lib/driver/compat/compat.shard.cml",
        "driver/platform-device.shard.cml",
    ],
    program: {
        compat: "driver/aml-ethernet.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.ethernet.board.Service" },
    ],
    use: [
        {
            name: "pdev",
            primary: true,
            bind: {
                one_of: [
                    { compat: "amlogic,ethernet-phy" },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        pid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.A311D",
                        did: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.ETH",
                    },
                ],
            },
        },
        {
            name: "gpio-int",
            service: "fuchsia.hardware.gpio.Service",
            bind: {
                rules: { "fuchsia.NAME": "gpio-int" },
            },
        },
        { service: "fuchsia.hardware.i2c.Service" },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.ethernet.board.Service",
            from: "self",
        },
    ],
}
