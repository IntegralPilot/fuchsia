{
    name: "gvnic",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/gvnic.so",
    },
    capabilities: [
        { service: "fuchsia.hardware.network.driver.Service" },
    ],
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                pci: {
                    vid: "fuchsia.pci.BIND_PCI_VID.GOOGLE",
                    did: "0x0042",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.network.driver.Service",
            from: "self",
        },
    ],
}
