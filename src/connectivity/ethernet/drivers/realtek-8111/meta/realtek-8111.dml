{
    name: "realtek-8111",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/realtek-8111.so",
    },
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                pci: {
                    vid: "fuchsia.pci.BIND_PCI_VID.REALTEK",
                    did: "fuchsia.pci.BIND_PCI_DID.RTL8111",
                    interface: "1",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
}
