{
    include: [
        "//src/connectivity/network/testing/netemul/runner/default.shard.cml",
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        networks: [
            {
                name: "net",
                endpoints: [
                    { name: "ep1" },

                    // An 8-byte name (len % 8 == 0) has 0 padding bytes in FIDL wire format;
                    // guards against regressions in StringView null-termination.
                    { name: "ethernet" },
                    { name: "ep3" },
                    { name: "if_max_length15" },
                ],
            },
        ],
        netstacks: [
            {
                name: "netstack",
                interfaces: [
                    {
                        name: "ep1",
                        static_ips: [ "192.168.0.1/20" ],
                    },
                    {
                        name: "ethernet",
                        static_ips: [ "192.168.0.2/15" ],
                    },
                    {
                        name: "ep3",
                        static_ips: [ "fe80::1/64" ],
                    },
                    {
                        name: "if_max_length15",
                        static_ips: [ "1234::5:6:7:8/120" ],
                    },
                ],
            },
        ],
    },
    children: [
        {
            name: "test-driver",
            url: "#meta/test-driver.cm",
        },
    ],
    use: [
        {
            protocol: "fuchsia.test.Suite",
            from: "#test-driver",
        },
        {
            protocol: "fuchsia.netemul.ConfigurableNetstack",
            from: "#netstack",
            path: "/svc/netstack",
        },
    ],
    offer: [
        {
            protocol: [ "fuchsia.posix.socket.Provider" ],
            from: "#netstack",
            to: "#test-driver",
        },
        {
            dictionary: "diagnostics",
            from: "parent",
            to: "#test-driver",
        },
    ],
}
