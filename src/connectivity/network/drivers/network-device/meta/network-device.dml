{
    name: "network-device",
    include: [],
    program: {
        binary: "driver/network-device.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        allowed_scheduler_roles: [
            "fuchsia.devices.network.core.rx",
            "fuchsia.devices.network.core.tx",
        ],
        bind: {
            one_of: [
                { protocol: "fuchsia.network.BIND_PROTOCOL.IMPL" },
                { service: "fuchsia.hardware.network.driver.Service" },
            ],
        },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.network.driver.Service",
            generate_bind_rule: false,
        },
    ],
}
