import("//src/developer/ffx/build/ffx_plugin.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host)

ffx_plugin("ffx_net_test_realm") {
  sdk_category = "not-yet-specified"
  edition = "2024"
  with_unit_tests = true
  args_deps = [
    "//src/connectivity/network/testing/network-test-realm/fidl:fuchsia.net.test.realm_rust_fdomain",
    "//src/developer/ffx/core:lib",
    "//src/lib/network/fidl_fuchsia_net_ext",
    "//third_party/rust_crates:argh",
  ]
  deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust_fdomain",
    "//sdk/fidl/fuchsia.net.dhcpv6:fuchsia.net.dhcpv6_rust_fdomain",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
    "//src/connectivity/lib/fidl_fuchsia_net_dhcpv6_ext",
    "//src/connectivity/network/testing/network-test-realm/fidl:fuchsia.net.test.realm_rust_fdomain",
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/target/holders:lib",
    "//src/developer/ffx/lib/writer:lib",
    "//src/lib/fdomain/client",
    "//src/lib/network/fidl_fuchsia_net_ext",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:uuid",
  ]
  test_deps = [
    "//sdk/fidl/fuchsia.net:fuchsia.net_rust_fdomain",
    "//src/connectivity/lib/net-declare",
    "//src/lib/fdomain/local",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
  ]
  args_sources = [ "src/args.rs" ]
  sources = [ "src/lib.rs" ]
}

ffx_tool("ffx_net_test_realm_tool") {
  edition = "2024"
  output_name = "ffx-net-test-realm"
  deps = [
    ":ffx_net_test_realm",
    "//src/developer/ffx/lib/fho:lib",
    "//src/lib/fuchsia",
  ]
  sources = [ "src/main.rs" ]
}

group("tests") {
  deps = [ ":ffx_net_test_realm_tests" ]
  testonly = true
}
