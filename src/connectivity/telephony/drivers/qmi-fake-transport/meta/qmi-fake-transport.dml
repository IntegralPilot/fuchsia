{
    name: "qmi-fake-transport",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/qmi-fake-transport.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            vid: "fuchsia.test.platform.BIND_PLATFORM_DEV_VID.TEST",
            pid: "fuchsia.test.platform.BIND_PLATFORM_DEV_PID.TEL",
            did: "fuchsia.test.platform.BIND_PLATFORM_DEV_DID.QMI_MODEM",
        },
    },
    use: [],
}
