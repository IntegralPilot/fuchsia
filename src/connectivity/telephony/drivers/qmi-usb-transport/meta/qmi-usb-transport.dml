{
    name: "qmi-transport",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/qmi-transport.so",
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            protocol: "fuchsia.usb.BIND_PROTOCOL.INTERFACE",
            usb: {
                vid: "fuchsia.sierra.platform.usb.BIND_USB_VID.SIERRA",
                pid: "fuchsia.sierra.platform.usb.BIND_USB_PID.EM7565",
            },
        },
    },
    use: [],
}
