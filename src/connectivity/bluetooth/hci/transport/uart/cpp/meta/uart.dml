{
    name: "bt-transport-uart",
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        default_dispatcher_scheduler_role: "fuchsia.devices.bt.drivers.bt-transport-uart",
        bind: {
            service: "fuchsia.hardware.serial.Service",
            rules: { "fuchsia.BIND_SERIAL_CLASS": "fuchsia.serial.BIND_SERIAL_CLASS.BLUETOOTH_HCI" },
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.bluetooth.HciService" },
        { service: "fuchsia.hardware.serialimpl.Service" },
        { service: "fuchsia.boot.metadata.MacAddressMetadata" },
        { service: "fuchsia.hardware.power.PowerTokenService" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            default: false,
            availability: "optional",
        },
        {
            name: "default",
            service: "fuchsia.boot.metadata.MacAddressMetadata",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.power.PowerTokenService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.serialimpl.Service",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.bluetooth.HciService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.serialimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.boot.metadata.MacAddressMetadata",
            from: "self",
        },
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
    ],
}
