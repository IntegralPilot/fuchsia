{
    name: "bt-transport-usb",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/bt-transport-usb.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        colocate: "true",
        bind: {
            protocol: "fuchsia.usb.BIND_PROTOCOL.DEVICE",
            usb: {
                class: "fuchsia.usb.BIND_USB_CLASS.WIRELESS",
                subclass: "fuchsia.usb.wireless.BIND_USB_SUBCLASS.MISC",
                protocol: "fuchsia.usb.wireless.BIND_USB_PROTOCOL.BLUETOOTH",
            },
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.bluetooth.HciService" },
    ],
    use: [],
    expose: [
        {
            service: "fuchsia.hardware.bluetooth.HciService",
            from: "self",
        },
    ],
}
