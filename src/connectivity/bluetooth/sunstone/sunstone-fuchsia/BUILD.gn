import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  output_name = "bt_host"
  edition = "2024"
  source_root = "src/main.rs"
  with_unit_tests = true
  sources = [
    "src/host_server.rs",
    "src/main.rs",
    "src/vendor.rs",
  ]

  deps = [
    ":bt_host_config",
    "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
    "//sdk/fidl/fuchsia.bluetooth.host:fuchsia.bluetooth.host_rust",
    "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
    "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures-util",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:tracing",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "bt-host"
  manifest = "meta/bt-host.cml"
}

fuchsia_structured_config_rust_lib("bt_host_config") {
  cm_label = ":manifest"
}

fuchsia_structured_config_values("default_config_values") {
  cm_label = ":manifest"
  values = {
    device_path = "/dev/class/bt-hci/000"
    enable_suspend = false
    legacy_pairing_enabled = false
    sco_offload_path_index = 6
    override_vendor_capabilites_version = 0
    hci_command_timeout_seconds = 10
    le_slow_adv_interval_min = 0
    le_slow_adv_interval_max = 0
    le_slow_adv_max_tx_power = 127
    le_fast_adv_interval_min = 0
    le_fast_adv_interval_max = 0
    le_fast_adv_max_tx_power = 127
    le_very_fast_adv_interval_min = 0
    le_very_fast_adv_interval_max = 0
    le_very_fast_adv_max_tx_power = 127
    le_active_scan_interval = 0
    le_active_scan_window = 0
  }
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

fuchsia_package("sunstone-bt-host") {
  package_name = "sunstone-bt-host"
  deps = [
    ":component",
    ":default_config_values",
  ]
}

fuchsia_unittest_package("sunstone-fuchsia-tests") {
  deps = [ ":bin_test" ]
}

fuchsia_unittest_package("sunstone-bt-host-tests") {
  deps = [ ":bin_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":sunstone-bt-host-tests",
    ":sunstone-fuchsia-tests",
  ]
}
