import("//build/rust/rustc_test.gni")

if (is_host) {
  rustc_test("sapphire_rpc_macro_test") {
    edition = "2024"
    source_root = "sapphire-rpc-macro/tests/test_rpc_macro.rs"
    sources = [ "sapphire-rpc-macro/tests/test_rpc_macro.rs" ]
    deps = [
      "//third_party/rust_crates:sapphire-async",
      "//third_party/rust_crates:sapphire-collections",
      "//third_party/rust_crates:sapphire-rpc-macro",
      "//third_party/rust_crates:sapphire-sync",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":sapphire_rpc_macro_test($host_toolchain)",
    "sapphire-emboss:tests",
    "//third_party/rust_crates:sapphire-async.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-buffer.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-collections.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-common.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-gap.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-gatt.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-hci.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-host.test($host_toolchain)",
    "//third_party/rust_crates:sapphire-sync.test($host_toolchain)",
  ]
}
