{
    children: [
        {
            name: "bluetooth-core",
            url: "fuchsia-pkg://fuchsia.com/bt-init#meta/bt-init.cm",
            environment: "#core-env",
        },
    ],
    offer: [
        {
            dictionary: "bluetooth-le-config",
            from: "parent",
            to: [ "#bluetooth-core" ],
            availability: "same_as_target",
        },
        {
            protocol: "fuchsia.power.system.ActivityGovernor",
            from: "parent",
            to: "#bluetooth-core",
            availability: "optional",
        },
        {
            protocol: [ "fuchsia.device.NameProvider" ],
            from: "parent",
            to: [ "#bluetooth-core" ],
        },
        {
            protocol: [ "fuchsia.stash.SecureStore" ],
            from: "#stash_secure",
            to: [ "#bluetooth-core" ],
        },
        {
            protocol: "fuchsia.bluetooth.snoop.Snoop",
            from: "#bt-snoop",
            to: [ "#bluetooth-core" ],
            source_availability: "unknown",
        },
        {
            protocol: "fuchsia.time.alarms.WakeAlarms",
            from: "#timekeeper",
            to: "#bluetooth-core",
            availability: "optional",
        },
        {
            config: "fuchsia.power.SuspendEnabled",
            from: "parent",
            to: "#bluetooth-core",
        },
        {
            config: "fuchsia.bluetooth.LegacyPairing",
            from: "parent",
            to: "#bluetooth-core",
        },
        {
            config: "fuchsia.bluetooth.HciCommandTimeout",
            from: "parent",
            to: "#bluetooth-core",
            availability: "optional",
        },
        {
            config: "fuchsia.bluetooth.ScoOffloadPathIndex",
            from: "parent",
            to: "#bluetooth-core",
            availability: "optional",
        },
        {
            config: "fuchsia.bluetooth.OverrideVendorCapabilitiesVersion",
            from: "parent",
            to: "#bluetooth-core",
            availability: "optional",
        },
        {
            // This service replaces the directory capability above.
            service: "fuchsia.hardware.bluetooth.Service",
            from: "parent",
            to: [
                "#bluetooth-core",
                "self/toolbox",
            ],
            target_availability: "unknown",
        },
        {
            protocol: "fuchsia.metrics.MetricEventLoggerFactory",
            from: "#cobalt",
            to: [ "#bluetooth-core" ],
        },
        {
            protocol: "fuchsia.scheduler.RoleManager",
            from: "parent",
            to: "#bluetooth-core",
        },
        {
            config: "fuchsia.bluetooth.FastPairProvider",
            from: "parent",
            to: "#bluetooth-core",
            availability: "optional",
        },
        {
            config: "fuchsia.bluetooth.Rfcomm",
            from: "parent",
            to: "#bluetooth-core",
            availability: "optional",
        },

        // Only needed when `bt-fastpair-provider` is present, so that
        // `bluetooth-core` can forward the offer.
        // TODO(https://fxbug.dev/329895689): Move back to a core shard for
        // `bt-fastpair-provider` when offer validation can handle optionally
        // included targets.
        {
            storage: "data",
            from: "self",
            to: [ "#bluetooth-core" ],
        },
        {
            protocol: [
                "fuchsia.bluetooth.bredr.Profile",
                "fuchsia.bluetooth.fastpair.Provider",
                "fuchsia.bluetooth.gatt.Server",
                "fuchsia.bluetooth.gatt2.Server",
                "fuchsia.bluetooth.le.Central",
                "fuchsia.bluetooth.le.Peripheral",
                "fuchsia.bluetooth.sys.Access",
                "fuchsia.bluetooth.sys.AddressLookup",
                "fuchsia.bluetooth.sys.Bootstrap",
                "fuchsia.bluetooth.sys.Configuration",
                "fuchsia.bluetooth.sys.HostWatcher",
                "fuchsia.bluetooth.sys.Pairing",
            ],
            from: "#bluetooth-core",
            to: "self/toolbox",
            target_availability: "unknown",
        },
        {
            protocol: [
                "fuchsia.bluetooth.rfcomm.test.RfcommTest",
                "fuchsia.bluetooth.sys.Access",
            ],
            from: "#bluetooth-core",
            to: "self/toolbox",
            availability: "optional",
            target_availability: "unknown",
        },
    ],
}
