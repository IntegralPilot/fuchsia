import("//build/components.gni")
import("//third_party/protobuf/proto_library.gni")

# To enable an experimental Pandora API, copy its .proto definition into
# third_party/github.com/google/bt-test-interfaces/src/pandora/ and set the
# corresponding variable below.
#
# TODO(https://fxbug.dev/444046268): Include experimental APIs by default.
pandora_with_gatt = false

config("include_bindings") {
  include_dirs =
      [ root_gen_dir + "/third_party/github.com/google/bt-test-interfaces/src" ]
}

proto_library("bt-test-interfaces") {
  visibility = [ ":*" ]

  sources = [
    "//third_party/github.com/google/bt-test-interfaces/src/pandora/a2dp.proto",
    "//third_party/github.com/google/bt-test-interfaces/src/pandora/host.proto",
    "//third_party/github.com/google/bt-test-interfaces/src/pandora/l2cap.proto",
    "//third_party/github.com/google/bt-test-interfaces/src/pandora/security.proto",
  ]

  if (pandora_with_gatt) {
    sources += [ "//third_party/github.com/google/bt-test-interfaces/src/pandora/gatt.proto" ]
  }

  proto_in_dir = "//third_party/github.com/google/bt-test-interfaces/src"
  extra_configs = [ ":include_bindings" ]

  generate_python = false
  generator_plugin_suffix = ".grpc.pb"
  generator_plugin_label = "//third_party/grpc:grpc_cpp_plugin"
  import_protobuf_full = true

  deps = [
    "//third_party/grpc:grpc++",
    "//third_party/protobuf:protobuf_full",
  ]
}

config("pandora_experimental_config") {
  if (pandora_with_gatt) {
    defines = [ "PANDORA_WITH_GATT" ]
  }
}

source_set("grpc_services") {
  public = [
    "src/grpc_services/a2dp.h",
    "src/grpc_services/host.h",
    "src/grpc_services/l2cap.h",
    "src/grpc_services/security.h",
  ]
  sources = [
    "src/grpc_services/a2dp.cc",
    "src/grpc_services/host.cc",
    "src/grpc_services/l2cap.cc",
    "src/grpc_services/security.cc",
  ]

  if (pandora_with_gatt) {
    public += [ "src/grpc_services/gatt.h" ]
    sources += [ "src/grpc_services/gatt.cc" ]
  }

  public_deps = [
    "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_cpp",
    "//sdk/fidl/fuchsia.bluetooth.a2dp:fuchsia.bluetooth.a2dp_cpp",
    "//sdk/fidl/fuchsia.bluetooth.affordances:fuchsia.bluetooth.affordances_cpp",
    "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_cpp",
    "//sdk/fidl/fuchsia.bluetooth.le:fuchsia.bluetooth.le_cpp",
    "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_cpp",
    "//src/connectivity/bluetooth/testing/bt-affordances:affordances-c",
    "//third_party/protobuf:protobuf_full",
  ]
  configs += [ ":include_bindings" ]
  public_configs = [ ":pandora_experimental_config" ]
  deps = [
    ":bt-test-interfaces",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/syslog/cpp",
    "//third_party/grpc:grpc++",
  ]
}

executable("bin") {
  output_name = "bt-pandora-server"

  sources = [
    "src/main.cc",
    "src/pandora_fidl_server.cc",
    "src/pandora_fidl_server.h",
    "src/pandora_grpc_server.cc",
    "src/pandora_grpc_server.h",
  ]
  configs += [ ":include_bindings" ]

  deps = [
    ":grpc_services",
    "//sdk/fidl/fuchsia.bluetooth.pandora:fuchsia.bluetooth.pandora_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/syslog/cpp",
    "//third_party/grpc:grpc++",
  ]
}

fuchsia_component("component") {
  component_name = "bt-pandora-server"
  manifest = "meta/bt-pandora-server.cml"
  deps = [ ":bin" ]
}

fuchsia_package("bt-pandora-server") {
  deps = [ ":component" ]
}
