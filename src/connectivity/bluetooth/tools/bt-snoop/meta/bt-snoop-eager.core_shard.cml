{
    children: [
        {
            name: "bt-snoop",
            url: "fuchsia-pkg://fuchsia.com/bt-snoop#meta/bt-snoop.cm",
            startup: "eager",
            environment: "#core-env",
        },
    ],
    offer: [
        {
            service: "fuchsia.hardware.bluetooth.Service",
            from: "parent",
            to: [ "#bt-snoop" ],
        },
        {
            protocol: "fuchsia.feedback.CrashReporter",
            from: "#feedback",
            to: "#bt-snoop",
        },
        {
            protocol: "fuchsia.firmware.crash.Reporter",
            from: "parent",
            to: "#bt-snoop",
            availability: "same_as_target",
        },
        {
            protocol: "fuchsia.bluetooth.snoop.Snoop",
            from: "#bt-snoop",
            to: "self/toolbox",
            target_availability: "unknown",
        },
    ],
}
