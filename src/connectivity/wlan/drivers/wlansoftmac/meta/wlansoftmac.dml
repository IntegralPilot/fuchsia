{
    name: "wlansoftmac",
    include: [
        "driver_component/driver.shard.cml",
        "trace/client.shard.cml",
    ],
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { service: "fuchsia.wlan.softmac.Service" },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.wlan.softmac.Service",
            generate_bind_rule: false,
        },
    ],
}
