import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")

driver_bind_rules("wlantapctl_bind") {
  rules = "meta/wlantap-driver.bind"
  bind_output = "wlantap-driver.bindbc"
  tests = "meta/bind_tests.json"
  deps = [ "//src/devices/bind/fuchsia.test" ]
}

group("tests") {
  testonly = true
  deps = [ ":wlantapctl_bind_test" ]
}

fuchsia_cc_driver("wlantap_driver-driver") {
  output_name = "wlantap"

  sources = [
    "utils.cc",
    "utils.h",
    "wlantap-ctl.cc",
    "wlantap-driver-context.h",
    "wlantap-driver.cc",
    "wlantap-mac.cc",
    "wlantap-mac.h",
    "wlantap-phy-impl.cc",
    "wlantap-phy-impl.h",
    "wlantap-phy.cc",
    "wlantap-phy.h",
  ]

  deps = [
    ":wlantapctl_bind",
    "//sdk/fidl/fuchsia.wlan.common:fuchsia.wlan.common_hlcpp",
    "//sdk/fidl/fuchsia.wlan.driver:fuchsia.wlan.driver_cpp",
    "//sdk/fidl/fuchsia.wlan.phy:fuchsia.wlan.phy_cpp",
    "//sdk/fidl/fuchsia.wlan.softmac:fuchsia.wlan.softmac_cpp",
    "//sdk/fidl/fuchsia.wlan.tap:fuchsia.wlan.tap_cpp",
    "//sdk/lib/driver/logging/cpp",
    "//src/connectivity/wlan/drivers/lib/log/cpp:dfv2",

    # ddk is still needed for ZX_PROTOCOL* definitions
    "//sdk/lib/driver/component/cpp",
    "//sdk/lib/driver/devfs/cpp",
    "//src/connectivity/wlan/lib/common/cpp:common",
    "//src/devices/lib/driver:driver_runtime",
    "//zircon/system/public",
  ]
  configs += [ "//build/config/fuchsia:enable_zircon_asserts" ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}

fuchsia_driver_component("wlantap_driver") {
  info = "meta/wlantap_driver-info.json"
  component_name = "wlantap"
  manifest = "meta/wlantap-driver.cml"
  deps = [ ":wlantap_driver-driver" ]
}
