{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/wlanix",
    },
    capabilities: [
        {
            protocol: [ "fuchsia.wlan.wlanix.Wlanix" ],
        },
    ],
    use: [
        {
            // TODO(fxb/552519222): Capability is currently named SuspendEnabled, but it really
            // means PowerFrameworkEnabled (when false, no power framework calls should be made).
            config: "fuchsia.power.SuspendEnabled",
            key: "power_framework_enabled",
            type: "bool",
        },
        {
            protocol: [ "fuchsia.wlan.device.service.DeviceMonitor" ],
        },
        {
            protocol: [ "fuchsia.metrics.MetricEventLoggerFactory" ],
        },

        // System power level controls.
        {
            protocol: [
                "fuchsia.power.broker.Topology",
                "fuchsia.power.system.ActivityGovernor",
            ],
            availability: "optional",
        },
        {
            service: [ "fuchsia.power.broker.ElementInfoProviderService" ],
            availability: "optional",
        },

        // Not all devices use battery, so we don't expect BatteryManager to always be
        // present. If BatteryManager is not present, the effect is that certain
        // Cobalt metrics that rely on battery states are not logged.
        {
            protocol: [ "fuchsia.power.battery.BatteryManager" ],
            availability: "optional",
        },
        {
            protocol: [ "fuchsia.tracing.provider.Registry" ],
        },
    ],
    expose: [
        {
            protocol: [ "fuchsia.wlan.wlanix.Wlanix" ],
            from: "self",
        },
    ],
}
