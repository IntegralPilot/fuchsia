{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/fake_netcfg_svc",
    },
    capabilities: [
        {
            protocol: [
                "fuchsia.net.policy.properties.Networks",
                "fuchsia.net.policy.socketproxy.NetworkRegistry",
                "fuchsia.net.reachability.Monitor",
            ],
        },
    ],
    expose: [
        {
            protocol: [
                "fuchsia.net.policy.properties.Networks",
                "fuchsia.net.policy.socketproxy.NetworkRegistry",
                "fuchsia.net.reachability.Monitor",
            ],
            from: "self",
        },
    ],
}
