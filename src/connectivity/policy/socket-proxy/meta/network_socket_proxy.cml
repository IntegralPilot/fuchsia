{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/socket_proxy",
    },
    capabilities: [
        {
            protocol: [
                "fuchsia.net.policy.properties.DefaultNetworkWatcher",
                "fuchsia.net.policy.socketproxy.StarnixNetworks",
                "fuchsia.posix.socket.Provider",
                "fuchsia.posix.socket.raw.Provider",
            ],
        },
    ],
    use: [
        {
            protocol: [
                "fuchsia.net.policy.properties.Networks",
                "fuchsia.net.policy.socketproxy.NetworkRegistry",
                "fuchsia.posix.socket.Provider",
                "fuchsia.posix.socket.raw.Provider",
            ],
        },
    ],
    expose: [
        {
            protocol: [
                "fuchsia.net.policy.properties.DefaultNetworkWatcher",
                "fuchsia.net.policy.socketproxy.StarnixNetworks",
                "fuchsia.posix.socket.Provider",
                "fuchsia.posix.socket.raw.Provider",
            ],
            from: "self",
        },
    ],
}
