group("tests") {
  testonly = true
  deps = [
    ":e2e_tests",
    ":tests_no_e2e",
  ]
}

group("tests_no_e2e") {
  testonly = true
  assert_no_deps = e2e_test_libs

  # Add the tests themselves
  deps = [
    ":bazel_tests",
    "bringup:tests",
    "camera:tests",
    "chromium:tests",
    "cobalt:tests",
    "connectivity:tests_no_e2e",
    "developer:tests",
    "devices:tests",
    "diagnostics:tests",
    "factory:tests",
    "firmware:tests",
    "fonts:tests",
    "graphics:tests",
    "hwinfo:tests",
    "intl:tests",
    "lib:tests",
    "media:tests",
    "microfuchsia:tests",
    "paravirtualization:tests",
    "performance:tests",
    "power:tests",
    "recovery:tests_no_e2e",
    "security:tests",
    "sensors:tests",
    "session:tests",
    "settings:tests",
    "starnix:tests",
    "storage:tests",
    "sys:tests",
    "testing:tests",
    "ui:tests",
    "virtualization:tests",
    "zircon:tests",
  ]
}

group("bazel_tests") {
  testonly = true
  deps = [
    "//examples/drivers/simple/dfv2:simple-driver-test",
    "//examples/drivers/template:template-test",
    "//examples/drivers/transport/driver/v2:driver_transport_example_test",
    "//sdk/lib/driver/devicetree/examples/example-board:example-board-test",
    "//src/connectivity/wlan/drivers/third_party/intel/iwlwifi/test:iwlwifi_test_pkg",
    "//src/devices/board/drivers/vim3-devicetree:vim3-devicetree-test",
    "//src/devices/clock/drivers/vim3-clk:vim3-clk-test",
    "//src/devices/gpio/drivers/aml-gpio:aml-gpio-test",
    "//src/devices/i2c/drivers/aml-i2c:aml-i2c-test",
    "//src/devices/i2c/drivers/dw-i2c:dw-i2c-test",
    "//src/devices/rtc/drivers/nxp/pcf8563:pcf8563_test",
    "//src/devices/spmi/lib/hwreg-spmi/cpp:spmi-hwreg-test",
    "//src/diagnostics/archivist/tests/pipeline_test",
    "//src/ui/input/drivers/adc-buttons:adc-buttons-test",
    "//tools/create/goldens:test_pkg",
  ]
  if (target_cpu == "arm64") {
    deps += [
      "//src/devices/usb/drivers/aml-usb-phy:aml-usb-phy-test",
      "//src/media/audio/drivers/aml-g12-tdm:aml-g12-composite-test",
    ]
  }
}

group("e2e_tests") {
  testonly = true
  deps = [
    "developer:e2e_tests",
    "devices:e2e_tests",
    "recovery:e2e_tests",
    "testing:e2e_tests",
    "tests",
    "//src/connectivity/network:e2e_tests",
    "//src/firmware/paver/e2e_tests",
    "//src/sys/pkg:e2e_tests",
    "//src/zircon:e2e_tests",
  ]
}
