import("//build/rust/rustc_binary.gni")

if (is_host) {
  group("bin") {
    public_deps =
        [ "//third_party/rust_crates:mock-omaha-server.mock-omaha-server" ]
  }
}

group("bin-host") {
  public_deps = [ ":bin($host_toolchain)" ]
}

group("host_tests") {
  testonly = true
  public_deps = [ "//third_party/rust_crates:mock-omaha-server.mock-omaha-server.test($host_toolchain)" ]
}
