import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("mock-omaha-server-fuchsia") {
  version = "0.0.1"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-hyper",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:hyper-util",
    "//third_party/rust_crates:mock-omaha-server",
  ]

  sources = [ "src/lib.rs" ]
}

fuchsia_unittest_package("mock-omaha-server-fuchsia-tests") {
  manifest = "meta/mock-omaha-server-fuchsia-tests.cml"
  deps = [
    ":mock-omaha-server-fuchsia_test",
    "//src/connectivity/network:netstack-for-tests",
  ]
}

group("hermetic_tests") {
  testonly = true
  public_deps = [ ":mock-omaha-server-fuchsia-tests" ]
}
