{
    offer: [
        {
            protocol: [
                "fuchsia.cobalt.SystemDataUpdater",
                "fuchsia.metrics.MetricEventLoggerFactory",
            ],
            from: "#cobalt",
            to: "#system-update",
        },

        // TODO(https://fxbug.dev/389134835): Remove the initiator capability.
        {
            protocol: "fuchsia.power.CollaborativeRebootInitiator",
            from: "parent",
            to: "#system-update",
        },
        {
            protocol: "fuchsia.power.internal.CollaborativeRebootScheduler",
            from: "parent",
            to: "#system-update",
        },
        {
            protocol: "fuchsia.stash.Store2",
            from: "#stash2",
            to: "#system-update",
        },
        {
            protocol: [
                "fuchsia.net.name.Lookup",
                "fuchsia.posix.socket.Provider",
            ],
            from: "#network",
            to: "#system-update",
        },
        {
            protocol: [
                "fuchsia.feedback.ComponentDataRegister",
                "fuchsia.feedback.CrashReporter",
            ],
            from: "#feedback",
            to: "#system-update",

            // TODO: break the dependency cycle
            dependency: "weak",
        },
        {
            protocol: "fuchsia.paver.Paver",
            from: "#paver",
            to: "#system-update",
        },
        {
            protocol: "fuchsia.pkg.Cup",
            from: "#pkg-resolver",
            to: "#system-update",
        },
        {
            directory: "build-info",
            from: "parent",
            to: "#system-update",
        },
        {
            directory: "config-data",
            from: "parent",
            as: "omaha-client-service-config-data",
            to: "#system-update",
            subdir: "omaha-client",
        },
        {
            config: [
                "fuchsia.omaha.AllowRebootWhenIdle",
                "fuchsia.omaha.FuzzPercentageRange",
                "fuchsia.omaha.PeriodicIntervalMinutes",
                "fuchsia.omaha.RetryDelaySeconds",
                "fuchsia.omaha.StartupDelaySeconds",
            ],
            from: "parent",
            to: "#system-update",
        },
        {
            config: [
                "fuchsia.omaha_app_id",
                "fuchsia.omaha_url",
                "fuchsia.ota_channel",
                "fuchsia.ota_realm",
                "fuchsia.product_id",
            ],
            from: "parent/boot_args",
            to: "#system-update",
        },
    ],
}
