import("//build/components.gni")
import("//build/rust/rustc_library.gni")

group("service-broker") {
  testonly = true
  deps = [ ":tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":service-broker-unittests" ]
}

rustc_library("lib") {
  name = "service_broker"
  edition = "2024"

  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.data:fuchsia.data_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
    "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
    "//sdk/rust/zx",
    "//src/lib/async-utils",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//src/sys/lib/cm_types",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  test_deps = [ "//src/lib/fuchsia" ]

  sources = [ "src/lib.rs" ]
}

fuchsia_unittest_component("service-broker-unittests-component") {
  component_name = "service-broker-unittests"
  deps = [ ":lib_test" ]
}

fuchsia_test_package("service-broker-unittests") {
  test_components = [ ":service-broker-unittests-component" ]
}
