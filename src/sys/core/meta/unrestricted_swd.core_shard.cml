{
    offer: [
        {
            protocol: "fuchsia.net.http.Loader",
            from: "#network",
            to: [
                "#pkg-resolver",
                "#system-update",
            ],
        },
        {
            protocol: "fuchsia.pkg.http.Client",
            from: "#network",
            to: "#pkg-resolver",
        },
        {
            directory: "root-ssl-certificates",
            from: "parent",
            as: "swd-root-ssl-certificates",
            to: "#system-update",
        },
    ],
}
