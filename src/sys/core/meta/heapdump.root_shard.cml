{
    offer: [
        {
            protocol: "fuchsia.memory.heapdump.process.Registry",
            from: "#core",
            to: "#bootstrap",
            dependency: "weak",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.memory.heapdump.process.Registry",
            from: "#core",
        },
    ],
}
