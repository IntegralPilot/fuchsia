{
    children: [
        {
            name: "persistence",
            url: "fuchsia-pkg://fuchsia.com/diagnostics-persistence#meta/diagnostics-persistence.cm",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.update.Listener",
            from: "parent",
            to: [ "#persistence" ],
        },
        {
            protocol: "fuchsia.power.battery.BatteryManager",
            from: "parent",
            to: "#persistence",
            availability: "same_as_target",
        },
        {
            dictionary: "diagnostics",
            from: "parent",
            to: "#persistence",
        },
        {
            protocol: [ "fuchsia.diagnostics.ArchiveAccessor.previous_boot" ],
            from: "parent/diagnostics-accessors",
            to: [ "#persistence" ],
        },
        {
            storage: "cache",
            from: "parent",
            to: "#persistence",
        },
        {
            config: "fuchsia.diagnostics.persist.SkipUpdateCheck",
            from: "parent",
            to: "#persistence",
        },
        {
            config: "fuchsia.diagnostics.persist.StopOnIdleTimeoutMillis",
            from: "parent",
            to: "#persistence",
            availability: "same_as_target",
        },
        {
            config: "fuchsia.diagnostics.persist.PersistencePeriodSeconds",
            from: "parent",
            to: "#persistence",
            availability: "same_as_target",
        },
        {
            config: "fuchsia.diagnostics.persist.LowBatteryThresholdPercent",
            from: "parent",
            to: "#persistence",
            availability: "same_as_target",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.component.Binder",
            from: "#persistence",
            as: "fuchsia.component.PersistenceBinder",
        },
        {
            protocol: "fuchsia.diagnostics.persistence.PreviousBootDataProvider",
            from: "#persistence",
        },
        {
            protocol: "fuchsia.component.Binder",
            from: "#detect",
            as: "fuchsia.component.DetectBinder",
            source_availability: "unknown",
        },
    ],
}
