import("//build/rust/rustc_binary.gni")
import("//tools/protobuf/rust_proto_library.gni")

assert(is_host, "Only supported on host")

rust_proto_library("cobalt_registry_proto") {
  sources = [ "//third_party/cobalt/src/registry/cobalt_registry.proto" ]
  packages = [ "cobalt" ]
  include_dirs = [ "//third_party/cobalt" ]
}

rustc_binary("merge_sampler_configs") {
  edition = "2024"
  with_unit_tests = true
  sources = [ "src/main.rs" ]
  deps = [
    ":cobalt_registry_proto",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//src/diagnostics/lib/sampler-config",
    "//src/lib/diagnostics/selectors",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:prost",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json5",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":merge_sampler_configs_test" ]
}
