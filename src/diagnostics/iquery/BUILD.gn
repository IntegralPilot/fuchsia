import("//build/components.gni")
import("//build/dist/renamed_binary.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_library.gni")

iquery_common_deps = [
  "//src/lib/diagnostics/data/rust",
  "//src/lib/diagnostics/hierarchy/rust",
  "//src/lib/diagnostics/selectors",
  "//src/lib/fidl/rust/fidl",
  "//src/sys/lib/cm_rust",
  "//src/sys/lib/moniker",
  "//third_party/rust_crates:anyhow",
  "//third_party/rust_crates:argh",
  "//third_party/rust_crates:derivative",
  "//third_party/rust_crates:either",
  "//third_party/rust_crates:nom",
  "//third_party/rust_crates:num-traits",
  "//third_party/rust_crates:serde",
  "//third_party/rust_crates:serde_json",
  "//third_party/rust_crates:thiserror",
]

iquery_sources = [
  "src/commands/list.rs",
  "src/commands/list_accessors.rs",
  "src/commands/mod.rs",
  "src/commands/selectors.rs",
  "src/commands/show.rs",
  "src/commands/types.rs",
  "src/commands/utils.rs",
  "src/text_formatter.rs",
  "src/types.rs",
]

template("iquery_lib") {
  rustc_library(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "deps",
                             "sources",
                             "test_deps",
                           ])
    if (target_name == "lib") {
      name = "iquery"
    } else {
      name = "iquery_fdomain"
    }
    edition = "2024"
    with_unit_tests = true
    source_root = "src/lib.rs"

    visibility = [
      "//src/developer/ffx/plugins/inspect/*",
      "//src/developer/remote-control/diagnostics-bridge/*",
      "//src/diagnostics/iquery/*",
      "//vendor/google/starnix/tests/*",
    ]

    deps = []
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    if (is_fuchsia) {
      deps += [ "//src/lib/diagnostics/reader/rust" ]
    }

    test_deps = [
      "//src/diagnostics/iquery/test_support:iquery_test_support",
      "//src/lib/fuchsia",
      "//third_party/rust_crates:assert_matches",
      "//third_party/rust_crates:test-case",
    ]

    sources = iquery_sources
    if (is_fuchsia) {
      sources += [
        "src/command_line.rs",
        "src/commands/target.rs",
      ]
    }
    sources += [ "src/lib.rs" ]

    configs += [ "//build/config/rust/lints:clippy_warn_all" ]
  }
}

iquery_lib("lib") {
  deps = [
           "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_flex",
           "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust_flex",
           "//sdk/fidl/fuchsia.io:fuchsia.io_rust_flex",
           "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_flex",
           "//src/lib/fdomain/client:flex_fidl",
           "//src/lib/fuchsia-fs",
           "//src/sys/lib/component_debug",
         ] + iquery_common_deps
}

iquery_lib("lib_fdomain") {
  deps = [
           "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain_flex",
           "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust_fdomain_flex",
           "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain_flex",
           "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain_flex",
           "//src/lib/fdomain/client:flex_fdomain",
           "//src/lib/fuchsia-fs:fuchsia-fs_fdomain",
           "//src/sys/lib/component_debug:component_debug_fdomain",
         ] + iquery_common_deps
  features = [ "fdomain" ]
}

rustc_binary("bin") {
  output_name = "iquery"
  edition = "2024"
  source_root = "src/main.rs"

  if (is_fuchsia) {
    configs += [ "//build/config/rust:bootfs" ]
  }

  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.diagnostics.system:fuchsia.diagnostics.system_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]

  sources = [ "src/main.rs" ]

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
}

renamed_binary("inspect_bin") {
  dest = "bin/inspect"
  source = "$root_out_dir/iquery"
  source_deps = [ ":bin" ]
}

fuchsia_unittest_package("test_iquery_lib_unittests") {
  deps = [
    ":lib_test",
    "//src/diagnostics/iquery/test_support:iquery_test_support",
    "//third_party/rust_crates:assert_matches",
  ]
}

rustc_test("iquery_test") {
  edition = "2024"
  output_name = "iquery_test"
  source_root = "src/main.rs"
  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//sdk/fidl/fuchsia.diagnostics.system:fuchsia.diagnostics.system_rust",
    "//sdk/fidl/fuchsia.inspect:fuchsia.inspect_rust",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/fidl/fuchsia.tracing.provider:fuchsia.tracing.provider_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/sys/lib/cm_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
  ]
  sources = [
    "src/main.rs",
    "src/tests/commands.rs",
    "src/tests/mod.rs",
    "src/tests/utils.rs",
  ]
  inputs = [
    "test_data/list_accessors.json",
    "test_data/list_accessors.text",
    "test_data/list_archive.json",
    "test_data/list_archive.text",
    "test_data/list_filter_manifest.json",
    "test_data/list_filter_manifest.text",
    "test_data/list_no_dups.json",
    "test_data/list_no_dups.text",
    "test_data/list_test.json",
    "test_data/list_test.text",
    "test_data/list_with_url.json",
    "test_data/list_with_url.text",
    "test_data/selectors_filter_test_serve_fs.json",
    "test_data/selectors_filter_test_serve_fs.text",
    "test_data/selectors_filter_test.json",
    "test_data/selectors_filter_test.text",
    "test_data/selectors_test.json",
    "test_data/selectors_test.text",
    "test_data/show_filter_test.text",
    "test_data/show_filter_test.json",
    "test_data/show_filter_test_serve_fs.text",
    "test_data/show_filter_test_serve_fs.json",
    "test_data/show_test.json",
    "test_data/show_test.text",
  ]

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("iquery-test") {
  testonly = true
  manifest = "meta/iquery-test.cml"
  deps = [ ":iquery_test" ]
  check_includes = false
}

fuchsia_test_package("iquery-tests") {
  test_components = [ ":iquery-test" ]
  deps = [
    "test/basic_component",
    "test/test_component",
    "test_data:goldens",
    "//src/diagnostics/archivist:archivist-for-embedding-bundle",
  ]
}

group("tests") {
  testonly = true

  deps = [
    ":iquery-tests",
    ":lib_test($host_toolchain)",
    ":test_iquery_lib_unittests",
  ]
}

group("iquery") {
  deps = [
    ":bin",
    ":inspect_bin",
    "//build/validate:non_production_tag",
  ]
}

fuchsia_package("package") {
  package_name = "iquery"
  deps = [ ":iquery" ]
}
