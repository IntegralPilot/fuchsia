import("//build/components.gni")

executable("bin") {
  output_name = "audio-codec-ctl"
  sources = [ "main.cc" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_cpp",
    "//sdk/lib/component/incoming/cpp",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_package("audio-codec-ctl") {
  deps = [ ":bin" ]
}
