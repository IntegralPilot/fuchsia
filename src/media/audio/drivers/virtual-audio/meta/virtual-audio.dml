{
    name: "virtual-audio-driver",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/virtual-audio-driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            one_of: [
                { compat: "fuchsia,virtual-audio" },
                {
                    vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                    pid: "fuchsia.platform.BIND_PLATFORM_DEV_PID.GENERIC",
                    did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.VIRTUAL_AUDIO",
                },
            ],
        },
    },
}
