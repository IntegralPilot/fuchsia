{
    name: "max98373",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/max98373.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "acpi",
            service: "fuchsia.hardware.acpi.Service",
        },
        {
            name: "default",
            service: "fuchsia.hardware.gpio.Service",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.i2c.Service",
            generate_bind_rule: false,
        },
        {
            name: "irq000",
            service: "fuchsia.hardware.interrupt.Service",
        },
        {
            name: "acpi",
            primary: true,
            bind: {
                banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE",
                one_of: [
                    {
                        rules: {
                            "fuchsia.BIND_ACPI_BUS_TYPE": "fuchsia.acpi.BIND_ACPI_BUS_TYPE.I2C",
                            "fuchsia.acpi.HID": "MX98373",
                        },
                    },
                    {
                        rules: {
                            "fuchsia.BIND_PLATFORM_DEV_VID": "fuchsia.maxim.platform.BIND_PLATFORM_DEV_VID.MAXIM",
                            "fuchsia.BIND_PLATFORM_DEV_DID": "fuchsia.maxim.platform.BIND_PLATFORM_DEV_DID.MAX98373",
                        },
                    },
                ],
            },
        },
    ],
}
