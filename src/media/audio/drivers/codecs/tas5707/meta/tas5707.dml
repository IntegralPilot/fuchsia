{
    name: "tas5707",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/tas5707.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            vid: "fuchsia.ti.platform.BIND_PLATFORM_DEV_VID.TI",
            did: "fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.TAS5707",
            rules: { "fuchsia.BIND_COMPOSITE": 1 },
        },
    },
    use: [
        { service: "fuchsia.hardware.i2c.Service" },
    ],
}
