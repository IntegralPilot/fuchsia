import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")

fuchsia_driver_dml("tas5707_dml") {
  dml = "meta/tas5707.dml"
  driver_name = "tas5707"
}

driver_bind_rules("ti_tas5707-bind") {
  dml_label = ":tas5707_dml"
  bind_output = "tas5707.bindbc"
  tests = "meta/tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.ti.platform",
  ]
}

fuchsia_cc_driver("tas5707-driver") {
  legacy = true
  output_name = "tas5707"
  configs += [ "//build/config/fuchsia:enable_zircon_asserts" ]
  sources = [ "tas5707.cc" ]
  deps = [
    ":ti_tas5707-bind",
    "//sdk/fidl/fuchsia.hardware.ti.metadata:fuchsia.hardware.ti.metadata_cpp",
    "//src/devices/i2c/lib/i2c-channel-legacy",
    "//src/devices/lib/driver",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//src/media/audio/lib/simple-codec",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_driver_component("tas5707") {
  component_name = "tas5707"
  deps = [ ":tas5707-driver" ]
  info = "meta/tas5707-info.json"
  cm_label = ":tas5707_dml_manifest"
}
