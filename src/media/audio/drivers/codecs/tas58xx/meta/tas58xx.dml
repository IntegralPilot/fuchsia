{
    name: "tas58xx",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        compat: "driver/tas58xx.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.audio.CodecService" },
    ],
    use: [
        {
            name: "gpio-init",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "gpio-fault",
            service: "fuchsia.hardware.gpio.Service",
            bind: {
                rules: { "fuchsia.NAME": "gpio-fault" },
            },
        },
        {
            name: "i2c",
            service: "fuchsia.hardware.i2c.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.i2c.Service",
                vid: "fuchsia.ti.platform.BIND_PLATFORM_DEV_VID.TI",
                did: "fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.TAS58xx",
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
        },
        {
            name: "pdev",
            bind: {
                banjo: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                vid: "fuchsia.ti.platform.BIND_PLATFORM_DEV_VID.TI",
                did: "fuchsia.ti.platform.BIND_PLATFORM_DEV_DID.TAS58xx",
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.audio.CodecService",
            from: "self",
        },
    ],
}
