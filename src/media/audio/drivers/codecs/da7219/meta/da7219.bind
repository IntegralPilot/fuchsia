composite da7219;


primary parent "acpi" {
  fuchsia.BIND_PROTOCOL == fuchsia.acpi.BIND_PROTOCOL.DEVICE;
  fuchsia.BIND_ACPI_BUS_TYPE == fuchsia.acpi.BIND_ACPI_BUS_TYPE.I2C;
  fuchsia.acpi.HID == "DLGS7219";
}

parent "irq000" {
  fuchsia.Service == "fuchsia.hardware.interrupt.Service";
}
