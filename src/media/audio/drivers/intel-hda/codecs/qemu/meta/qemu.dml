{
    name: "qemu",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/qemu-audio-codec.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            protocol: "fuchsia.audio.intelhda.BIND_PROTOCOL.IHDA_CODEC",
            rules: {
                "fuchsia.BIND_IHDA_CODEC_DID": "0x0022",
                "fuchsia.BIND_IHDA_CODEC_VID": "fuchsia.audio.intelhda.BIND_IHDA_CODEC_VID.RED_HAT",
            },
        },
    },
}
