{
    name: "test-codec",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/codec-test-driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            rules: { "fuchsia.test.TEST_CHILD": "\"codec\"" },
        },
    },
}
