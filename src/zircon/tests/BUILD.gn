# Note: Tests specified using `bootfs_test` are included via
# //products/bringup_with_tests and not this target.
group("tests") {
  testonly = true
  deps = [
    "events:tests",
    "exception:tests",
    "futex-ownership:tests",
    "handle-alias:tests",
    "kernel-clocks:tests",
    "next-vdso:tests",
    "processor:tests",
    "restricted-mode-shared:tests",
    "status:tests",
    "stress-tests:tests",
    "vmo:tests",
    "x86-umip:tests",
  ]
}
