load("@fuchsia_build_info//:args.bzl", "build_info_version")
load(
    "@rules_fuchsia//fuchsia:assembly.bzl",
    "ARCH",
    "BUILD_TYPES",
    "fuchsia_elf_sizes",
    "fuchsia_prebuilt_package",
    "fuchsia_product",
    "fuchsia_product_bundle",
    "fuchsia_product_configuration",
    "fuchsia_virtual_device",
)
load("//build/info:info.bzl", "DEFAULT_PRODUCT_BUILD_INFO")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = [
        "//build/bazel/assembly:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)

fuchsia_product_bundle(
    name = "product_bundle_eng.x64",
    default_virtual_device = ":workbench_emu",
    main = ":assembly_eng.x64",
    product_bundle_name = "workbench_eng.x64",
    recovery = "//products/zedboot:x64",
    repository_keys = "//src/sys/pkg/repositories/devhost/keys",
    update_epoch = "1",
    virtual_devices = [
        ":workbench_emu",
    ],
)

fuchsia_product_bundle(
    name = "product_bundle_eng.arm64",
    default_virtual_device = ":workbench_emu.arm64",
    main = ":assembly_eng.arm64",
    product_bundle_name = "workbench_eng.arm64",
    recovery = "//products/zedboot:arm64",
    repository_keys = "//src/sys/pkg/repositories/devhost/keys",
    update_epoch = "1",
    virtual_devices = [
        ":workbench_emu.arm64",
    ],
)

fuchsia_product_bundle(
    name = "product_bundle_eng.vim3",
    main = ":assembly_eng.vim3",
    product_bundle_name = "workbench_eng.vim3",
    recovery = "//products/zedboot:vim3_recovery",
    repository_keys = "//src/sys/pkg/repositories/devhost/keys",
    update_epoch = "1",
)

fuchsia_product(
    name = "assembly_eng.x64",
    board_config = "//boards:x64",
    platform_artifacts = "//build/bazel/assembly/assembly_input_bundles:platform_eng",
    product_config = ":assembly_config_eng",
)

fuchsia_product(
    name = "assembly_eng.arm64",
    board_config = "//boards:arm64",
    platform_artifacts = "//build/bazel/assembly/assembly_input_bundles:platform_eng",
    product_config = ":assembly_config_eng",
)

fuchsia_product(
    name = "assembly_eng.vim3",
    board_config = "//boards:vim3",
    platform_artifacts = "//build/bazel/assembly/assembly_input_bundles:platform_eng",
    product_config = ":assembly_config_eng",
)

fuchsia_elf_sizes(
    name = "elf_sizes.x64",
    product = ":assembly_eng.x64",
)

fuchsia_elf_sizes(
    name = "elf_sizes.arm64",
    product = ":assembly_eng.arm64",
)

fuchsia_elf_sizes(
    name = "elf_sizes.vim3",
    product = ":assembly_eng.vim3",
)

fuchsia_virtual_device(
    name = "workbench_emu",
    arch = ARCH.X64,
    audio_model = "hda",
    device_name = "workbench_emu",
    input_device = "touch",
    window_height_px = 1200,
    window_width_px = 720,
)

fuchsia_virtual_device(
    name = "workbench_emu.arm64",
    arch = ARCH.ARM64,
    audio_model = "hda",
    device_name = "workbench_emu.arm64",
    input_device = "touch",
    window_height_px = 1200,
    window_width_px = 720,
)

fuchsia_product_configuration(
    name = "assembly_config_eng",
    cache_packages = [
        ":workbench_session",
    ],
    product_config_json = {
        "platform": {
            "build_type": BUILD_TYPES.ENG,
            "battery": {
                "enabled": True,
            },
            "connectivity": {
                "network": {
                    "networking": "standard",
                    "netcfg_config_path": "LABEL(//src/connectivity/policy/netcfg/config:netcfg_default.json5)",
                    "include_tun": True,
                    "netstack_multi_vmo": True,
                },
            },
            "development_support": {
                "tools": {
                    "audio": {
                        "driver_tools": True,
                        "legacy_driver_tools": True,
                        "virtual_audio": {
                            "modern": True,
                            "legacy": True,
                            "tools": True,
                        },
                    },
                    "display": {
                        "driver_tools": True,
                    },
                    "connectivity": {
                        "enable_networking": True,
                        "enable_wlan": True,
                        "enable_thread": True,
                    },
                },
            },
            "timekeeper": {
                "first_sampling_delay_sec": 86400,
                "back_off_time_between_pull_samples_sec": 86400,
            },
            "media": {
                "audio": {
                    "device_registry": {},
                },
            },
            "starnix": {
                "enabled": True,
            },
            "usb": {
                "peripheral": {
                    "functions": [
                        "cdc",
                        "vsock_bridge",
                    ],
                },
            },
            "session": {
                "enabled": True,
            },
            "ui": {
                "display_composition": True,
                "enabled": True,
                "supported_input_devices": [
                    "button",
                    "keyboard",
                    "mouse",
                    "touchscreen",
                ],
                "with_synthetic_device_support": True,
            },
            "power": {
                "suspend_enabled": True,
            },
            "kernel": {
                "oom": {
                    "behavior": {
                        "reboot": {
                            "timeout": "low",
                        },
                    },
                },
                "scheduler_enable_new_wakeup_accounting": True,
            },
            "memory_monitor": {
                "memory_monitor_versions": ["v2"],
            },
        },
        "product": {
            "session": {
                "url": "fuchsia-pkg://fuchsia.com/workbench_session#meta/workbench_session.cm",
            },
            "build_info": DEFAULT_PRODUCT_BUILD_INFO | {
                "name": "workbench_eng",
            },
        },
    },
    version = build_info_version,
)

fuchsia_prebuilt_package(
    name = "workbench_session",
    archive = "@gn_targets//products/workbench/workbench_session:workbench_session_archive",
)
