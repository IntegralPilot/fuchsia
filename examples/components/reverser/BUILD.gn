import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

fuchsia_component_manifest("reverser_manifest") {
  component_name = "reverser"
  manifest = "meta/reverser.cml"
}

fuchsia_structured_config_rust_lib("reverser_config") {
  cm_label = ":reverser_manifest"
}

fuchsia_structured_config_values("reverser_config_default_values") {
  cm_label = ":reverser_manifest"
  values = {
    switch_case = false
    use_replacer = false
  }
}

rustc_binary("bin") {
  output_name = "reverser_bin"
  edition = "2024"

  deps = [
    ":reverser_config",
    "//examples/components/reverser/fidl:fuchsia.examples.reverser_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]

  sources = [ "src/main.rs" ]
}

fuchsia_component("reverser_component") {
  component_name = "reverser"
  cm_label = ":reverser_manifest"
  deps = [
    ":bin",
    ":reverser_config_default_values",
  ]
}

fuchsia_package("reverser") {
  deps = [ ":reverser_component" ]
}

group("tests") {
  testonly = true
  deps = [
    "tests:reverser_integration_test",
    "trf_test:reverser_trf_test",
  ]
}
