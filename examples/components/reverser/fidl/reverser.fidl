@available(added=HEAD)
library fuchsia.examples.reverser;

const MAX_STRING_LENGTH uint64 = 256;

@discoverable
closed protocol Reverser {
    strict Reverse(struct {
        value string:MAX_STRING_LENGTH;
    }) -> (struct {
        response string:MAX_STRING_LENGTH;
    });
};

@discoverable
closed protocol Replacer {
    strict Replace(struct {
        value string:MAX_STRING_LENGTH;
    }) -> (struct {
        response string:MAX_STRING_LENGTH;
    });
};
