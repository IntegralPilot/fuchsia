{
    name: "child-driver",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/zircon_transport_rust_child.so",
        bind: { service: "fuchsia.hardware.i2c.Service" },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.i2c.Service",
            generate_bind_rule: false,
        },
    ],
}
