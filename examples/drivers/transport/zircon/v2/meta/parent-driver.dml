{
    name: "parent-driver",
    program: {
        binary: "driver/zircon_transport_parent.so",
        bind: {
            one_of: [
                { protocol: "fuchsia.test.BIND_PROTOCOL.PARENT" },
                {
                    rules: { "gizmo.example.TEST_NODE_ID": "zircon_transport_parent" },
                },
            ],
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.i2c.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.i2c.Service",
            from: "self",
        },
    ],
}
