import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

fuchsia_driver_dml("child-driver-dml") {
  dml = "meta/child-driver.dml"
  driver_name = "zircon_transport_child"
}

driver_bind_rules("bind") {
  dml_label = ":child-driver-dml"
  bind_output = "child-driver.bindbc"
  deps = [ "//src/devices/bind/fuchsia" ]
}

fuchsia_rust_driver("driver") {
  edition = "2024"
  with_unit_tests = true

  output_name = "zircon_transport_rust_next_child"
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_rust_next",
    "//sdk/lib/driver/component/rust",
    "//sdk/rust/zx",
    "//src/devices/bind/fuchsia.test:fuchsia.test_rust",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
  ]
  test_deps = [
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
    "//sdk/lib/driver/runtime/rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_driver_component("component") {
  dml_label = ":child-driver-dml"
  deps = [
    ":bind",
    ":driver",
  ]
  info = "meta/component-info.json"
}

fuchsia_unittest_package("test-pkg") {
  package_name = "zircon_transport_rust_next_child_test"
  deps = [ ":driver_test" ]
}
