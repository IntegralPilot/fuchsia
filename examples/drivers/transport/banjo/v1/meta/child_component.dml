{
    name: "child-driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        compat: "driver/banjo_transport_child_v1.so",
        colocate: "true",
        bind: { protocol: "fuchsia.platform.BIND_PROTOCOL.MISC" },
    },
}
