{
    name: "child-driver",
    program: {
        binary: "driver/banjo_transport_child.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        colocate: "true",
        bind: {
            protocol: "fuchsia.platform.BIND_PROTOCOL.MISC",
            rules: { "gizmo.example.TEST_NODE_ID": "banjo_child" },
        },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.driver.compat.Service",
            generate_bind_rule: false,
        },
    ],
}
