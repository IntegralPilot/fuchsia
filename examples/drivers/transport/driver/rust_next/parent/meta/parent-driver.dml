{
    name: "parent-driver",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/driver_transport_rust_next_parent.so",
        colocate: "true",
        bind: {
            one_of: [
                { protocol: "fuchsia.test.BIND_PROTOCOL.PARENT" },
                {
                    rules: { "gizmo.example.TEST_NODE_ID": "driver_transport_rust_next_parent" },
                },
            ],
        },
    },
    capabilities: [
        { service: "fuchsia.hardware.i2cimpl.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.i2cimpl.Service",
            from: "self",
        },
    ],
}
