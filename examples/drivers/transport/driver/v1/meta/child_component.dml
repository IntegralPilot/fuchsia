{
    name: "child-driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        compat: "driver/driver_transport_child_v1.so",
        colocate: "true",
        bind: { service: "fuchsia.examples.gizmo.Service" },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.examples.gizmo.Service",
            generate_bind_rule: false,
        },
    ],
}
