{
    name: "parent-driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        compat: "driver/driver_transport_parent_v1.so",
        colocate: "true",
        bind: { protocol: "fuchsia.test.BIND_PROTOCOL.PARENT" },
    },
    capabilities: [
        { service: "fuchsia.examples.gizmo.Service" },
    ],
    expose: [
        {
            service: "fuchsia.examples.gizmo.Service",
            from: "self",
        },
    ],
}
