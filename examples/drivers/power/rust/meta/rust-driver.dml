{
    name: "rust",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/power_rust_driver.so",
        bind: {
            rules: { "gizmo.example.TEST_NODE_ID": "power_rust_driver" },
        },
    },
    use: [
        { protocol: "fuchsia.power.system.ActivityGovernor" },
    ],
}
