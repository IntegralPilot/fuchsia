{
    name: "simple_driver",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        compat: "driver/simple_dfv1.so",
        colocate: "true",
        bind: {
            rules: { "gizmo.example.TEST_NODE_ID": "simple_driver_v1" },
        },
    },
}
