{
    name: "interrupt_handling_driver_rust",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        bind: { protocol: "fuchsia.gpio.BIND_PROTOCOL.DEVICE" },
    },
    use: [
        {
            name: "default",
            service: "fuchsia.hardware.gpio.Service",
            generate_bind_rule: false,
        },
    ],
}
