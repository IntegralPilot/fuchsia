{
    name: "forwarder",
    program: {
        binary: "driver/forwarder_driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: {
            rules: { "fuchsia.examples.metadata.CHILD_TYPE": "fuchsia.examples.metadata.CHILD_TYPE.FORWARDER" },
        },
    },
    capabilities: [
        { service: "fuchsia.examples.metadata.Metadata" },
    ],
    use: [
        {
            name: "default",
            service: "fuchsia.examples.metadata.Metadata",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.examples.metadata.Metadata",
            from: "self",
        },
    ],
}
