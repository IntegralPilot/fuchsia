{
    name: "example_config_driver_rust",
    program: {
        bind: {
            rules: { "gizmo.example.TEST_NODE_ID": "config_driver_rust" },
        },
    },
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "suspend_enabled",
            type: "bool",
        },
    ],
}
