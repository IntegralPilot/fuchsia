import("//build/bazel/bazel_host_tool.gni")
import("//build/host.gni")
import("//build/sdk/sdk_host_tool.gni")

# TODO(https://fxbug.dev/438572714): Remove once IDK uses Bazel atom metadata.
sdk_host_tool("orchestrate_sdk") {
  category = "partner"
  output_name = "orchestrate"
  deps = [ ":orchestrate" ]
}

bazel_host_tool("orchestrate") {
  bazel_target = "//tools/orchestrate:orchestrate"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/orchestrate_/orchestrate"
}
