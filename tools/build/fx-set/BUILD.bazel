load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "main",
    srcs = [
        "cmd/main.go",
        "cmd/xattr_linux.go",
        "cmd/xattr_other.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/build/fx-set/cmd",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        "//third_party/golibs:github.com/spf13/pflag",
        "//tools/integration/fint:fint_lib",
        "//tools/integration/fint:proto_lib",
        "//tools/lib/color",
        "//tools/lib/logger",
        "//tools/lib/osmisc",
        "//tools/lib/subprocess",
    ],
)

go_binary_host_tool(
    name = "fx-set",
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
)

host_go_test(
    name = "fx_set_tests",
    srcs = [
        "cmd/main_test.go",
    ],
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:github.com/google/go-cmp/cmp/cmpopts",
        "//third_party/golibs:google.golang.org/protobuf/proto",
        "//third_party/golibs:google.golang.org/protobuf/testing/protocmp",
        "//tools/integration/fint:proto_lib",
        "//tools/lib/osmisc",
        "//tools/lib/subprocess",
    ],
)

test_suite(
    name = "tests",
    tests = [":fx_set_tests"],
    visibility = ["//tools:__pkg__"],
)
