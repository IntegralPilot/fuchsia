TEST_get-ssh-components-unbuilt-ffx() {
  local ffx_backup="${ffx}.bak"
  mv "${ffx}" "${ffx_backup}"

  # Test with FUCHSIA_SSH_KEY and FUCHSIA_AUTHORIZED_KEYS pointing to existing files
  local custom_priv="${BT_TEMP_DIR}/custom_priv"
  local custom_auth="${BT_TEMP_DIR}/custom_auth"
  touch "${custom_priv}" "${custom_auth}"

  (
    export FUCHSIA_SSH_KEY="${custom_priv}"
    export FUCHSIA_AUTHORIZED_KEYS="${custom_auth}"
    BT_EXPECT_EQ "$(get-ssh-privkey)" "${custom_priv}"
    BT_EXPECT_EQ "$(get-ssh-authkeys)" "${custom_auth}"
  )

  # Test with default HOME/.ssh keys
  local fake_home="${BT_TEMP_DIR}/fake_home"
  mkdir -p "${fake_home}/.ssh"
  local default_priv="${fake_home}/.ssh/fuchsia_ed25519"
  local default_auth="${fake_home}/.ssh/fuchsia_authorized_keys"
  touch "${default_priv}" "${default_auth}"

  (
    export HOME="${fake_home}"
    unset FUCHSIA_SSH_KEY
    unset FUCHSIA_AUTHORIZED_KEYS
    BT_EXPECT_EQ "$(get-ssh-privkey)" "${default_priv}"
    BT_EXPECT_EQ "$(get-ssh-authkeys)" "${default_auth}"
  )

  mv "${ffx_backup}" "${ffx}"
}

