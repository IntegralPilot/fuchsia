TEST_ota_packageless() {
  echo "0" > "${check_package_server}.mock_status" # package server is running
  setup_versions_after_update "1" "1"
  setup_ffx

  local out="${BT_TEMP_DIR}/_fx_ota_output"
  BT_EXPECT ${fx} ota --no-build --packageless > "$out" 2>&1
  # update was triggered
  BT_ASSERT_FILE_EXISTS "${trigger_update}.mock_state"
  # reboot was called with reason
  btf::expect-mock-args "${trigger_reboot}" "target" "reboot" "--reason" "system-update"
  # update was committed
  BT_ASSERT_FILE_EXISTS "${commit_update}.mock_state"
  # check that ffx was called with --reboot false, --product-bundle and --packageless
  btf::expect-mock-args "${trigger_update}" "target" "update" "force-install" "--reboot" "false" "--product-bundle" "--packageless"
}

TEST_ota_no_packageless() {
  echo "0" > "${check_package_server}.mock_status" # package server is running
  setup_versions_after_update "1" "1"

  local ffx="$(btf::make_installed_hosttools_mock ffx)"
  cat > "${ffx}.mock_side_effects" <<EOF
   if [[ "\$@" == "target update force-install --reboot false" ]]; then
     $trigger_update "\$@"
     return
   elif [[ "\$@" == "target reboot --reason system-update" ]]; then
     $trigger_reboot "\$@"
     return
   else
     echo "unknown command \$@" 1>&2
     exit 1
  fi
EOF

  local out="${BT_TEMP_DIR}/_fx_ota_output"
  BT_EXPECT ${fx} ota --no-build --no-packageless > "$out" 2>&1
  # update was triggered
  BT_ASSERT_FILE_EXISTS "${trigger_update}.mock_state"
  # reboot was called with reason
  btf::expect-mock-args "${trigger_reboot}" "target" "reboot" "--reason" "system-update"
  # update was committed
  BT_ASSERT_FILE_EXISTS "${commit_update}.mock_state"
  # check that ffx was called with --reboot false and without --packageless
  btf::expect-mock-args "${trigger_update}" "target" "update" "force-install" "--reboot" "false"
}

TEST_ota_update_failed() {
  echo "0" > "${check_package_server}.mock_status" # package server is running
  setup_versions_after_update "1" "2"
  setup_ffx

  local out="${BT_TEMP_DIR}/_fx_ota_output"
  BT_EXPECT_FAIL ${fx} ota --no-build > "$out" 2>&1
  # update was not triggered
  BT_ASSERT_FILE_EXISTS "${trigger_update}.mock_state"
  # update was not committed
  BT_ASSERT_FILE_EXISTS "${commit_update}.mock_state"
}

TEST_ota_nopackageserver() {
  echo "1" > "${check_package_server}.mock_status" # package server is not running
  setup_ffx

  local out="${BT_TEMP_DIR}/_fx_ota_output"
  # ota fails because package server is not running
  BT_EXPECT_FAIL ${fx} ota --no-packageless > "$out" 2>&1

  # build was not called
  BT_ASSERT_FILE_DOES_NOT_EXIST "${build}.mock_state"
}

TEST_ota_serve() {
  echo "1" > "${check_package_server}.mock_status" # package server is not running
  setup_versions_after_update "1" "1"

  local ffx="$(btf::make_installed_hosttools_mock ffx)"
  local stop_called="${BT_TEMP_DIR}/stop_called"
  btf::make_mock "$stop_called"

  cat > "${ffx}.mock_side_effects" <<EOF
   if [[ "\$@" == "target update force-install --reboot false" ]]; then
     $trigger_update "\$@"
     return
   elif [[ "\$@" == "target reboot --reason system-update" ]]; then
     $trigger_reboot "\$@"
     return
   elif [[ "\$@" == "repository server stop fx-ota-serve-"* ]]; then
     $stop_called "\$@"
     return
   fi
EOF

  local serve_mock="${BT_TEMP_DIR}/tools/devshell/serve"
  cat >> "${serve_mock}.mock_side_effects" <<EOF
    echo "0" > "${check_package_server}.mock_status"
EOF

  local out="${BT_TEMP_DIR}/_fx_ota_output"
  BT_EXPECT ${fx} ota --no-packageless --serve > "$out" 2>&1

  # Assert serve was called
  BT_ASSERT_FILE_EXISTS "${serve_mock}.mock_state"

  # Assert update was triggered
  BT_ASSERT_FILE_EXISTS "${trigger_update}.mock_state"

  # Assert reboot was called with reason
  btf::expect-mock-args "${trigger_reboot}" "target" "reboot" "--reason" "system-update"

  # Assert stop was called
  BT_ASSERT_FILE_EXISTS "${stop_called}.mock_state"
}

TEST_ota_serve_packageless() {
  echo "0" > "${check_package_server}.mock_status"
  setup_versions_after_update "1" "1"
  setup_ffx

  local serve_mock="${BT_TEMP_DIR}/tools/devshell/serve"

  local out="${BT_TEMP_DIR}/_fx_ota_output"
  BT_EXPECT ${fx} ota --no-build --serve > "$out" 2>&1

  # Assert serve was not called
  BT_ASSERT_FILE_DOES_NOT_EXIST "${serve_mock}.mock_state"

  # Assert update was triggered
  BT_ASSERT_FILE_EXISTS "${trigger_update}.mock_state"
  # Assert reboot was called with reason
  btf::expect-mock-args "${trigger_reboot}" "target" "reboot" "--reason" "system-update"
  # Assert update was committed
  BT_ASSERT_FILE_EXISTS "${commit_update}.mock_state"
}

BT_RUN_TESTS "$@"
