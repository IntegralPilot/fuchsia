import("//build/bazel/bazel_host_tool.gni")

assert(is_host, "bazel_host_tool() can only be called in a host toolchain.")

bazel_host_tool("readme_fuchsia") {
  bazel_target = ":readme_fuchsia_bin"
  bazel_output_path =
      "{{BAZEL_TARGET_OUT_DIR}}/readme_fuchsia_bin_/readme_fuchsia_bin"
  install_host_tool = true
}
