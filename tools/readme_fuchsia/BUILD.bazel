load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "readme_fuchsia_lib",
    srcs = [
        "fields.go",
        "formatter.go",
        "parser.go",
        "types.go",
        "validate.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/readme_fuchsia",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = [
        "//tools/check-licenses:__pkg__",
    ],
)

go_library(
    name = "main",
    srcs = ["cmd/main.go"],
    importpath = "go.fuchsia.dev/fuchsia/tools/readme_fuchsia/cmd",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        ":readme_fuchsia_lib",
    ],
)

go_binary_host_tool(
    name = "readme_fuchsia_bin",
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
)

host_go_test(
    name = "readme_fuchsia_test",
    srcs = [
        "fields_test.go",
        "formatter_test.go",
        "parser_test.go",
        "validate_test.go",
    ],
    embed = [":readme_fuchsia_lib"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = [
        "//tools/check-licenses:__pkg__",
    ],
)

host_go_test(
    name = "main_test",
    srcs = ["cmd/main_test.go"],
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
)

test_suite(
    name = "tests",
    tests = [
        ":main_test",
        ":readme_fuchsia_test",
    ],
    visibility = ["//tools:__pkg__"],
)
