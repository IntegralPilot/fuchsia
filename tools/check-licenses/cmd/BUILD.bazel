load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "main",
    srcs = [
        "allowlist.go",
        "classify.go",
        "common.go",
        "copyright.go",
        "fix.go",
        "generate.go",
        "main.go",
        "policy.go",
        "project.go",
        "project_check.go",
        "project_info.go",
        "project_list.go",
        "project_update.go",
        "readme.go",
        "validate.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/check-licenses/cmd",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools/check-licenses:__subpackages__"],
    deps = [
        "//third_party/golibs:github.com/google/subcommands",
        "//tools/check-licenses:config",
        "//tools/check-licenses:pipeline",
        "//tools/check-licenses:readme",
        "//tools/check-licenses:stages_boundary",
        "//tools/check-licenses:stages_classify",
        "//tools/check-licenses:stages_discover",
        "//tools/check-licenses:stages_prune",
        "//tools/check-licenses:stages_report",
        "//tools/check-licenses:stages_validate",
        "//tools/check-licenses/metrics",
        "//tools/check-licenses/util",
        "//tools/lib/logger",
    ],
)

host_go_test(
    name = "cmd_test",
    size = "small",
    srcs = [
        "allowlist_test.go",
        "classify_test.go",
        "copyright_test.go",
        "fix_test.go",
        "generate_test.go",
        "policy_test.go",
        "project_test.go",
        "readme_test.go",
        "validate_test.go",
    ],
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools/check-licenses:__subpackages__"],
)
