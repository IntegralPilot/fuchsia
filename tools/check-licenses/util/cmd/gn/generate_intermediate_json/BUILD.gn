import("//build/bazel/bazel_host_tool.gni")

assert(is_host, "bazel_host_tool() can only be called in a host toolchain.")

bazel_host_tool("generate_intermediate_json_cmd") {
  bazel_target = ":generate_intermediate_json_cmd"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/generate_intermediate_json_cmd_/generate_intermediate_json_cmd"
  install_host_tool = true
}
