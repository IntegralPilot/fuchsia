load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")
load("//build/tools/bazel2gn/bazel_rules:defs.bzl", "install_host_tools")

package(default_applicable_licenses = ["//:license"])

go_binary_host_tool(
    name = "check-licenses",
    embed = ["//tools/check-licenses/cmd:main"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//visibility:public"],
)

install_host_tools(
    name = "host",
    implementation_deps = [":check-licenses"],
    target_compatible_with = HOST_CONSTRAINTS,
    tool_output_names = ["check-licenses"],
)

go_library(
    name = "pipeline",
    srcs = [
        "pipeline/interfaces.go",
        "pipeline/orchestrator.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/check-licenses/pipeline",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools/check-licenses:__subpackages__"],
    deps = [
        "//tools/check-licenses/metrics",
        "//tools/readme_fuchsia:readme_fuchsia_lib",
    ],
)

