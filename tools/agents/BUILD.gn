import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")
import("//build/testing/host_test_data.gni")
if (is_host) {
  _agents_sources = [
    "__init__.py",
    "commands/__init__.py",
    "commands/setup.py",
    "lib/__init__.py",
    "lib/config.py",
    "lib/git_staging/__init__.py",
    "lib/git_staging/engine.py",
    "lib/githooks/__init__.py",
    "lib/githooks/adapters.py",
    "lib/githooks/installer.py",
    "lib/githooks/reporters.py",
    "lib/githooks/runner.py",
    "lib/paths.py",
    "lib/permissions.py",
    "lib/services.py",
    "lib/state.py",
    "main.py",
  ]

  python_library("agents_lib") {
    library_name = "agents"
    source_root = "."
    sources = _agents_sources
  }

  python_library("agents_testing") {
    testonly = true
    library_name = "agents_testing"
    source_root = "testing"
    sources = [
      "__init__.py",
      "base.py",
      "workspace.py",
    ]
  }

  python_host_test("agents_main_test") {
    main_source = "tests/main_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }

  python_host_test("agents_setup_test") {
    main_source = "tests/setup_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }

  python_host_test("agents_config_test") {
    main_source = "tests/config_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }

  python_host_test("agents_paths_test") {
    main_source = "tests/paths_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }

  python_host_test("agents_permissions_test") {
    main_source = "tests/permissions_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }

  python_host_test("agents_services_test") {
    main_source = "tests/services_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }

  python_host_test("agents_state_test") {
    main_source = "tests/state_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }

  python_host_test("agents_git_staging_test") {
    main_source = "tests/git_staging_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }
  python_host_test("agents_githooks_reporters_test") {
    main_source = "tests/githooks_reporters_test.py"
    libraries = [ ":agents_lib" ]
  }
  python_host_test("agents_githooks_adapters_test") {
    main_source = "tests/githooks_adapters_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }
  python_host_test("agents_githooks_runner_test") {
    main_source = "tests/githooks_runner_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }
  python_host_test("agents_githooks_installer_test") {
    main_source = "tests/githooks_installer_test.py"
    libraries = [
      ":agents_lib",
      ":agents_testing",
    ]
  }
  host_test_data("e2e_githooks_scripts") {
    sources = [
      "//scripts/shac/commit_msg_checker.py",
      "//scripts/style/json-fmt.py",
    ]
  }
  python_host_test("agents_e2e_githooks_test") {
    main_source = "tests/e2e_githooks_test.py"
    libraries = [ ":agents_lib" ]
    test_data_deps = [ ":e2e_githooks_scripts" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":agents_config_test($host_toolchain)",
    ":agents_e2e_githooks_test($host_toolchain)",
    ":agents_git_staging_test($host_toolchain)",
    ":agents_githooks_adapters_test($host_toolchain)",
    ":agents_githooks_installer_test($host_toolchain)",
    ":agents_githooks_reporters_test($host_toolchain)",
    ":agents_githooks_runner_test($host_toolchain)",
    ":agents_main_test($host_toolchain)",
    ":agents_paths_test($host_toolchain)",
    ":agents_permissions_test($host_toolchain)",
    ":agents_services_test($host_toolchain)",
    ":agents_setup_test($host_toolchain)",
    ":agents_state_test($host_toolchain)",
  ]
}
