load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "rfcmeta_lib",
    srcs = [
        "rfcmeta.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/staticanalysis/rfcmeta",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        "//third_party/golibs:gopkg.in/yaml.v2",
        "//tools/staticanalysis",
    ],
)

go_binary_host_tool(
    name = "rfcmeta",
    embed = [":rfcmeta_lib"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//visibility:public"],
)

host_go_test(
    name = "rfcmeta_tests",
    srcs = [
        "rfcmeta_test.go",
    ],
    embed = [":rfcmeta_lib"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:github.com/google/go-cmp/cmp/cmpopts",
        "//tools/staticanalysis",
    ],
)
