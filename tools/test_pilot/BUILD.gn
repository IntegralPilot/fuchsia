import("//build/components.gni")
import("//build/host.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_test.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  rustc_binary("test-pilot") {
    name = "test-pilot"
    with_unit_tests = true
    edition = "2024"

    deps = [
      "//src/lib/fuchsia",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:heck",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:serde_json5",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:tokio",
      "//third_party/rust_crates:valico",
      "//tools/test_pilot/post_processing/resummarize",
      "//tools/test_pilot/test_pilot_lib",
    ]

    test_deps = [
      "//third_party/rust_crates:assert_matches",
      "//third_party/rust_crates:rand",
      "//third_party/rust_crates:tempfile",
    ]

    sources = [
      "src/builder.rs",
      "src/env.rs",
      "src/errors.rs",
      "src/logger.rs",
      "src/main.rs",
      "src/name.rs",
      "src/parsers.rs",
      "src/run_tests.rs",
      "src/schema.rs",
      "src/std_writer.rs",
      "src/test_config.rs",
    ]
  }

  install_host_tools("install") {
    deps = [ ":test-pilot" ]
    outputs = [ "test-pilot" ]
  }

  host_test_data("test_deps") {
    testonly = true
    deps = [ ":install" ]
    sources = [ "${host_tools_dir}/test-pilot" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":test-pilot_test($host_toolchain)",
    "//tools/test_pilot/post_processing/resummarize:tests",
    "//tools/test_pilot/test_pilot_lib:tests",
  ]
}
