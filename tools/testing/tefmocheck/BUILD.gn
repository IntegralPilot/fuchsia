import("//build/bazel/bazel_host_tool.gni")

# "public_checks" target is referenced by //:tefmocheck_rules_manifest.
group("public_checks") {
  metadata = {
    tefmocheck_rules = [ rebase_path("check-configs.yaml", root_build_dir) ]
  }
}

if (is_host) {
  bazel_host_tool("tefmocheck") {
    bazel_target = ":tefmocheck"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/tefmocheck_/tefmocheck"
  }
}
