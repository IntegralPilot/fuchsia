import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("fidlmerge") {
    bazel_target = ":fidlmerge"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/fidlmerge_/fidlmerge"
    install_host_tool = true
  }
}
