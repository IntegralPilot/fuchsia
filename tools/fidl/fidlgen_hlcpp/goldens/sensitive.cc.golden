  } else {
    result->clear_sensitive_struct_field();
  }
  return ZX_OK;
}

extern "C" const fidl_type_t test_sensitive_NonSensitiveUnionTable;
const fidl_type_t* NonSensitiveUnion::FidlType = &test_sensitive_NonSensitiveUnionTable;

::std::unique_ptr<NonSensitiveUnion> NonSensitiveUnion::New() { return ::std::make_unique<NonSensitiveUnion>(); }

NonSensitiveUnion::NonSensitiveUnion() {}

NonSensitiveUnion::~NonSensitiveUnion() {
  Destroy();
}

NonSensitiveUnion::NonSensitiveUnion(NonSensitiveUnion&& other) : tag_(other.tag_) {
  switch (tag_) {
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField:
      new (&sensitive_field_)::std::string();
      sensitive_field_ = std::move(other.sensitive_field_);
      break;
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField:
      new (&sensitive_struct_field_)::test::sensitive::SensitiveStruct();
      sensitive_struct_field_ = std::move(other.sensitive_struct_field_);
      break;
    case static_cast<fidl_xunion_tag_t>(::test::sensitive::NonSensitiveUnion::Tag::Invalid):
      break;
  }
}

NonSensitiveUnion& NonSensitiveUnion::operator=(NonSensitiveUnion&& other) {
  if (this != &other) {
    Destroy();
    tag_ = other.tag_;
    switch (tag_) {
      case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField:
        new (&sensitive_field_)::std::string();
        sensitive_field_ = std::move(other.sensitive_field_);
        break;
      case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField:
        new (&sensitive_struct_field_)::test::sensitive::SensitiveStruct();
        sensitive_struct_field_ = std::move(other.sensitive_struct_field_);
        break;
      case static_cast<fidl_xunion_tag_t>(::test::sensitive::NonSensitiveUnion::Tag::Invalid):
        break;
    }
  }
  return *this;
}

NonSensitiveUnion NonSensitiveUnion::WithSensitiveField(::std::string&& val) {
  NonSensitiveUnion result;
  result.set_sensitive_field(std::move(val));
  return result;
}
NonSensitiveUnion NonSensitiveUnion::WithSensitiveStructField(::test::sensitive::SensitiveStruct&& val) {
  NonSensitiveUnion result;
  result.set_sensitive_struct_field(std::move(val));
  return result;
}

void NonSensitiveUnion::Encode(::fidl::Encoder* encoder, size_t offset,
                               std::optional<::fidl::HandleInformation> maybe_handle_info) {
  const size_t length_before = encoder->CurrentLength();
  const size_t handles_before = encoder->CurrentHandleCount();

  switch (Which()) {
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField: {
      if (::fidl::EncodingInlineSize<::std::string>(encoder) <= FIDL_ENVELOPE_INLINING_SIZE_THRESHOLD) {
        ::fidl::Encode(encoder, &sensitive_field_, offset + offsetof(fidl_union_t, envelope));

        fidl_union_t* xunion = encoder->GetPtr<fidl_union_t>(offset);
        xunion->tag = tag_;
        xunion->envelope.num_handles = static_cast<uint16_t>(encoder->CurrentHandleCount() - handles_before);
        xunion->envelope.flags = FIDL_ENVELOPE_FLAGS_INLINING_MASK;
        break;
      }

      ::fidl::Encode(
          encoder,
          &sensitive_field_,
          encoder->Alloc(::fidl::EncodingInlineSize<::std::string, ::fidl::Encoder>(encoder)));

      fidl_union_t* xunion = encoder->GetPtr<fidl_union_t>(offset);
      xunion->tag = tag_;
      xunion->envelope.num_bytes = static_cast<uint32_t>(encoder->CurrentLength() - length_before);
      xunion->envelope.num_handles = static_cast<uint16_t>(encoder->CurrentHandleCount() - handles_before);
      xunion->envelope.flags = 0;
      break;
    }
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField: {
      if (::fidl::EncodingInlineSize<::test::sensitive::SensitiveStruct>(encoder) <= FIDL_ENVELOPE_INLINING_SIZE_THRESHOLD) {
        ::fidl::Encode(encoder, &sensitive_struct_field_, offset + offsetof(fidl_union_t, envelope));

        fidl_union_t* xunion = encoder->GetPtr<fidl_union_t>(offset);
        xunion->tag = tag_;
        xunion->envelope.num_handles = static_cast<uint16_t>(encoder->CurrentHandleCount() - handles_before);
        xunion->envelope.flags = FIDL_ENVELOPE_FLAGS_INLINING_MASK;
        break;
      }

      ::fidl::Encode(
          encoder,
          &sensitive_struct_field_,
          encoder->Alloc(::fidl::EncodingInlineSize<::test::sensitive::SensitiveStruct, ::fidl::Encoder>(encoder)));

      fidl_union_t* xunion = encoder->GetPtr<fidl_union_t>(offset);
      xunion->tag = tag_;
      xunion->envelope.num_bytes = static_cast<uint32_t>(encoder->CurrentLength() - length_before);
      xunion->envelope.num_handles = static_cast<uint16_t>(encoder->CurrentHandleCount() - handles_before);
      xunion->envelope.flags = 0;
      break;
    }
    default:
      break;
  }
}

void NonSensitiveUnion::Decode(::fidl::Decoder* _decoder, NonSensitiveUnion* value, size_t offset) {
  fidl_union_t* xunion = _decoder->GetPtr<fidl_union_t>(offset);

  if (xunion->envelope.num_bytes == 0 &&
      xunion->envelope.num_handles == 0 &&
      xunion->envelope.flags == 0) {
    value->EnsureStorageInitialized(static_cast<fidl_xunion_tag_t>(::test::sensitive::NonSensitiveUnion::Tag::Invalid));
    return;
  }

  value->EnsureStorageInitialized(xunion->tag);

  size_t value_offset = _decoder->EnvelopeValueOffset(&xunion->envelope);

  switch (value->tag_) {
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField: {
      value->sensitive_field_.~decltype(value->sensitive_field_)();
      new (&value->sensitive_field_)::std::string();
      ::fidl::Decode(_decoder, &value->sensitive_field_, value_offset);
      break;
    }
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField: {
      value->sensitive_struct_field_.~decltype(value->sensitive_struct_field_)();
      new (&value->sensitive_struct_field_)::test::sensitive::SensitiveStruct();
      ::fidl::Decode(_decoder, &value->sensitive_struct_field_, value_offset);
      break;
    }
    default: {
      break;
    }
  }
}

zx_status_t NonSensitiveUnion::Clone(NonSensitiveUnion* result) const {
  result->Destroy();
  result->tag_ = tag_;
  switch (tag_) {
    case ::test::sensitive::NonSensitiveUnion::Tag::Invalid:
      return ZX_OK;
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField:
      new (&result->sensitive_field_)::std::string();
      return ::fidl::Clone(sensitive_field_, &result->sensitive_field_);
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField:
      new (&result->sensitive_struct_field_)::test::sensitive::SensitiveStruct();
      return ::fidl::Clone(sensitive_struct_field_, &result->sensitive_struct_field_);
    default:
      return ZX_OK;
  }
}

NonSensitiveUnion& NonSensitiveUnion::set_sensitive_field(::std::string value) {
  EnsureStorageInitialized(::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField);
  sensitive_field_ = std::move(value);
  return *this;
}

NonSensitiveUnion& NonSensitiveUnion::set_sensitive_struct_field(::test::sensitive::SensitiveStruct value) {
  EnsureStorageInitialized(::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField);
  sensitive_struct_field_ = std::move(value);
  return *this;
}

void NonSensitiveUnion::Destroy() {
  switch (tag_) {
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField:
      sensitive_field_.~decltype(sensitive_field_)();
      break;
    case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField:
      sensitive_struct_field_.~decltype(sensitive_struct_field_)();
      break;

    default:
      break;
  }
  tag_ = static_cast<fidl_xunion_tag_t>(::test::sensitive::NonSensitiveUnion::Tag::Invalid);
}

void NonSensitiveUnion::EnsureStorageInitialized(::fidl_xunion_tag_t tag) {
  if (tag_ != tag) {
    Destroy();
    tag_ = tag;
    switch (tag_) {
      case static_cast<fidl_xunion_tag_t>(::test::sensitive::NonSensitiveUnion::Tag::Invalid):
        break;
      case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveField:
        new (&sensitive_field_)::std::string();
        break;
      case ::test::sensitive::NonSensitiveUnion::Tag::kSensitiveStructField:
        new (&sensitive_struct_field_)::test::sensitive::SensitiveStruct();
        break;
      default:
        break;
    }
  }
}

