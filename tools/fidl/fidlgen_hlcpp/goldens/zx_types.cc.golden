      return &::test::zxtypes::_internal::test_zxtypes_StatusProtocol_A_ResultTable;
      ;
    case ::test::zxtypes::internal::kStatusProtocol_B_Ordinal:
      return &::test::zxtypes::_internal::test_zxtypes_StatusProtocol_B_ResultTable;
      ;
    default:
      return nullptr;
  }
}

