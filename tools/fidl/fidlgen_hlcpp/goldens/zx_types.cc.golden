void StatusUnion::Decode(::fidl::Decoder* _decoder, StatusUnion* value, size_t offset) {
  fidl_union_t* xunion = _decoder->GetPtr<fidl_union_t>(offset);

  if (xunion->envelope.num_bytes == 0 &&
      xunion->envelope.num_handles == 0 &&
      xunion->envelope.flags == 0) {
    value->EnsureStorageInitialized(static_cast<fidl_xunion_tag_t>(::test::zxtypes::StatusUnion::Tag::Invalid));
    return;
  }

  value->EnsureStorageInitialized(xunion->tag);

  size_t value_offset = _decoder->EnvelopeValueOffset(&xunion->envelope);

  switch (value->tag_) {
    case ::test::zxtypes::StatusUnion::Tag::kStatus: {
      ::fidl::Decode(_decoder, &value->status_, value_offset);
      break;
    }
    case ::test::zxtypes::StatusUnion::Tag::kStatusArray: {
      value->status_array_.~decltype(value->status_array_)();
      new (&value->status_array_)::std::array<int32_t, 10>();
      ::fidl::Decode(_decoder, &value->status_array_, value_offset);
      break;
    }
    case ::test::zxtypes::StatusUnion::Tag::kStatusVector: {
      value->status_vector_.~decltype(value->status_vector_)();
      new (&value->status_vector_)::std::vector<int32_t>();
      ::fidl::Decode(_decoder, &value->status_vector_, value_offset);
      break;
    }
    default: {
      auto unknown_info = _decoder->EnvelopeUnknownDataInfo(&xunion->envelope);
      value->unknown_data_.resize(unknown_info.num_bytes);
      ::fidl::DecodeUnknownBytesContents(_decoder, &value->unknown_data_, unknown_info.value_offset);
      break;
    }
  }
}

