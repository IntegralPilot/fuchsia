                         _decoder->EnvelopeValueOffset(envelope));
        } else {
          _value->clear_status_vector();
        }
        break;
      default:
        break;
    }
  }
  if (count < 1) {
    _value->clear_status();
  }
  if (count < 2) {
    _value->clear_status_array();
  }
  if (count < 3) {
    _value->clear_status_vector();
  }

  return;
}

zx_status_t StatusTableAlias::Clone(StatusTableAlias* result) const {
  if (field_presence_.IsSet<0>()) {
    zx_status_t _status = ::fidl::Clone(status_value_.value, result->mutable_status());
    if (_status != ZX_OK)
      return _status;
  } else {
    result->clear_status();
  }
  if (field_presence_.IsSet<1>()) {
    zx_status_t _status = ::fidl::Clone(status_array_value_.value, result->mutable_status_array());
    if (_status != ZX_OK)
      return _status;
  } else {
    result->clear_status_array();
  }
  if (field_presence_.IsSet<2>()) {
    zx_status_t _status = ::fidl::Clone(status_vector_value_.value, result->mutable_status_vector());
    if (_status != ZX_OK)
      return _status;
  } else {
    result->clear_status_vector();
  }
  return ZX_OK;
}

