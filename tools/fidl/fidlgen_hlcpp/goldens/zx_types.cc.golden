class StatusProtocol_A_Responder final {
 public:
  StatusProtocol_A_Responder(::fidl::internal::PendingResponse response)
      : response_(std::move(response)) {}

  void operator()(::test::zxtypes::StatusProtocol_A_Result StatusProtocol_A_Result) {
    ::fidl::MessageEncoder _encoder(::test::zxtypes::internal::kStatusProtocol_A_Ordinal, ::test::zxtypes::internal::kStatusProtocol_A_DynamicFlags);
    const fidl_type_t* resp_type = &::test::zxtypes::_internal::test_zxtypes_StatusProtocol_A_ResultTable;
    ZX_ASSERT_MSG(!StatusProtocol_A_Result.is_framework_err(), "Applications must not explicitly send framework_err for flexible methods.");
    response_.Send(resp_type, ::test::zxtypes::StatusProtocol_ResponseEncoder::A(&_encoder, &StatusProtocol_A_Result));
  }

 private:
  ::fidl::internal::PendingResponse response_;
};

