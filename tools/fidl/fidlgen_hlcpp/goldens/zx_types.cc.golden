const fidl_type_t* ::test::zxtypes::StatusProtocol_RequestDecoder::GetType(uint64_t ordinal, bool* out_needs_response, bool* out_is_known) {
  *out_needs_response = false;
  *out_is_known = false;
  switch (ordinal) {
    case ::test::zxtypes::internal::kStatusProtocol_A_Ordinal:
      *out_is_known = true;
      *out_needs_response = true;
      return &::test::zxtypes::_internal::test_zxtypes_StatusProtocolARequestTable;
      ;
    case ::test::zxtypes::internal::kStatusProtocol_B_Ordinal:
      *out_is_known = true;
      *out_needs_response = true;
      return &::test::zxtypes::_internal::test_zxtypes_StatusProtocolBRequestTable;
      ;
    default:
      return nullptr;
  }
}

