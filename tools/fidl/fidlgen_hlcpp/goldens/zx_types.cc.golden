    case ::test::zxtypes::StatusProtocol_B_Result::Tag::Invalid:
      return ZX_OK;
    case ::test::zxtypes::StatusProtocol_B_Result::Tag::kResponse:
      new (&result->response_)::test::zxtypes::StatusProtocol_B_Response();
      return ::fidl::Clone(response_, &result->response_);
    case ::test::zxtypes::StatusProtocol_B_Result::Tag::kErr:
      return ::fidl::Clone(err_, &result->err_);
    case ::test::zxtypes::StatusProtocol_B_Result::Tag::kFrameworkErr:
      return ::fidl::Clone(framework_err_, &result->framework_err_);
    default:
      return ZX_OK;
  }
}

StatusProtocol_B_Result& StatusProtocol_B_Result::set_response(::test::zxtypes::StatusProtocol_B_Response value) {
  EnsureStorageInitialized(::test::zxtypes::StatusProtocol_B_Result::Tag::kResponse);
  response_ = std::move(value);
  return *this;
}

StatusProtocol_B_Result& StatusProtocol_B_Result::set_err(int32_t value) {
  EnsureStorageInitialized(::test::zxtypes::StatusProtocol_B_Result::Tag::kErr);
  err_ = std::move(value);
  return *this;
}

StatusProtocol_B_Result& StatusProtocol_B_Result::set_framework_err(::fidl::FrameworkErr value) {
  EnsureStorageInitialized(::test::zxtypes::StatusProtocol_B_Result::Tag::kFrameworkErr);
  framework_err_ = std::move(value);
  return *this;
}

void StatusProtocol_B_Result::Destroy() {
  switch (tag_) {
    case ::test::zxtypes::StatusProtocol_B_Result::Tag::kResponse:
      response_.~decltype(response_)();
      break;
    case ::test::zxtypes::StatusProtocol_B_Result::Tag::kErr:
      break;
    case ::test::zxtypes::StatusProtocol_B_Result::Tag::kFrameworkErr:
      break;

    default:
      break;
  }
  tag_ = static_cast<fidl_xunion_tag_t>(::test::zxtypes::StatusProtocol_B_Result::Tag::Invalid);
}

void StatusProtocol_B_Result::EnsureStorageInitialized(::fidl_xunion_tag_t tag) {
  if (tag_ != tag) {
    Destroy();
    tag_ = tag;
    switch (tag_) {
      case static_cast<fidl_xunion_tag_t>(::test::zxtypes::StatusProtocol_B_Result::Tag::Invalid):
        break;
      case ::test::zxtypes::StatusProtocol_B_Result::Tag::kResponse:
        new (&response_)::test::zxtypes::StatusProtocol_B_Response();
        break;
      case ::test::zxtypes::StatusProtocol_B_Result::Tag::kErr:
        new (&err_) int32_t();
        break;
      case ::test::zxtypes::StatusProtocol_B_Result::Tag::kFrameworkErr:
        new (&framework_err_)::fidl::FrameworkErr();
        break;
      default:
        break;
    }
  }
}

