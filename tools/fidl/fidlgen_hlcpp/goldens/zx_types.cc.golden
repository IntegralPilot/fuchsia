zx_status_t StatusProtocol_SyncProxy::A(int32_t arg, ::test::zxtypes::StatusProtocol_A_Result* out_StatusProtocol_A_Result) {
  ::fidl::MessageEncoder _encoder(::test::zxtypes::internal::kStatusProtocol_A_Ordinal, ::test::zxtypes::internal::kStatusProtocol_A_DynamicFlags);
  ::fidl::IncomingMessageBuffer buffer_;
  ::fidl::HLCPPIncomingMessage response_ = buffer_.CreateEmptyIncomingMessage();
  const fidl_type_t* req_type = &::test::zxtypes::_internal::test_zxtypes_StatusProtocolARequestTable;
  const fidl_type_t* resp_type = &::test::zxtypes::_internal::test_zxtypes_StatusProtocol_A_ResultTable;
  zx_status_t status_ = proxy_.Call(req_type, resp_type, ::test::zxtypes::StatusProtocol_RequestEncoder::A(&_encoder, &arg), &response_);
  if (status_ != ZX_OK)
    return status_;
  ::fidl::Decoder decoder_(std::move(response_));
  *out_StatusProtocol_A_Result = ::fidl::DecodeAs<::test::zxtypes::StatusProtocol_A_Result>(&decoder_, 0 + sizeof(fidl_message_header_t));
  return ZX_OK;
}

