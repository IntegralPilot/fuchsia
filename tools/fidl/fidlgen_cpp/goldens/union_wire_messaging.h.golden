// Pure-virtual interface to be implemented by a server.
// This interface uses typed channels (i.e. |::fidl::ClientEnd<::test_union::TestProtocol>|
// and |::fidl::ServerEnd<::test_union::TestProtocol>|).
template <>
class ::fidl::WireServer<::test_union::TestProtocol> : public ::fidl::internal::IncomingMessageDispatcher {
 public:
  WireServer() = default;
  virtual ~WireServer() = default;

  // The FIDL protocol type that is implemented by this server.
  using _EnclosingProtocol = ::test_union::TestProtocol;

  using Handler = fidl::ProtocolHandler<::test_union::TestProtocol>;

  using StrictUnionHenceResponseMayBeStackAllocatedCompleter = ::fidl::internal::WireCompleter<::test_union::TestProtocol::StrictUnionHenceResponseMayBeStackAllocated>;

  virtual void StrictUnionHenceResponseMayBeStackAllocated(
      StrictUnionHenceResponseMayBeStackAllocatedCompleter::Sync& completer) = 0;

  using FlexibleUnionHenceResponseMustBeHeapAllocatedCompleter = ::fidl::internal::WireCompleter<::test_union::TestProtocol::FlexibleUnionHenceResponseMustBeHeapAllocated>;

  virtual void FlexibleUnionHenceResponseMustBeHeapAllocated(
      FlexibleUnionHenceResponseMustBeHeapAllocatedCompleter::Sync& completer) = 0;

  // |bind_handler| returns a handler that binds incoming connections to this
  // server implementation.
  //
  // The returned handler borrows the server instance.
  // The server must outlive the provided |dispatcher|. Only after
  // the dispatcher is shutdown will it be safe to destroy the servers.
  // The server should not be moved.
  Handler bind_handler(async_dispatcher_t* dispatcher);

 private:
  void dispatch_message(
      ::fidl::IncomingHeaderAndMessage&& msg, ::fidl::Transaction* txn,
      ::fidl::internal::MessageStorageViewBase* storage_view) final;
};

