    }
    default:
      auto* hdr = msg.header();
      ::fidl::UnknownMethodType unknown_method_type =
          ::fidl::internal::UnknownMethodTypeFromHeader(hdr);
      bool is_flexible_interaction = ::fidl::IsFlexibleInteraction(hdr);
