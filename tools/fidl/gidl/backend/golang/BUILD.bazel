load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "golang",
    srcs = [
        "benchmarks.go",
        "common.go",
        "conformance.go",
        "equality_builder.go",
    ],
    embedsrcs = [
        "benchmarks.tmpl",
        "conformance.tmpl",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/fidl/gidl/backend/golang",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = [
        "//tools/fidl/gidl:__subpackages__",
    ],
    deps = [
        "//tools/fidl/gidl/lib/config",
        "//tools/fidl/gidl/lib/ir",
        "//tools/fidl/gidl/lib/mixer",
        "//tools/fidl/lib/fidlgen",
    ],
)

host_go_test(
    name = "gidl_golang_tests",
    srcs = ["golang_test.go"],
    embed = [":golang"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
)
