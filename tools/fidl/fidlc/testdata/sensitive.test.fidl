library test.sensitive;

type Empty = struct {};

@sensitive
type SensitiveStruct = struct {
    field string;
};

@sensitive
type SensitiveTable = table {
    1: field string;
};

@sensitive
type SensitiveUnion = strict union {
    1: field string;
};

type ContainerWithPropagation = struct {
    unannotated_field string;
    sensitive_struct_field SensitiveStruct;
    sensitive_table_field SensitiveTable;
    sensitive_union_field SensitiveUnion;
};

type NonSensitiveStruct = struct {
    @sensitive
    sensitive_field string;
    sensitive_struct_field SensitiveStruct;
};

type NonSensitiveTable = table {
    @sensitive
    1: sensitive_field string;
    2: sensitive_struct_field SensitiveStruct;
};

type NonSensitiveUnion = strict union {
    @sensitive
    1: sensitive_field string;
    2: sensitive_struct_field SensitiveStruct;
};
