library test.zxtypes;

using zx;

alias StatusAlias = zx.Status;

type StatusEnum = flexible enum : zx . Status {
    OK = 0;
};

type StatusEnumAlias = flexible enum : StatusAlias {
    OK = 0;
};

type StatusStruct = struct {
    status zx.Status;
    status_array array<zx.Status, 10>;
    status_vector vector<zx.Status>;
};

type StatusStructAlias = struct {
    status StatusAlias;
    status_array array<StatusAlias, 10>;
    status_vector vector<StatusAlias>;
};

type StatusTable = table {
    1: status zx.Status;
    2: status_array array<zx.Status, 10>;
    3: status_vector vector<zx.Status>;
};

type StatusTableAlias = table {
    1: status StatusAlias;
    2: status_array array<StatusAlias, 10>;
    3: status_vector vector<StatusAlias>;
};

type StatusUnion = union {
    1: status zx.Status;
    2: status_array array<zx.Status, 10>;
    3: status_vector vector<zx.Status>;
};

type StatusUnionAlias = union {
    1: status StatusAlias;
    2: status_array array<StatusAlias, 10>;
    3: status_vector vector<StatusAlias>;
};

protocol StatusProtocol {
    A(struct {
        arg zx.Status;
    }) -> (struct {
        result zx.Status;
    }) error zx.Status;

    B(struct {
        arg StatusAlias;
    }) -> (struct {
        result StatusAlias;
    }) error StatusAlias;
};
