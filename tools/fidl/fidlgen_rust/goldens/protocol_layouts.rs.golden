        self.control_handle.inner.send::<fidl::encoding::ResultType<
            fidl_test_protocollayouts_imported::ComposedOpenProtocolStrictTwoWayWithErrorResponse,
            i32,
        >>(
            result.map(|value| (value,)),
            self.tx_id,
            0x4a72f997c7db5037,
            fidl::encoding::DynamicFlags::empty(),
        )
    }
}

mod internal {
    use super::*;
