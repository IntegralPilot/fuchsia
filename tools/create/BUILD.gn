import("//build/bazel/bazel_host_tool.gni")
import("//build/host.gni")

if (is_host) {
  bazel_host_tool("create_bin") {
    bazel_target = ":create_bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/create_bin"
    output_name = "create"
    install_host_tool = true
  }
}

group("create") {
  deps = [
    ":create_bin($host_toolchain)",
    "templates($host_toolchain)",
  ]
}

group("tests") {
  testonly = true
  deps = [ "goldens:tests" ]
}
