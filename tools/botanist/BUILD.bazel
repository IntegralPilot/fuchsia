load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "botanist_lib",
    srcs = [
        "common.go",
        "pkg.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/botanist",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        ":constants",
        ":repo",
        "//tools/build",
        "//tools/lib/logger",
        "//tools/lib/osmisc",
        "//tools/lib/retry",
        "//tools/lib/streams",
        "//tools/lib/subprocess",
        "//tools/net/netboot",
        "//tools/net/tftp",
    ],
)

go_library(
    name = "repo",
    srcs = [
        "repo/config.go",
        "repo/repo.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/botanist/repo",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        "//src/sys/pkg/lib/repo",
        "//third_party/golibs:github.com/theupdateframework/go-tuf",
        "//third_party/golibs:github.com/theupdateframework/go-tuf/data",
    ],
)

go_library(
    name = "targets",
    srcs = [
        "targets/auxiliary.go",
        "targets/device.go",
        "targets/emulator.go",
        "targets/errors.go",
        "targets/gce.go",
        "targets/ip.go",
        "targets/target.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/botanist/targets",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        ":botanist_lib",
        ":constants",
        "//src/sys/pkg/lib/repo",
        "//third_party/golibs:github.com/creack/pty",
        "//third_party/golibs:github.com/kr/pretty",
        "//third_party/golibs:golang.org/x/crypto/ssh",
        "//third_party/golibs:golang.org/x/sync/errgroup",
        "//tools/build",
        "//tools/lib/ffxutil",
        "//tools/lib/iomisc",
        "//tools/lib/jsonutil",
        "//tools/lib/logger",
        "//tools/lib/osmisc",
        "//tools/lib/productbundle",
        "//tools/lib/retry",
        "//tools/lib/serial",
        "//tools/lib/serial:constants",
        "//tools/lib/subprocess",
        "//tools/lib/syslog",
        "//tools/net/mdns",
        "//tools/net/netboot",
        "//tools/net/netutil",
        "//tools/net/sshutil",
        "//tools/net/tftp",
        "//tools/testing/testrunner:constants",
    ],
)

go_library(
    name = "main",
    srcs = [
        "cmd/main.go",
        "cmd/run.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/botanist/main",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        ":botanist_lib",
        ":constants",
        ":targets",
        "//third_party/golibs:github.com/google/subcommands",
        "//third_party/golibs:golang.org/x/sync/errgroup",
        "//tools/lib/color",
        "//tools/lib/environment",
        "//tools/lib/ffxutil",
        "//tools/lib/flagmisc",
        "//tools/lib/jsonutil",
        "//tools/lib/logger",
        "//tools/lib/osmisc",
        "//tools/lib/retry",
        "//tools/lib/serial",
        "//tools/lib/streams",
        "//tools/lib/subprocess",
        "//tools/lib/syslog",
        "//tools/net/sshutil",
        "//tools/testing/runtests",
        "//tools/testing/testrunner:constants",
        "//tools/testing/testrunner:lib",
    ],
)

go_library(
    name = "constants",
    srcs = [
        "constants/constants.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/botanist/constants",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
)

# @bazel2gn:skip
go_binary_host_tool(
    name = "botanist",
    embed = [":main"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# @bazel2gn:skip
host_go_test(
    name = "botanist_cmd_tests",
    srcs = ["cmd/run_test.go"],
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
)

# @bazel2gn:skip
host_go_test(
    name = "botanist_lib_tests",
    srcs = [
        "common_test.go",
        "pkg_test.go",
    ],
    embed = [":botanist_lib"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
)

# @bazel2gn:skip
host_go_test(
    name = "botanist_repo_tests",
    srcs = [
        "repo/config_test.go",
        "repo/repo_test.go",
    ],
    embed = [":repo"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
)

# @bazel2gn:skip
host_go_test(
    name = "botanist_targets_tests",
    srcs = [
        "targets/auxiliary_test.go",
        "targets/device_test.go",
        "targets/emulator_test.go",
        "targets/gce_test.go",
        "targets/target_test.go",
    ],
    embed = [":targets"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = ["//third_party/golibs:github.com/google/go-cmp/cmp"],
)
