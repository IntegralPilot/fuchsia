             version="git_revision:7ca22c44fa2bd62630ebe2734db14628436d6560"
             path="prebuilt/tools/buildidtool/{{.OS}}-{{.Arch}}"
             platforms="linux-amd64"/>

    <!--   LLVM libraries -->
