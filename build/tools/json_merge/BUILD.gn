import("//build/bazel/bazel_host_tool.gni")
import("//build/test.gni")

assert(is_host, "bazel_host_tool() can only be called in a host toolchain.")

bazel_host_tool("json_merge") {
  bazel_target = ":json_merge"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/json_merge"
  install_host_tool = true
}

source_set("srcs") {
  sources = [
    "json_merge.cc",
    "json_merge.h",
  ]

  public_deps = [ "//third_party/rapidjson" ]
}

test("json_merge_test") {
  sources = [ "test.cc" ]

  deps = [
    ":srcs",
    "//src/lib/fxl/test:gtest_main",
  ]
}
