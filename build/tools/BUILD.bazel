load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_CONSTRAINTS,
    tests = [
        "//build/tools/bazel2gn:bazel2gn_tests",
        "//build/tools/json_validator/test:tests",
        "//build/tools/tarmaker:tarmaker_tests",

        # This `test_suite()` cannot currently be run by the "*tests" targets
        # in `//build/bazel/rules/tests/BUILD.bazel`, so add this test suite to
        # ensure they are included in `tests.json`.
        # TODO(https://fxbug.dev/500485175): Ensure these are run at appropriate times,
        # possibly including via `tests.json`-based mechanisms, by some other means.
        "//build/bazel/rules/tests:host_tests",
    ],
)
