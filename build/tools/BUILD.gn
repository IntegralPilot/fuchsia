import("//build/bazel/bazel_test_suite.gni")

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    "json_merge:json_merge_test($host_toolchain)",

    # TODO(https://fxbug.dev/495266204): Move all tests to Bazel and remove.
    "json_validator/test:tests($host_toolchain)",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//build/tools:host_tests" ]
}
