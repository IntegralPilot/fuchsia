import("//build/python/python_binary.gni")
import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  python_library("gn_runner") {
    sources = [ "gn_runner.py" ]
    library_deps = [ "//build/bazel/scripts:build_utils" ]
  }

  python_library("path_normalizer") {
    sources = [ "path_normalizer.py" ]
  }

  python_build_time_tests("path_normalizer_test") {
    tests = [ "path_normalizer_test.py" ]
    deps = [ ":path_normalizer" ]
  }

  python_library("normalize_rustc_args") {
    sources = [ "normalize_rustc_args.py" ]
    deps = [ ":path_normalizer" ]
  }

  python_library("discover_migration_candidates") {
    sources = [ "discover_migration_candidates.py" ]
    deps = [ ":gn_runner" ]
  }

  python_library("shell_utils") {
    sources = [ "shell_utils.py" ]
  }

  python_build_time_tests("discover_migration_candidates_test") {
    tests = [ "discover_migration_candidates_test.py" ]
    deps = [ ":discover_migration_candidates" ]
    inputs = [ "shell_utils.py" ]
  }

  python_build_time_tests("shell_utils_test") {
    tests = [ "shell_utils_test.py" ]
    inputs = [ "shell_utils.py" ]
  }

  python_build_time_tests("normalize_rustc_args_test") {
    tests = [ "normalize_rustc_args_test.py" ]
    deps = [ ":normalize_rustc_args" ]
  }

  python_build_time_tests("gn_runner_test") {
    tests = [ "gn_runner_test.py" ]
    deps = [ ":gn_runner" ]
  }

  python_library("build_command_query_utils") {
    sources = [ "build_command_query_utils.py" ]
    library_deps = [
      "//build/api:gn_ninja_outputs",
      "//build/bazel/scripts:bazel_build_args",
      "//build/bazel/scripts:build_utils",
    ]
  }

  python_build_time_tests("build_command_query_utils_test") {
    tests = [ "build_command_query_utils_test.py" ]
    deps = [ ":build_command_query_utils" ]
  }

  python_binary("compare_rustc_commands") {
    testonly = true
    main_source = "compare_rustc_commands.py"
    sources = [
      "//build/bazel/scripts/bazel_build_args.py",
      "//build/bazel/scripts/build_utils.py",
      "build_command_query_utils.py",
      "gn_runner.py",
      "normalize_rustc_args.py",
      "path_normalizer.py",
      "shell_utils.py",
    ]
  }

  group("tests") {
    testonly = true
    deps = [
      ":build_command_query_utils_test",
      ":discover_migration_candidates_test",
      ":normalize_rustc_args_test",
      ":path_normalizer_test",
      ":shell_utils_test",
    ]
  }
}
