# Map Bazel cpu to a filegroup() label covering sysroot headers.
FUCHSIA_SYSROOT_HEADERS_FILEGROUPS = {
    "aarch64": "%{SYSROOT_HEADERS_AARCH64}",
    "riscv64": "%{SYSROOT_HEADERS_RISCV64}",
    "x86_64": "%{SYSROOT_HEADERS_X86_64}",
}

# Map Bazel cpu to a filegroup() label covering sysroot libraries.
FUCHSIA_SYSROOT_LIBS_FILEGROUPS = {
    "aarch64": "%{SYSROOT_LIBS_AARCH64}",
    "riscv64": "%{SYSROOT_LIBS_RISCV64}",
    "x86_64": "%{SYSROOT_LIBS_X86_64}",
}

# Map Bazel cpu to a path string to the sysroot directory.
# This can be absolute or relative to the execroot, such
# as external/<canonical_repo_name>/arch/<fuchsia_cpu>/sysroot
FUCHSIA_SYSROOT_PATHS = {
    "aarch64": "%{SYSROOT_PATH_AARCH64}",
    "riscv64": "%{SYSROOT_PATH_RISCV64}",
    "x86_64": "%{SYSROOT_PATH_X86_64}",
}

# A list of extra target_compatible_with labels for the Fuchsia
# C++ toolchain instances. This is empty for OOT projects, but
# the in-tree Fuchsia build uses it to distinguish the toolchain
# from the one used for the fuchsia_platform Bazel platform.
EXTRA_TARGET_COMPATIBLE_WITH = %{EXTRA_TARGET_COMPATIBLE_WITH}
