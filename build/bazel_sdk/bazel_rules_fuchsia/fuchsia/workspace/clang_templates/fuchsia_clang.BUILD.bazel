load("@fuchsia_sdk//:generated_constants.bzl", sdk_constants = "constants")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_toolchain_suite")
load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "fuchsia_cpu_filter_dict",
)
load("//:generated_constants.bzl", clang_constants = "constants")
load(
    "//common:toolchains/clang/repository_utils.bzl",
    "setup_clang_repository",
)
load(
    "//common:toolchains/clang/toolchain_utils.bzl",
    "generate_clang_cc_toolchain",
)
load(
    ":sysroot_defs.bzl",
    "EXTRA_TARGET_COMPATIBLE_WITH",
    "FUCHSIA_SYSROOT_HEADERS_FILEGROUPS",
    "FUCHSIA_SYSROOT_LIBS_FILEGROUPS",
    "FUCHSIA_SYSROOT_PATHS",
)

licenses(["notice"])

package(default_visibility = ["//visibility:public"])

setup_clang_repository(clang_constants)

# This is the set of CPUs that the Fuchsia SDK provides sysroots for.
_SDK_SUPPORTED_TARGET_CPUS = sdk_constants.target_cpus

cc_toolchain_suite(
    name = "toolchain",
    toolchains = fuchsia_cpu_filter_dict(
        {
            "arm64": {
                "aarch64|llvm": ":cc-fuchsia-aarch64",
                "aarch64": ":cc-fuchsia--aarch64",
            },
            "x64": {
                "x86_64|llvm": ":cc-fuchsia-x86_64",
                "x86_64": ":cc-fuchsia-x86_64",
            },
            "riscv64": {
                "riscv64|llvm": ":cc-fuchsia-riscv64",
                "riscv64": ":cc-fuchsia-riscv64",
            },
        },
        _SDK_SUPPORTED_TARGET_CPUS,
    ),
)

_TO_BAZEL_CPU_MAP = {
    "x64": "x86_64",
    "arm64": "aarch64",
}

TARGET_CPUS = [_TO_BAZEL_CPU_MAP.get(cpu, cpu) for cpu in _SDK_SUPPORTED_TARGET_CPUS]

exports_files([
    "bin/clang-format",
    "bin/clang-tidy",
    "bin/llvm-readelf",

    # Referenced from @fuchsia_sdk//clang:BUILD.bazel
    "lib/debug/.build-id",
])

[
    generate_clang_cc_toolchain(
        name = "cc-fuchsia-" + cpu,
        host_os = "linux",
        host_arch = "x86_64",
        target_os = "fuchsia",
        target_arch = cpu,
        sysroot_header_files = [FUCHSIA_SYSROOT_HEADERS_FILEGROUPS[cpu]],
        sysroot_library_files = [FUCHSIA_SYSROOT_LIBS_FILEGROUPS[cpu]],
        sysroot_path = FUCHSIA_SYSROOT_PATHS[cpu],
        extra_target_compatible_with = EXTRA_TARGET_COMPATIBLE_WITH,

        # The Fuchsia SDK handles the API level with a custom scheme that
        # relies on transitions and does not provide a configured target
        # providing it to dependents.
        fuchsia_api_level = None,
    )
    for cpu in TARGET_CPUS
]

cc_library(
    name = "sources",
    srcs = glob(["src/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)
