"""Definitions related to the @fuchsia_clang repository.

These cannot go into the top-level @fuchsia_sdk//:BUILD.bazel file because
the latter is used in OOT workspaces that do not have the @fuchsia_clang
repository (e.g. they only perform Bazel assembly, and never build any
C++ code). A reference to @fuchsia_clang in that file would break these
projects.

Instead, these definitions go under @fuchsia_sdk//clang:BUILD.bazel
and are only referenced from C++ related rules such as fuchsia_cc_binary().
"""

load("@fuchsia_clang//:generated_constants.bzl", clang_constants = "constants")
load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "COMPATIBILITY",
    "fuchsia_debug_symbols",
    "fuchsia_package_resource_group",
)
load(
    "@rules_fuchsia//common:toolchains/clang/package_resources.bzl",
    "get_clang_package_resources",
)
load("//:generated_constants.bzl", sdk_constants = "constants")

fuchsia_debug_symbols(
    name = "debug_symbols",
    source_search_root = "//:BUILD.bazel",
    build_id_dirs = ["@fuchsia_clang//:lib/debug/.build-id"],

    # This must be visibile to any OOT use of fuchsia_cc_binary()
    visibility = ["//visibility:public"],
)

# Define clang runtime libraries as fuchsia_package_resource_group()
clang_package_resources = get_clang_package_resources(
    clang_repo_prefix = "@fuchsia_clang//",
    lib_clang_internal_dir = clang_constants.lib_clang_internal_dir,
    supported_cpus = sdk_constants.target_cpus,
)

fuchsia_package_resource_group(
    name = "libcxx_resources",
    srcs = select(clang_package_resources.libcxx_srcs_select_map),
    dest = select(clang_package_resources.libcxx_dest_select_map),
    strip_prefix = select(clang_package_resources.libcxx_strip_prefix_select_map),
    target_compatible_with = COMPATIBILITY.FUCHSIA_CONDITION,
    visibility = ["//visibility:public"],
)

fuchsia_package_resource_group(
    name = "sanitizer_resources",
    srcs = select(clang_package_resources.sanitizers_srcs_select_map),
    dest = select(clang_package_resources.sanitizers_dest_select_map),
    strip_prefix = select(clang_package_resources.sanitizers_strip_prefix_select_map),
    target_compatible_with = COMPATIBILITY.FUCHSIA_CONDITION,
    visibility = ["//visibility:public"],
)

