# NOTE: The following repository exists only to bootstrap other repositories
# (eg: cipd, clang, fuchsia sdk).
# Once @fuchsia_sdk is initialized, it should be used whenever possible.
module(
    name = "rules_fuchsia",
    version = "0.0.1",
    #TODO(https://fxbug.dev/42059530) add bazel_compatibility when it is ready
)

# Required Dependencies
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "0.36.0")
bazel_dep(name = "rules_cc", version = "0.0.9")

# BEGIN_FUCHSIA_IN_TREE_ONLY
#
# Because common provider definitions for in-tree and SDK rules require
# a single definition location, the @fuchsia_rules_common repository
# is special:
#
# - In the Fuchsia in-tree build, the repository exists and its content
#   comes from build/bazel_sdk/fuchsia_rules_common, while the content
#   of @rules_fuchsia comes from build/bazel_sdk/bazel_rules_fuchsia.
#
#   Also, all @rules_fuchsia files contain label references that begin
#   with @fuchsia_rules_common// when they need to access the common
#   definitions.
#
# - The in-tree //:rules_fuchsia.export GN target is used to produce
#   a version of @rules_fuchsia that can be used out-of-tree without
#   a separate common directory. To do this, it will:
#
#   1) Copy the content of build/bazel_sdk/bazel_rules_fuchsia to
#      a new $RULES_FUCHSIA output directory.
#
#   2) Copy the content of build/bazel_sdk/fuchsia_rules_common to
#      $RULES_FUCHSIA/fuchsia_rules_common
#
#   3) Change all strings in $RULES_FUCHSIA Bazel files that
#      start with "@fuchsia_rules_common//" to use
#      "@rules_fuchsia//fuchsia_rules_common" instead. This makes all
#      label references valid inside $RULES_FUCHSIA.
#
# The following definition is only required in-tree as there is no
# external repository when using this file OOT.
bazel_dep(name = "fuchsia_rules_common", version = "0")
local_path_override(
    module_name = "fuchsia_rules_common",
    path = "../fuchsia_rules_common",
)
# END_FUCHSIA_IN_TREE_ONLY

# Declare the fuchsia sdk
fuchsia_sdk_ext = use_extension("//fuchsia/workspace:fuchsia_sdk_repository.bzl", "fuchsia_sdk_ext")
use_repo(fuchsia_sdk_ext, "fuchsia_sdk", "fuchsia_sdk_toolchain_decl")

register_toolchains("@fuchsia_sdk_toolchain_decl//:all")

# Declare clang
fuchsia_clang_ext = use_extension("//fuchsia/workspace:fuchsia_clang_repository.bzl", "fuchsia_clang_ext")
use_repo(fuchsia_clang_ext, "fuchsia_clang")

register_toolchains("@fuchsia_clang//:all")

# NOTE: This will become @rules_fuchsia//fuchsia_rules_common/build_flags:all
# after export processing.
register_toolchains("@fuchsia_rules_common//build_flags:all")
