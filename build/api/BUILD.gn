import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  python_library("affected_tests") {
    sources = [ "affected_tests.py" ]
    library_deps = [ "//build/bazel/scripts:build_utils" ]
  }

  python_build_time_tests("affected_tests_test") {
    tests = [ "affected_tests_test.py" ]
    deps = [
      ":affected_tests",
      ":ninja_artifacts",
    ]
  }

  python_library("build_api_filter") {
    sources = [ "build_api_filter.py" ]
  }

  python_build_time_tests("build_api_filter_test") {
    tests = [ "build_api_filter_test.py" ]
    deps = [ ":build_api_filter" ]
  }

  python_library("debug_symbols") {
    sources = [ "debug_symbols.py" ]
  }

  python_build_time_tests("debug_symbols_test") {
    tests = [ "debug_symbols_test.py" ]
    deps = [ ":debug_symbols" ]
  }

  python_library("file_to_test_package") {
    sources = [ "file_to_test_package.py" ]
    library_deps = [
      ":gn_ninja_outputs",
      "//build/bazel/scripts:build_utils",
    ]
  }

  python_build_time_tests("file_to_test_package_test") {
    tests = [ "file_to_test_package_test.py" ]
    deps = [ ":file_to_test_package" ]
  }

  python_library("gn_labels") {
    sources = [ "gn_labels.py" ]
  }

  python_build_time_tests("gn_labels_test") {
    tests = [ "gn_labels_test.py" ]
    deps = [ ":gn_labels" ]
  }

  python_library("gn_ninja_outputs") {
    sources = [ "gn_ninja_outputs.py" ]
  }

  python_build_time_tests("gn_ninja_outputs_test") {
    tests = [ "gn_ninja_outputs_test.py" ]
    deps = [ ":gn_ninja_outputs" ]
  }

  python_library("ninja_artifacts") {
    sources = [ "ninja_artifacts.py" ]
    library_deps = [ "//build/bazel/scripts:build_utils" ]
  }

  python_build_time_tests("ninja_artifacts_test") {
    tests = [ "ninja_artifacts_test.py" ]
    deps = [ ":ninja_artifacts" ]
  }

  python_library("script_commands") {
    sources = [ "script_commands.py" ]
  }

  python_build_time_tests("script_commands_test") {
    tests = [ "script_commands_test.py" ]
    deps = [ ":script_commands" ]
  }

  # This target cannot be named "client" as it would conflict
  # with the script with the same name during mypy checks.
  python_library("client_lib") {
    sources = [ "client.py" ]
    library_deps = [
      ":affected_tests",
      ":build_api_filter",
      ":debug_symbols",
      ":file_to_test_package",
      ":gn_labels",
      ":gn_ninja_outputs",
      ":ninja_artifacts",
      ":script_commands",
      "//build/bazel/scripts:build_utils",
    ]
  }

  python_build_time_tests("client_test") {
    tests = [ "client_test.py" ]
    inputs = [
      "client",
      "target_metadata.schema.json",

      # Ninja is accessed implicitly by the test now.
      "//prebuilt/third_party/ninja/${host_os}-${host_cpu}/ninja",
    ]
    deps = [ ":client_lib" ]
  }

  group("host_tests") {
    testonly = true
    deps = [
      ":affected_tests_test",
      ":build_api_filter_test",
      ":client_test",
      ":debug_symbols_test",
      ":file_to_test_package_test",
      ":gn_labels_test",
      ":gn_ninja_outputs_test",
      ":ninja_artifacts_test",
      ":script_commands_test",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":host_tests($host_toolchain)" ]
}
