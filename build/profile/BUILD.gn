import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

group("tests") {
  testonly = true

  deps = [
    ":hardware_profiler_test($host_toolchain)",
    ":system_profiler_test($host_toolchain)",
  ]
}

if (is_host) {
  python_library("system_profiler") {
    sources = [ "system_profiler.py" ]
  }

  python_library("hardware_profiler") {
    sources = [ "hardware_profiler.py" ]
  }

  python_build_time_tests("system_profiler_test") {
    tests = [ "system_profiler_test.py" ]
    inputs = [ "system_profiler.py" ]
  }

  python_build_time_tests("hardware_profiler_test") {
    tests = [ "hardware_profiler_test.py" ]
    inputs = [ "hardware_profiler.py" ]
  }
}
