declare_args() {
  # The list of environment names to include in "basic_envs".
  basic_env_names = [ "emu" ]
}

_all_named_fuchsia_envs = []
_all_named_host_envs = []

# The 'enum' of supported device types. These values, like all referenced under
# environment dimensions, are known to Infrastructure.
device_types = {
  aemu = "AEMU"
  astro = "Astro"
  atlas = "Atlas"
  crosvm = "crosvm"
  gce = "GCE"
  iris = "Iris"
  kola = "Kola"
  lilac = "Lilac"
  luis = "Luis"
  maple = "Maple"
  nelson = "Nelson"
  nuc7 = "Intel NUC Kit NUC7i5DNHE"
  nuc11 = "Intel NUC Kit NUC11TNHv5"
  qemu = "QEMU"
  sherlock = "Sherlock"
  sorrel = "Sorrel"
  vim3 = "Vim3"
}

# The 'enum' of supported host device types. These values, like all referenced
# under environment dimensions, are known to Infrastructure.
host_device_types = {
  ampere_altra = "AmpereAltraMax-M128-30"
  ampere_one = "AmpereOne-A192-32X"
  gcp_c4a_highmem_96_bm = "GCP_C4A_HIGHMEM_96_BM"
  lattepanda_sigma_cell = "LATTEPANDA_SIGMA_CELL"
}

