load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_applicable_licenses = ["//:license"])

# The target API level of the current build configuration.
#
# The default is "PLATFORM", which corresponds to the platform build configuration.
#
# Other valid values are "NEXT", "HEAD", or a string that is the decimal
# representation of a positive integer corresponding to a currently Supported
# (not Sunset) API level.
#
# Only IDK build logic and related tests should change this setting.
# Only a limited set of macros and toolchain rules should reference it as these
# apply it correctly for affected targets.
#
# Note: This flag is distinct from similar Fuchsia Bazel SDK concepts,
# including the flags (`@fuchsia_sdk//flags:fuchsia_api_level` and
# `@fuchsia_sdk//flags:repository_default_fuchsia_api_level`) and the private
# `fuchsia_api_level()` rule and `get_fuchsia_api_level()` function.
# It should not be necessary to reference these and this flag in the same file
# or build. If you encounter such a situation, please contact the build team.
string_flag(
    name = "api_level",
    build_setting_default = "PLATFORM",
    visibility = [
        "//build/bazel/rules/fidl:__subpackages__",
        "//build/bazel/rules/idk/private:__subpackages__",
        "//build/bazel/rules/packages:__subpackages__",
        "//build/bazel/toolchains:__subpackages__",
    ],
)

# Configuration settings for each IDK buildable API level.
# These should only be used by IDK atom rules. In particular, they should not
# be used to condition IDK source files as these must be consistent for all
# API levels.
# TODO(https://fxbug.dev/490506836): Automatically generate these config_setting
# targets from the list of IDK buildable API levels.

_api_level_condition_visibility = [
    # The location where `verify_public_symbols()` is defined - see
    # https://fxbug.dev/491244314.
    "//build/bazel/rules/cc:__subpackages__",
    # The location where Rust toolchains are defined.
    "@fuchsia_prebuilt_rust//:__subpackages__",
]

config_setting(
    name = "is_api_level_PLATFORM",
    flag_values = {"//build/bazel/versioning:api_level": "PLATFORM"},
    visibility = _api_level_condition_visibility + [
        "//build/bazel/rules:__subpackages__",

        # Unlike the other macros in //build/bazel/rules/host/, `go_binary_host_tool()` is a
        # legacy macro, so this setting must be visible where that macro is used.
        "//build/bazel/rules/host_tests/tests/go:__pkg__",
        "//build/beads/.agent/skills:__subpackages__",
        "//build/config/python/generate_python_api_symbols:__pkg__",
        "//build/tools:__subpackages__",
        "//tools:__subpackages__",
        "//sdk/ctf/plasa:__subpackages__",
        "//src/tests/benchmarks/fidl/benchmark_suite/gen:__pkg__",
    ],
)

config_setting(
    name = "is_api_level_27",
    flag_values = {"//build/bazel/versioning:api_level": "27"},
    visibility = _api_level_condition_visibility,
)

config_setting(
    name = "is_api_level_28",
    flag_values = {"//build/bazel/versioning:api_level": "28"},
    visibility = _api_level_condition_visibility,
)

config_setting(
    name = "is_api_level_29",
    flag_values = {"//build/bazel/versioning:api_level": "29"},
    visibility = _api_level_condition_visibility,
)

config_setting(
    name = "is_api_level_30",
    flag_values = {"//build/bazel/versioning:api_level": "30"},
    visibility = _api_level_condition_visibility,
)

config_setting(
    name = "is_api_level_31",
    flag_values = {"//build/bazel/versioning:api_level": "31"},
    visibility = _api_level_condition_visibility,
)

config_setting(
    name = "is_api_level_32",
    flag_values = {"//build/bazel/versioning:api_level": "32"},
    visibility = _api_level_condition_visibility,
)

config_setting(
    name = "is_api_level_NEXT",
    flag_values = {"//build/bazel/versioning:api_level": "NEXT"},
    visibility = _api_level_condition_visibility,
)

config_setting(
    name = "is_api_level_HEAD",
    flag_values = {"//build/bazel/versioning:api_level": "HEAD"},
    visibility = _api_level_condition_visibility,
)
