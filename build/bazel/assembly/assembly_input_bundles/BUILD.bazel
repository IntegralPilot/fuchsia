load(
    "//build/bazel/rules/assembly:platform_artifacts.bzl",
    "platform_artifacts_from_fuchsia_platform",
)

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

# These targets are provided for use with @rules_fuchsia targets.  They source the platform
# artifacts from the fuchsia_platform Bazel Platform configuration.

platform_artifacts_from_fuchsia_platform(
    name = "platform_bringup",
    platform_artifacts = "//bundles/assembly:bringup",
)

platform_artifacts_from_fuchsia_platform(
    name = "platform",
    platform_artifacts = "//bundles/assembly:platform",
)

# TODO(https://fxbug.dev/483063916): Remove these aliases when all references
# point to the above :platform target instead.
alias(
    name = "platform_user",
    actual = ":platform",
)

alias(
    name = "platform_userdebug",
    actual = ":platform",
)

alias(
    name = "platform_eng",
    actual = ":platform",
)
