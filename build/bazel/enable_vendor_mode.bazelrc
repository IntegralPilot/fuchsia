# The following settings are used to enable Bazel "vendor mode"
# which forces Bazel to use pre-downloaded third-party repositories
# instead of trying to download them from the internet. This is
# achieved by:
#  - Disallowing network downloads from repository rules and module extensions.
#  - Adding --vendor_dir=<vendor_dir> to locate the vendored dependencies.
#  - Adding --registry=file://<registry_dir> to locate the registry to use
#
# These flags must *not* be used when running the special "vendor"
# command, used to populate <vendor_dir> and <registry_dir>, which is
# why they are not part of the workspace's .bazelrc file. Instead the
# Bazel wrapper launcher script adds a --bazelrc option pointing to
# this file for all commands *except* the "vendor" one.

# Prevent repository downloads with custom downloader config file.
common --downloader_config=build/bazel/config/no_downloads_allowed.config

# Use specific vendor directory to pick the content of repository dependencies.
# LINT.IfChange(bazel_vendor_dir)
common --vendor_dir=third_party/bazel_vendor
# LINT.ThenChange(
#     //build/bazel_sdk/tests/scripts/bazel_test.py:bazel_vendor_dir,
#     //build/bazel/bazel_fuchsia_sdk.gni:bazel_vendor_dir,
#     //tools/devshell/contrib/update-bazel-vendor-dir:bazel_vendor_dir
# )

# Use specific module registry to resolve MODULE.bazel dependencies.
# Note that Bazel uses --registry=url://bcr.bazel.build by default if no
# --registry option is used, which points to the default Bazel Central Registry.
# LINT.IfChange(bazel_registry_dir)
common --registry=file://%workspace%/third_party/bazel_registries/bcr.bazel.build
# LINT.ThenChange(
#     //build/bazel_sdk/tests/scripts/bazel_test.py:bazel_registry_dir,
#     //build/bazel/bazel_fuchsia_sdk.gni:bazel_registry_dir,
#     //tools/devshell/contrib/update-bazel-vendor-dir:bazel_registry_dir
# )

