# Collect information about one or more Bazel test labels.
#
# This template does not build anything, it emits GN metadata, and targets using
# this template should be in transitive dependencies of //:bazel_test_suites to
# ensure that the Bazel tests they reference appear in `tests.json` and thus are
# visible to `fx test` and infra builders.
#
# See //docs/development/build/bazel_concepts/tests.md for details. In a
# nutshell:
#
# - Add a GN bazel_test_suite() target referencing the Bazel tests.
# - Ensure it is reachable from the //:bazel_test_suites target, e.g. by
#   adding it to `host_tests` or `developer_specified_tests` in `args.gn`.
#
# Args:
#   host_tests: A string list, where each item is a Bazel label to
#       a test_suite() target (preferred), or a host_xxx_test() targets.
#       Labels do not have to start with @ here or match any target in
#       the GN graph.
#
#   visibility: Usual meaning.
#
template("bazel_test_suite") {
  group(target_name) {
    forward_variables_from(invoker, [ "visibility" ])
    testonly = true
    metadata = {
      # TODO(https://fxbug.dev/546173288): Support target tests as well, not
      # just host tests.
      # Used by //:bazel_test_suites target.
      bazel_test_suite = [] + invoker.host_tests
      bazel_test_suite_barrier = []
    }
  }
}
