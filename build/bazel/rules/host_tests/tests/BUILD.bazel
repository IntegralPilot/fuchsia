load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_CONSTRAINTS,
    tests = [
        "//build/bazel/rules/host_tests/tests/cc:host_tests",
        "//build/bazel/rules/host_tests/tests/go:host_tests",
        "//build/bazel/rules/host_tests/tests/host_test_data:host_tests",
        "//build/bazel/rules/host_tests/tests/py:host_tests",
        "//build/bazel/rules/host_tests/tests/rust:host_tests",
    ],
    visibility = ["//build/bazel/rules/tests:__subpackages__"],
)
