load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/host_tests:host_test.bzl", "host_test")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")
load(
    ":host_tests.bzl",
    "build_flags_rust_binary_host_test",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    visibility = ["//build/bazel/rules/build_flags/tests:__pkg__"],
)

# A test to verify that 'rustflags' and 'rustenv' attributes of build_flags()
# are correctly passed to the Rust compiler.

build_flags(
    name = "flags_rust",
    rustenv = ["RUSTENV_TEST_VAR=hello_world"],
    rustflags = ["--cfg=rustflags_work"],
)

build_flags_rust_binary_host_test(
    name = "check_rustflags_and_rustenv",
    srcs = ["check_rustflags_and_rustenv.rs"],
    build_flags = [":flags_rust"],
    edition = "2024",
)

# This is the same test, but uses the rustc_binary() wrapper, while
# build_flags_rustc_binary_host_test() uses rust_binary() directly.
rustc_binary(
    name = "check_rustc_binary_with_rustflags_and_rustenv_bin",
    srcs = ["check_rustflags_and_rustenv.rs"],
    build_flags = [":flags_rust"],
    edition = "2024",
)

host_test(
    name = "check_rustc_binary_with_rustflags_and_rustenv",
    binary = ":check_rustc_binary_with_rustflags_and_rustenv_bin",
)

# Checks for rustc_xxx() wrapper macros.

rustc_library(
    name = "check_rustc_library_lib",
    srcs = ["check_rustc_library.rs"],
    build_flags = [":flags_rust"],
    edition = "2024",
)

rustc_proc_macro(
    name = "check_rustc_proc_macro_lib",
    srcs = ["check_rustc_proc_macro.rs"],
    build_flags = [":flags_rust"],
    edition = "2024",
)

rustc_binary(
    name = "check_rust_rules_test_bin",
    srcs = ["check_rust_rules.rs"],
    edition = "2024",
    proc_macro_deps = [
        ":check_rustc_proc_macro_lib",
    ],
    deps = [
        ":check_rustc_library_lib",
    ],
)

host_test(
    name = "check_rust_rules_test",
    binary = ":check_rust_rules_test_bin",
)

host_rustc_test(
    name = "check_rustc_test_with_rustflags_and_rustenv",
    srcs = ["check_rustc_test.rs"],
    build_flags = [":flags_rust"],
    edition = "2024",
)
