import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  python_library("main_build_lib") {
    sources = [
      "main_build.py",
      "signal_utils.py",
    ]
  }

  python_library("signal_utils_lib") {
    sources = [ "signal_utils.py" ]
  }

  python_library("ninjatrace2json_lib") {
    sources = [ "ninjatrace2json.py" ]
  }

  python_build_time_tests("main_build_test") {
    tests = [ "main_build_test.py" ]
    deps = [ ":main_build_lib" ]
  }

  python_build_time_tests("signal_utils_test") {
    tests = [ "signal_utils_test.py" ]
    deps = [ ":signal_utils_lib" ]
  }

  python_build_time_tests("ninjatrace2json_test") {
    tests = [ "ninjatrace2json_test.py" ]
    deps = [ ":ninjatrace2json_lib" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":main_build_test($host_toolchain)",
    ":ninjatrace2json_test($host_toolchain)",
    ":signal_utils_test($host_toolchain)",
  ]
}
