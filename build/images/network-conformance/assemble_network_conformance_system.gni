import("//build/assembly/assembled_system.gni")
import("//build/assembly/board_configuration.gni")
import("//build/assembly/product_assembly_configuration.gni")
import("//build/assembly/product_bundle.gni")
import("//build/info/info.gni")
import("//build/testing/host_test_data.gni")
import("//src/storage/fshost/generated_fshost_config.gni")

# Wraps assembled_system to allow adding internal network-conformance test
# stubs.
#
# Parameters
#
#   additional_cache_packages
#     Additional package labels to include in the product assembly
#     configuration.  These must not be groups, but labels of fuchsia_package()
#     targets.
#
template("assemble_network_conformance_system") {
  _image_name = target_name

  labels = {
    product_config = "${target_name}.product_assembly_config"
    product_config_fxfs = "${target_name}.product_assembly_config_fxfs"
    board_config = "${target_name}.board_config"
    assembled_system = "${target_name}.assembled_system"
  }

  files = {
    assembled_system = "${target_out_dir}/${labels.assembled_system}"
  }

  board_configuration(labels.board_config) {
    name = "network-conformance"
    version = build_info_version
    partitions_config = "//boards/partitions:default"
    kernel = {
      halt_on_panic = true
    }
    filesystems = {
    }
    if (target_cpu == "x64") {
      input_bundles = [
        "//boards/x64:x64_common",
        "//boards/emulation/virtio",
      ]
    }

    provided_features = [
      "fuchsia::bus_pci",
      "fuchsia::real_time_clock",
      "fuchsia::usb_host",
      "fuchsia::usb_peripheral_support",
    ]
  }

  product_assembly_base = {
    testonly = true
    platform = {
      build_type = "eng"
      intl = {
        config_type = "none"
      }
      graphics = {
        virtual_console = {
          enable = false
        }
      }
    }
    cache_packages = [
      {
        package_target = "//src/connectivity/network/net-cli"
      },
      {
        package_target = "//src/connectivity/network/testing/network-test-realm/service:network-test-realm"
      },
    ]
  }
  if (defined(invoker.additional_cache_packages)) {
    foreach(_package, invoker.additional_cache_packages) {
      product_assembly_base.cache_packages += [
        {
          package_target = _package
        },
      ]
    }
  }

  product_assembly_configuration(labels.product_config) {
    forward_variables_from(product_assembly_base, "*")
    platform.storage = {
      filesystems = {
        image_name = _image_name
        image_mode = "ramdisk"

        if (!fxfs_blob) {
          volume = {
            fvm = {
              data = {
                data_filesystem_format = "minfs"
              }
              blob = {
              }
            }
          }
        }
      }
    }
  }

  assembled_system(labels.assembled_system) {
    testonly = true

    if (!fxfs_blob) {
      generate_fvm = true
    } else {
      generate_fxfs = true
    }

    ramdisk_in_zbi = true
    image_name = _image_name
    namespace = labels.assembled_system

    product_assembly_config_label = ":${labels.product_config}"
    board_config_label = ":${labels.board_config}"
  }

  product_bundle(target_name) {
    testonly = true
    name = target_name
    deps = [ ":${labels.assembled_system}" ]
    system_a = files.assembled_system
  }
}

# Produces the necessary `host_test_data` for a given invocation of
# `assemble_network_conformance_system` in order for the product bundle to be
# used in a host test.
#
# Parameters
#
#   assembly_name
#     The target_name passed to `assemble_network_conformance_system`.
template("network_conformance_assembly_host_test_data") {
  _assembly_name = invoker.assembly_name

  _out_dir = get_label_info(":anything($target_toolchain)", "target_out_dir")
  host_test_data(target_name) {
    sources = [ "${_out_dir}/${_assembly_name}" ]
    deps = [ ":${_assembly_name}($target_toolchain)" ]
  }
}
