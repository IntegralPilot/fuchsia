import("//build/python/python_action.gni")

# Declares a target that collects individual size reports from GN metadata
# and merges them into a single size report JSON file.
#
# Parameters
#
#   deps (required)
#     The list of targets to walk for "gerrit_size_reports" metadata.
#     Type: list(label)
#
#   testonly
#   visibility
#
template("size_report_aggregator") {
  assert(defined(invoker.deps), "deps is required for size_report_aggregator")

  _main_target = target_name
  _manifest_target = "${target_name}_manifest"
  _manifest_file = "$target_gen_dir/${target_name}_inputs.json"
  _output = "$target_out_dir/${target_name}.json"
  _depfile = "${_output}.d"

  generated_file(_manifest_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":${_main_target}" ]
    outputs = [ _manifest_file ]
    data_keys = [ "gerrit_size_reports" ]
    walk_keys = [ "gerrit_size_reports_barrier" ]
    output_conversion = "json"
    deps = invoker.deps
  }

  python_action(target_name) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    binary_label = "//build/assembly/scripts:size_report_merger"
    inputs = [ _manifest_file ]
    outputs = [ _output ]
    depfile = _depfile
    args = [
      "--input-manifest",
      rebase_path(_manifest_file, root_build_dir),
      "--merged-size-reports",
      rebase_path(_output, root_build_dir),
      "--depfile",
      rebase_path(_depfile, root_build_dir),
    ]
    deps = invoker.deps + [ ":${_manifest_target}" ]
    metadata = {
      gerrit_size_reports = [ rebase_path(_output, root_build_dir) ]
      gerrit_size_reports_barrier = []
    }
  }
}
