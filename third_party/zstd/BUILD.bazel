    name = "zstd",
    srcs = ZSTD_COMMON_SOURCES + ZSTD_COMPRESS_SOURCES + ZSTD_DECOMPRESS_SOURCES,
    hdrs = [
        "include/zstd/zstd.h",
        "include/zstd/zstd_errors.h",
        "src/lib/zdict.h",
        "src/lib/zstd.h",
        "src/lib/zstd_errors.h",
    ],
    copts = [
        "-Wno-conversion",
        "-Wno-unused-but-set-variable",
        "-Wno-bitwise-instead-of-logical",
        "-Wno-implicit-fallthrough",
        "-Isrc/lib",
        "-Isrc/lib/common",
        "-Isrc/lib/compress",
        "-Isrc/lib/dictBuilder",
    ],
    defines = [
        "XXH_NAMESPACE=ZSTD_",
        "ZDICTLIB_VISIBILITY=",
        "ZSTDERRORLIB_VISIBILITY=",
        "ZSTDLIB_HIDDEN=",
        "ZSTDLIB_VISIBILITY=",
        "ZSTDLIB_VISIBLE=",
        "ZSTD_MULTITHREAD",
    ],
    includes = [
        "include",
    ],
    linkopts = ["-lpthread"],
    visibility = ["//visibility:public"],
)

