# The definitions in BUILD.gn are too complex for bazel2gn (due to custom
# configs, standalone kernel decompressor, and multiple targets).
# Keep these files manually synchronized.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange
ZSTD_COMMON_SOURCES = [
