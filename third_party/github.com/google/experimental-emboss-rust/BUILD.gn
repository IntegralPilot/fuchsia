import("//build/python/python_binary.gni")
import("//build/python/python_library.gni")
import("//build/rust/rustc_library.gni")
import(
    "//third_party/github.com/google/experimental-emboss-rust/src/gen/sources.gni")

visibility = [ ":*" ]

python_library("emboss_compiler") {
  enable_mypy = false
  library_name = "compiler"
  source_root = "src/compiler"
  sources = [
    "__init__.py",
    "back_end/__init__.py",
    "back_end/cpp/__init__.py",
    "back_end/cpp/attributes.py",
    "back_end/cpp/emboss_codegen_cpp.py",
    "back_end/cpp/generated_code_templates",
    "back_end/cpp/header_generator.py",
    "back_end/experimental/__init__.py",
    "back_end/experimental/rust/__init__.py",
    "back_end/experimental/rust/emboss_codegen_rust.py",
    "back_end/experimental/rust/generated_code_templates",
    "back_end/util/__init__.py",
    "back_end/util/code_template.py",
    "front_end/__init__.py",
    "front_end/attribute_checker.py",
    "front_end/attributes.py",
    "front_end/constraints.py",
    "front_end/dependency_checker.py",
    "front_end/emboss_front_end.py",
    "front_end/error_examples",
    "front_end/expression_bounds.py",
    "front_end/generated/cached_parser.py",
    "front_end/glue.py",
    "front_end/lr1.py",
    "front_end/make_parser.py",
    "front_end/module_ir.py",
    "front_end/parser.py",
    "front_end/prelude.emb",
    "front_end/reserved_words",
    "front_end/symbol_resolver.py",
    "front_end/synthetics.py",
    "front_end/tokenizer.py",
    "front_end/type_check.py",
    "front_end/write_inference.py",
    "util/__init__.py",
    "util/attribute_util.py",
    "util/error.py",
    "util/expression_parser.py",
    "util/ir_data.py",
    "util/ir_data_fields.py",
    "util/ir_data_utils.py",
    "util/ir_util.py",
    "util/name_conversion.py",
    "util/parser_types.py",
    "util/parser_util.py",
    "util/resources.py",
    "util/simple_memoizer.py",
    "util/traverse_ir.py",
  ]
}

python_binary("embossc") {
  main_source = "main.py"
  main_callable = "main"
  sources = [ "embossc_lib.py" ]
  enable_mypy = false
  deps = [ ":emboss_compiler" ]
  visibility += [ "//*" ]
}

config("cpp_utils_config") {
  include_dirs = [ "src" ]
}

source_set("cpp_utils") {
  sources = []
  foreach(s, emboss_runtime_cpp_sources) {
    sources += [ "src/$s" ]
  }
  public_configs = [ ":cpp_utils_config" ]

  # This backend is still experimental and as such should only be used
  # by the `sunstone` project.
  visibility += [ "//src/connectivity/bluetooth/sunstone:*" ]
}

rustc_library("emboss_runtime") {
  crate_name = "emboss_runtime"
  version = "0.1.0"
  edition = "2024"
  source_root = "src/runtime/experimental/rust/src/lib.rs"
  sources = [
    "src/runtime/experimental/rust/src/lib.rs",
    "src/runtime/experimental/rust/src/prelude.rs",
    "src/runtime/experimental/rust/src/typestate.rs",
  ]

  # This backend is still experimental and as such should only be used
  # by the `sunstone` project.
  visibility += [
    "//src/connectivity/bluetooth/sunstone:*",
    "//src/connectivity/bluetooth/sunstone/*",
  ]
}
