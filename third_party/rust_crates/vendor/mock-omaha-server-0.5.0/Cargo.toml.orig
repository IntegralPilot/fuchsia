[package]
name = "mock-omaha-server"
version = "0.5.0"
edition = "2024"
description = "Mock implementation of the server end of the Omaha Protocol"
license = "BSD-2-Clause OR Apache-2.0 OR MIT"
repository = "https://github.com/google/omaha-client"
readme = "README.md"

exclude = [".*"]

[features]
default = []
tokio = ["dep:tokio", "hyper-util/tokio"]

[dependencies]
anyhow = "1.0"
argh = "0.1"
derive_builder = "0.20"
hex = "0.4"
http-body = "1"
hyper = { version = "1", default-features = false, features = ["http1", "server"] }
hyper-util = "0.1"
log = "0.4"
omaha_client = { version = "0.4", path = "../omaha-client" }
p256 = "0.14"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
sha2 = "0.11"
url = "2"

tokio = { version = "1", features = ["io-util", "macros", "net", "rt", "rt-multi-thread", "sync", "time"], optional = true }

[dev-dependencies]
hyper-util = { version = "0.1", features = ["client-legacy", "http1"] }

[[bin]]
name = "mock-omaha-server"
required-features = ["tokio"]

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(export_testing_macro)'] }
