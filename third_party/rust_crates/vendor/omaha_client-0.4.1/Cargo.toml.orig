[package]
name = "omaha_client"
version = "0.4.1"
edition = "2024"
description = "Platform- and product-agnostic implementation of the client end of the Omaha Protocol"
license = "BSD-2-Clause OR Apache-2.0 OR MIT"
repository = "https://github.com/google/omaha-client"
readme = "README.md"

exclude = [".*"]

[dependencies]
anyhow = "1.0"
chrono = "0.4"
ecdsa =  { version = "0.17", features = ["pem"] }
elliptic-curve = "0.14"
futures = "0.3"
hex = "0.4"
http = "1"
http-body = "1"
http-body-util = "0.1"
hyper = "1"
hyper-util = { version = "0.1", features = ["http1"] }
bytes = "1"
itertools = "0.14"
log = "0.4"
p256 = "0.14"
pkcs8 = { version = "0.11", features = ["pem"] }
pretty_assertions = "1.2.1"
rand = { version = "0.9", default-features = false, features = ["thread_rng"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde_repr = "0.1"
sha2 = "0.11"
signature = "3"
thiserror = "2.0"
typed-builder = "0.23"
uuid = { version = "1.23", features = ["serde", "v4"] }
pin-project = "1.1"

[dev-dependencies]
argh = "0.1"
assert_matches = "1.5.0"
hyper-rustls = { version = "0.27", default-features = false, features = ["rustls-native-certs", "ring", "http1", "http2"] }
tokio = { version = "1", features = ["io-util", "macros", "net", "rt-multi-thread", "sync", "time"] }
url = "2"
