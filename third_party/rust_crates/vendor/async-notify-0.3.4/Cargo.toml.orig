[package]
name = "async-notify"
version = "0.3.4"
authors = ["Sherlock Holo <sherlockya@gmail.com>"]
edition = "2024"
license = "MIT"
repository = "https://github.com/Sherlock-Holo/async-notify"
description = "A general version async Notify, like `tokio` Notify but can work with any async runtime."
rust-version = "1.92.0"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html

[dependencies]
event-listener = "5.4.1"
futures-core = "0.3.32"
pin-project-lite = "0.2.16"

[dev-dependencies]
async-global-executor = { version = "3.1.0", default-features = false }
futures-util = "0.3.32"
