import("//zircon/kernel/kernel_rust_mod.gni")

source_set("ktrace") {
  public_deps = [ "//src/performance/lib/fxt:headers" ]

  sources = [
    "ktrace.cc",
    "ktrace_ffi.cc",
  ]
  deps = [
    ":ktrace-rs",
    "//zircon/kernel/hypervisor:headers",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/init",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/percpu_writer",
    "//zircon/kernel/lib/syscalls:headers",
    "//zircon/kernel/object:headers",
    "//zircon/system/ulib/zircon-internal",
  ]
}

kernel_rust_mod("ktrace-rs") {
  output_name = "ktrace_rs"
  source_root = "src/mod.rs"
  sources = [ "src/mod.rs" ]
  deps = [
    "macro:ktrace-macro",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/kstring",
    "//src/performance/lib/fxt/rust:fxt-layout",
    "//zircon/kernel/lib/spsc_buffer:spsc-buffer-rs",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true

  # TODO(https://fxbug.dev/529516970): We fail to link the KTrace Rust tests when GCC is used.
  if (!is_gcc) {
    deps = [ "tests" ]
  }
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
