import("//build/config/current_target_tuple.gni")
import("//build/config/sysroot.gni")
import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

source_set("counters") {
  visibility = [
    "//src/zircon/bin/kcounter:*",
    "//src/zircon/tests/kcounter:*",
    "//zircon/kernel/*",
    "//zircon/system/ulib/kcounter/*",
  ]

  public_deps = [ ":headers" ]

  if (is_kernel) {
    deps = [
      "//zircon/kernel/lib/init",
      "//zircon/kernel/lib/special-sections",
    ]
  }
}

kernel_rust_mod("counters-rs") {
  output_name = "counters"
  source_root = "src/lib.rs"
  sources = [ "src/lib.rs" ]
  deps = [
    ":counters-bindings",
    "//src/lib/zr",
  ]
}

library_headers("headers") {
  headers = [
    "lib/counters.h",
    "lib/counter-vmo-abi.h",
  ]

  public_deps = [
    # <lib/counters.h> has #include <lib/special-sections/special-sections.h>.
    "//zircon/kernel/lib/special-sections:headers",
  ]

  if (is_kernel) {
    public_deps += [ "//zircon/kernel/lib/libc:headers" ]
  }
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}

kernel_bindgen_crate("counters-bindings") {
  headers = [ "bindgen.h" ]
  cpp = true

  non_rust_deps = [ ":headers" ]

  type_allowlist = [ "counters::.*" ]

  notice_year = 2026

  raw_lines = [ "#![no_std]" ]

  expect_lints = [
    "clippy::missing_safety_doc",
    "non_camel_case_types",
    "non_upper_case_globals",
  ]
}
