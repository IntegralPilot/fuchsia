import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("page_cache-rs") {
  sources = [ "page_cache.rs" ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//third_party/rust_crates:pin-init",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

static_library("page_cache") {
  public_deps = [ ":headers" ]

  sources = [
    "page_cache.cc",
    "page_cache_ffi.cc",
  ]
  deps = [
    ":page_cache-rs",
    "//zircon/kernel/lib/counters",
    "//zircon/kernel/lib/crypto",
    "//zircon/kernel/lib/ktl",
  ]
}

library_headers("headers") {
  headers = [
    "lib/page_cache.h",
    "lib/page_cache_ffi.h",
  ]
  public_deps = [
    "//zircon/kernel/lib/ktl:headers",
    "//zircon/kernel/vm:headers",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
