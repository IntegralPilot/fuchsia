import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

static_library("fbl") {
  public_deps = [ ":headers" ]

  sources = [
    "alloc-checker-new.cc",
    "arena.cc",
  ]
  deps = [
    "//sdk/lib/fit",
    "//zircon/kernel/lib/heap",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/vm:headers",
    "//zircon/system/ulib/fbl",
  ]
}

library_headers("headers") {
  headers = []

  public_deps = [
    "//zircon/system/ulib/fbl:headers",

    # <fbl/gparena.h> has #include <lib/fit/defer.h>
    "//sdk/lib/fit:headers",

    # <fbl/arena.h> has #include <ktl/forward.h>.
    "//zircon/kernel/lib/ktl:headers",

    # <fbl/gparena.h> has #include <lib/page/size.h>
    "//zircon/kernel/lib/page:headers",
  ]
}

group("tests") {
  testonly = true
}

kernel_rust_mod("name_tests_rust") {
  testonly = true
  source_root = "tests/kernel.rs"
  sources = [ "tests/kernel.rs" ]
  deps = [
    "//third_party/rust_crates:pin-init",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("kernel-tests") {
  testonly = true
  visibility = [
    ":*",
    "//zircon/kernel/lib:kernel-tests",
  ]
  sources = [
    "arena_tests.cc",
    "gparena_tests.cc",
    "name_tests.cc",
  ]

  deps = [
    ":headers",
    ":name_tests_rust",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/lib/unittest",
  ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
