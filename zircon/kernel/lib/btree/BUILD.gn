import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "lib/btree.h" ]
  public_deps = [
    # The re-exported implementation headers use #include
    # <fbl/packed_pointer.h> and #include <fbl/ref_ptr.h>.
    "//zircon/system/ulib/fbl",
  ]
}

source_set("btree") {
  if (!is_host) {
    sources = [ "btree.cc" ]
    deps = [
      "//src/lib/lazy_init",
      "//zircon/kernel/lib/init",
      "//zircon/kernel/lib/page",
      "//zircon/kernel/vm:headers",
    ]
  }
  public_deps = [ ":headers" ]
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
