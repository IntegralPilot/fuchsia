import("//build/cpp/library_headers.gni")
import("//build/zircon/zircon_cpu.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")
import("//zircon/kernel/params.gni")

source_set("kernel") {
  public_deps = [ ":headers" ]

  sources = [
    "brwlock.cc",
    "cpu_distance_map.cc",
    "cpu_search_set.cc",
    "deadline.cc",
    "debug.cc",
    "dpc.cc",
    "event.cc",
    "event_ffi.cc",
    "idle_power_thread.cc",
    "init.cc",
    "koid_ffi.cc",
    "lazy_owned_wait_queue.cc",
    "mp.cc",
    "mp_ffi.cc",
    "mutex.cc",
    "owned_wait_queue.cc",
    "owned_wait_queue_ffi.cc",
    "owned_wait_queue_pool.cc",
    "percpu.cc",
    "recurring_callback.cc",
    "restricted_ffi.cc",
    "rppm_ffi.cc",
    "scheduler.cc",
    "scheduler_ffi.cc",
    "scheduler_pi.cc",
    "scheduler_state.cc",
    "semaphore.cc",
    "stats_ffi.cc",
    "task_runtime_stats.cc",
    "thread.cc",
    "thread_ffi.cc",
    "timer.cc",
    "timer_ffi.cc",
    "wait.cc",
  ]

  deps = [
    "//sdk/lib/fit",
    "//src/lib/lazy_init",
    "//zircon/kernel/dev/interrupt",
    "//zircon/kernel/dev/pdev/hw_watchdog",
    "//zircon/kernel/dev/pdev/power:headers",
    "//zircon/kernel/lib/arch",
    "//zircon/kernel/lib/boot-options:headers",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/counters",
    "//zircon/kernel/lib/fbl",
    "//zircon/kernel/lib/heap",
    "//zircon/kernel/lib/init",
    "//zircon/kernel/lib/jtrace",
    "//zircon/kernel/lib/kconcurrent",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/ktrace",
    "//zircon/kernel/lib/libc",
    "//zircon/kernel/lib/mmu_rcu",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/lib/power-management",
    "//zircon/kernel/lib/sched",
    "//zircon/kernel/lib/stall",
    "//zircon/kernel/lib/suspend_wakeup_timer",
    "//zircon/kernel/lib/thread_sampler",
    "//zircon/kernel/lib/topology",
    "//zircon/kernel/lib/userabi",
    "//zircon/kernel/lib/wake-vector",
    "//zircon/kernel/object",
    "//zircon/kernel/vm",
    "//zircon/system/ulib/affine",
    "//zircon/system/ulib/explicit-memory",
    "//zircon/system/ulib/pretty",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]

  # TODO(https://fxbug.dev/42101573): This dependency is conditional because when built
  # with GCC the kernel uses function scoped statics requiring dynamic
  # initialization. Once https://fxbug.dev/42101573 is fixed, this dependency can be made
  # unconditional.
  if (!is_gcc) {
    deps += [ "//zircon/kernel/lib/cxxabi-dynamic-init" ]
  }
}

library_headers("headers") {
  headers = []
}

source_set("tests") {
  testonly = true
  sources = [
    "intensive_thread_test.cc",
    "mutex_tests.cc",
    "semaphore_tests.cc",
    "spinlock_tests.cc",
    "thread_test.cc",
  ]
  deps = [
    "//zircon/kernel/lib/arch",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/unittest",
    "//zircon/system/ulib/zircon-internal",
  ]
}

group("kernel-tests") {
  testonly = true
  deps = [ ":tests" ]
}

kernel_bindgen_crate("event-bindings") {
  visibility = [ "//zircon/kernel/*" ]
  headers = [ "//zircon/kernel/include/kernel/event_ffi.h" ]
  non_rust_deps = [ ":kernel" ]
  output_name = "event_bindings.rs"
  cpp = true

  edition = "2024"
  notice_year = 2026
  function_allowlist = [
    "cpp_event_.*",
    "cpp_autounsignal_event_.*",
  ]
  type_allowlist = [
    "Event",
    "AutounsignalEvent",
  ]
  type_blocklist = [
    "Deadline",
    "Interruptible",
    "OwnedWaitQueue",
    "zx_instant_mono_t",
    "zx_status_t",
  ]
  opaque_types = [
    "Event",
    "AutounsignalEvent",
  ]
  function_blocklist = [
    "Event_.*",
    "AutounsignalEvent_.*",
  ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  deps = [ "//sdk/rust/zx-types" ]
  expect_lints = [
    "non_camel_case_types",
    "non_upper_case_globals",
  ]
  raw_lines = [
    "#![no_std]",
    "pub use zx_types::{zx_instant_mono_t, zx_status_t};",
    "pub type Deadline = core::ffi::c_void;",
    "pub type Interruptible = bool;",
    "pub type OwnedWaitQueue = core::ffi::c_void;",
  ]
}

kernel_bindgen_crate("percpu-bindings") {
  visibility = [ "//zircon/kernel/*" ]
  headers = [ "//zircon/kernel/include/kernel/percpu.h" ]
  non_rust_deps = [ ":kernel" ]
  cpp = true

  edition = "2024"
  notice_year = 2026

  function_blocklist = [ ".*" ]

  type_allowlist = [
    "percpu",
    "ktl::atomic",
    "std::atomic",
    "guest_stats",
    "cpu_stats",
    "TimerQueue",
    "CpuSearchSet",
    "Scheduler",
    "IdlePowerThread",
    "DpcRunner",
    "vm_page_counts",
    "vm_page_counts_t",
    "Timer",
    "StallAccumulator",
    "PlatformCpuResumeState",
    "lockdep::ThreadLockState",
    "ChainLockTransaction",
  ]
  type_blocklist = [
    "zx_duration_mono_t",
    "zx_instant_mono_t",
    "TimerQueue_.*",
    "CpuSearchSet_.*",
    "Scheduler_.*",
    "IdlePowerThread_.*",
    "DpcRunner_.*",
    "Timer_.*",
    "StallAccumulator_.*",
    "PlatformCpuResumeState_.*",
    "ChainLockTransaction_.*",
  ]
  var_blocklist = [ "percpu_.*" ]
  opaque_types = [
    "TimerQueue",
    "CpuSearchSet",
    "Scheduler",
    "IdlePowerThread",
    "DpcRunner",
    "Timer",
    "StallAccumulator",
    "PlatformCpuResumeState",
    "ktl::atomic",
    "std::atomic",
    "lockdep::ThreadLockState",
    "vm_page_counts",
    "ChainLockTransaction",
  ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  deps = [ "//sdk/rust/zx-types" ]
  expect_lints = [ "non_camel_case_types" ]
  raw_lines = [
    "#![no_std]",
    "pub use zx_types::{zx_duration_mono_t, zx_instant_mono_t};",
    "pub type ulong = ::core::ffi::c_ulong;",
  ]
}

kernel_rust_mod("kernel-rs") {
  output_name = "kernel"
  source_root = "mod.rs"
  sources = [
    "bits.rs",
    "deadline.rs",
    "event.rs",
    "koid.rs",
    "mod.rs",
    "mp.rs",
    "owned_wait_queue.rs",
    "percpu.rs",
    "relaxed_atomic.rs",
    "restricted.rs",
    "restricted_state.rs",
    "scheduler.rs",
    "scheduler_state.rs",
    "stats.rs",
    "thread.rs",
    "timer.rs",
    "types.rs",
  ]
  deps = [
    ":event-bindings",
    ":percpu-bindings",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:paste",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/object-constants:object-constants-rs",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}
