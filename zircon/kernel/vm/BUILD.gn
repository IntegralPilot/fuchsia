    "cpp_make_partially_committed_pager_vmo",
    "cpp_make_private_attribution_counts",
    "cpp_supply_pager_vmo_pages",
    "cpp_test_rand",
    "cpp_test_region",
    "cpp_verify_continuous_attribution_bytes",
  ]
  type_blocklist = [
    "AttributionCounts",
    "VmObject",
    "VmObjectPaged",
    "vm_page_t",
    "zx_status_t",
  ]

  additional_bindgen_flags = [ "--no-recursive-allowlist" ]

  raw_lines = [
    "#![no_std]",
    "use attribution_bindings::vm_AttributionCounts;",
    "use page_bindings::vm_page_t;",
    "use vm_object_bindings::VmObject;",
    "use vm_object_paged_bindings::VmObjectPaged;",
    "use zx_types::zx_status_t;",
  ]
  deps = [
    ":attribution-bindings",
    ":page-bindings",
    ":vm-object-bindings",
    ":vm-object-paged-bindings",
    "//sdk/rust/zx-types",
  ]
}

kernel_rust_mod("vm-rs-unittests") {
  output_name = "vm_unittests"
  testonly = true
  visibility = [ ":*" ]
  source_root = "unittests/mod.rs"
  sources = [
    "unittests/aspace_unittest.rs",
    "unittests/continuous_attribution_unittest.rs",
    "unittests/slab_unittest.rs",
    "unittests/test_helper.rs",
    "unittests/vmo_unittest.rs",
    "unittests/vmpl_unittest.rs",
  ]
  deps = [
    ":test-helper-bindings",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//third_party/rust_crates:pin-init",
    "//third_party/rust_crates:rand",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [
    ":test-helper-bindings",
    "//zircon/kernel/lib/unittest:unittest-rs",
  ]
}

config("suppress-nonheap-warning") {
  visibility = [ ":*" ]
  if (is_gcc) {
    cflags = [ "-Wno-free-nonheap-object" ]
  }
}

source_set("tests") {
  testonly = true
  sources = [
    "unittests/aspace_unittest.cc",
    "unittests/compression_unittest.cc",
    "unittests/continuous_attribution_unittest.cc",
    "unittests/evictor_unittest.cc",
    "unittests/page_queues_unittest.cc",
    "unittests/pmm_unittest.cc",
    "unittests/slab_unittest.cc",
    "unittests/test_helper.cc",
    "unittests/test_helper_ffi.cc",
    "unittests/vmo_unittest.cc",
    "unittests/vmpl_unittest.cc",
  ]
  deps = [
    ":vm-rs-unittests",
    "//third_party/lz4",
    "//zircon/kernel/lib/page",
    "//zircon/kernel/lib/unittest",
  ]
}

group("kernel-tests") {
  testonly = true
  deps = [ ":tests" ]
}
