import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

group("interrupt") {
  public_deps = [ ":headers" ]
  deps = [ ":dev_interrupt" ]
}

library_headers("headers") {
  headers = [
    "dev/interrupt.h",
    "dev/interrupt-limits.h",
  ]
  public_deps = [ "//sdk/lib/fit" ]
}

kernel_rust_mod("dev_interrupt") {
  deps = [ ":interrupt-limits" ]
  visibility = [ ":*" ]
  source_root = "interrupt.rs"
  sources = [ "interrupt.rs" ]
}

kernel_bindgen_crate("interrupt-limits") {
  headers = [ "include/dev/interrupt-limits.h" ]
  cpp = true
  non_rust_deps = [ ":headers" ]
  raw_lines = [ "#![no_std]" ]
  var_allowlist = [ "MAX_INTERRUPTS" ]
  notice_year = 2026
}
