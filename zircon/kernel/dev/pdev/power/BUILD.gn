import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "pdev/power.h" ]
}

kernel_rust_mod("power-rs") {
  output_name = "pdev_power"
  source_root = "power.rs"
  sources = [
    "console.rs",
    "power.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/zr",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/debug",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("power") {
  sources = [ "power_ffi.cc" ]
  public_deps = [ ":headers" ]
  deps = [ ":power-rs" ]
}
