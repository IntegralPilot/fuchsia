import("//zircon/kernel/kernel_rust_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")
import("//zircon/kernel/params.gni")

# This directory has tests of the Rust build support and fundamental features
# of the compiler and cross-language linkage support.  It is not a place to put
# tests for other kernel code that happens to be in Rust.

source_set("kernel-tests") {
  testonly = true
  sources = [ "rust-tests.cc" ]
  deps = [
    ":test_mod",
    ":trivial_tests",
    "//zircon/kernel/lib/unittest",
  ]
}

kernel_rust_crate("trivial_tests") {
  testonly = true
  visibility = [ ":*" ]
  sources = [ "src/lib.rs" ]
  deps = [ "test_macro" ]
}

kernel_rust_mod("test_mod") {
  testonly = true
  visibility = [ ":*" ]
  sources = [
    "test_mod.rs",
    "test_submod.rs",
  ]
  public_deps = [ ":test_dep_pub_mod" ]
  deps = [ ":test_dep_rename_mod" ]
}

kernel_rust_mod("test_dep_pub_mod") {
  testonly = true
  visibility = [ ":*" ]
  sources = [ "test_dep_pub_mod.rs" ]
  deps = [
    ":test_dep_priv_mod",
    "test_lib",
  ]
}

kernel_rust_mod("test_dep_priv_mod") {
  testonly = true
  visibility = [ ":*" ]
  sources = [ "test_dep_priv_mod.rs" ]
  deps = [ "test_macro" ]
}

kernel_rust_mod("test_dep_rename_mod") {
  testonly = true
  visibility = [ ":*" ]
  output_name = "test_dep_renamed_mod"
  source_root = "test_dep_was_renamed_mod.rs"
  sources = [ "test_dep_was_renamed_mod.rs" ]
}
