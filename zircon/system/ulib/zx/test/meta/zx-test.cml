{
    include: [
        "//src/sys/test_runners/elf/create_raw_processes.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        binary: "test/zx-test",
    },
    use: [
        {
            protocol: [
                "fuchsia.boot.WriteOnlyLog",
                "fuchsia.kernel.ProfileResource",
            ],
        },
    ],
}
