import("//build/zircon/zx_library.gni")

group("tests") {
  testonly = true
  deps = [ "test:tests" ]
}

# LINT.IfChange
zx_library("zx") {
  sdk = "source"
  sdk_publishable = "partner"
  stable = true

  sdk_headers = [ "lib/zx/result.h" ]
  sources = []

  # Be compatible with hermetic_source_set() deps reaching this target.  The
  # vDSO link stub will satisfy references in the outer link rather than being
  # an input to the hermetic relocatable link.
  deps = [ "//src/zircon/lib/zircon:zircon.as-needed" ]

  public_deps = [
    "//sdk/lib/fit",
    "//sdk/lib/stdcompat",
    "//src/zircon/lib/zircon:headers",
  ]

  if (is_fuchsia && !is_kernel) {
    sdk_headers += [
      "lib/zx/bti.h",
      "lib/zx/channel.h",
      "lib/zx/clock.h",
      "lib/zx/counter.h",
      "lib/zx/debuglog.h",
      "lib/zx/event.h",
      "lib/zx/eventpair.h",
      "lib/zx/exception.h",
      "lib/zx/fifo.h",
      "lib/zx/guest.h",
      "lib/zx/handle.h",
      "lib/zx/interrupt.h",
      "lib/zx/iob.h",
      "lib/zx/iommu.h",
      "lib/zx/job.h",
      "lib/zx/msi.h",
      "lib/zx/object.h",
      "lib/zx/object_traits.h",
      "lib/zx/pager.h",
      "lib/zx/pmt.h",
      "lib/zx/port.h",
      "lib/zx/process.h",
      "lib/zx/profile.h",
      "lib/zx/resource.h",
      "lib/zx/socket.h",
      "lib/zx/stream.h",
      "lib/zx/suspend_token.h",
      "lib/zx/task.h",
      "lib/zx/thread.h",
      "lib/zx/time.h",
      "lib/zx/timer.h",
      "lib/zx/vcpu.h",
      "lib/zx/vmar.h",
      "lib/zx/vmo.h",
    ]

    sources += [
      "bti.cc",
      "channel.cc",
      "counter.cc",
      "debuglog.cc",
      "event.cc",
      "eventpair.cc",
      "fifo.cc",
      "guest.cc",
      "interrupt.cc",
      "iob.cc",
      "iommu.cc",
      "job.cc",
      "msi.cc",
      "pager.cc",
      "port.cc",
      "process.cc",
      "profile.cc",
      "resource.cc",
      "socket.cc",
      "stream.cc",
      "thread.cc",
      "time.cc",
      "timer.cc",
      "vcpu.cc",
      "vmar.cc",
      "vmo.cc",
    ]
  }

  if (!is_kernel) {
    sources += [ "status_string.cc" ]
  }
}
# LINT.ThenChange(BUILD.bazel)
