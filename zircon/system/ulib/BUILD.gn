# This target holds tests under //zircon/system/ulib which are now hosted in
# packages but whose code hasn't yet been migrated to //src.
# When a migration happens, the test needs to be removed from this list and
# placed within the proper `tests` target under //src.

import("//build/fuzz.gni")

# IMPORTANT NOTE
# Do not add more libraries to this directory.
# New libraries should be introduced under //src.

group("tests") {
  testonly = true
  deps = [
    "affine:tests",
    "bitmap:tests",
    "closure-queue:tests",
    "concurrent:tests",
    "debugdata:tests",
    "fbl:tests",
    "ffl:tests",
    "fzl:tests",
    "hwreg:tests",
    "id_allocator:tests",
    "image-format:tests",
    "inspect:tests",
    "inspector:tests",
    "ldmsg:tests",
    "mmio-ptr:tests",
    "mock-function:tests",
    "perftest:tests",
    "pretty:tests",
    "ram-crashlog:tests",
    "refcount:tests",
    "region-alloc:tests",
    "runtests-utils:tests",
    "smbios:tests",
    "sysconfig-client:tests",
    "syslog:tests",
    "sysmem-version:tests",
    "test-exceptions:tests",
    "tftp:tests",
    "trace-engine:tests",
    "trace-provider:tests",
    "trace-reader:tests",
    "trace-test-utils:tests",
    "trace-vthread:tests",
    "uart:tests",
    "zircon-internal:tests",
    "zx:tests",
    "zxtest:tests",
    "//third_party/lz4:tests",
    "//zircon/third_party/ulib/safemath:tests",
  ]
}

group("e2e_tests") {
  testonly = true
  deps = [ "uart:e2e_tests" ]
}
