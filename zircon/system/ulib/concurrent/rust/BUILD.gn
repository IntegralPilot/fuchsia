import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("concurrent") {
  edition = "2024"
  sources = [
    "src/common.rs",
    "src/copy.rs",
    "src/lib.rs",
    "src/seqlock.rs",
    "src/seqlock_payload.rs",
  ]
  deps = [
    "//src/lib/zr",
    "//third_party/rust_crates:zerocopy",
  ]
  with_unit_tests = true

  if (is_kernel) {
    features = [ "kernel" ]

    # Provides `cpp_arch_yield`, the FFI shim for `arch::Yield()`.
    deps += [ "//zircon/kernel/arch:ffi" ]
  }

  # Keep this in sync with the set of in-tree clients of libconcurrent.
  visibility = [
    ":*",
    "//zircon/kernel/lib/fasttime/*",
    "//zircon/kernel/lib/kconcurrent/*",
    "//zircon/system/ulib/concurrent/*",
  ]
}

fuchsia_unittest_package("concurrent-rust-test-pkg") {
  package_name = "concurrent-rust-test"
  deps = [ ":concurrent_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":concurrent-rust-test-pkg",
    ":concurrent_test($host_toolchain)",
  ]
}
