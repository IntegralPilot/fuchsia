import("//build/components.gni")
import("//build/config/current_target_tuple.gni")
import("//build/config/sysroot.gni")
import("//build/rust/rustc_bindgen.gni")
import("//build/rust/rustc_library.gni")

rustc_library("fbl") {
  edition = "2024"
  sources = [
    "src/array.rs",
    "src/canary.rs",
    "src/conditional_select_nospec.rs",
    "src/confine_array_index.rs",
    "src/doubly_linked_list.rs",
    "src/inline_array.rs",
    "src/intrusive_container_test_support.rs",
    "src/lib.rs",
    "src/name.rs",
    "src/opaque_ref_counted.rs",
    "src/packed_pointer.rs",
    "src/ptr_traits.rs",
    "src/recyclable.rs",
    "src/ref_counted.rs",
    "src/ref_ptr.rs",
    "src/ring_buffer.rs",
    "src/sentinel.rs",
    "src/singly_linked_list.rs",
    "src/size_tracker.rs",
    "src/slab_allocator.rs",
    "src/string_buffer.rs",
    "src/tag.rs",
    "src/unique_ptr.rs",
    "src/vector.rs",
    "src/wavl_tree.rs",
  ]
  with_unit_tests = true
  test_deps = [
    ":fbl-bindings",
    ":test_support",
    "//third_party/rust_crates:lock_api",
  ]
  deps = [
    "fbl-macros",
    "//src/lib/kalloc",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//third_party/rust_crates:zerocopy",
  ]

  # TODO(https://fxbug.dev/548748442): remove when all fixed in the code
  if (is_kernel) {
    features = [ "kernel" ]
    configs += [ "//zircon/kernel/switch:allow-redundant-pattern-matching" ]
    configs += [ "//zircon/kernel/switch:allow-collapsible-if" ]
    configs += [ "//zircon/kernel/switch:allow-let-unit-value" ]
    configs += [ "//zircon/kernel/switch:allow-type-complexity" ]
    configs += [ "//zircon/kernel/switch:allow-ptr-eq" ]
    configs += [ "//zircon/kernel/switch:allow-len-zero" ]
    configs += [ "//zircon/kernel/switch:allow-needless-late-init" ]
    configs += [ "//zircon/kernel/switch:allow-unnecessary-unwrap" ]
    configs += [ "//zircon/kernel/switch:allow-new-without-default" ]
    configs += [ "//zircon/kernel/switch:allow-needless-range-loop" ]
  }
}

source_set("test_support") {
  testonly = true
  public_configs = [ "//build/config/fuchsia:static_cpp_standard_library" ]
  sources = [
    "test/canary_test.cc",
    "test/doubly_linked_list_test.cc",
    "test/intrusive_container_test_support.cc",
    "test/intrusive_container_test_support.h",
    "test/opaque_ref_counted_test.cc",
    "test/ref_ptr_test.cc",
    "test/singly_linked_list_test.cc",
    "test/unique_ptr_test.cc",
    "test/wavl_tree_test.cc",
  ]
  deps = [ "//zircon/system/ulib/fbl" ]
}

group("rust") {
  public_deps = [ ":fbl" ]
}

fuchsia_unittest_package("fbl-rust-test-pkg") {
  package_name = "fbl-rust-test"
  deps = [ ":fbl_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":fbl-bindings",
    ":fbl-rust-test-pkg",
  ]
}

rustc_bindgen("fbl-bindings.bindgen") {
  testonly = true
  visibility = [ ":*" ]
  headers = [ "bindgen.h" ]
  cpp = true

  output_name = "fbl_bindings.rs"
  deps = [ "//zircon/system/ulib/fbl" ]

  type_allowlist = [ "fbl_bindgen::.*" ]

  notice_year = 2026

  raw_lines = [ "#![no_std]" ]

  expect_lints = [
    "non_camel_case_types",
    "non_upper_case_globals",
  ]
}

rustc_library("fbl-bindings") {
  testonly = true
  edition = "2024"
  source_root = "$target_gen_dir/fbl_bindings.rs"
  sources = [ "$target_gen_dir/fbl_bindings.rs" ]
  deps = [ ":fbl-bindings.bindgen" ]
}
