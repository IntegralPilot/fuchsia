import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("smbios") {
  name = "smbios"
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/entry_point.rs",
    "src/lib.rs",
    "src/string_table.rs",
    "src/structures.rs",
    "src/tests.rs",
  ]

  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/zr",
    "//third_party/rust_crates:zerocopy",
  ]

  # TODO(https://fxbug.dev/548748442): remove when all fixed in the code
  if (is_kernel) {
    configs += [ "//zircon/kernel/switch:allow-collapsible-if" ]
  }
}

fuchsia_unittest_package("smbios-rust-test-pkg") {
  package_name = "smbios-rust-test"
  deps = [ ":smbios_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":smbios-rust-test-pkg" ]
}
