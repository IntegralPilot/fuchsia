import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("pretty") {
  name = "pretty"
  edition = "2024"
  sources = [
    "src/hexdump.rs",
    "src/lib.rs",
    "src/sizes.rs",
  ]
  deps = [ "//src/lib/kprint" ]
  with_unit_tests = true

  # TODO(https://fxbug.dev/548748442): remove when all fixed in the code
  if (is_kernel) {
    configs += [ "//zircon/kernel/switch:allow-needless-range-loop" ]
    configs += [ "//zircon/kernel/switch:allow-collapsible-if" ]
    configs += [ "//zircon/kernel/switch:allow-write-with-newline" ]
    configs += [ "//zircon/kernel/switch:allow-manual-is-multiple-of" ]
  }
}

fuchsia_unittest_package("pretty-rust-tests") {
  deps = [ ":pretty_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":pretty-rust-tests" ]
}
