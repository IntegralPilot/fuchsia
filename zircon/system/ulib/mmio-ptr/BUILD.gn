import("//build/rust/rustc_library.gni")
import("//build/zircon/migrated_targets.gni")

zx_library("mmio-ptr") {
  sources = []

  sdk = "source"
  stable = true
  sdk_publishable = "partner"
  sdk_headers = [
    "lib/mmio-ptr/fake.h",
    "lib/mmio-ptr/mmio-ptr.h",
  ]
}

source_set("wrappers") {
  visibility = [ ":*" ]
  sources = [ "mmio-ptr.cc" ]
  deps = [ ":mmio-ptr" ]
}

rustc_library("mmio-ptr-rs") {
  name = "mmio_ptr"
  edition = "2024"
  source_root = "mmio-ptr.rs"
  sources = [ source_root ]
  deps = [
    ":mmio-ptr",
    ":wrappers",
  ]
}

group("tests") {
  testonly = true
  deps = [ "test" ]
}
