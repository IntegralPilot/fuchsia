import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "lib/test-exceptions/exception-catcher.h" ]
  public_deps = [ "//zircon/system/ulib/zx" ]
}

static_library("test-exceptions") {
  testonly = true
  public_deps = [ ":headers" ]
  sources = [ "exception-catcher.cc" ]
}

group("tests") {
  testonly = true
  deps = [ "test:tests" ]
}
