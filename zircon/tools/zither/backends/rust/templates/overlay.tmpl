{{- define "GenerateRustOverlay" -}}

{{- $name := UpperCamelCase . }}
{{- $discType := print $name "Discriminant" }}
{{- $attrs := OverlayAttributes . }}

{{ range .Comments }}
///{{ . }}
{{- end }}
{{- range $attrs }}
{{ . }}
{{- end }}
pub enum {{ $name }} {
{{ range .Variants }}
{{- if .Comments }}
{{ range .Comments }}
    ///{{ . }}
{{- end }}
{{ end -}}
    {{ UpperCamelCase . }}({{ DescribeType .Type }}) = {{ .Discriminant }},
{{ end }}
}

{{ end }}
