load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "cksum",
    srcs = [
        "crc32.c",
        "crc32.h",
        "zutil.h",
    ],
    hdrs = [
        "include/lib/cksum.h",
    ],
    copts = [
        "-Wno-strict-prototypes",
    ],
    includes = [
        "include",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
)
