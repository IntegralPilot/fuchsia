import("//build/bazel/bazel_host_tool.gni")

assert(is_host, "bazel_host_tool() can only be called in a host toolchain.")

bazel_host_tool("plasa_test_coverage_report") {
  bazel_target = ":plasa_test_coverage_report"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/plasa_test_coverage_report_/plasa_test_coverage_report"
  install_host_tool = true
}
