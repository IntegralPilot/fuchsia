load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "main_lib",
    srcs = [
        "main.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/sdk/ctf/plasa/clang_doc_filter/main_lib",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//visibility:public"],
    deps = [
        "//sdk/ctf/plasa/model:gopkg",
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:gopkg.in/yaml.v2",
    ],
)

go_binary_host_tool(
    name = "clang_doc_filter",
    embed = [":main_lib"],
    target_compatible_with = HOST_CONSTRAINTS,
)

host_test_data_files(
    name = "clang_doc_filter_testdata",
    srcs = [
        "testdata/@nonymous_record_FFBFAD8A3BBD799586600B40A3453BBD95900F13.yaml",
        "testdata/channel.yaml",
        "testdata/index.yaml",
    ],
    dest_dir = "testdata",
)

host_go_test(
    name = "clang_doc_filter_test",
    srcs = ["report_test.go"],
    embed = [":main_lib"],
    target_compatible_with = HOST_CONSTRAINTS,
    test_args = ["-test_data_dir=testdata"],
    test_data = [":clang_doc_filter_testdata"],
    visibility = ["//sdk:__pkg__"],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//third_party/golibs:github.com/google/go-cmp/cmp/cmpopts",
    ],
)
