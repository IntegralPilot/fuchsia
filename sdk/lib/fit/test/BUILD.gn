import("//build/components.gni")
import("//build/config/fuchsia_cxx_version.gni")
import("//build/cpp/sdk_cpp_test.gni")
import("//build/cpp/sdk_cpp_unittest_package.gni")
import("//build/test.gni")

group("tests") {
  testonly = true
  deps = [
    ":fit($host_toolchain)",
    ":fit-test-pkg",
  ]
}

sdk_cpp_test("fit") {
  sources = [
    "defer_tests.cc",
    "examples/function_example1.cc",
    "examples/function_example2.cc",
    "function_examples.cc",
    "function_tests.cc",
    "function_traits_tests.cc",
    "inline_any_multi_inheritance_tests.cc",
    "inline_any_tests.cc",
    "nullable_tests.cc",
    "result_tests.cc",
    "thread_checker_tests.cc",
    "traits_tests.cc",
    "utility_internal_tests.cc",
  ]
  deps = [
    "//sdk/lib/fit",
    "//src/lib/fxl/test:gtest_main",
    "//src/sys/test_runners/gtest:death_test",
  ]
  configs += [ "//build/config:test_exercising_sdk_headers" ]
}

sdk_cpp_unittest_package("fit-test-pkg") {
  package_name = "fit"
  sdk_cpp_test_deps = [ ":fit" ]
}
