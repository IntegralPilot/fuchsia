import("//build/rust/rustc_library.gni")

group("rust") {
  public_deps = [ ":zx-libc" ]
}

# LINT.IfChange
rustc_library("zx-libc") {
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/lib.rs",
    "src/sanitizer.rs",
    "src/utc.rs",
  ]
  deps = [ "//sdk/rust/zx" ]

  configs -= [ "//build/config/rust:no_features" ]  # bazel2gn can't generate
  rustflags = [ "-Zallow_features=c_size_t" ]
}
# LINT.ThenChange(BUILD.bazel)
