import("//build/components.gni")
import("//build/cpp/sdk_cpp_test.gni")
import("//build/cpp/sdk_cpp_unittest_package.gni")

sdk_cpp_test("bin") {
  output_dir = target_out_dir

  sources = [ "real_loop_test.cc" ]

  deps = [
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/async-default",
    "//sdk/lib/async-loop-testing/cpp",
    "//sdk/lib/fit-promise",
    "//src/lib/fxl",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/fxl/test:test_settings",
    "//src/lib/testing/predicates",
    "//zircon/system/ulib/sync:sync-cpp",
  ]

  testonly = true
}

sdk_cpp_unittest_package("async_loop_testing_tests") {
  sdk_cpp_test_deps = [ ":bin" ]
}

group("tests") {
  testonly = true

  deps = [ ":async_loop_testing_tests" ]
}
