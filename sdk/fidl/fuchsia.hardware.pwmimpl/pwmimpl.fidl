@available(added=HEAD)
library fuchsia.hardware.pwmimpl;

using fuchsia.hardware.pwm;
using zx;

/// Low-level interface for PWM (Pulse Width Modulation) drivers.
@transport("Driver")
open protocol PwmImpl {
    /// Gets the current configuration of the PWM channel.
    ///
    /// ## Errors
    ///
    /// * `ZX_ERR_INVALID_ARGS`: The `idx` is invalid.
    flexible GetConfig(struct {
        /// The index of the requested PWM channel.
        idx uint32;
    }) -> (struct {
        /// The current configuration of the PWM channel.
        config fuchsia.hardware.pwm.PwmConfig;
    }) error zx.Status;

    /// Sets the configuration of the PWM channel.
    ///
    /// ## Errors
    ///
    /// * `ZX_ERR_INVALID_ARGS`: The `idx` or `config` is invalid.
    flexible SetConfig(struct {
        /// The index of the requested PWM channel.
        idx uint32;

        /// The new configuration to apply.
        config fuchsia.hardware.pwm.PwmConfig;
    }) -> () error zx.Status;

    /// Enables the PWM channel.
    ///
    /// ## Errors
    ///
    /// * `ZX_ERR_INVALID_ARGS`: The `idx` is invalid.
    flexible Enable(struct {
        /// The index of the requested PWM channel.
        idx uint32;
    }) -> () error zx.Status;

    /// Disables the PWM channel.
    ///
    /// ## Errors
    ///
    /// * `ZX_ERR_INVALID_ARGS`: The `idx` is invalid.
    flexible Disable(struct {
        /// The index of the requested PWM channel.
        idx uint32;
    }) -> () error zx.Status;
};

service Service {
    device client_end:PwmImpl;
};
