library fuchsia.fdomain;

/// Options for creating a VMO.
@available(added=HEAD)
type VmoOptions = flexible bits : uint32 {
    RESIZABLE = 0x0002;
    TRAP_DIRTY = 0x0008;
    UNBOUNDED = 0x0010;
};

/// FDomain operations on VMOs (Virtual Memory Objects).
@no_resource
@available(added=HEAD)
open protocol Vmo {
    /// Create a new VMO in this FDomain.
    flexible CreateVmo(struct {
        size uint64;
        options VmoOptions;
        handle NewHandleId;
    }) -> () error Error;

    /// Read data from a VMO.
    flexible ReadVmo(struct {
        handle HandleId;
        offset uint64;
        size uint64;
    }) -> (struct {
        data vector<uint8>;
    }) error Error;

    /// Write data to a VMO.
    flexible WriteVmo(struct {
        handle HandleId;
        offset uint64;
        data vector<uint8>;
    }) -> () error Error;

    /// Get the size of a VMO in bytes.
    flexible GetVmoSize(struct {
        handle HandleId;
    }) -> (struct {
        size uint64;
    }) error Error;

    /// Set the size of a VMO in bytes.
    flexible SetVmoSize(struct {
        handle HandleId;
        size uint64;
    }) -> () error Error;

    /// Get the stream size of a VMO in bytes.
    flexible GetVmoStreamSize(struct {
        handle HandleId;
    }) -> (struct {
        size uint64;
    }) error Error;

    /// Set the stream size of a VMO in bytes.
    flexible SetVmoStreamSize(struct {
        handle HandleId;
        size uint64;
    }) -> () error Error;
};
