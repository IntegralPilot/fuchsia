@available(added=HEAD)
library fuchsia.diagnostics.persistence;

using fuchsia.io;
using zx;

/// Represents the processed data from the previous boot once it is ready.
type PreviousBootData = resource table {
    /// The monotonic timestamp associated with when this data was captured/processed.
    1: monotonic_timestamp zx.InstantMono;

    /// The boot timestamp associated with when this data was captured/processed.
    2: boot_timestamp zx.InstantBoot;

    /// The UTC timestamp at which this data was captured, if the UTC time was at logging
    /// quality. This field is omitted if UTC is not available or not at logging quality.
    /// See //sdk/fidl/fuchsia.time.fidl for reference.
    3: utc_timestamp_ns zx.Time;

    /// An open, read-only file handle to the processed data file.
    /// The client can read the data directly from this channel.
    4: inspect client_end:fuchsia.io.File;
};

/// File format for Inspect data.
type InspectFormat = flexible enum {
    JSON = 1;
};

/// Options for configuring the watcher.
type PreviousBootDataProviderOptions = table {
    1: format InspectFormat;
};

@discoverable
open protocol PreviousBootDataProvider {
    /// Hanging get: Returns the data once it has been rotated and is ready.
    ///
    /// If the data is already ready when this method is called, the responder
    /// returns immediately. Otherwise, the responder holds the request until
    /// the data becomes available.
    ///
    /// Clients should only call this method once per boot. This data does not
    /// change across a given boot.
    flexible WatchPreviousBootData(struct {
        options PreviousBootDataProviderOptions;
    }) -> (resource struct {
        data PreviousBootData;
    });
};
