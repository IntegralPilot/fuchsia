library fuchsia.pkg;

/// A mapping from package URLs [0] to package hashes and blob sources.
/// [0] https://fuchsia.dev/fuchsia-src/concepts/packages/package_url
@discoverable
closed protocol Authority {
    /// Get information about a package from this `Authority`.
    strict Lookup(struct {
        /// The absolute package URL of the package to look up.
        package_url PackageUrl;
    }) -> (struct {
        /// The id of the package (the hash of its meta.far).
        package_id BlobId;

        /// A URL of a directory on an HTTP[S] server that contains all of the blobs of the package.
        /// The filenames of the blobs in the directory are the hex-encoded hashes of the blobs.
        /// The blob files are contained directly in the directory (e.g. the delivery blob type
        /// does not need to be appended to the URL).
        http_blob_dir string:1024;
    }) error strict enum {
        /// `package_url` was not a valid package URL.
        INVALID_URL = 1;

        /// `package_url` was pinned, which is not allowed.
        PINNED_URL_NOT_ALLOWED = 2;

        /// This `Authority` is not aware of the repository indicated by `package_url`.
        REPOSITORY_NOT_FOUND = 3;

        /// The repository indicated by `package_url` does not contain the indicated package.
        PACKAGE_NOT_FOUND = 4;

        /// This `Authority` failed to communicate with an upstream authority of its own, so this
        /// `Authority` does not know if it has the package. Clients may attempt to fallback to a
        /// different authority.
        UPSTREAM_CONNECTION = 5;

        /// There was an error with the configuration or operation of this `Authority` or its
        /// dependencies.
        INTERNAL = 6;
    };
};
