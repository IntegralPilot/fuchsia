library fuchsia.ui.input;

using fuchsia.input;
using zx;

@available(added=HEAD)
const MAX_NAME_LENGTH uint32 = 256;
@available(added=HEAD)
const MOUSE_MAX_NUM_BUTTONS uint32 = fuchsia.input.MOUSE_MAX_NUM_BUTTONS;
@available(added=HEAD)
const KEYBOARD_MAX_NUM_KEYS uint32 = 256;
@available(added=HEAD)
const KEYBOARD_MAX_NUM_LEDS uint32 = 256;
@available(added=HEAD)
const TOUCH_MAX_CONTACTS uint32 = fuchsia.input.TOUCH_MAX_CONTACTS;
@available(added=HEAD)
const TOUCH_MAX_NUM_BUTTONS uint32 = fuchsia.input.TOUCH_MAX_NUM_BUTTONS;
@available(added=HEAD)
const CONSUMER_CONTROL_MAX_NUM_BUTTONS uint32 = fuchsia.input.CONSUMER_CONTROL_MAX_NUM_BUTTONS;
@available(added=HEAD)
const SENSOR_MAX_VALUES uint32 = 100;

/// An LedType represents an LED on a device that can be turned on or off.
@available(added=HEAD)
type LedType = flexible enum : uint32 {
    NUM_LOCK = 0x01;
    CAPS_LOCK = 0x02;
    SCROLL_LOCK = 0x03;
    COMPOSE = 0x04;
    KANA = 0x05;
};

/// The device type from which the touch originated.
@available(added=HEAD)
type TouchType = flexible enum : uint32 {
    TOUCHSCREEN = 1;
    TOUCHPAD = 2;
};

/// Each sensor value has a corresponding SensorType, which explains what the
/// value is measuring in the world.
@available(added=HEAD)
type SensorType = flexible enum : uint32 {
    ACCELEROMETER_X = 1;
    ACCELEROMETER_Y = 2;
    ACCELEROMETER_Z = 3;
    MAGNETOMETER_X = 4;
    MAGNETOMETER_Y = 5;
    MAGNETOMETER_Z = 6;
    GYROSCOPE_X = 7;
    GYROSCOPE_Y = 8;
    GYROSCOPE_Z = 9;
    LIGHT_ILLUMINANCE = 10;
    LIGHT_RED = 11;
    LIGHT_GREEN = 12;
    LIGHT_BLUE = 13;
};

/// A `SensorAxis` is a normal `Axis` with an additional `SensorType` to describe what the
/// axis is measuring.
@available(added=HEAD)
type SensorAxis = struct {
    axis fuchsia.input.Axis;
    type SensorType;
};

/// DeviceInformation provides more information about the device and lets a
/// client distinguish between devices (e.g between two touchscreens that come
/// from different vendors).
@available(added=HEAD)
type DeviceInformation = table {
    /// Required.
    1: vendor_id uint32;

    /// Required.
    2: product_id uint32;

    /// Optional.
    3: version uint32;

    /// The time interval between each poll of the device.
    ///
    /// Optional.
    4: polling_rate zx.Duration;

    /// Human-readable name of the manufacturer. Optional.
    /// Must be non-empty if present.
    5: manufacturer_name string:MAX_NAME_LENGTH;

    /// Human-readable name of the product. Optional.
    /// Must be non-empty if present.
    6: product_name string:MAX_NAME_LENGTH;

    /// Serial number of the device. Optional.
    /// Must be non-empty if present.
    7: serial_number string:MAX_NAME_LENGTH;
};

/// Describes the format of the input report that will be sent from the mouse
/// to the device.
@available(added=HEAD)
type MouseInputDescriptor = table {
    /// The range of relative X movement.
    1: movement_x fuchsia.input.Axis;

    /// The range of relative Y movement.
    2: movement_y fuchsia.input.Axis;

    /// The range of relative vertical scroll.
    3: scroll_v fuchsia.input.Axis;

    /// The range of relative horizontal scroll.
    4: scroll_h fuchsia.input.Axis;

    /// IDs of the mouse buttons.
    5: buttons vector<uint8>:MOUSE_MAX_NUM_BUTTONS;

    /// The range of the position of X.
    6: position_x fuchsia.input.Axis;

    /// The range of the position of Y.
    7: position_y fuchsia.input.Axis;
};

/// The capabilities of a mouse device.
@available(added=HEAD)
type MouseDescriptor = table {
    /// Describes the input capabilities of the device.
    1: input MouseInputDescriptor;
};

/// Describes the format of the input report that will be sent from the keyboard
/// to the device.
@available(added=HEAD)
type KeyboardInputDescriptor = table {
    /// The list of keys that this keyboard contains.
    1: keys vector<fuchsia.input.Key>:KEYBOARD_MAX_NUM_KEYS;
};

/// Describes the format of the output report that can be sent to the keyboard.
@available(added=HEAD)
type KeyboardOutputDescriptor = table {
    /// The list of keyboard LEDs that can be toggled.
    1: leds vector<LedType>:KEYBOARD_MAX_NUM_LEDS;
};

/// The capabilities of a keyboard device.
@available(added=HEAD)
type KeyboardDescriptor = table {
    1: input KeyboardInputDescriptor;
    2: output KeyboardOutputDescriptor;
};

/// `ContactInputDescriptor` describes the fields associated with a touch on a touch device.
@available(added=HEAD)
type ContactInputDescriptor = table {
    1: position_x fuchsia.input.Axis;
    2: position_y fuchsia.input.Axis;
    3: pressure fuchsia.input.Axis;
    4: contact_width fuchsia.input.Axis;
    5: contact_height fuchsia.input.Axis;
};

/// Describes the format of the input report that will be sent from the touch device
/// to the host.
@available(added=HEAD)
type TouchInputDescriptor = table {
    1: contacts vector<ContactInputDescriptor>:TOUCH_MAX_CONTACTS;
    2: max_contacts uint32;
    3: touch_type TouchType;
    4: buttons vector<TouchButton>:TOUCH_MAX_NUM_BUTTONS;
};

/// Describes the format of the touchpad configuration's feature report.
@available(added=HEAD)
type TouchFeatureDescriptor = table {
    1: supports_input_mode bool;
    2: supports_selective_reporting bool;
};

/// The capabilities of a touch device.
@available(added=HEAD)
type TouchDescriptor = table {
    1: input TouchInputDescriptor;
    2: feature TouchFeatureDescriptor;
};

/// Describes the format of the input report that will be sent from the
/// ConsumerControl device to the host.
@available(added=HEAD)
type ConsumerControlInputDescriptor = table {
    1: buttons vector<fuchsia.input.ConsumerControlButton>:CONSUMER_CONTROL_MAX_NUM_BUTTONS;
};

/// A Fuchsia ConsumerControl represents a device that changes values on the host.
@available(added=HEAD)
type ConsumerControlDescriptor = table {
    1: input ConsumerControlInputDescriptor;
};

/// Describes the format of the input report that will be sent from the sensor
/// to the device.
@available(added=HEAD)
type SensorInputDescriptor = table {
    1: values vector<SensorAxis>:SENSOR_MAX_VALUES;
};

/// The capabilities of a sensor device.
@available(added=HEAD)
type SensorDescriptor = table {
    1: input SensorInputDescriptor;
};

/// `DeviceDescriptor` describes a physical input device.
@available(added=HEAD)
type DeviceDescriptor = table {
    /// Identifies the physical device.
    1: device_information DeviceInformation;

    /// Describes the mouse part of the device.
    2: mouse MouseDescriptor;

    /// Describes the sensor part of the device.
    3: sensor SensorDescriptor;

    /// Describes the touch part of the device.
    4: touch TouchDescriptor;

    /// Describes the keyboard part of the device.
    5: keyboard KeyboardDescriptor;

    /// Describes the consumer control part of the device.
    6: consumer_control ConsumerControlDescriptor;
};
