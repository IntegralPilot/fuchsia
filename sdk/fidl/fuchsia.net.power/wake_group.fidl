@available(added=HEAD)
library fuchsia.net.power;

using fuchsia.net.resources;
using zx;

const MAX_NAME_LEN uint8 = 255;

// TODO(https://fxbug.dev/42061412): Use signal constants directly once they're
// defined in the zx library.

/// Signal asserted by the netstack to request the client to wake up.
const GROUP_WAKEUP_SIGNAL uint32 = 0x01000000; // USER_SIGNAL_0

// These two signals were picked to specifically match the Starnix wake watcher.
/// Signal asserted by the client when it's awake.
const WAITER_AWAKE_SIGNAL uint32 = 0x01000000; // USER_SIGNAL_0
/// Signal asserted by the client when it's asleep.
const WAITER_ASLEEP_SIGNAL uint32 = 0x02000000; // USER_SIGNAL_1

type WakeGroupOptions = table {
    /// A name to identify the wake group for the purposes of debugging.
    ///
    /// Optional. If absent, the netstack chooses a debug name.
    ///
    /// Note: the debug name is not required to be, nor is it guaranteed to be,
    /// unique. Wake groups are uniquely identified by their
    /// [`fuchsia.net.resources/WakeGroupToken`].
    1: debug_name string:MAX_NAME_LEN;
};

/// A provider of wake groups.
///
/// A wake group represents a set of sockets that should wake up a client when
/// data arrives on any of them. Each `WakeGroupToken` represents a distinct
/// wake group.
///
/// A socket can only be registered with a wake group on creation. To do so,
/// pass the `WakeGroupToken` to the appropriate `fuchsia.posix.socket` method.
@discoverable
closed protocol WakeGroupProvider {
    /// Creates a new wake group with the provided options.
    strict CreateWakeGroup(@generated_name("CreateWakeGroupRequest") resource struct {
        options WakeGroupOptions;
        /// Used by the client to signal its current power state.
        ///
        /// [`WAITER_AWAKE_SIGNAL`] or [`WAITER_ASLEEP_SIGNAL`], but never both,
        /// should be asserted continuously to ensure the netstack stays
        /// up-to-date on the current state of the client. The netstack closes
        /// the wake group if both are asserted simultaneously or if the
        /// eventpair is closed.
        ///
        /// Note that this corresponds to the behavior of
        /// [`fuchsia.starnix.runner/Manager.RegisterWakeWatcher`].
        wake_watcher zx.Handle:<EVENTPAIR, zx.Rights.TRANSFER | zx.Rights.WAIT>;
    }) -> (@generated_name("CreateWakeGroupResponse") resource table {
        /// A token that is used both to identify this wake group when adding
        /// networking resources (such as sockets) to the group, and for wake
        /// signaling.
        ///
        /// A signal of [`GROUP_WAKEUP_SIGNAL`] is raised to indicate that the
        /// client should wake up due to incoming data. For efficiency, the
        /// netstack only newly asserts this when the client is asleep. How long
        /// it remains asserted after wakeup is unspecified.
        ///
        /// Always present.
        1: token fuchsia.net.resources.WakeGroupToken;
    });
};
