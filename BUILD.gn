# LINT.IfChange(bazel_target_infos)
#
# The bazel_target_infos.json file maps provides the information necessary for
# Ninja to run a bazel action, by telling the bazeL_ninja_delayed_actions.py
# script how to find all the inputs from Ninja for each Bazel target, and all
# the outputs to copy out.
#
# This data is structured for ease of generation, and is flattened into a more
# manageable format by the parsing code used by bazeL_ninja_delayed_actions.py.
#
# Type: list(scope)
#
#   type:
#     - Required: The output type, one of:
#         file
#         directory
#         package
#         final_symlink
#     - Type: string
#
#   bazel_target:
#     - Required: bazel target that builds the directory
#     - Type: string
#
#   bazel_platform_label:
#     - Required: bazel platform label to use with the --platforms arg when calling bazel
#     - Type: string
#
#   bazel_platform_config:
#     - Required: bazel config to add to the bazel command line with the --config arg
#     - Type: string
#
#   ninja_depfile:
#     - Required: the ninja depfile path (rebased) for the action
#     - Type: string
#
#   gn_targets_manifest
#     - Required: Path to a manifest of file to add the to the @gn_targets directory when building
#                 this target
#     - Type: string
#
#   stamp_path
#     - Required: Path to a "stamp file" that is to be touched when 'bazel_target' has been built.
#     - Type: string
#
#   update_rust_project:
#     - Optional: Whether this target should trigger updating rust-project.json
#     - Type: bool
#
#  The other fields depend on the 'type':
#
#     "file":
#        bazel_file:
#          - Required: Path in the bazel outdir to copy a file from
#          - Type: string
#
#        ninja_file:
#          - Required: path in the ninja outdir to copy to the file to
#          - Type: string
#
#     "directory":
#        bazel_dir:
#          - Required: path in the bazel outputs to the directory to copy
#          - Type: string
#
#        ninja_dir:
#          - Required: path in the ninja outdir to copy to the directory to
#          - Type: string
#
#        tracked_files:
#          - Required: list of file paths that are expected outputs by ninja, and used to track if
#            the directory contents have changed.
#          - Type: string
#
#        copy_debug_symbols:
#          - Optional: whether or not to copy debug symbols from the outputs back to ninja.
#          - Default: false
#          - Type: boolean
#
#     "package":
#
#        ninja_archive:
#          - Required: path the package archive (far) file
#          - Type: string
#
#        copy_debug_symbols:
#          - Optional: whether or not to copy debug symbols from the package back to ninja.
#          - Default: false
#          - Type: boolean
#
#     "final_symlink":
#        bazel_file:
#          - Required: path in the bazel outputs that's the symlink target
#          - Type: string
#
#        ninja_file:
#          - Required: path in the ninja outdir that's the symlink source
#          - Type: string
#
generated_file("bazel_target_infos") {
  testonly = true
  deps = [
           ":default",

           # //:root_targets has bazel_action() dependencies that are always
           # defined in the GN graph, so depend on it.
           "//:root_targets",

           # If it's in a build_api(), we need the ability to build it with
           # Bazel.
           ":api",
         ] + extra_bazel_build_action_labels

  data_keys = [ "bazel_target_infos" ]
  outputs = [ "$root_build_dir/$target_name.json" ]
  output_conversion = "json"
}

# LINT.ThenChange(
#   //build/bazel/scripts/bazel_action_utils.py:bazel_target_infos,
#   //build/bazel/bazel_action.gni:bazel_target_infos)

###
### Top-level targets.
###
group("default") {
  testonly = true
  deps = [
    ":size_reports",
    "//:build_only",
    "//:host",
    "//:product_bundles.check",
    "//:test-list",
    "//build:bazel2gn_dir_list",
    "//build/assembly:validate_product_defs",
    "//build/bazel:gn_build_variables_for_bazel",
    "//bundles/assembly",

    # TODO(https://fxbug.dev/42067746) has_board check not working
    "//build/images",
    "//build/images/updates:packages",
    "//sdk",

    # LINT.IfChange(fidl_compatibility_checks)
    # Ensure compatibility tests and SDK category checks run for all FIDL
    # libraries that require them.
    "//sdk/fidl:compatibility_tests",

    # LINT.ThenChange(//sdk/fidl/BUILD.gn:ensure_compatibility_checks)
  ]

  # SDK-only builds must not attempt to build images.
  if (has_board) {
    deps += [
      "//:drivers-check",
      "//build/images",
    ]
  }

  # Add any additional targets from the product.
  deps += additional_default_targets
}

###
# The build-only group.  These are additional targets to add to the build but
# are not part of a product, board, or host tools.  This group also serves as
# an alternative to '//:default' when performing sub-builds.
group("build_only") {
  testonly = true
  deps = build_only_labels
}

###
# GN-Argument configured groups for adding tests to a build.
#

# Host-only tests.  These cannot have any dependency on an assembled platform
# image, or the compiled OS itself, not even for their host_test_data().
group("host_tests") {
  testonly = true
  visibility = [ ":*" ]

  deps = []
  foreach(label, host_test_labels) {
    # Strip any toolchain that is provided, and replace with the host toolchain.
    full_label = get_label_info(label, "label_no_toolchain")
    deps += [ "$full_label($host_toolchain)" ]
  }
}

# Can be any test-type. This is for local-developer use only.  It is not for use
# by infra or products.
group("developer_specified_tests") {
  testonly = true
  visibility = [
    ":*",
    "//build/images/updates:*",
  ]
  public_deps = target_labels + developer_test_labels + e2e_test_labels +
                hermetic_test_package_labels
}

###
# GN-Argument configured groups other package sets
#

# Packages that are compiled and published, but unable to contribute to the
# product in any way.
group("discoverable_packages") {
  testonly = true
  visibility = [
    "//:bazel_test_suites",
    "//:test_components",
    "//:tests_from_metadata",
    "//build/images/updates:*",
  ]
  public_deps = discoverable_package_labels + universe_package_labels

  # Add //bundles/tools to the discoverable package set, as generally-available
  # platform tools, as all products were including them in
  # discoverable_package_labels anyway.
  public_deps += [ "//bundles/tools" ]
  assert_no_deps = [
    "//build/validate:config_data_tag",
    "//build/validate:shell_command_tag",
  ]
}

###
# GN-Argument configured groups for host binaries and tools
#

group("host") {
  # TODO(https://fxbug.dev/42160904) investigate removing testonly here
  testonly = true
  public_deps = [
    # Static analysis tools used by shac should always be built so that
    # `fx format-code` and other static analysis entrypoints can be run on any
    # build configuration.
    "//bundles/buildbot/static_checks($host_toolchain)",

    # Host tests for //build/api/client
    "//build/api:tests",

    # Tools & tests added by the developer
    ":developer_host_tools",
  ]

  public_deps += [ "//bundles/tools:host_tools" ]

  if (has_board) {
    # This indicates that we're building a product, rather than the SDK. In
    # this case it is likely useful to have fx tools pre-compiled for testing as
    # an optimization. That way fx commands can assume the executables exist
    # instead of running ninja, which is costly even if it's a no-op.
    public_deps += [ "//tools/devshell:fx($host_toolchain)" ]
  }
}

# WARNING: Known to infrastructure
#
# This group creates a single ninja build target that can create all targets
# specified by `host_labels` with `fx build :developer_host_tools`
group("developer_host_tools") {
  testonly = true
  public_deps = []

  foreach(label, host_labels) {
    # Strip any toolchain that is provided, and replace with the host toolchain.
    full_label = get_label_info(label, "label_no_toolchain")
    public_deps += [ "$full_label($host_toolchain)" ]
  }
}

# IMPORTANT: Nothing should depend on this target, except other generated_file()
# targets in this file. It is here to ensure that its dependencies are always in
# the GN build graph even if they are not reachable from //:default.
group("root_targets") {
  testonly = true
  visibility = [ ":*" ]
  deps = [
    # These are only required by the
    # core.x64-sdk_source_sets_and_shlibs-apiXX-build_only
    # builders. TODO(https://fxbug.dev/42082833): Remove these lines once these builders are
    # removed since they seem no longer necessary.
    "//build/sdk:sdk_versioned_shared_libraries",
    "//build/sdk:sdk_versioned_source_sets",

    # The Fuchsia Bazel SDK generated from the Fuchsia IDK, and the associated
    # tests.
    "//sdk:final_fuchsia_sdk_tests",

    # The IDK generated for the in-tree @fuchsia_sdk Bazel workspace, and
    # associated tests.
    "//sdk:bazel_in_tree_idk_tests",

    # The Bazel SDK test suite running against the in-tree @fuchsia_sdk
    # repository.
    "//build/bazel/bazel_sdk:bazel_sdk_tests",

    # Tests of platform Bazel rules, macros, and migrated targets.
    "//build/bazel/rules/tests:all",

    # Required by `fx fidldoc` as well as the Fuchsia controller ffx plugin
    # at runtime!
    "//build/fidl:all_fidl_json",

    # Required for local developer overrides to be found by the bazel workspace.
    "//build/bazel:assembly_developer_overrides",

    # The list of content hash files required by the Bazel workspace.
    # This is parsed by //build/regenerator just after `gn gen` to create
    # the final files in the Bazel workspace.
    "//build/bazel:bazel_content_hashes_json",

    # The sysroot files for the Bazel fuchsia_platform toolchain.
    "//zircon/public/sysroot_sdk:sysroot_for_fuchsia_platform",

    # The bazel_build_args.json collects the Bazel build arguments
    # needed to replicate the GN build configuration. Necessary to implement
    # `fx build @<bazel_label>` properly.
    "//build/bazel:bazel_args_json",

    # It must be possible to run the versioning scripts without them being part
    # of the default build.
    "//scripts/versioning($host_toolchain)",

    # To allow multi-products builds to define products that can be build with
    # fx build
    #
    # (the ":product_bundles" target itself is only a stub, so we need to
    # include its metadata target that actually follows the dependencies pass to
    # it)
    ":product_bundles_metadata",

    # A manifest file that points to implicit inputs for all targets listed
    # by ninja_implicit_inputs_root_labels.
    "//build/ninja_implicit_inputs:manifest",
  ]

  # Required by `fx publish` at runtime. Only included when package serving
  # processes are needed.
  if (has_board) {
    deps += [ "//build/images/updates:prepare_publish" ]
  }

  deps += [ "//sdk:subbuild_config" ]
}

# A GN pool matching the special Ninja 'console' pool. Any action() that
# uses this pool will be able to send its stdout/stderr directly to the
# output terminal, instead of being buffered by Ninja until the command
# completes.
#
# This is very useful for long-running commands, e.g. bazel build invocations
# that can take several dozen seconds to complete, or any other command that
# prints a _lot_ of output, because our infra bots will timeout if Ninja tries
# to print too much data at once after command completion for some undetermined
# reason.
#
pool("console") {
  depth = 1
}

# An action that pretends to create ninja_outputs.json. Dependents will be
# re-run when this file is regenerated, which will happen when the regenerator
# is invoked.
action("ninja_outputs_json") {
  script = "//build/scripts/no_op.sh"
  outputs = [ "${root_build_dir}/ninja_outputs.json" ]
  args = rebase_path(outputs, root_build_dir)
}
