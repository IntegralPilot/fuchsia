# Checks that product bundle names are unique.
action("product_bundles.check") {
  testonly = true

  inputs = get_target_outputs(":product_bundles")
  outputs = [ "${root_build_dir}/$target_name.stamp" ]

  script = "//build/check_product_bundles_manifest.py"
  args = [
    "--product-bundle-json",
    rebase_path(inputs[0], root_build_dir),
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
  ]

  if (!is_multi_product_build) {
    args += [
      # Fuchsia infrastructure expects this product bundle to exist.
      # TODO(https://fxbug.dev/402187053): Remove this check.
      "--expect-product-bundle-name",
      "${build_info_product}.${build_info_board}",
    ]
  }

  deps = [ ":product_bundles" ]
}

