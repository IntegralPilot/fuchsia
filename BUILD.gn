# This describes all the binaries linked by the build.
#
# This enumerates each linked binary (executable, shared library, or
# loadable/"plug-in" module) used by the build, or produced by the build.
#
# This includes host tools, kernels, boot loaders, drivers, as well as
# normal executables. This also includes prebuilt toolchain runtime
# libraries that end up in image files. It does not yet include any
# non-native binary formats.
#
# For non-prebuilts, this is meant to reach the entire dependency graph
# of all binaries that the build would ever produce.  Not every binary
# described is necessarily actually produced by any given Ninja run.  Either
# the $debug or the $dist file for any individual binary can be passed to
# Ninja as a specific target argument to ensure it's built and
# up to date before making use of that binary.  Like all build_api_module()
# targets, the top-level "binaries" target serves as a Ninja target to
# request that every binary described be built.
#
# Note that in certain cases, the paths in `debug` and `dist` will
# point out of the build tree, and thus cannot be used as Ninja targets.
# This happens for prebuilts or binaries produced by the Zircon build.
#
# Type: list(scope)
#
#   cpu
#     Required: CPU architecture the binary is for, e.g. "arm64" or "x64".
#     Type: string
#
#   os
#     Required: OS the binary is for, e.g. "fuchsia", "linux", or "mac".
#     Type: string
#
#   environment
#     Required: The ${toolchain_environment} name of what specific
#     execution this was built for, e.g. "user", "host", "guest".  The
#     tuple of ($cpu, $os, $environment) should indicate what hardware and
#     software environment this binary is compatible with.
#     Type: string
#
#   label
#     Required: The GN label of the binary target.
#     Type: label_with_toolchain
#
#   type
#     Required: The type of binary.
#     Type: "executable" or "shared_library" or "loadable_module"
#
#   debug
#     Required: Path to where the unstripped or separate debug file is
#     found, relative to $root_build_dir.  If $dist is omitted, this
#     is also the file that is used at runtime.
#     Type: path relative to $root_build_dir
#
#   dist
#     Optional: Path to where the stripped binary for deployment/execution is
#     found, relative to $root_build_dir.  This binary may be required for
#     some debugging tasks if $debug is a separate debug file rather than
#     an unstripped file.  It should exactly match the binary that will be
#     seen on devices or run directly on hosts.
#     Type: path relative to $root_build_dir
#
#   elf_build_id
#     Optional: Path to a file containing the lowercase ASCII hexadecimal
#     representation of the ELF build ID in this binary.  This is omitted
#     for OS environments that don't use ELF.  For an ELF binary that
#     doesn't have a build ID note, this key will be present but point to
#     an empty file.
#     Type: path relative to $root_build_dir
#
#   breakpad
#     Optional: Path to the breakpad symbol file for the debug binary.  This
#     will only be present if $output_breakpad_syms was set.
#     Type: path relative to $root_build_dir
build_api_module("binaries") {
  testonly = true
  data_keys = [ "binaries" ]
  deps = [ ":default" ]
}

# A build API module to describe the debug symbols for all ELF files that are
# either generated or used (as prebuilts) by the current build configuration.
# This is useful for infra tools to upload said symbol files to cloud storage.
#
# Debug symbols files can come from different sources:
#
# - They can be generated directly by GN C++ or Rust link commands, for example see
#   the tool() definitions in clang_toolchain().
#
# - They can be provided directly by certain prebuilts. For example, the Clang and
#   Rust toolchains provide a lib/debug/.build-id/ directory, whose content is
#   referenced from lib/runtime.json describing each runtime shared library
#   and the corresponding debug symbol files. See
#   //build/toolchain/runtime/toolchain_runtime_deps.gni
#
# - Many prebuilt binaries are distributed from CIPD packages that do not include
#   debug symbols at all. Instead, these debug symbol files are provided by a separate
#   and *optional* CIPD package that Jiri does not download by default.
#
#   For example, the JIRI manifest fragment at //integration/fuchsia/prebuilts
#   contains entries like:
#
#       <package name="fuchsia/prebuilt/bt-host/arm64"
#                path="prebuilt/connectivity/bluetooth/bt-host/arm64"
#                version="git_revision:29508f79429cd7610e1a87957d33d8ba8501475c"/>
#
#       <package name="fuchsia/prebuilt/bt-host/debug-symbols-arm64"
#                path="prebuilt/.build-id"
#                version="git_revision:29508f79429cd7610e1a87957d33d8ba8501475c"
#                attributes="debug-symbols,debug-symbols-arm64"/>
#
#   Note that debug symbols CIPD packages:
#
#       - Include "debug-symbols" in their name (either as a prefix or suffix)
#       - Set the "debug-symbols" JIRI "attributes" value.
#       - Typically extract to //prebuilt/.build-id/
#
#   A Jiri checkout can be configured to download and unpack debug symbols
#   with the following command:
#
#       jiri init -fetch-optional=debug-symbols
#       jiri update
#
#   Note that this adds about 66 GiB of prebuilts to the checkout as of March 2025!
#
# - Bazel targets can also generate unstripped ELF binaries, or can
#   depend on prebuilt ones provided by the @fuchsia_sdk repository.
#
# There are two types of entries in this manifest.
#
# The first one uses the "debug_symbol_files" metadata key, and describes one
# individual ELF debug symbol per entry, and is used for GN targets that
# generate them directly (e.g. C++ or Rust link actions), or from the
# runtime.json definitions provided with the prebuilt Clang and Rust toolchains.
# Its schema is:
#
# LINT.IfChange(debug_symbols)
#
# Type: list(scope)
#
#   label
#     Optional: The GN label of the binary target. Only used for debugging or
#     printing error messages.
#     Type: label_with_toolchain
#
#   dest_path
#     Optional: The Fuchsia package path for the corresponding stripped
#     binary, if available. Only used as debugging information, as several entries
#     can have the same dest_path value.
#     Type: path relative to Fuchsia package root.
#
#   cpu
#     Required: CPU architecture the binary is for, e.g. "arm64" or "x64".
#     Type: string
#
#   os
#     Required: OS the binary is for, e.g. "fuchsia", "linux", or "mac".
#     Type: string
#
#   debug
#     Required: Path to where the unstripped or separate debug file is.
#     Type: path relative to $root_build_dir
#
#   elf_build_id
#     Optional: Lowercase hexadecimal ASCII representation of the ELF build ID
#     for this binary, if available at `gn gen` time.
#     Type: string
#
#   elf_build_id_file
#     Optional: Path to a file containing the lowercase ASCII hexadecimal
#     representation of the ELF build ID in this binary. This is useful when
#     the value can be computed at build time, instead of `gn gen` time.
#     Type: path relative to $root_build_dir
#
#   breakpad
#     Optional: Path to the breakpad symbol file for the debug binary,
#     if available.
#
# LINT.ThenChange(
#    //build/bazel/debug_symbols/aspects.bzl:debug_symbols,
#    //build/bazel/scripts/bazel_tests_utils.py:debug_symbols,
#    //tools/artifactory/debug_symbols.go:ExportedDebugSymbol)
#
# Note that it is possible for none of "elf_build_id" or "elf_build_id_file" to
# be defined. This happens for Go executables for example. In that case, the
# value must be extracted by post-build tools manually, either by looking at the
# "debug" path, if it looks like "...../.build-id/xx/yyyyyyyyy.debug", or by
# parsing the content of the ELF file.
#
# If there is no breakpad value for an entry, the corresponding Breakpad symbol
# must be generated post-build, for example with the generate_breakpad tool.
#
# The second format, using "debug_symbol_manifests" metadata entries, describes
# one manifest per entry. This is to be used for prebuilt packages, or Bazel
# build targets.
#
#   label
#     Optional: The GN label of the target generating the manifest.
#     Type: label_with_toolchain
#
#   manifest
#     Required: Path to a manifest file listing all debug symbols corresponding
#     to a given target. The file must follow the same schema, and thus can include
#     entries pointing to other manifests (cycles are forbidden).
#
# Due to the way GN metadata collection works, the content of this manifest will
# reflect all possible debug symbols used/generated by the current build
# configuration, which is a superset of the symbols used/generated by the last
# build command.
#
# To filter its content properly, one should use the `//build/api/client
# print_debug_symbols --last-build-only` command instead, which will also
# flatten all nested manifest definitions into a single list of file entries.
#
build_api_module("debug_symbols") {
  testonly = true
  data_keys = [
    "debug_symbol_files",
    "debug_symbol_manifests",
  ]
  deps = [
    ":default",
    "//:bazel_test_suites",
    "//:prebuilt_binaries",
  ]
}

